// Package event dispatches typed events to their listeners, as Symfony's
// EventDispatcher does: a part of an app announces what happened, and the
// parts that care listen, without depending on each other.
//
//	type ArticlePublished struct{ Slug string }
//
//	event.On(d, func(ctx context.Context, e *ArticlePublished) error { … })
//	check event.Dispatch(ctx, d, &ArticlePublished{Slug: art.Slug}) ""
//
// An event is any type; its listeners get a pointer, so that they can
// change it for the listeners after them and for the dispatcher. Listeners
// run in order of priority, then of registration; a listener's error stops
// the dispatch and is Dispatch's, except Stop, which only stops it.
//
// A Subscriber registers listeners: goncini generate hands the app's
// subscribers to its Dispatcher, as it does routes.
package event

import (
	"cmp"
	"context"
	"errors"
	"fmt"
	"io"
	"reflect"
	"runtime"
	"slices"
	"strings"
	"sync"
	"text/tabwriter"
)

// Stop is what a listener returns to stop the dispatch of its event: the
// listeners after it don't run, and Dispatch returns nil.
var Stop = errors.New("event: stop")

// Subscriber registers listeners, as Symfony's event subscribers do.
type Subscriber interface {
	Subscribe(d *Dispatcher)
}

// Dispatcher keeps listeners, by the type of their events. Its zero value
// has none; a nil *Dispatcher dispatches to none.
type Dispatcher struct {
	mu        sync.RWMutex
	listeners map[reflect.Type][]listener
	added     int
}

// listener is a listener of an event type: a func(context.Context, *E)
// error, behind a func of any.
type listener struct {
	call     func(ctx context.Context, e any) error
	priority int
	order    int // when it was added, to keep that order at equal priorities
	name     string
}

// New returns a dispatcher with the listeners of the subscribers.
func New(subscribers ...Subscriber) *Dispatcher {
	d := &Dispatcher{}
	for _, s := range subscribers {
		s.Subscribe(d)
	}
	return d
}

// Option sets how a listener listens.
type Option func(*listener)

// Priority runs a listener before those of lower priority; the default is
// 0, and negative priorities run after.
func Priority(p int) Option {
	return l => { l.priority = p }
}

// On adds a listener of the events of type E.
func On[E any](d *Dispatcher, l func(ctx context.Context, e *E) error, opts ...Option) {
	ln := listener{
		call: (ctx context.Context, e any) => l(ctx, e.(*E)),
		name: funcName(l),
	}
	for _, o := range opts {
		o(&ln)
	}
	t := reflect.TypeFor[E]()
	d.mu.Lock()
	defer d.mu.Unlock()
	ln.order = d.added
	d.added++
	if d.listeners == nil {
		d.listeners = map[reflect.Type][]listener{}
	}
	// A new slice, so that a dispatch going through the old one isn't
	// disturbed.
	ls := append(slices.Clone(d.listeners[t]), ln)
	slices.SortStableFunc(ls, (a, b listener) => cmp.Compare(b.priority, a.priority))
	d.listeners[t] = ls
}

// Dispatch calls the listeners of e's type with e, in order, until one
// fails or returns Stop.
func Dispatch[E any](ctx context.Context, d *Dispatcher, e *E) error {
	if d == nil {
		return nil
	}
	d.mu.RLock()
	ls := d.listeners[reflect.TypeFor[E]()]
	d.mu.RUnlock()
	for _, l := range ls {
		if err := l.call(ctx, e); err != nil {
			if errors.Is(err, Stop) {
				return nil
			}
			return err
		}
	}
	return nil
}

// Has reports whether d has listeners of the events of type E, so that a
// dispatcher can skip making an event no one listens to.
func Has[E any](d *Dispatcher) bool {
	if d == nil {
		return false
	}
	d.mu.RLock()
	defer d.mu.RUnlock()
	return len(d.listeners[reflect.TypeFor[E]()]) > 0
}

// Info describes a listener, for debug:event-dispatcher.
type Info struct {
	Event    string // the event's type, such as articles.ArticlePublished
	Listener string // the function, such as feed.(*Feed).OnPublished
	Priority int
}

// List returns the listeners, by event type, then in the order they run.
func (d *Dispatcher) List() []Info {
	if d == nil {
		return nil
	}
	d.mu.RLock()
	defer d.mu.RUnlock()
	var out []Info
	for t, ls := range d.listeners {
		for _, l := range ls {
			out = append(out, Info{Event: t.String(), Listener: l.name, Priority: l.priority})
		}
	}
	slices.SortStableFunc(out, (a, b Info) => strings.Compare(a.Event, b.Event))
	return out
}

// WriteTable writes listeners as a table, one per line, the way
// debug:event-dispatcher prints them.
func WriteTable(w io.Writer, listeners []Info) error {
	tw := tabwriter.NewWriter(w, 0, 0, 2, ' ', 0)
	fmt.Fprintln(tw, "EVENT\tPRIORITY\tLISTENER")
	for _, l := range listeners {
		fmt.Fprintf(tw, "%s\t%d\t%s\n", l.Event, l.Priority, l.Listener)
	}
	return tw.Flush()
}

// funcName is the name of a function without its package's import path,
// and without the -fm suffix of a method value.
func funcName(fn any) string {
	f := runtime.FuncForPC(reflect.ValueOf(fn).Pointer())
	if f == nil {
		return "unknown"
	}
	name := strings.TrimSuffix(f.Name(), "-fm")
	if i := strings.LastIndexByte(name, '/'); i >= 0 {
		name = name[i+1:]
	}
	return name
}
