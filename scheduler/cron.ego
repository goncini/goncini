package scheduler

import (
	"fmt"
	"strconv"
	"strings"
	"time"
)

// Trigger says when a task runs next.
type Trigger interface {
	// Next returns the first time after t that the task runs.
	Next(t time.Time) time.Time
	String() string
}

// Every runs a task every d, at the multiples of d since the zero time:
// every instance of an app agrees on them, and Every(time.Hour) runs on the
// hour.
func Every(d time.Duration) Trigger {
	if d <= 0 {
		panic("scheduler: Every needs a positive duration")
	}
	return every(d)
}

type every time.Duration

func (e every) Next(t time.Time) time.Time {
	d := time.Duration(e)
	return t.Truncate(d).Add(d)
}

func (e every) String() string { return "every " + time.Duration(e).String() }

// Cron runs a task as a cron expression says, in UTC: five fields, the
// minute, hour, day of the month, month and day of the week (0 or 7 for
// Sunday), each *, a number, a range a-b, a step */n or a-b/n, or a list of
// those: "30 2 * * 1-5" is at 2:30 on weekdays. When both days are
// restricted, a day that matches either does, as in cron. @hourly, @daily,
// @weekly, @monthly and @yearly stand for their expressions.
func Cron(expr string) (Trigger, error) {
	return CronIn(expr, time.UTC)
}

// CronIn is Cron in the location: at 2:30 local time, for instance.
func CronIn(expr string, loc *time.Location) (Trigger, error) {
	full := match expr {
		"@hourly"              => "0 * * * *"
		"@daily", "@midnight"  => "0 0 * * *"
		"@weekly"              => "0 0 * * 0"
		"@monthly"             => "0 0 1 * *"
		"@yearly", "@annually" => "0 0 1 1 *"
		_                      => expr
	}
	fields := strings.Fields(full)
	if len(fields) != 5 {
		return nil, fmt.Errorf("scheduler: cron expression %q doesn't have 5 fields", expr)
	}
	c := &cron{expr: expr, loc: loc}
	bounds := [5][2]int{{0, 59}, {0, 23}, {1, 31}, {1, 12}, {0, 7}}
	sets := [5]*uint64{&c.minutes, &c.hours, &c.days, &c.months, &c.weekdays}
	for i, f := range fields {
		set, err := parseField(f, bounds[i][0], bounds[i][1])
		if err != nil {
			return nil, fmt.Errorf("scheduler: cron expression %q: %v", expr, err)
		}
		*sets[i] = set
	}
	if c.weekdays&(1<<7) != 0 {
		c.weekdays |= 1 // 7 is Sunday too
	}
	// A day field that starts with *, as */2, restricts nothing for the
	// OR of the two days, as in Vixie cron.
	c.anyDay, c.anyWeekday = strings.HasPrefix(fields[2], "*"), strings.HasPrefix(fields[4], "*")
	return c, nil
}

// MustCron is Cron, panicking on an invalid expression.
func MustCron(expr string) Trigger {
	t, err := Cron(expr)
	if err != nil {
		panic(err)
	}
	return t
}

// cron is a parsed cron expression: a bit set per field.
type cron struct {
	expr                                   string
	loc                                    *time.Location
	minutes, hours, days, months, weekdays uint64
	anyDay, anyWeekday                     bool
}

// parseField parses a field into a bit set of its values.
func parseField(f string, lo, hi int) (uint64, error) {
	var set uint64
	for part := range strings.SplitSeq(f, ",") {
		rng, stepText, hasStep := strings.Cut(part, "/")
		step := 1
		if hasStep {
			n, err := strconv.Atoi(stepText)
			if err != nil || n <= 0 {
				return 0, fmt.Errorf("invalid step %q", stepText)
			}
			step = n
		}
		from, to := lo, hi
		if rng != "*" {
			a, b, isRange := strings.Cut(rng, "-")
			var err error
			if from, err = strconv.Atoi(a); err != nil {
				return 0, fmt.Errorf("invalid value %q", a)
			}
			to = from
			if isRange {
				if to, err = strconv.Atoi(b); err != nil {
					return 0, fmt.Errorf("invalid value %q", b)
				}
			} else if hasStep {
				to = hi
			}
		}
		if from < lo || to > hi || from > to {
			return 0, fmt.Errorf("%q is out of %d-%d", part, lo, hi)
		}
		for v := from; v <= to; v += step {
			set |= 1 << v
		}
	}
	return set, nil
}

func (c *cron) String() string { return c.expr }

// Next returns the first minute after t that matches, walking the
// location's calendar and clocks: a time that its clocks skip, in a
// daylight saving gap, doesn't happen, and one that they repeat happens
// once.
func (c *cron) Next(t time.Time) time.Time {
	t = t.In(c.loc)
	y, m, d := t.Date()
	h, mi := t.Hour(), t.Minute()
	for day := 0; day < 5*366; day++ { // no match within 5 years: never, as February 30
		date := time.Date(y, m, d+day, 12, 0, 0, 0, time.UTC) // a civil date
		if c.months&(1<<int(date.Month())) == 0 || !c.dayMatches(date) {
			continue
		}
		for hour := 0; hour < 24; hour++ {
			if c.hours&(1<<hour) == 0 || day == 0 && hour < h {
				continue
			}
			for minute := 0; minute < 60; minute++ {
				if c.minutes&(1<<minute) == 0 || day == 0 && hour == h && minute <= mi {
					continue
				}
				next := time.Date(date.Year(), date.Month(), date.Day(), hour, minute, 0, 0, c.loc)
				if next.Hour() != hour || next.Minute() != minute || !next.After(t) {
					continue // skipped by the clocks
				}
				return next
			}
		}
	}
	return time.Time{}
}

// dayMatches reports whether t's day of the month or of the week matches:
// either, when both are restricted, as cron has it.
func (c *cron) dayMatches(t time.Time) bool {
	day := c.days&(1<<t.Day()) != 0
	weekday := c.weekdays&(1<<int(t.Weekday())) != 0
	switch {
	case c.anyDay && c.anyWeekday:
		return true
	case c.anyDay:
		return weekday
	case c.anyWeekday:
		return day
	}
	return day || weekday
}
