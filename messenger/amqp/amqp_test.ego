package amqp_test

import (
	"context"
	"database/sql"
	"os"
	"testing"
	"time"

	amqp091 "github.com/rabbitmq/amqp091-go"
	_ "modernc.org/sqlite"

	"github.com/goncini/goncini/messenger"
	"github.com/goncini/goncini/messenger/amqp"
	"github.com/goncini/goncini/messenger/transporttest"
	"github.com/goncini/goncini/uid"
)

// connect returns a connection to the broker of AMQP_TEST_URL, closed when
// the test ends, or skips the test without one.
func connect(t *testing.T) (*amqp.Connection, func() error) {
	url := os.Getenv("AMQP_TEST_URL")
	if url == "" {
		t.Skip("AMQP_TEST_URL names no broker to test with")
	}
	conn, closeConn := must amqp.NewConnection(amqp.Config{URL: url})
	must conn.PingContext(context.Background())
	t.Cleanup(() => { closeConn() })
	return conn, closeConn
}

// queue returns the name of a queue of the test's own, which goes when it
// ends, with its delay queues.
func queue(t *testing.T) string {
	name := "test." + uid.NewV4().String()
	t.Cleanup(() => {
		conn := must amqp091.Dial(os.Getenv("AMQP_TEST_URL"))
		defer conn.Close()
		ch := must conn.Channel()
		must ch.QueueDelete(name, false, false, false)
		for ttl := 1; ttl <= 1<<22; ttl *= 2 {
			must ch.QueueDelete(f"{name}.delay.{ttl}s", false, false, false)
		}
	})
	return name
}

func TestTransport(t *testing.T) {
	transporttest.RunBroker(t, func(t *testing.T) messenger.Transport {
		conn, _ := connect(t)
		return amqp.NewTransport(conn, queue(t))
	})
}

// TestLostLease checks that a lease lasts as long as the connection: once it
// drops, the message is another's to receive, and the lost lease's Ack does
// nothing.
func TestLostLease(t *testing.T) {
	ctx := context.Background()
	conn, closeConn := connect(t)
	tr := amqp.NewTransport(conn, queue(t))
	must tr.Send(ctx, messenger.Message{ID: "a", Type: "test.Message", Body: []byte(`{}`)})
	lost, _ := must tr.Receive(ctx, time.Second)
	time.Sleep(2 * time.Second)
	held := must lost.Extend(ctx, time.Second)
	if !held {
		t.Fatal("the lease ran out with time, rather than with the connection")
	}
	must closeConn()
	held = must lost.Extend(ctx, time.Second)
	if held {
		t.Fatal("the lease is held without a connection")
	}
	must lost.Ack(ctx)
	again, ok := must tr.Receive(ctx, time.Second) // dialled again
	if !ok || again.Message().ID != "a" {
		t.Fatalf("received %v", ok)
	}
}

func TestTransports(t *testing.T) {
	pool := must sql.Open("sqlite", "file::memory:")
	t.Cleanup(() => { pool.Close() })
	mc := messenger.Config{Queues: []string{"async", "mail"}}

	memory, _ := must amqp.NewConnection(amqp.Config{URL: "memory://"})
	ts := must amqp.NewTransports(memory, pool, amqp.Config{}, mc)
	for _, name := range []string{"async", "mail", "failed"} {
		if _, ok := ts[name].(*messenger.MemoryTransport); !ok {
			t.Errorf("%s is a %T", name, ts[name])
		}
	}

	broker, _ := must amqp.NewConnection(amqp.Config{URL: "amqp://localhost"}) // not dialled
	ts = must amqp.NewTransports(broker, pool, amqp.Config{}, mc)
	if _, ok := ts["async"].(*amqp.Transport); !ok || len(ts) != 3 {
		t.Errorf("transports %v", ts)
	}
	if _, ok := ts["failed"].(*messenger.SQLTransport); !ok {
		t.Errorf("the failure transport is a %T", ts["failed"])
	}
}
