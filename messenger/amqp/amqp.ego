// Package amqp keeps goncini's messages in RabbitMQ, or another AMQP 0.9.1
// broker, such as LavinMQ: a bus whose queues are the broker's, and whose
// failure transport is in the app's database, as SQL's, where
// messenger:failed:show lists it, as Symfony advises.
//
//	var Services = layer.Set(db.Open, amqp.Messenger, …)
//
// with an amqp.Config section in the app's config, whose URL is a secret:
// amqp://user:password@host:5672/vhost. In tests, the URL memory:// keeps
// the messages in the app's memory, as the redis module's does.
//
// The broker keeps the time, rather than the workers:
//
//   - A queue's messages are received in the order they come, rather than
//     by when they are due.
//   - A delayed message waits in a queue of its delay, whose messages expire
//     back to the queue: a queue per power of two seconds, declared when
//     first needed, so that a delay of 3 seconds waits 2, then 1. Delays
//     are timed to the second, never early.
//   - A lease lasts as long as the worker's connection, rather than a time:
//     the broker gives the message to another worker once the connection
//     drops, or once RabbitMQ's delivery acknowledgement timeout,
//     consumer_timeout, runs out, 30 minutes by default. A handler that
//     takes longer needs a longer one.
//   - A message sent again doesn't replace the one that is there: a message
//     moved to another queue twice is there twice, and handled twice, as
//     any message may be.
//
// A message dispatched in a database transaction is sent at once, whether
// the transaction commits or not: messenger.SQL's queues, which are in the
// database, send it with the transaction.
package amqp

import (
	"context"
	"database/sql"
	"errors"
	"maps"
	"math/bits"
	"sync"
	"time"

	"github.com/effect-go/effect-go/layer"
	amqp091 "github.com/rabbitmq/amqp091-go"

	"github.com/goncini/goncini/messenger"
)

// Config says which broker to use.
type Config struct {
	// URL is the broker's, amqp:// or amqps://, as amqp091-go's Dial takes
	// it, or memory:// for tests.
	URL string
	// Prefix is put before the queues' names, for apps that share a virtual
	// host; empty means goncini.
	Prefix string
	// QueueType is the x-queue-type of the queues it declares, such as
	// quorum, for queues that RabbitMQ replicates; empty means the virtual
	// host's default.
	QueueType string
}

func (c Config) prefix() string {
	return if c.Prefix == "" { "goncini." } else { c.Prefix }
}

// Messenger is the providers of a bus whose queues are the broker's, one
// per messenger.Config.Queues, and whose failure transport is in the app's
// database.
var Messenger = layer.Set(NewConnection, NewTransports, messenger.NewBus)

// NewTransports returns the queues of mc in the broker, and its failure
// transport in pool; or all of them in memory.
func NewTransports(conn *Connection, pool *sql.DB, c Config, mc messenger.Config) (messenger.Transports, error) {
	if conn.url == "" {
		return messenger.NewMemoryTransports(mc), nil
	}
	failed := mc.FailureTransport()
	ts := messenger.Transports{}
	for _, name := range mc.TransportNames() {
		if name != failed {
			ts[name] = NewTransport(conn, c.prefix()+name)
		}
	}
	ts[failed] = check messenger.NewSQLTransport(pool, failed) ""
	return ts, nil
}

// Connection is the transports' connection to the broker, which it dials
// again once it drops, with the channels that aren't in use.
type Connection struct {
	url       string // empty for memory://
	queueType string

	mu       sync.Mutex
	conn     *amqp091.Connection
	idle     []*amqp091.Channel
	declared map[string]bool // the queues declared since conn was dialled
}

// maxIdle is how many channels are kept for later.
const maxIdle = 32

// NewConnection returns the connection to c.URL, closed with the app, which
// doesn't dial until it is used: its PingContext checks it before serving.
func NewConnection(c Config) (*Connection, func() error, error) {
	switch c.URL {
	case "":
		return nil, nil, errors.New("amqp: Config.URL is empty")
	case "memory://":
		return &Connection{}, func() error { return nil }, nil
	}
	check amqp091.ParseURI(c.URL) ""
	conn := &Connection{url: c.URL, queueType: c.QueueType}
	return conn, conn.close, nil
}

func (c *Connection) close() error {
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.conn == nil || c.conn.IsClosed() {
		return nil
	}
	return c.conn.Close()
}

// PingContext checks that the broker answers.
func (c *Connection) PingContext(ctx context.Context) error {
	if c.url == "" {
		return nil
	}
	ch := check c.channel() ""
	c.release(ch, nil)
	return nil
}

// channel returns an idle channel, or a new one, in confirm mode, dialling
// the broker if it isn't connected.
func (c *Connection) channel() (*amqp091.Channel, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	if c.conn == nil || c.conn.IsClosed() {
		conn := check amqp091.DialConfig(c.url, amqp091.Config{Dial: amqp091.DefaultDial(10 * time.Second)}) ""
		c.conn, c.idle, c.declared = conn, nil, map[string]bool{}
	}
	for len(c.idle) > 0 {
		ch := c.idle[len(c.idle)-1]
		c.idle = c.idle[:len(c.idle)-1]
		if !ch.IsClosed() {
			return ch, nil
		}
	}
	ch := check c.conn.Channel() ""
	if err := ch.Confirm(false); err != nil {
		ch.Close()
		return nil, err
	}
	return ch, nil
}

// release keeps ch for later, or closes it if err says that its use failed:
// what it received but didn't acknowledge goes back to its queue.
func (c *Connection) release(ch *amqp091.Channel, err error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	if err == nil && !ch.IsClosed() && len(c.idle) < maxIdle {
		c.idle = append(c.idle, ch)
		return
	}
	ch.Close()
}

// declare declares a durable queue, with args, unless it was since the
// connection was dialled.
func (c *Connection) declare(ch *amqp091.Channel, name string, args amqp091.Table) error {
	c.mu.Lock()
	done := c.declared[name]
	c.mu.Unlock()
	if done {
		return nil
	}
	if c.queueType != "" {
		with := amqp091.Table{"x-queue-type": c.queueType}
		maps.Copy(with, args)
		args = with
	}
	check ch.QueueDeclare(name, true, false, false, false, args) ""
	c.mu.Lock()
	c.declared[name] = true
	c.mu.Unlock()
	return nil
}

// Transport keeps the messages of a queue of the broker.
type Transport struct {
	conn  *Connection
	queue string
}

// NewTransport returns the transport of the queue.
func NewTransport(conn *Connection, queue string) *Transport {
	return &Transport{conn: conn, queue: queue}
}

func (t *Transport) Send(ctx context.Context, m messenger.Message) error {
	ch := check t.conn.channel() ""
	err := t.publish(ctx, ch, m)
	t.conn.release(ch, err)
	return err
}

// The headers of what a message has that a publishing doesn't.
const (
	attemptsHeader    = "goncini-attempts"
	errorHeader       = "goncini-error"
	availableAtHeader = "goncini-available-at" // in Unix milliseconds
)

// publish publishes m on ch, and waits for the broker to confirm it: to the
// queue if m is due, or else to a delay queue.
func (t *Transport) publish(ctx context.Context, ch *amqp091.Channel, m messenger.Message) error {
	check t.conn.declare(ch, t.queue, nil) "" // where the delayed messages go
	queue := t.queue
	if wait := time.Until(m.AvailableAt); wait > 0 {
		queue = check t.delay(ch, wait) ""
	}
	confirm := check ch.PublishWithDeferredConfirmWithContext(ctx, "", queue, false, false, amqp091.Publishing{
		ContentType:  "application/json",
		DeliveryMode: amqp091.Persistent,
		MessageId:    m.ID,
		Type:         m.Type,
		Headers:      amqp091.Table{attemptsHeader: int64(m.Attempts), errorHeader: m.Error, availableAtHeader: m.AvailableAt.UnixMilli()},
		Body:         m.Body,
	}) ""
	acked := check confirm.WaitContext(ctx) ""
	if !acked {
		return errors.New("amqp: the broker refused the message")
	}
	return nil
}

// maxDelay is the longest delay queue's, in seconds: RabbitMQ's TTLs are
// below 2³² milliseconds.
const maxDelay = 1 << 22

// delay declares the delay queue of the longest power of two seconds within
// wait, rounded up to the second, and returns its name. Its messages expire
// back to the queue, where Receive delays those that are early again.
func (t *Transport) delay(ch *amqp091.Channel, wait time.Duration) (string, error) {
	seconds := (wait + time.Second - 1) / time.Second
	ttl := min(int64(1)<<(bits.Len64(uint64(seconds))-1), maxDelay)
	name := f"{t.queue}.delay.{ttl}s"
	check t.conn.declare(ch, name, amqp091.Table{"x-message-ttl": ttl * 1000, "x-dead-letter-exchange": "", "x-dead-letter-routing-key": t.queue}) ""
	return name, nil
}

// Receive leases the queue's next message for as long as the connection
// lasts, whatever ttl says.
func (t *Transport) Receive(ctx context.Context, ttl time.Duration) (messenger.Lease, bool, error) {
	ch := check t.conn.channel() ""
	lease, ok, err := t.receive(ctx, ch)
	if !ok || err != nil {
		t.conn.release(ch, err)
	}
	return lease, ok, err
}

func (t *Transport) receive(ctx context.Context, ch *amqp091.Channel) (messenger.Lease, bool, error) {
	check t.conn.declare(ch, t.queue, nil) ""
	for {
		d, ok, err := ch.Get(t.queue, false)
		if err != nil || !ok {
			return nil, false, err
		}
		m := messenger.Message{
			ID:          d.MessageId,
			Type:        d.Type,
			Body:        d.Body,
			Attempts:    int(d.Headers[attemptsHeader].(int64) ?? 0),
			Error:       d.Headers[errorHeader].(string) ?? "",
			AvailableAt: time.UnixMilli(d.Headers[availableAtHeader].(int64) ?? 0),
		}
		if time.Now().Before(m.AvailableAt) {
			// Back early from a delay queue, whose time was shorter.
			check t.publish(ctx, ch, m) ""
			check d.Ack(false) ""
			continue
		}
		return &lease{t: t, ch: ch, tag: d.DeliveryTag, msg: m}, true, nil
	}
}

// lease is a message that the channel received, until it acknowledges it.
type lease struct {
	t   *Transport
	ch  *amqp091.Channel // nil once the lease is settled
	tag uint64
	msg messenger.Message
}

func (l *lease) Message() messenger.Message { return l.msg }

// Extend reports whether the channel that received the message is open.
func (l *lease) Extend(ctx context.Context, ttl time.Duration) (bool, error) {
	return l.ch != nil && !l.ch.IsClosed(), nil
}

func (l *lease) Ack(ctx context.Context) error {
	return l.settle(ch => ch.Ack(l.tag, false))
}

// Retry publishes m, then acknowledges the message it replaces.
func (l *lease) Retry(ctx context.Context, m messenger.Message) error {
	return l.settle(func(ch *amqp091.Channel) error {
		check l.t.publish(ctx, ch, m) ""
		return ch.Ack(l.tag, false)
	})
}

// settle ends the lease with f, unless it was lost: the broker gave its
// message back, with the channel.
func (l *lease) settle(f func(ch *amqp091.Channel) error) error {
	ch := l.ch
	if ch == nil || ch.IsClosed() {
		return nil
	}
	l.ch = nil
	err := f(ch)
	l.t.conn.release(ch, err)
	return err
}
