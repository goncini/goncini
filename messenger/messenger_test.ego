package messenger_test

import (
	"context"
	"errors"
	"log/slog"
	"strings"
	"sync"
	"testing"
	"testing/synctest"
	"time"

	"github.com/goncini/goncini/console"
	"github.com/goncini/goncini/messenger"
)

type welcome struct {
	User string `json:"user"`
}

type unhandled struct{}

// newBus returns a bus with an async transport and a failure transport, in
// memory.
func newBus() (*messenger.Bus, *messenger.MemoryTransport, *messenger.MemoryTransport) {
	async, failed := &messenger.MemoryTransport{}, &messenger.MemoryTransport{}
	b := messenger.NewBus(messenger.Config{}, messenger.Transports{"async": async, "failed": failed}, nil, slog.New(slog.DiscardHandler))
	return b, async, failed
}

func TestDispatchNow(t *testing.T) {
	b, async, _ := newBus()
	var got []string
	messenger.Handle(b, func(ctx context.Context, m welcome) error { got = append(got, m.User); return nil })
	ctx := context.Background()
	must messenger.Dispatch(ctx, b, welcome{"ann"})
	if len(got) != 1 || got[0] != "ann" {
		t.Errorf("handled %v", got)
	}
	if _, ok := errors.AsType[messenger.NoHandler](messenger.Dispatch(ctx, b, unhandled{})); !ok {
		t.Error("no NoHandler for a message without a handler")
	}
	list := must async.List(ctx)
	if len(list) != 0 {
		t.Errorf("sent %v", list)
	}
}

// worker returns a worker of the bus's async transport.
func worker(b *messenger.Bus, limit int) *messenger.Worker {
	return &messenger.Worker{Bus: b, Transports: []string{"async"}, Limit: limit, Lease: time.Minute, StopTimeout: time.Minute, Logger: b.Logger}
}

func TestWorker(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		b, async, _ := newBus()
		var mu sync.Mutex
		var got []string
		messenger.Handle(b, func(ctx context.Context, m welcome) error {
			mu.Lock()
			defer mu.Unlock()
			got = append(got, m.User)
			return nil
		})
		messenger.Route[welcome](b, "async")
		ctx := context.Background()
		must messenger.Dispatch(ctx, b, welcome{"ann"})
		must messenger.Dispatch(ctx, b, welcome{"bob"}, messenger.Delay(time.Hour))
		if len(got) != 0 {
			t.Fatal("a routed message was handled when dispatched")
		}
		w := worker(b, 2)
		w.Concurrency = 2
		must w.Run(ctx) // returns after 2 messages, an hour later
		left := must async.List(ctx)
		if len(got) != 2 || got[0] != "ann" || got[1] != "bob" || len(left) != 0 {
			t.Errorf("handled %v, left %v", got, left)
		}
	})
}

func TestRetriesAndFailures(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		b, _, failed := newBus()
		start := time.Now()
		var tries []time.Duration
		messenger.Handle(b, func(ctx context.Context, m welcome) error {
			tries = append(tries, time.Since(start))
			return errors.New("the mail server is down")
		})
		messenger.Route[welcome](b, "async")
		ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
		defer cancel()
		must messenger.Dispatch(ctx, b, welcome{"ann"})
		must worker(b, 0).Run(ctx)
		want := []time.Duration{0, time.Second, 3 * time.Second, 7 * time.Second} // then 1, 2 and 4 seconds later
		if len(tries) != len(want) {
			t.Fatalf("tries at %v", tries)
		}
		for i := range want {
			if tries[i] < want[i] || tries[i] > want[i]+2*time.Second { // the worker polls every second
				t.Errorf("try %d at %v, want %v", i, tries[i], want[i])
			}
		}
		list := must failed.List(ctx)
		if len(list) != 1 || list[0].Attempts != 4 || list[0].Error != "the mail server is down" {
			t.Errorf("failed %+v", list)
		}
	})
}

// TestStopping checks that a worker told to stop finishes the message it
// handles, and that one cut short by the stop timeout goes back.
func TestStopping(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		b, async, _ := newBus()
		var done []string
		messenger.Handle(b, func(ctx context.Context, m welcome) error {
			takes := if m.User == "slow" { time.Hour } else { 10 * time.Second }
			select {
			case <-time.After(takes):
				done = append(done, m.User)
				return nil
			case <-ctx.Done():
				return context.Cause(ctx)
			}
		})
		messenger.Route[welcome](b, "async")
		for _, user := range []string{"quick", "slow"} {
			ctx := context.Background()
			must messenger.Dispatch(ctx, b, welcome{user})
			ctx, stop := context.WithCancel(ctx)
			w := worker(b, 0)
			finished := make(chan error)
			go func() { finished <- w.Run(ctx) }()
			time.Sleep(time.Second) // the worker took the message
			stop()                  // SIGTERM
			start := time.Now()
			if err := <-finished; err != nil {
				t.Fatal(err)
			}
			if user == "slow" && time.Since(start) != time.Minute || user != "slow" && time.Since(start) > 10*time.Second {
				t.Errorf("%s: stopping took %v", user, time.Since(start))
			}
		}
		left := must async.List(context.Background())
		if len(done) != 1 || done[0] != "quick" || len(left) != 1 || left[0].Attempts != 0 {
			// slow is back, as it was: being cut short isn't a failure.
			t.Errorf("done %v, left %+v", done, left)
		}
	})
}

// TestLostWorker checks that a message a worker leased, and never
// acknowledged, as when the worker dies, is received again once its lease
// runs out.
func TestLostWorker(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		ctx := context.Background()
		tr := &messenger.MemoryTransport{}
		must tr.Send(ctx, messenger.Message{ID: "1", Type: "welcome"})
		lease, ok := must tr.Receive(ctx, time.Minute)
		_, again := must tr.Receive(ctx, time.Minute)
		if !ok || again {
			t.Fatalf("received %v, again %v", ok, again)
		}
		time.Sleep(time.Minute)
		other, back := must tr.Receive(ctx, time.Minute)
		if !back || other.Message().ID != "1" {
			t.Fatal("the message isn't back once the lease ran out")
		}
		held := must lease.Extend(ctx, time.Minute)
		must lease.Ack(ctx) // the dead worker's: nothing happens
		list := must tr.List(ctx)
		if held || len(list) != 1 {
			t.Errorf("the old lease still held it: extended %v, left %d", held, len(list))
		}
	})
}

// TestFailedCommands checks messenger:failed:show, retry and remove.
func TestFailedCommands(t *testing.T) {
	b, async, failed := newBus()
	messenger.Route[welcome](b, "async")
	ctx := context.Background()
	at := time.Date(2026, 10, 7, 12, 0, 0, 0, time.UTC)
	must failed.Send(ctx, messenger.Message{ID: "1", Type: "github.com/goncini/goncini/messenger_test.welcome", Body: []byte(`{"user":"ann"}`), Attempts: 4, Error: "down", AvailableAt: at})
	must failed.Send(ctx, messenger.Message{ID: "2", Type: "github.com/goncini/goncini/messenger_test.welcome", Attempts: 4, AvailableAt: at})
	run := func(args ...string) (string, error) {
		var out strings.Builder
		err := console.Run(ctx, &out, messenger.Commands(b), "", args)
		return out.String(), err
	}
	shown := must run("messenger:failed:show")
	if !strings.Contains(shown, "1   github.com/goncini/goncini/messenger_test.welcome  4         2026-10-07 12:00:00  down") {
		t.Errorf("show:\n%s", shown)
	}
	must run("messenger:failed:retry", "1")
	must run("messenger:failed:remove", "2")
	back := must async.List(ctx)
	left := must failed.List(ctx)
	if len(back) != 1 || back[0].ID != "1" || back[0].Attempts != 0 || len(left) != 0 {
		t.Errorf("back %+v, left %+v", back, left)
	}
}
