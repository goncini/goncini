package messenger_test

import (
	"context"
	"database/sql"
	"errors"
	"log/slog"
	"strings"
	"sync/atomic"
	"testing"
	"testing/synctest"
	"time"

	"github.com/goncini/goncini/console"
	"github.com/goncini/goncini/db"
	"github.com/goncini/goncini/messenger"
)

// sqliteBus returns a bus whose queues are in a SQLite database in memory.
func sqliteBus(t *testing.T, c messenger.Config) (*messenger.Bus, messenger.Transports) {
	pool := must sql.Open("sqlite", "file::memory:")
	pool.SetMaxOpenConns(1)
	t.Cleanup(() => { pool.Close() })
	ts := must messenger.NewSQLTransports(pool, c)
	return messenger.NewBus(c, ts, nil, slog.New(slog.DiscardHandler)), ts
}

// TestSQLFailureTransport checks that a message that failed for good moves
// to the SQL failure queue, keeping its ID, and that failed:retry moves it
// back.
func TestSQLFailureTransport(t *testing.T) {
	b, ts := sqliteBus(t, messenger.Config{Retries: -1})
	messenger.Handle(b, func(ctx context.Context, m welcome) error { return errors.New("down") })
	messenger.Route[welcome](b, "async")
	ctx := context.Background()
	must messenger.Dispatch(ctx, b, welcome{"ann"})
	w := worker(b, 1)
	must w.Run(ctx)
	failed := must ts["failed"].(messenger.Browser).List(ctx)
	async := must ts["async"].(messenger.Browser).List(ctx)
	if len(failed) != 1 || failed[0].Attempts != 1 || len(async) != 0 {
		t.Fatalf("failed %+v, async %+v", failed, async)
	}
	var out strings.Builder
	must console.Run(ctx, &out, messenger.Commands(b), "", []string{"messenger:failed:retry"})
	failed = must ts["failed"].(messenger.Browser).List(ctx)
	async = must ts["async"].(messenger.Browser).List(ctx)
	if len(failed) != 0 || len(async) != 1 || async[0].ID == "" {
		t.Errorf("failed %+v, async %+v", failed, async)
	}
}

// TestStopTimeoutBoundsHandlers checks that a worker returns within its
// stop timeout even when a handler ignores its context, giving its message
// back.
func TestStopTimeoutBoundsHandlers(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		b, async, _ := newBus()
		messenger.Handle(b, func(ctx context.Context, m welcome) error {
			time.Sleep(time.Hour) // deaf to ctx
			return nil
		})
		messenger.Route[welcome](b, "async")
		must messenger.Dispatch(context.Background(), b, welcome{"ann"})
		ctx, stop := context.WithCancel(context.Background())
		w := worker(b, 0)
		w.StopTimeout = time.Second
		done := make(chan error)
		go func() { done <- w.Run(ctx) }()
		time.Sleep(time.Second)
		stop()
		start := time.Now()
		if err := <-done; err != nil {
			t.Fatal(err)
		}
		left := must async.List(context.Background())
		if took := time.Since(start); took > 2*time.Second || len(left) != 1 || left[0].Attempts != 0 {
			t.Errorf("stopping took %v; left %+v", took, left)
		}
		time.Sleep(time.Hour) // let the deaf handler end
	})
}

// flaky is a transport whose receives fail some of the time.
type flaky struct {
	messenger.Transport
	calls atomic.Int32
}

func (f *flaky) Receive(ctx context.Context, ttl time.Duration) (messenger.Lease, bool, error) {
	if f.calls.Add(1)%2 == 1 {
		return nil, false, errors.New("database is locked")
	}
	return f.Transport.Receive(ctx, ttl)
}

// TestReceiveErrorsPass checks that a worker goes on after a failed
// receive.
func TestReceiveErrorsPass(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		b, async, _ := newBus()
		b.Transports["async"] = &flaky{Transport: async}
		handled := 0
		messenger.Handle(b, func(ctx context.Context, m welcome) error { handled++; return nil })
		messenger.Route[welcome](b, "async")
		for range 3 {
			must messenger.Dispatch(context.Background(), b, welcome{"ann"})
		}
		must worker(b, 3).Run(context.Background())
		if handled != 3 {
			t.Errorf("handled %d", handled)
		}
	})
}

// TestSetupIsRetried checks that a transport whose table creation failed
// creates it at the next call.
func TestSetupIsRetried(t *testing.T) {
	_, ts := sqliteBus(t, messenger.Config{})
	cancelled, cancel := context.WithCancel(context.Background())
	cancel()
	if _, _, err := ts["async"].Receive(cancelled, time.Minute); err == nil {
		t.Fatal("no error with a cancelled context")
	}
	if _, _, err := ts["async"].Receive(context.Background(), time.Minute); err != nil {
		t.Errorf("after a failed setup: %v", err)
	}
}

// TestSQLOutbox checks that a message dispatched in a transaction of the
// queues' pool is queued with it: only if it commits.
func TestSQLOutbox(t *testing.T) {
	pool := must sql.Open("sqlite", "file::memory:")
	pool.SetMaxOpenConns(1) // a send outside the transaction would wait for it forever
	t.Cleanup(() => { pool.Close() })
	c := messenger.Config{}
	ts := must messenger.NewSQLTransports(pool, c)
	b := messenger.NewBus(c, ts, nil, slog.New(slog.DiscardHandler))
	messenger.Route[welcome](b, "async")
	tx := db.NewSQL(pool)
	ctx := context.Background()
	err := tx.InTx(ctx, func(ctx context.Context) error {
		must messenger.Dispatch(ctx, b, welcome{"rolled back"})
		return errors.New("rollback")
	})
	if err == nil {
		t.Fatal("no rollback")
	}
	must tx.InTx(ctx, func(ctx context.Context) error { return messenger.Dispatch(ctx, b, welcome{"ann"}) })
	queued := must ts["async"].(messenger.Browser).List(ctx)
	if len(queued) != 1 || !strings.Contains(string(queued[0].Body), "ann") {
		t.Errorf("queued %+v", queued)
	}
}

// TestFailedMoveAgain checks that a message whose move to the failure queue
// wasn't acknowledged, and so is in both queues, moves again once handled
// again, and that failed:retry sends back a message still queued.
func TestFailedMoveAgain(t *testing.T) {
	b, ts := sqliteBus(t, messenger.Config{Retries: -1})
	messenger.Handle(b, func(ctx context.Context, m welcome) error { return errors.New("down") })
	messenger.Route[welcome](b, "async")
	ctx := context.Background()
	async, failed := ts["async"].(messenger.Browser), ts["failed"].(messenger.Browser)
	must messenger.Dispatch(ctx, b, welcome{"ann"})
	queued := must async.List(ctx)
	must ts["failed"].Send(ctx, queued[0]) // moved, but the Ack failed
	must worker(b, 1).Run(ctx)
	inFailed := must failed.List(ctx)
	inAsync := must async.List(ctx)
	if len(inFailed) != 1 || inFailed[0].Attempts != 1 || len(inAsync) != 0 {
		t.Fatalf("failed %+v, async %+v", inFailed, inAsync)
	}
	must ts["async"].Send(ctx, inFailed[0]) // in both again
	var out strings.Builder
	must console.Run(ctx, &out, messenger.Commands(b), "", []string{"messenger:failed:retry"})
	inFailed = must failed.List(ctx)
	inAsync = must async.List(ctx)
	if len(inFailed) != 0 || len(inAsync) != 1 || inAsync[0].Attempts != 0 {
		t.Errorf("failed %+v, async %+v", inFailed, inAsync)
	}
}

// down is a transport whose database is away.
type down struct{}

func (down) Send(ctx context.Context, m messenger.Message) error { return errors.New("down") }

func (down) Receive(ctx context.Context, ttl time.Duration) (messenger.Lease, bool, error) {
	return nil, false, errors.New("down")
}

// TestWorkerErrors checks that a draining worker stops on a transport that
// fails, rather than poll it forever, and that a worker refuses to consume
// the failure transport, whose messages would fail over to it again.
func TestWorkerErrors(t *testing.T) {
	b := messenger.NewBus(messenger.Config{}, messenger.Transports{"async": down{}, "failed": &messenger.MemoryTransport{}}, nil, slog.New(slog.DiscardHandler))
	w := worker(b, 0)
	w.Drain = true
	if err := w.Run(context.Background()); err == nil || !strings.Contains(err.Error(), "down") {
		t.Errorf("draining a transport that is down: %v", err)
	}
	w = worker(b, 0)
	w.Transports = []string{"failed"}
	if err := w.Run(context.Background()); err == nil {
		t.Error("the worker consumed the failure transport")
	}
}

// TestBackground checks that serve's worker consumes the bus's transports,
// named as the app likes, but the failure transport.
func TestBackground(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		emails := &messenger.MemoryTransport{}
		b := messenger.NewBus(messenger.Config{Consume: true}, messenger.Transports{"emails": emails, "failed": &messenger.MemoryTransport{}}, nil, slog.New(slog.DiscardHandler))
		var handled atomic.Int32
		messenger.Handle(b, func(ctx context.Context, m welcome) error {
			handled.Add(1)
			return nil
		})
		messenger.Route[welcome](b, "emails")
		must messenger.Dispatch(context.Background(), b, welcome{"ann"})
		ctx, stop := context.WithTimeout(context.Background(), time.Minute)
		defer stop()
		must b.Background(ctx)
		if handled.Load() != 1 {
			t.Errorf("%d handled", handled.Load())
		}
	})
}
