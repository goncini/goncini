// Package transporttest checks that a messenger.Transport behaves as
// workers need: messages in order, leases that exclude each other and run
// out, and the acknowledgements and retries of a lost lease ignored.
//
//	func TestTransport(t *testing.T) {
//		transporttest.Run(t, (t *testing.T, now func() time.Time) => newTransport(t, now))
//	}
package transporttest

import (
	"context"
	"slices"
	"testing"
	"time"

	"github.com/goncini/goncini/messenger"
)

// Clock is a fake clock that the tests move.
type Clock struct {
	now time.Time
}

// Now returns the clock's time.
func (c *Clock) Now() time.Time { return c.now }

// Run runs the checks on transports that newTransport returns, new and
// empty for each check, with now as their clock.
func Run(t *testing.T, newTransport func(t *testing.T, now func() time.Time) messenger.Transport) {
	setup := func(t *testing.T) (messenger.Transport, *Clock) {
		c := &Clock{now: time.Date(2026, 10, 7, 12, 0, 0, 0, time.UTC)}
		return newTransport(t, c.Now), c
	}
	ctx := context.Background()
	msg := func(id string, at time.Time) messenger.Message {
		return messenger.Message{ID: id, Type: "test.Message", Body: []byte(`{"id":"` + id + `"}`), AvailableAt: at}
	}
	receive := func(t *testing.T, tr messenger.Transport, want string) messenger.Lease {
		t.Helper()
		lease, ok, err := tr.Receive(ctx, time.Minute)
		switch {
		case err != nil:
			t.Fatal(err)
		case want == "" && ok:
			t.Fatalf("received %s, want none", lease.Message().ID)
		case want != "" && !ok:
			t.Fatalf("received none, want %s", want)
		case want != "" && lease.Message().ID != want:
			t.Fatalf("received %s, want %s", lease.Message().ID, want)
		}
		return lease
	}

	t.Run("order and delays", (t *testing.T) => {
		tr, c := setup(t)
		for _, m := range []messenger.Message{msg("later", c.now.Add(time.Hour)), msg("b", c.now.Add(-time.Second)), msg("a", c.now.Add(-time.Minute))} {
			if err := tr.Send(ctx, m); err != nil {
				t.Fatal(err)
			}
		}
		a := receive(t, tr, "a")
		if got := a.Message(); string(got.Body) != `{"id":"a"}` || got.Type != "test.Message" {
			t.Errorf("message %+v", got)
		}
		b := receive(t, tr, "b")
		receive(t, tr, "") // later isn't available, and the others are leased
		a.Ack(ctx)
		b.Ack(ctx)
		c.now = c.now.Add(time.Hour)
		receive(t, tr, "later")
	})

	t.Run("acknowledging", (t *testing.T) => {
		tr, c := setup(t)
		tr.Send(ctx, msg("a", c.now))
		lease := receive(t, tr, "a")
		if err := lease.Ack(ctx); err != nil {
			t.Fatal(err)
		}
		c.now = c.now.Add(time.Hour)
		receive(t, tr, "") // gone for good
	})

	t.Run("lost leases", (t *testing.T) => {
		tr, c := setup(t)
		tr.Send(ctx, msg("a", c.now))
		dead := receive(t, tr, "a")
		c.now = c.now.Add(30 * time.Second)
		receive(t, tr, "") // still leased
		c.now = c.now.Add(31 * time.Second)
		alive := receive(t, tr, "a") // the lease ran out
		held, err := dead.Extend(ctx, time.Minute)
		if err != nil || held {
			t.Errorf("the lost lease extended: %v, %v", held, err)
		}
		dead.Ack(ctx)
		retried := dead.Message()
		retried.Attempts = 9
		dead.Retry(ctx, retried)
		held, err = alive.Extend(ctx, time.Minute)
		if err != nil || !held {
			t.Errorf("the new lease can't extend: %v, %v", held, err)
		}
		c.now = c.now.Add(61 * time.Second)
		again := receive(t, tr, "a") // the lost lease's ack and retry did nothing
		if again.Message().Attempts != 0 {
			t.Errorf("attempts %d", again.Message().Attempts)
		}
	})

	t.Run("retrying", (t *testing.T) => {
		tr, c := setup(t)
		tr.Send(ctx, msg("a", c.now))
		lease := receive(t, tr, "a")
		m := lease.Message()
		m.Attempts, m.Error, m.AvailableAt = 1, "the server is down", c.now.Add(time.Second)
		if err := lease.Retry(ctx, m); err != nil {
			t.Fatal(err)
		}
		receive(t, tr, "") // not yet
		c.now = c.now.Add(time.Second)
		got := receive(t, tr, "a").Message()
		if got.Attempts != 1 || got.Error != "the server is down" {
			t.Errorf("retried %+v", got)
		}
	})

	t.Run("browsing", (t *testing.T) => {
		tr, c := setup(t)
		b, ok := tr.(messenger.Browser)
		if !ok {
			t.Skip("the transport isn't a Browser")
		}
		tr.Send(ctx, msg("b", c.now))
		tr.Send(ctx, msg("a", c.now.Add(-time.Second)))
		list, err := b.List(ctx)
		if err != nil {
			t.Fatal(err)
		}
		ids := []string{}
		for _, m := range list {
			ids = append(ids, m.ID)
		}
		if !slices.Equal(ids, []string{"a", "b"}) {
			t.Errorf("listed %v", ids)
		}
		b.Remove(ctx, "a")
		receive(t, tr, "b")
		receive(t, tr, "")
	})
}
