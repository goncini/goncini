package redis_test

import (
	"context"
	"log/slog"
	"os"
	"sync"
	"sync/atomic"
	"testing"
	"time"

	"github.com/goncini/goncini/hub"
	"github.com/goncini/goncini/lock"
	"github.com/goncini/goncini/lock/locktest"
	"github.com/goncini/goncini/messenger"
	"github.com/goncini/goncini/messenger/transporttest"
	"github.com/goncini/goncini/ratelimit"
	"github.com/goncini/goncini/redis"
	"github.com/goncini/goncini/uid"
)

// client returns a client of the Redis of REDIS_TEST_URL, and a prefix of
// the test's own, whose keys go when it ends; or skips the test without
// one.
func client(t *testing.T) (*redis.Client, string) {
	url := os.Getenv("REDIS_TEST_URL")
	if url == "" {
		t.Skip("REDIS_TEST_URL names no Redis to test with")
	}
	c, closeClient := must redis.NewClient(redis.Config{URL: url})
	must c.PingContext(context.Background())
	prefix := "test:" + uid.NewV4().String() + ":"
	t.Cleanup(() => {
		ctx := context.Background()
		keys := must c.Keys(ctx, prefix+"*").Result()
		if len(keys) > 0 {
			must c.Del(ctx, keys...).Err()
		}
		closeClient()
	})
	return c, prefix
}

func TestTransport(t *testing.T) {
	transporttest.Run(t, func(t *testing.T, now func() time.Time) messenger.Transport {
		c, prefix := client(t)
		tr := redis.NewTransport(c, prefix, "async")
		tr.Now = now
		return tr
	})
}

func TestLockStore(t *testing.T) {
	locktest.Run(t, func(t *testing.T) lock.Store {
		c, prefix := client(t)
		return redis.NewLockStore(c, redis.Config{Prefix: prefix})
	})
}

// TestRateLimitStore checks that concurrent takes don't exceed the limit,
// that Reset gives it back, and that Redis expires the states.
func TestRateLimitStore(t *testing.T) {
	c, prefix := client(t)
	ctx := context.Background()
	l := &ratelimit.Limiter{Policy: ratelimit.FixedWindow{Limit: 10, Interval: time.Minute}, Store: redis.NewRateLimitStore(c, redis.Config{Prefix: prefix})}
	var allowed atomic.Int32
	var wg sync.WaitGroup
	for range 20 {
		wg.Go(() => {
			res, err := l.Take(ctx, "k", 1)
			if err != nil {
				t.Error(err)
			} else if res.Allowed {
				allowed.Add(1)
			}
		})
	}
	wg.Wait()
	if n := allowed.Load(); n != 10 {
		t.Errorf("%d takes allowed, not 10", n)
	}
	must l.Reset(ctx, "k")
	res := must l.Take(ctx, "k", 1)
	if !res.Allowed || res.Remaining != 9 {
		t.Errorf("after Reset: %+v", res)
	}
	ttl := must c.PTTL(ctx, prefix+"ratelimit:k").Result()
	if ttl <= 0 || ttl > time.Minute {
		t.Errorf("the state expires in %v", ttl)
	}
}

// TestHub checks that an event published on one instance reaches the
// subscribers of the others, and its own once.
func TestHub(t *testing.T) {
	c, prefix := client(t)
	ctx := t.Context()
	newHub := func() *hub.Hub {
		h, stop, _ := hub.New(hub.Config{}, redis.NewHubTransport(c, redis.Config{Prefix: prefix}), slog.New(slog.DiscardHandler))
		t.Cleanup(() => { stop() })
		return h
	}
	one, two := newHub(), newHub()
	for {
		subs := must c.PubSubNumSub(ctx, prefix+"hub").Result()
		if subs[prefix+"hub"] == 2 {
			break
		}
		time.Sleep(10 * time.Millisecond)
	}
	mine := hub.Subscribe[string](ctx, one, "", "notes")
	theirs := hub.Subscribe[string](ctx, two, "", "notes")
	must one.Publish(ctx, "notes", "hello")
	e := <-theirs
	if e.Data != "hello" {
		t.Errorf("the other instance got %+v", e)
	}
	if e = <-mine; e.Data != "hello" {
		t.Errorf("this instance got %+v", e)
	}
	must one.Publish(ctx, "notes", "again")
	if e = <-mine; e.Data != "again" {
		t.Errorf("this instance got %+v, not the next event", e)
	}
}

// TestMemory checks that memory:// keeps the messages, locks, limits and
// hub's events in memory.
func TestMemory(t *testing.T) {
	c, closeClient := must redis.NewClient(redis.Config{URL: "memory://"})
	defer closeClient()
	must c.PingContext(context.Background())
	ts := redis.NewTransports(c, redis.Config{}, messenger.Config{})
	if _, ok := ts["async"].(*messenger.MemoryTransport); !ok || len(ts) != 2 {
		t.Errorf("transports %v", ts)
	}
	if _, ok := redis.NewLockStore(c, redis.Config{}).(*lock.MemoryStore); !ok {
		t.Error("the lock store isn't in memory")
	}
	if _, ok := redis.NewRateLimitStore(c, redis.Config{}).(*ratelimit.MemoryStore); !ok {
		t.Error("the rate limits aren't in memory")
	}
	if _, ok := redis.NewHubTransport(c, redis.Config{}).(hub.LocalTransport); !ok {
		t.Error("the hub's events leave the instance")
	}
}
