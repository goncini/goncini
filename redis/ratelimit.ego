package redis

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"time"

	goredis "github.com/redis/go-redis/v9"

	"github.com/goncini/goncini/ratelimit"
)

// RateLimitStore is a ratelimit.Store in Redis: a key per limited key,
// holding its state as JSON, which Redis expires with the TTL. An update
// watches the key, and tries again when another update changed it first.
type RateLimitStore struct {
	client goredis.UniversalClient
	prefix string
}

// updateAttempts is how many times Update tries, while other updates of
// the key keep changing it first, before it fails.
const updateAttempts = 50

// Update calls f with key's state and writes the result, unless the key
// changed in between: then it calls f again, with the new state.
func (s *RateLimitStore) Update(ctx context.Context, key string, now time.Time, ttl time.Duration, f func(*ratelimit.State)) error {
	key = s.prefix + key
	update := func(tx *goredis.Tx) error {
		var st ratelimit.State
		raw, err := tx.Get(ctx, key).Bytes()
		if err == nil {
			check json.Unmarshal(raw, &st) ""
		} else if !errors.Is(err, goredis.Nil) {
			return err
		}
		f(&st)
		raw = must json.Marshal(st)
		_, err = tx.TxPipelined(ctx, func(p goredis.Pipeliner) error {
			return p.Set(ctx, key, raw, max(ttl, time.Millisecond)).Err()
		})
		return err
	}
	for range updateAttempts {
		err := s.client.Watch(ctx, update, key)
		if !errors.Is(err, goredis.TxFailedErr) {
			return err
		}
	}
	return fmt.Errorf("redis: %s changed %d times while it was updated", key, updateAttempts)
}
