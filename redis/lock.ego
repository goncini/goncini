package redis

import (
	"context"
	"time"

	goredis "github.com/redis/go-redis/v9"
)

// LockStore is a lock.Store in Redis: a key per lock, holding its owner,
// which Redis expires with the hold.
type LockStore struct {
	client goredis.UniversalClient
	prefix string
}

// acquire sets the lock's key to the owner for the TTL, in milliseconds,
// unless another owner holds it: KEYS[1] the key, ARGV the owner and TTL.
var acquire = goredis.NewScript(`
local owner = redis.call('GET', KEYS[1])
if owner and owner ~= ARGV[1] then return 0 end
redis.call('SET', KEYS[1], ARGV[1], 'PX', ARGV[2])
return 1`)

// release deletes the lock's key, if the owner holds it.
var release = goredis.NewScript(`
if redis.call('GET', KEYS[1]) == ARGV[1] then redis.call('DEL', KEYS[1]) end
return 0`)

func (s *LockStore) Acquire(ctx context.Context, key, owner string, ttl time.Duration) (bool, error) {
	ms := max(ttl.Milliseconds(), 1)
	n := check acquire.Run(ctx, s.client, []string{s.prefix + key}, owner, ms).Int() ""
	return n == 1, nil
}

func (s *LockStore) Release(ctx context.Context, key, owner string) error {
	return release.Run(ctx, s.client, []string{s.prefix + key}, owner).Err()
}
