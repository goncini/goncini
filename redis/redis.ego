// Package redis keeps goncini's messages and locks in Redis, which the
// instances of an app share: a bus whose queues are in Redis, and a lock
// store, as the scheduler's.
//
//	var Services = layer.Set(redis.Messenger, redis.Lock, scheduler.New, …)
//
// with a redis.Config section in the app's config, whose URL is a secret:
// redis://user:password@host:6379/0, of Redis 6.2 or later, or Valkey.
// The Redis must keep what it is given:
// with persistence, such as appendonly yes, so that a restart doesn't lose
// the queued messages, and maxmemory-policy noeviction. A cache that may
// evict is on a Redis of its own, rediscache's.
//
// In tests, the URL memory:// keeps the messages and locks in the app's
// memory, as Symfony's in-memory:// transport does: each app that a test
// boots has its own, and needs no Redis.
//
// A message dispatched in a database transaction is sent at once, whether
// the transaction commits or not: messenger.SQL's queues, which are in the
// database, send it with the transaction.
package redis

import (
	"context"
	"errors"

	"github.com/effect-go/effect-go/layer"
	goredis "github.com/redis/go-redis/v9"

	"github.com/goncini/goncini/lock"
	"github.com/goncini/goncini/messenger"
)

// Config says which Redis to use.
type Config struct {
	// URL is the Redis server's, as go-redis's ParseURL takes it, or
	// memory:// for tests.
	URL string
	// Prefix is put before the keys, for apps that share a Redis; empty
	// means goncini:.
	Prefix string
}

func (c Config) prefix() string {
	return if c.Prefix == "" { "goncini:" } else { c.Prefix }
}

// Messenger is the providers of a bus whose transports are queues in
// Redis, one per messenger.Config.Queues and the failure transport's.
var Messenger = layer.Set(NewClient, NewTransports, messenger.NewBus)

// Lock is the providers of a lock store in Redis.
var Lock = layer.Set(NewClient, NewLockStore)

// Client is the client that the transports and the lock store share: a
// type of its own, so that it isn't rediscache's, whose Redis may be
// another.
type Client struct {
	// UniversalClient is nil for memory://.
	goredis.UniversalClient
}

// NewClient returns the client of c.URL, closed with the app, which
// doesn't connect until it is used: its PingContext checks it before
// serving.
func NewClient(c Config) (*Client, func() error, error) {
	switch c.URL {
	case "":
		return nil, nil, errors.New("redis: Config.URL is empty")
	case "memory://":
		return &Client{}, func() error { return nil }, nil
	}
	opts := check goredis.ParseURL(c.URL) ""
	client := goredis.NewClient(opts)
	return &Client{UniversalClient: client}, client.Close, nil
}

// PingContext checks that Redis answers.
func (c *Client) PingContext(ctx context.Context) error {
	if c.UniversalClient == nil {
		return nil
	}
	return c.Ping(ctx).Err()
}

// NewTransports returns the queues of mc in Redis, or in memory.
func NewTransports(client *Client, c Config, mc messenger.Config) messenger.Transports {
	ts := messenger.Transports{}
	for _, name := range mc.TransportNames() {
		if client.UniversalClient == nil {
			ts[name] = &messenger.MemoryTransport{}
		} else {
			ts[name] = NewTransport(client, c.prefix(), name)
		}
	}
	return ts
}

// NewLockStore returns the lock store in Redis, or in memory.
func NewLockStore(client *Client, c Config) lock.Store {
	if client.UniversalClient == nil {
		return &lock.MemoryStore{}
	}
	return &LockStore{client: client, prefix: c.prefix() + "lock:"}
}
