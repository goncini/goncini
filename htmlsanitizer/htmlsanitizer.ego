// Package htmlsanitizer keeps of HTML what can't run code nor take over a
// page, as Symfony's HtmlSanitizer does, for the APIs that take rich text,
// such as a comment's body written in an editor. It is bluemonday's.
//
//	var Services = layer.Set(htmlsanitizer.New, …)
//
//	body := a.sanitizer.Sanitize(in.Body.Comment.Body)
//
// with an htmlsanitizer.Config section in the app's config, if it changes
// anything. Sanitize what an endpoint receives, before it keeps it, so that
// every client shows the same safe HTML; a validate tag such as max=20000
// bounds its length, which Symfony's sanitizer cuts instead. A sanitizer
// with other rules is another New's, of a Config of its own.
package htmlsanitizer

import (
	"net/url"
	"slices"
	"strings"

	"github.com/microcosm-cc/bluemonday"
)

// Config says what a sanitizer keeps.
type Config struct {
	// Strict keeps no element but Allow's, only their text; otherwise, the
	// elements and attributes of user content that can't run code are
	// kept, bluemonday's UGCPolicy's, such as p, a, img, table and code,
	// with a rel="nofollow" on the links.
	Strict bool
	// Allow is more elements to keep, with the attributes that each keeps,
	// even those that run code, such as script, if it says so; the element
	// "*" gives attributes to all of them, such as class. A sanitizer that
	// keeps less than user content's elements is Strict, with Allow's. The
	// elements that aren't kept leave their text, except those whose
	// content isn't text, such as script and style.
	Allow map[string][]string
	// URLSchemes are the schemes that the URLs of links and media may have;
	// empty means http, https and mailto.
	URLSchemes []string
	// URLHosts are the only hosts that the URLs of links and media may
	// name; empty means any. Relative URLs are kept without hosts, and
	// removed with them, as //host/path is relative.
	URLHosts []string
}

// Sanitizer sanitizes HTML, as its config says. Its methods are safe to
// call at once.
type Sanitizer struct {
	policy *bluemonday.Policy
}

// standardSchemes are the schemes that URLs may have when Config doesn't
// say, as bluemonday's AllowStandardURLs has them.
var standardSchemes = []string{"http", "https", "mailto"}

// New returns the sanitizer of c.
func New(c Config) *Sanitizer {
	p := if c.Strict { bluemonday.StrictPolicy() } else { bluemonday.UGCPolicy() }
	for element, attrs := range c.Allow {
		if element != "*" {
			p.AllowElements(element)
		}
		if len(attrs) > 0 {
			allowed := p.AllowAttrs(attrs...)
			if element == "*" {
				allowed.Globally()
			} else {
				allowed.OnElements(element)
			}
		}
	}

	// Every URL is checked, even a strict policy's, whose Allow may have
	// links: a scheme is allowed by a function, which replaces the
	// UGCPolicy's.
	p.RequireParseableURLs(true)
	p.AllowRelativeURLs(len(c.URLHosts) == 0)
	p.RequireNoFollowOnLinks(true)
	var schemes []string
	for _, scheme := range c.URLSchemes {
		schemes = append(schemes, strings.ToLower(scheme))
	}
	if len(schemes) == 0 {
		schemes = standardSchemes
	}
	host := (u *url.URL) => len(c.URLHosts) == 0 || u.Host == "" && u.Opaque != "" || slices.ContainsFunc(c.URLHosts, h => strings.EqualFold(h, u.Hostname()))
	allowed := (u *url.URL) => slices.Contains(schemes, u.Scheme) && host(u)
	for _, scheme := range slices.Compact(slices.Sorted(slices.Values(slices.Concat(standardSchemes, schemes)))) {
		p.AllowURLSchemeWithCustomPolicy(scheme, allowed)
	}
	return &Sanitizer{policy: p}
}

// Sanitize returns what html keeps, as HTML: its text escaped, and its
// elements and attributes those that the config allows.
func (s *Sanitizer) Sanitize(html string) string {
	return s.policy.Sanitize(html)
}
