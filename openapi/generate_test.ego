package openapi_test

import (
	"bytes"
	"encoding/json/jsontext"
	"encoding/json/v2"
	"flag"
	"net/http"
	"os"
	"reflect"
	"testing"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/openapi"
	"github.com/goncini/goncini/routing"
	"github.com/goncini/goncini/validator"
)

var update = flag.Bool("update", false, "rewrite the golden files")

// NoteError is everything the notes endpoints fail with.
error NoteError {
	NoNote{ ID int64 } "no note {ID}"
	Unavailable{ Cause error } "the notes are unavailable"
}

func noteProblem(err NoteError) httpkernel.Problem {
	return match err {
		nil            => httpkernel.Problem{}
		NoNote(e)      => httpkernel.Problem{Status: http.StatusNotFound, Detail: e.Error()}
		Unavailable(_) => httpkernel.Problem{Status: http.StatusServiceUnavailable}
	}
}

// Note is a note.
type Note struct {
	ID    int64    `json:"id"`
	Title string   `json:"title"`
	Tags  []string `json:"tags"`
	// Bio is the author's.
	Bio    *string `json:"bio"`
	Hidden string  `json:"-"`
	Draft  bool    `json:"draft,omitempty"`
	Parent *Note   `json:"parent,omitzero"`
}

type NoteBody struct {
	Note Note `json:"note"`
}

type ShowInput struct {
	ID int64 `path:"id"`
}

type Page struct {
	Limit int `query:"limit" default:"20" validate:"min=1,max=100"`
}

type ListInput struct {
	Page
	Sort string   `query:"sort" enum:"asc,desc"`
	Tags []string `query:"tag"`
	Key  string   `header:"X-Key"`
}

type CreateInput struct {
	Body struct {
		Note struct {
			Title string                      `json:"title" validate:"required,max=120"`
			Tags  []string                    `json:"tags" validate:"max=5,dive,alpha"`
			Bio   httpkernel.Optional[string] `json:"bio"`
		} `json:"note" validate:"required"`
	}
}

type Notes struct{}

effect (n *Notes) Show(in ShowInput) (NoteBody, NoteError) {
	return NoteBody{}, nil
}

effect (n *Notes) List(in ListInput) ([]Note, NoteError) {
	return nil, nil
}

effect (n *Notes) Create(in CreateInput) (httpkernel.Created[NoteBody], NoteError) {
	return httpkernel.Created[NoteBody]{}, nil
}

effect (n *Notes) Delete(in ShowInput) (httpkernel.NoContent, NoteError) {
	return httpkernel.NoContent{}, nil
}

// locked answers 423 to every request, and says so.
func locked(next http.Handler) http.Handler { return lockedHandler{} }

type lockedHandler struct{}

func (lockedHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {}

func (lockedHandler) DescribeOperation(op *openapi.Op) {
	op.Errors = append(op.Errors, httpkernel.Problem{Status: http.StatusLocked, Header: http.Header{"Retry-After": {"60"}}})
}

// notesAPI returns the routes and kernel of an API of notes, and the
// annotations goncini generate would write for it.
func notesAPI() (*routing.Router, *httpkernel.Kernel, openapi.Annotations) {
	n := &Notes{}
	r := routing.New()
	show := httpkernel.Endpoint(n.Show)
	r.Get("/notes/{id<\\d+>}", show).Name("note_show")
	r.Get("/notes", httpkernel.Endpoint(n.List))
	r.With(locked).Post("/notes", httpkernel.Endpoint(n.Create)).Name("note_create")
	r.Delete("/notes/{id}", httpkernel.Endpoint(n.Delete)).Name("note_delete")
	r.Handle("/health", http.NotFoundHandler())
	k := &httpkernel.Kernel{Handler: r, ErrorMappers: []httpkernel.ErrorMapper{httpkernel.Map[NoteError](noteProblem)}, Validator: validator.New()}
	d, _ := httpkernel.Describe(show)
	a := openapi.Annotations{
		Operations: map[string]openapi.OperationDoc{
			d.Func: {Summary: "Returns a note.", Description: "Anyone can read it.", Errors: []error{NoNote{}, Unavailable{}}},
		},
		Types: map[reflect.Type]openapi.TypeDoc{
			reflect.TypeFor[Note]():        {Description: "Note is a note.", Fields: map[string]string{"Bio": "Bio is the author's."}},
			reflect.TypeFor[CreateInput](): {Fields: map[string]string{"Body.Note.Title": "Title is the note's."}},
		},
	}
	return r, k, a
}

// TestGenerate compares the document of the notes API with the golden
// one: run go test -update to rewrite it, and review the diff.
func TestGenerate(t *testing.T) {
	r, k, a := notesAPI()
	doc, err := openapi.Generate(r.List(), k, openapi.Config{Title: "Notes", Version: "1.0.0"}, a)
	if err != nil {
		t.Fatal(err)
	}
	got, err := json.Marshal(doc, json.Deterministic(true), jsontext.Multiline(true), jsontext.WithIndent("  "))
	if err != nil {
		t.Fatal(err)
	}
	golden(t, "testdata/notes.json", got)
}

// golden compares got with the file, or rewrites the file with -update.
func golden(t *testing.T, file string, got []byte) {
	t.Helper()
	got = append(got, '\n')
	if *update {
		if err := os.WriteFile(file, got, 0o644); err != nil {
			t.Fatal(err)
		}
		return
	}
	want, err := os.ReadFile(file)
	if err != nil {
		t.Fatal(err)
	}
	if !bytes.Equal(got, want) {
		t.Errorf("%s differs: run go test -update, and review the diff\n%s", file, got)
	}
}

func TestDuplicateOperationIDs(t *testing.T) {
	n := &Notes{}
	r := routing.New()
	r.Get("/a", httpkernel.Endpoint(n.Show))
	r.Get("/b", httpkernel.Endpoint(n.Show))
	if _, err := openapi.Generate(r.List(), nil, openapi.Config{}, openapi.Annotations{}); err == nil {
		t.Error("no error for two operations named the same")
	}
}
