package main

import (
	"runtime/debug"
	"testing"

	"golang.org/x/mod/modfile"
)

func TestDelegates(t *testing.T) {
	released := "module example.com/acme\n\nrequire github.com/goncini/goncini v0.2.0\n"
	replaced := released + "\nreplace github.com/goncini/goncini => ../goncini\n"
	tool := (version string, replace *debug.Module) => debug.Module{Path: gonciniPath, Version: version, Replace: replace}
	tests := []struct {
		name  string
		gomod string
		tool  debug.Module
		inner bool
		want  bool
	}{
		{"the app's version", released, tool("v0.2.0", nil), false, false},
		{"another version", released, tool("v0.1.0", nil), false, true},
		{"built from a checkout", released, tool("(devel)", nil), false, true},
		{"the app's checkout", replaced, tool("v0.2.0", &debug.Module{Path: "../goncini"}), false, false},
		{"another checkout", replaced, tool("v0.2.0", &debug.Module{Path: "/src/goncini"}), false, true},
		{"a release, for an app with a checkout", replaced, tool("v0.2.0", nil), false, true},
		{"run by another goncini", released, tool("v0.1.0", nil), true, false},
	}
	for _, tt := range tests {
		app := must modfile.Parse("go.mod", []byte(tt.gomod), nil)
		if got := delegates(app, tt.tool, tt.inner); got != tt.want {
			t.Errorf("%s: delegates = %v", tt.name, got)
		}
	}
}
