// Command goncini is goncini's tool. goncini new writes a new app:
//
//	go run github.com/goncini/goncini/cmd/goncini@latest new example.com/acme
//
// In an app, it runs the app's commands, after generating the app if a .ego
// file changed, and building it if its code did: from a binary, which it
// links again only when the code changed, unlike go run.
//
//	go tool goncini list            # the app's commands
//	go tool goncini debug:router    # its routes
//	go tool goncini db:migrate      # applies its migrations
//
// goncini serve serves the app while it is developed: it generates, builds
// and restarts the app when its files change, and answers what went wrong,
// such as what doesn't compile, while it doesn't build or run. goncini check
// checks that the generated files are up to date, and that no known
// vulnerability is in the code the app calls, with govulncheck:
//
//	go tool goncini serve            # on the address of the app's config
//	go tool goncini check
//
// The makers write .ego files in its layout, add their services to
// app/services.ego, and wire them with goncini generate; if what they wrote
// doesn't compile, they put the app back as it was:
//
//	go tool goncini make:feature notes          # a feature: store, endpoints, test, migration
//	go tool goncini make:feature people Person  # when the type isn't the singular without its s
//	go tool goncini make:endpoint -method POST -path '/notes/{id}/archive' notes Archive
//	go tool goncini make:message notes NoteAdded
//	go tool goncini make:command -summary "Prunes the old notes" notes:prune
//	go tool goncini make:migration add_note_tags
//
// The secrets: commands keep an environment's secrets in its vault, in
// config/secrets/<env>, encrypted, as Symfony's secrets: commands do:
//
//	go tool goncini secrets:generate-keys -env prod
//	printf %s "$URL" | go tool goncini secrets:set -env prod DATABASE_URL
//	go tool goncini secrets:list -env prod -reveal
//
// goncini tidy is go mod tidy for an app's .ego files, which go mod tidy
// doesn't read: run it after importing a new module in a .ego file.
//
//	go tool goncini tidy
//
// goncini generate writes an app's
// Autoconfigured providers, which hand goncini the app's services of each
// kind it uses, found by their types, as Symfony's autoconfiguration does:
//
//	go tool goncini generate          # from the app's module root
//	go tool goncini generate -check   # fails if the file isn't up to date
//
// An app requires it with a tool directive:
//
//	tool github.com/goncini/goncini/cmd/goncini
//
// Installed with go install, as goncini, it runs the app's own, of the
// version that the app requires, as the symfony command runs the app's
// console:
//
//	go install github.com/goncini/goncini/cmd/goncini@latest
//	goncini debug:router
package main

import (
	"cmp"
	"context"
	"flag"
	"fmt"
	"os"
	"os/signal"
	"path"
	"runtime/debug"
	"syscall"
	"text/tabwriter"
)

const usage = `usage: goncini new [-replace dir] module [dir]
       goncini serve [-addr address]
       goncini check
       goncini generate [-check]
       goncini tidy
       goncini make:feature name [Type]
       goncini make:endpoint [-method GET] [-path /feature/name] feature Name
       goncini make:message feature Name
       goncini make:command -summary text feature:name
       goncini make:migration name
       goncini secrets:generate-keys [-env dev] [-rotate]
       goncini secrets:set [-env dev] [-random] NAME
       goncini secrets:list [-env dev] [-reveal]
       goncini secrets:remove [-env dev] NAME
       goncini command [args]       the app's command, such as list`

// commands are the tool's commands for an app, which goncini list shows
// after the app's own.
var commands = [][2]string{
	{"serve", "Serves the app, instead of its serve, and reloads it when its files change"},
	{"check", "Checks the generated files, and runs govulncheck"},
	{"generate", "Generates the Go of the .ego files, and the wiring"},
	{"tidy", "Runs go mod tidy, for the .ego files too"},
	{"make:feature", "Makes a feature: store, endpoints, error set, test, migration"},
	{"make:endpoint", "Makes an endpoint in a feature"},
	{"make:message", "Makes a message, and its handler"},
	{"make:command", "Makes a command"},
	{"make:migration", "Makes a migration"},
	{"secrets:generate-keys", "Makes an environment's vault of secrets, or replaces its keys"},
	{"secrets:set", "Seals a secret in a vault, from the standard input"},
	{"secrets:list", "Lists the secrets of a vault, and their values with -reveal"},
	{"secrets:remove", "Removes a secret from a vault"},
}

func main() {
	root, mod, inApp := findApp(".")
	var tool debug.Module
	if info, ok := debug.ReadBuildInfo(); ok {
		tool = info.Main
	}
	if inApp && delegates(mod, tool, os.Getenv("GONCINI_TOOL") != "") {
		os.Exit(delegate(os.Args[1:]))
	}
	if !inApp {
		root = "."
	}
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, usage)
		os.Exit(2)
	}
	cmd := os.Args[1]
	fs := flag.NewFlagSet(cmd, flag.ExitOnError)
	fs.Usage = () => fmt.Fprintln(os.Stderr, usage)
	args := (min, max int) => {
		fs.Parse(os.Args[2:])
		if fs.NArg() < min || fs.NArg() > max {
			fs.Usage()
			os.Exit(2)
		}
	}
	var err error
	var files []string // that a maker wrote
	switch cmd {
	case "new":
		replace := fs.String("replace", "", "a goncini checkout for the app to require, instead of a released version")
		args(1, 2)
		module := fs.Arg(0)
		dir := cmp.Or(fs.Arg(1), path.Base(module))
		if err = newApp(module, dir, *replace); err == nil {
			fmt.Printf("%s is ready: cd %s, then go test ./..., and go tool goncini serve.\n", module, dir)
		}
	case "generate":
		checkOnly := fs.Bool("check", false, "fail if the generated file isn't up to date, instead of writing it")
		args(0, 0)
		err = generate(root, *checkOnly)
	case "tidy":
		args(0, 0)
		err = tidy(root)
	case "serve":
		addr := fs.String("addr", "", "the TCP address to serve on, instead of the config's")
		args(0, 0)
		ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
		err = devServe(ctx, os.Stderr, root, *addr)
		stop()
	case "check":
		args(0, 0)
		err = checkApp(os.Stdout, root)
	case "make:feature":
		args(1, 2)
		files, err = makeFeature(root, fs.Arg(0), fs.Arg(1))
	case "make:endpoint":
		method := fs.String("method", "GET", "the endpoint's HTTP method")
		at := fs.String("path", "", "the endpoint's path; /feature/name by default")
		args(2, 2)
		files, err = makeEndpoint(root, fs.Arg(0), fs.Arg(1), *method, *at)
	case "make:message":
		args(2, 2)
		files, err = makeMessage(root, fs.Arg(0), fs.Arg(1))
	case "make:command":
		summary := fs.String("summary", "", "what the command does, in a line, for the list")
		args(1, 1)
		files, err = makeCommand(root, fs.Arg(0), *summary)
	case "make:migration":
		args(1, 1)
		files, err = makeMigration(root, fs.Arg(0))
	case "secrets:generate-keys", "secrets:set", "secrets:list", "secrets:remove":
		env := fs.String("env", "dev", "the environment whose vault it is")
		rotate := fs.Bool("rotate", false, "secrets:generate-keys: replace the keys, sealing the secrets again")
		random := fs.Bool("random", false, "secrets:set: a random value, instead of the standard input's")
		reveal := fs.Bool("reveal", false, "secrets:list: the values too")
		n := if cmd == "secrets:set" || cmd == "secrets:remove" { 1 } else { 0 }
		args(n, n)
		match cmd {
			"secrets:generate-keys" => err = generateKeys(os.Stdout, root, *env, *rotate)
			"secrets:set"           => err = setSecret(os.Stderr, os.Stdin, root, *env, fs.Arg(0), *random)
			"secrets:list"          => err = listSecrets(os.Stdout, root, *env, *reveal)
			_                       => err = removeSecret(os.Stdout, root, *env, fs.Arg(0))
		}
	default:
		if !inApp {
			fs.Usage()
			os.Exit(2)
		}
		status := runCommand(root, os.Args[1:])
		if cmd == "list" && status == 0 {
			fmt.Println("\ngoncini's commands, for developing the app:")
			tw := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
			for _, c := range commands {
				fmt.Fprintf(tw, "%s\t%s\n", c[0], c[1])
			}
			tw.Flush()
		}
		os.Exit(status)
	}
	for _, f := range files {
		fmt.Println("wrote", f)
	}
	if err != nil {
		fmt.Fprintf(os.Stderr, "goncini %s: %v\n", cmd, err)
		os.Exit(1)
	}
}
