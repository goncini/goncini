package main

import (
	"os"
	"path/filepath"
	"testing"
)

func TestNames(t *testing.T) {
	for _, c := range []struct{ in, camel, snake, singular string }{
		{"notes", "Notes", "notes", "note"},
		{"categories", "Categories", "categories", "category"},
		{"address", "Address", "address", "address"},
		{"prune-old", "PruneOld", "prune_old", "prune-old"},
		{"id", "ID", "id", "id"},
		{"NoteAdded", "NoteAdded", "note_added", "NoteAdded"},
	} {
		if got := camel(c.in); got != c.camel {
			t.Errorf("camel(%q) = %q, want %q", c.in, got, c.camel)
		}
		if got := snake(c.in); got != c.snake {
			t.Errorf("snake(%q) = %q, want %q", c.in, got, c.snake)
		}
		if got := singular(c.in); got != c.singular {
			t.Errorf("singular(%q) = %q, want %q", c.in, got, c.singular)
		}
	}
}

func TestAddImport(t *testing.T) {
	src := "import (\n\t\"time\"\n\n\t\"github.com/goncini/goncini/db\"\n\n\t\"example.com/acme/home\"\n)\n"
	got := addImport(src, "github.com/goncini/goncini/messenger")
	got = addImport(got, "example.com/acme/notes")
	got = addImport(got, "example.com/acme/notes") // once
	want := "import (\n\t\"time\"\n\n\t\"github.com/goncini/goncini/db\"\n\t\"github.com/goncini/goncini/messenger\"\n\n\t\"example.com/acme/home\"\n\t\"example.com/acme/notes\"\n)\n"
	if got != want {
		t.Errorf("got\n%s\nwant\n%s", got, want)
	}
}

func TestWriteMigration(t *testing.T) {
	root := t.TempDir()
	must os.Mkdir(filepath.Join(root, "migrations"), 0o755)
	must os.WriteFile(filepath.Join(root, "migrations", "00009_old.sql"), nil, 0o644)
	file := must writeMigration(root, "add_tags", []byte("-- +goose Up\n"))
	if filepath.Base(file) != "00010_add_tags.sql" {
		t.Errorf("file %s", file)
	}
	if _, err := writeMigration(root, "Add tags", nil); err == nil {
		t.Error("a name with a space and a capital is written")
	}
}
