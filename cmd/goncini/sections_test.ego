package main

import (
	"go/token"
	"go/types"
	"testing"
)

// TestIsSection checks which config sections goncini generate gives a
// default: goncini's and bundles' Config structs, and no other type.
func TestIsSection(t *testing.T) {
	layerPkg := types.NewPackage(layerPath, "layer")
	providerSet := types.NewNamed(types.NewTypeName(token.NoPos, layerPkg, "ProviderSet", nil), types.NewStruct(nil, nil), nil)
	named := (pkg *types.Package, name string, underlying types.Type) => types.NewNamed(types.NewTypeName(token.NoPos, pkg, name, nil), underlying, nil)
	empty := types.NewStruct(nil, nil)

	goncini := types.NewPackage(gonciniPath+"/messenger", "messenger")
	bundle := types.NewPackage("example.com/maintenance", "maintenance")
	bundle.Scope().Insert(types.NewVar(token.NoPos, bundle, "Layer", providerSet))
	other := types.NewPackage("example.com/acme/editors", "editors") // no Layer
	tparam := types.NewTypeParam(types.NewTypeName(token.NoPos, bundle, "T", nil), types.NewInterfaceType(nil, nil))
	generic := named(bundle, "Config", empty)
	generic.SetTypeParams([]*types.TypeParam{tparam})
	instance := must types.Instantiate(nil, generic, []types.Type{types.Typ[types.Int]}, true)

	for _, c := range []struct {
		name string
		t    types.Type
		want bool
	}{
		{"goncini's", named(goncini, "Config", empty), true},
		{"a bundle's", named(bundle, "Config", empty), true},
		{"the app's own", named(other, "Config", empty), false},
		{"not named Config", named(bundle, "Settings", empty), false},
		{"not a struct", named(bundle, "Config", types.Typ[types.String]), false},
		{"a pointer", types.NewPointer(named(bundle, "Config", empty)), false},
		{"generic", instance, false},
	} {
		if got := isSection(c.t); got != c.want {
			t.Errorf("%s: %v, want %v", c.name, got, c.want)
		}
	}
}
