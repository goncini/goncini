package <%.Package%>

import (
	"context"
	"fmt"
	"io"
)

// <%.Type%> is the <%.Command%> command.
type <%.Type%> struct{}

func New<%.Type%>() *<%.Type%> { return &<%.Type%>{} }

func (*<%.Type%>) Name() string    { return <%printf "%q" .Command%> }
func (*<%.Type%>) Summary() string { return <%printf "%q" .Summary%> }

func (c *<%.Type%>) Run(ctx context.Context, out io.Writer, args []string) error {
	_, err := fmt.Fprintln(out, <%printf "%q" .Command%>, "done")
	return err
}
