package main

import (
	"os"
	"strings"
	"testing"
)

// TestSecrets checks the secrets: commands on an app's vault, a value
// piped to secrets:set.
func TestSecrets(t *testing.T) {
	root := t.TempDir()
	var out strings.Builder
	must generateKeys(&out, root, "prod", false)
	r, w := must os.Pipe()
	w.WriteString("postgres://db/app\n")
	w.Close()
	must setSecret(&out, r, root, "prod", "DATABASE_URL", false)
	must setSecret(&out, nil, root, "prod", "APP_SECRET", true)
	out.Reset()
	must listSecrets(&out, root, "prod", true)
	lines := strings.Split(strings.TrimSpace(out.String()), "\n")
	if len(lines) != 2 || !strings.HasPrefix(lines[0], "APP_SECRET=") || len(lines[0]) < len("APP_SECRET=")+20 || lines[1] != "DATABASE_URL=postgres://db/app" {
		t.Errorf("listed %q", lines)
	}
	must removeSecret(&out, root, "prod", "APP_SECRET")
	must generateKeys(&out, root, "prod", true)
	out.Reset()
	must listSecrets(&out, root, "prod", false)
	if out.String() != "DATABASE_URL\n" {
		t.Errorf("after the rotation, listed %q", out.String())
	}
	if err := listSecrets(&out, root, "staging", false); err == nil || !strings.Contains(err.Error(), "secrets:generate-keys -env staging") {
		t.Errorf("a vault that isn't: %v", err)
	}
}
