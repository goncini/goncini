package main

import (
	"bytes"
	"cmp"
	"context"
	"encoding/json/v2"
	"errors"
	"fmt"
	"io"
	"io/fs"
	"net"
	"net/http"
	"net/http/httputil"
	"net/url"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"sync"
	"time"
)

// devServer serves an app while it is developed: it generates, builds and
// restarts the app when its files change, and stands in for it, with what
// went wrong, while it doesn't build or run. Requests made while the app
// restarts wait for it.
type devServer struct {
	root, appDir string
	internal     string // the address the app serves on, behind the proxy
	proxy        *httputil.ReverseProxy
	logs         *tail // the app's last output
	out          io.Writer

	mu      sync.Mutex
	ready   chan struct{} // closed once the app runs, or failed to
	failure string        // what went wrong, when the app doesn't run
	app     *exec.Cmd
	exited  chan struct{} // closed when app exits
	bin     string
}

// devServe serves the app at root on addr, or on the address of its config,
// until ctx is done, and writes what it does to out.
func devServe(ctx context.Context, out io.Writer, root, appDir, addr string) error {
	internal := check freeAddr() ""
	s := &devServer{root: root, appDir: appDir, internal: internal, logs: &tail{}, out: out, ready: make(chan struct{})}
	s.proxy = &httputil.ReverseProxy{
		Rewrite: func(r *httputil.ProxyRequest) {
			r.SetURL(&url.URL{Scheme: "http", Host: internal})
			r.Out.Host = r.In.Host // the app's trusted hosts and URLs see the client's
		},
		ErrorHandler: func(w http.ResponseWriter, r *http.Request, err error) {
			s.mu.Lock()
			failure := s.failure
			s.mu.Unlock()
			s.writeFailure(w, r, http.StatusBadGateway, cmp.Or(failure, f"the app didn't answer: {err}"))
		},
	}
	s.build()
	if addr == "" {
		addr = s.configAddr()
	}
	var lc net.ListenConfig
	ln := check lc.Listen(ctx, "tcp", addr) ""
	fmt.Fprintf(s.out, "goncini serve: serving the app on http://localhost:%d, and reloading it when its files change\n", ln.Addr().(*net.TCPAddr).Port)
	changes := make(chan string, 1)
	go watch(ctx, root, changes)
	reloaded := make(chan struct{})
	go func() {
		s.reload(ctx, changes)
		close(reloaded)
	}()
	srv := &http.Server{Handler: s, ReadHeaderTimeout: 10 * time.Second}
	go func() {
		<-ctx.Done()
		shutdown, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		srv.Shutdown(shutdown)
	}()
	err := srv.Serve(ln)
	<-reloaded // or it could start the app after it is stopped
	s.stopApp()
	if errors.Is(err, http.ErrServerClosed) {
		return nil
	}
	return err
}

// ServeHTTP proxies r to the app, once it runs, or answers what went wrong.
func (s *devServer) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	s.mu.Lock()
	ready := s.ready
	s.mu.Unlock()
	select {
	case <-ready:
	case <-r.Context().Done():
		return
	}
	s.mu.Lock()
	failure := s.failure
	s.mu.Unlock()
	if failure != "" {
		s.writeFailure(w, r, http.StatusInternalServerError, failure)
		return
	}
	s.proxy.ServeHTTP(w, r)
}

// writeFailure answers that the app doesn't run, and why: as text to a
// browser, and as a problem to the API's clients.
func (s *devServer) writeFailure(w http.ResponseWriter, r *http.Request, status int, detail string) {
	if strings.Contains(r.Header.Get("Accept"), "text/html") {
		w.Header().Set("Content-Type", "text/plain; charset=utf-8")
		w.WriteHeader(status)
		io.WriteString(w, "goncini serve: the app doesn't run\n\n"+detail+"\n")
		return
	}
	w.Header().Set("Content-Type", "application/problem+json")
	w.WriteHeader(status)
	json.MarshalWrite(w, map[string]any{"title": "The app doesn't run", "status": status, "detail": detail})
}

// reload starts the app built, then rebuilds and restarts it each time its
// files change, until ctx is done.
func (s *devServer) reload(ctx context.Context, changes <-chan string) {
	s.start(ctx)
	for {
		select {
		case <-ctx.Done():
			return
		case file := <-changes:
			fmt.Fprintf(s.out, "goncini serve: %s changed, reloading the app\n", file)
			s.mu.Lock()
			s.ready = make(chan struct{})
			s.mu.Unlock()
			s.stopApp() // first: what it failed with until now is no longer
			s.build()
			s.start(ctx)
		}
	}
}

// build generates the app if a .ego file changed, and builds it: its
// failure, if it fails, is what the server answers.
func (s *devServer) build() {
	bin, err := buildApp(s.root, s.appDir)
	s.mu.Lock()
	defer s.mu.Unlock()
	s.bin, s.failure = bin, ""
	if err != nil {
		s.failure = err.Error()
		fmt.Fprintf(s.out, "goncini serve: the app doesn't build:\n%s\n", err)
	}
}

// start starts the app built, if it was, and waits until it answers or
// exits, or ctx is done.
func (s *devServer) start(ctx context.Context) {
	s.mu.Lock()
	failed, bin := s.failure != "", s.bin
	s.mu.Unlock()
	if failed {
		s.done("")
		return
	}
	s.logs.Reset()
	app := exec.Command(bin, "serve", "-addr", s.internal)
	app.Dir = s.root
	app.Stdout = io.MultiWriter(s.out, s.logs)
	app.Stderr = app.Stdout
	if err := app.Start(); err != nil {
		s.done(err.Error())
		return
	}
	exited := make(chan struct{})
	s.mu.Lock()
	s.app, s.exited = app, exited
	s.mu.Unlock()
	go func() {
		err := app.Wait()
		s.mu.Lock()
		if s.app == app { // it wasn't stopped: it failed
			reason := if err != nil { f"the app exited: {err}" } else { "the app stopped" }
			s.failure = f"{reason}\n\n{s.logs}"
			s.app = nil
		}
		s.mu.Unlock()
		close(exited)
	}()
	for deadline := time.Now().Add(time.Minute); time.Now().Before(deadline); {
		select {
		case <-exited:
			s.done("") // with the failure that the waiter recorded
			return
		case <-ctx.Done():
			return
		case <-time.After(50 * time.Millisecond):
		}
		if conn, err := net.Dial("tcp", s.internal); err == nil {
			conn.Close()
			s.done("")
			return
		}
	}
	s.done("the app didn't listen within a minute")
}

// done ends a reload: the app runs, or failed with failure, if any.
func (s *devServer) done(failure string) {
	s.mu.Lock()
	defer s.mu.Unlock()
	if failure != "" {
		s.failure = failure
	}
	select {
	case <-s.ready:
	default:
		close(s.ready)
	}
}

// stopApp interrupts the app, if it runs, for it to shut down gracefully,
// and kills it if it hasn't within ten seconds.
func (s *devServer) stopApp() {
	s.mu.Lock()
	app, exited := s.app, s.exited
	s.app = nil
	s.mu.Unlock()
	if app == nil {
		return
	}
	if app.Process.Signal(os.Interrupt) != nil { // Windows can't
		app.Process.Kill()
	}
	select {
	case <-exited:
	case <-time.After(10 * time.Second):
		app.Process.Kill()
		<-exited
	}
}

// configAddr is the address that the app's config serves it on, or the
// default one when the app doesn't build.
func (s *devServer) configAddr() string {
	s.mu.Lock()
	bin, failed := s.bin, s.failure != ""
	s.mu.Unlock()
	if !failed {
		cmd := exec.Command(bin, "serve", "-print-addr")
		cmd.Dir = s.root
		if out, err := cmd.Output(); err == nil {
			lines := strings.Fields(string(out))
			if len(lines) > 0 {
				return lines[len(lines)-1]
			}
		}
	}
	return ":8080"
}

// freeAddr returns a local address that is free.
func freeAddr() (string, error) {
	ln := check net.Listen("tcp", "127.0.0.1:0") ""
	defer ln.Close()
	return ln.Addr().String(), nil
}

// watch sends on changes the name of a file of the app at root that
// changed, after the changes stop: those that the app is built from, and
// not the files that generating writes.
func watch(ctx context.Context, root string, changes chan<- string) {
	last := watchedFiles(root)
	for {
		select {
		case <-ctx.Done():
			return
		case <-time.After(300 * time.Millisecond):
		}
		now := watchedFiles(root)
		changed := diff(last, now)
		if changed == "" {
			continue
		}
		// An editor, or a git checkout, writes several files: wait until
		// they are written.
		for {
			time.Sleep(100 * time.Millisecond)
			next := watchedFiles(root)
			if diff(now, next) == "" {
				break
			}
			now = next
		}
		last = now
		select {
		case changes <- changed:
		default: // a reload is already due
		}
	}
}

// watched reports whether the app is built from the file: its code, its
// migrations, its module, its environment, and the files it embeds, such
// as templates. Tests aren't, nor what generating writes.
func watched(rel string) bool {
	name := filepath.Base(rel)
	switch {
	case strings.HasSuffix(name, "_test.ego"), strings.HasSuffix(name, "_test.go"),
		strings.HasSuffix(name, "_ego.go"), name == FileName:
		return false
	case name == "go.mod", name == "go.sum", name == ".env", strings.HasPrefix(name, ".env."):
		return true
	case strings.HasPrefix(rel, "var"+string(filepath.Separator)): // the profiler's and the dev database's
		return false
	}
	switch filepath.Ext(name) {
	case ".ego", ".go", ".sql", ".html", ".tmpl", ".txt", ".json", ".yaml", ".yml", ".toml":
		return true
	}
	return false
}

// watchedFiles is the modification times and sizes of the watched files.
func watchedFiles(root string) map[string]string {
	files := map[string]string{}
	walkModule(root, func(path string, d fs.DirEntry) error {
		rel, err := filepath.Rel(root, path)
		if err != nil || !watched(rel) {
			return nil
		}
		if info, err := d.Info(); err == nil {
			files[rel] = f"{info.ModTime().UnixNano()} {info.Size()}"
		}
		return nil
	})
	return files
}

// diff returns a file that was added, changed or removed between two
// snapshots, or "" when they are the same.
func diff(a, b map[string]string) string {
	for name, v := range b {
		if a[name] != v {
			return name
		}
	}
	for name := range a {
		if _, ok := b[name]; !ok {
			return name
		}
	}
	return ""
}

// tail keeps the last 16 KiB written to it.
type tail struct {
	mu  sync.Mutex
	buf bytes.Buffer
}

func (t *tail) Write(p []byte) (int, error) {
	t.mu.Lock()
	defer t.mu.Unlock()
	t.buf.Write(p)
	if over := t.buf.Len() - 16<<10; over > 0 {
		t.buf.Next(over)
	}
	return len(p), nil
}

func (t *tail) Reset() {
	t.mu.Lock()
	defer t.mu.Unlock()
	t.buf.Reset()
}

func (t *tail) String() string {
	t.mu.Lock()
	defer t.mu.Unlock()
	return t.buf.String()
}
