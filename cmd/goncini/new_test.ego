package main

import (
	"bytes"
	"context"
	"crypto/sha256"
	"fmt"
	"io"
	"io/fs"
	"net/http"
	"os"
	"os/exec"
	"path/filepath"
	"regexp"
	"slices"
	"strings"
	"testing"
	"time"
)

// TestNew is M5's second and third gates: goncini new writes an app whose
// tests pass, and which goncini serve serves, with nothing to edit first,
// and reloads as it changes; then the makers write a feature, an endpoint,
// a message, a command and a migration, which generate wires, whose tests
// pass, and which the OpenAPI document lists; goncini tidy requires a
// module that a .ego file imports; and a removed .ego file makes the app
// stale.
func TestNew(t *testing.T) {
	if testing.Short() {
		t.Skip("builds a new app")
	}
	dir := filepath.Join(t.TempDir(), "acme")
	must newApp("example.com/acme", dir, "../..")
	for _, dotfile := range []string{".env", ".env.test", ".gitignore", ".gitattributes", ".dockerignore", ".vscode/settings.json"} {
		if _, err := os.Stat(filepath.Join(dir, dotfile)); err != nil {
			t.Errorf("the new app's %s: %v", dotfile, err)
		}
	}
	goTest(t, dir)
	devServes(t, dir)

	must makeFeature(dir, "notes", "")
	must makeEndpoint(dir, "notes", "Archive", "POST", "/notes/{id}/archive")
	must makeMessage(dir, "notes", "NoteAdded")
	must makeCommand(dir, "notes:prune", `Prunes the "old" notes`)
	must makeMigration(dir, "add_note_tags")
	// A maker whose code doesn't compile puts the app back as it was: a
	// path parameter named body clashes with the input's body.
	before := snapshot(t, dir)
	if _, err := makeEndpoint(dir, "notes", "Clash", "POST", "/notes/{body}/clash"); err == nil {
		t.Error("an endpoint that doesn't compile is made")
	}
	if after := snapshot(t, dir); after != before {
		t.Errorf("the app isn't put back:\n%s\nwas\n%s", after, before)
	}
	// A .ego file that imports a module go.mod lacks: generate says to run
	// goncini tidy, and leaves the wiring as it was; tidy requires it.
	must os.WriteFile(filepath.Join(dir, "notes", "price.ego"), []byte("package notes\n\nimport \"github.com/shopspring/decimal\"\n\nvar free = decimal.Zero\n"), 0o644)
	wiring := must os.ReadFile(filepath.Join(dir, "app", FileName))
	if err := generate(dir, false); err == nil || !strings.Contains(err.Error(), "goncini tidy") {
		t.Errorf("generate with a module missing: %v", err)
	}
	after := must os.ReadFile(filepath.Join(dir, "app", FileName))
	if string(after) != string(wiring) || !stale(dir) {
		t.Error("a failed generate changed the wiring, or left the app as if generated")
	}
	must tidy(dir)
	gomod := must os.ReadFile(filepath.Join(dir, "go.mod"))
	if !regexp.MustCompile(`(?m)^\s+github.com/shopspring/decimal v\S+$`).Match(gomod) {
		t.Errorf("tidy didn't require github.com/shopspring/decimal directly:\n%s", gomod)
	}
	if _, err := os.Stat(filepath.Join(dir, tidyDir)); err == nil {
		t.Error("tidy left its stand-in")
	}
	// A .ego file removed: the app is stale, and its Go goes when it is
	// generated again, as its commands do.
	must os.Remove(filepath.Join(dir, "notes", "price.ego"))
	if !stale(dir) {
		t.Error("the app isn't stale when a .ego file is removed")
	}
	bin := build(t, dir)
	if _, err := os.Stat(filepath.Join(dir, "notes", "price_ego.go")); err == nil {
		t.Error("the Go of a removed .ego file is left")
	}
	goTest(t, dir)
	for cmd, want := range map[string]string{"openapi:dump": `"/notes/{id}/archive"`, "list": `Prunes the "old" notes`, "debug:container": "NoteAddedHandler"} {
		run := exec.Command(bin, cmd)
		run.Dir = dir
		out, err := run.CombinedOutput()
		if err != nil || !strings.Contains(string(out), want) {
			t.Errorf("%s: %v, without %s:\n%s", cmd, err, want, out)
		}
	}
}

// snapshot lists the app's files, with their sizes and hashes.
func snapshot(t *testing.T, dir string) string {
	var b strings.Builder
	must filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
		check err ""
		if d.IsDir() {
			return nil
		}
		content := check os.ReadFile(path) ""
		rel := check filepath.Rel(dir, path) ""
		fmt.Fprintf(&b, "%s %x\n", rel, sha256.Sum256(content))
		return nil
	})
	return b.String()
}

// build builds the app, as its commands run through goncini, and returns
// its binary.
func build(t *testing.T, dir string) string {
	t.Helper()
	bin, err := buildApp(dir)
	if err != nil {
		t.Fatalf("build: %v", err)
	}
	t.Cleanup(func() { os.RemoveAll(filepath.Dir(bin)) })
	return bin
}

// devServes serves the app with goncini serve, breaks its code, and fixes
// it: the server answers what doesn't compile, then the app as it changed.
func devServes(t *testing.T, dir string) {
	addr := must freeAddr()
	ctx, cancel := context.WithCancel(context.Background())
	done := make(chan error, 1)
	go func() { done <- devServe(ctx, t.Output(), dir, addr) }()
	defer func() {
		cancel()
		if err := <-done; err != nil {
			t.Errorf("goncini serve: %v", err)
		}
	}()
	answers := (status int, want string) => {
		t.Helper()
		var last string
		for deadline := time.Now().Add(time.Minute); time.Now().Before(deadline); time.Sleep(100 * time.Millisecond) {
			res, err := http.Get("http://" + addr + "/")
			if err != nil {
				last = err.Error()
				continue
			}
			body := must io.ReadAll(res.Body)
			res.Body.Close()
			last = fmt.Sprintf("%d %s", res.StatusCode, body)
			if res.StatusCode == status && strings.Contains(string(body), want) {
				return
			}
		}
		t.Fatalf("GET / doesn't answer %d with %s: %s", status, want, last)
	}
	answers(200, `"status":"ok"`)
	home := filepath.Join(dir, "home", "home.ego")
	src := must os.ReadFile(home)
	must os.WriteFile(home, append(slices.Clip(src), "\nfunc broken() int { return \"x\" }\n"...), 0o644)
	answers(500, "cannot use")
	must os.WriteFile(home, bytes.ReplaceAll(src, []byte(`Status: "ok"`), []byte(`Status: "fine"`)), 0o644)
	answers(200, `"status":"fine"`)
	must os.WriteFile(home, src, 0o644)
	answers(200, `"status":"ok"`)
}

// goTest runs the app's tests.
func goTest(t *testing.T, dir string) {
	t.Helper()
	test := exec.Command("go", "test", "./...")
	test.Dir = dir
	if out, err := test.CombinedOutput(); err != nil {
		t.Fatalf("go test: %v\n%s", err, out)
	}
}

// TestAgents checks that new apps get goncini's AGENTS.md as it is.
func TestAgents(t *testing.T) {
	want := must os.ReadFile("../../AGENTS.md")
	got := must skeleton.ReadFile("skeleton/AGENTS.md")
	if string(got) != string(want) {
		t.Error("skeleton/AGENTS.md isn't AGENTS.md: cp AGENTS.md cmd/goncini/skeleton/")
	}
}
