// Package config is the API's config: the values of every environment,
// then what each environment changes.
package config

import (
	"github.com/goncini/goncini"
	"github.com/goncini/goncini/db"
	"github.com/goncini/goncini/profiler"
)

// Config is the API's config, one section per part of the app.
type Config struct {
	HTTP     goncini.HTTP
	Log      goncini.Log
	DB       db.Config
	Profiler profiler.Config
}

// Load returns the config of env: what every environment shares, then what
// env changes.
func Load(env *goncini.Env) Config {
	c := Config{
		DB: db.Config{Driver: "sqlite", URL: env.Secret("DATABASE_URL")},
	}
	switch env.Name {
	case "dev":
		dev(&c)
	case "test":
		test(&c)
	case "prod":
		prod(&c)
	default:
		env.Unknown()
	}
	return c
}
