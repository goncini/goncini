package main

import (
	"cmp"
	"fmt"
	"path"
	"regexp"
	"slices"
	"strconv"
	"strings"
	"unicode"
)

// servicesFile is the file of the app's Services, from the module's root.
const servicesFile = "app/services.ego"

const servicesSet = "var Services = layer.Set("

// addServices adds providers, such as notes.NewStore, to the app's
// Services, on a line of their own, and imports their package.
func addServices(c *change, importPath string, providers ...string) error {
	src := check c.read(servicesFile) ""
	start := strings.Index(src, servicesSet)
	end := closingParen(src, start+len(servicesSet))
	if start < 0 || end < 0 {
		return fmt.Errorf("%s has no %s…): add %s to the app's services", servicesFile, servicesSet, strings.Join(providers, ", "))
	}
	start += len(servicesSet)
	list := strings.TrimSuffix(strings.TrimRight(src[start:end], " \t\n"), ",")
	added := ",\n\t" + strings.Join(providers, ", ")
	if strings.HasSuffix(strings.TrimRight(src[start:end], " \t"), "\n") {
		added += ",\n"
	}
	src = src[:start] + list + added + src[end:]
	c.edit(servicesFile, addImport(src, importPath))
	return nil
}

// closingParen returns the index of the parenthesis that closes the one
// before from, or -1.
func closingParen(src string, from int) int {
	if from < 0 || from > len(src) {
		return -1
	}
	depth := 1
	for i := from; i < len(src); i++ {
		switch src[i] {
		case '(':
			depth++
		case ')':
			depth--
			if depth == 0 {
				return i
			}
		}
	}
	return -1
}

var importLine = regexp.MustCompile(`(?m)^\s*(?:(\w+)\s+)?"([^"]+)"`)

// importNames returns the names that src's import block declares: their
// packages' last elements, or their aliases.
func importNames(src string) []string {
	start := strings.Index(src, "import (\n")
	if start < 0 {
		return nil
	}
	block := src[start:]
	block = block[:strings.Index(block, "\n)")+1]
	var names []string
	for _, m := range importLine.FindAllStringSubmatch(block, -1) {
		names = append(names, cmp.Or(m[1], path.Base(m[2])))
	}
	return names
}

// addImport adds an import of path to src's import block, unless it has
// one, at the end of the group of the import that shares the most of its
// path, and at least its host and owner, such as github.com/goncini: the
// first of those groups, which an app whose module goncini's owner also
// owns has after goncini's. Without, it goes last.
func addImport(src, path string) string {
	quoted := strconv.Quote(path)
	start := strings.Index(src, "import (\n")
	if start < 0 || strings.Contains(src, quoted) {
		return src
	}
	start += len("import (\n")
	end := start + strings.Index(src[start:], "\n)") + 1
	at, best := end, 1
	inBest := false // whether the line is in the group of the best match
	for i := start; i < end; {
		line := src[i : i+strings.IndexByte(src[i:], '\n')+1]
		if m := importLine.FindStringSubmatch(line); m != nil {
			if shared := sharedSegments(m[2], path); shared > best {
				best, inBest = shared, true
			}
			if inBest {
				at = i + len(line)
			}
		} else {
			inBest = false // a blank line ends a group
		}
		i += len(line)
	}
	return src[:at] + "\t" + quoted + "\n" + src[at:]
}

// sharedSegments is how many of their first segments two import paths
// share.
func sharedSegments(a, b string) int {
	as, bs := strings.Split(a, "/"), strings.Split(b, "/")
	n := 0
	for n < len(as) && n < len(bs) && as[n] == bs[n] {
		n++
	}
	return n
}

// egoFmt formats .ego files with ego fmt.
func egoFmt(root string, files ...string) error {
	return run(root, "go", append([]string{"tool", "ego", "fmt", "-w"}, files...)...)
}

// initialisms are the words that Go names write in capitals.
var initialisms = []string{"api", "csv", "html", "http", "id", "json", "sql", "url", "uuid", "xml"}

// camel turns a name into an exported Go one: prune-old becomes PruneOld,
// and import-csv ImportCSV.
func camel(name string) string {
	var b strings.Builder
	for _, w := range strings.FieldsFunc(name, r => r == '-' || r == '_' || r == ':') {
		if slices.Contains(initialisms, w) {
			b.WriteString(strings.ToUpper(w))
			continue
		}
		b.WriteString(strings.ToUpper(w[:1]) + w[1:])
	}
	return b.String()
}

// snake turns a Go name into a file or route name: NoteCreated becomes
// note_created, and prune-old prune_old.
func snake(name string) string {
	var b strings.Builder
	for i, r := range name {
		if unicode.IsUpper(r) && i > 0 && !unicode.IsUpper(rune(name[i-1])) {
			b.WriteByte('_')
		}
		b.WriteRune(unicode.ToLower(r))
	}
	return strings.ReplaceAll(b.String(), "-", "_")
}

// kebab turns a Go name into a path segment: ArchiveAll becomes
// archive-all.
func kebab(name string) string {
	return strings.ReplaceAll(snake(name), "_", "-")
}

// singular returns the singular of an English plural, as far as simple
// rules go: notes gives note, and categories category; status and news
// stay as they are.
func singular(name string) string {
	switch {
	case strings.HasSuffix(name, "ies"):
		return strings.TrimSuffix(name, "ies") + "y"
	case strings.HasSuffix(name, "s") && !strings.HasSuffix(name, "ss") && !strings.HasSuffix(name, "us") && !strings.HasSuffix(name, "is") && !strings.HasSuffix(name, "ews"):
		return strings.TrimSuffix(name, "s")
	}
	return name
}
