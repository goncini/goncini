package main

import (
	"bytes"
	"errors"
	"fmt"
	"go/ast"
	"go/format"
	"go/types"
	"io/fs"
	"os"
	"os/exec"
	"path/filepath"
	"sort"
	"strconv"
	"strings"

	"golang.org/x/tools/go/packages"
)

// FileName is the file that goncini generate writes in the app's package.
const FileName = "autoconfigured_gen.go"

const (
	gonciniPath    = "github.com/goncini/goncini"
	layerPath      = "github.com/effect-go/effect-go/layer"
	generatedTitle = "// Code generated by goncini generate. DO NOT EDIT.\n\n"
)

// generate writes the Autoconfigured providers of the app whose module is
// at root, and whose wiring package is in appDir: or, with checkOnly,
// fails if the file isn't what it would write. Generating runs ego
// generate before, so that the types of the .ego files are known, and
// after, so that the app's layers use the providers.
func generate(root, appDir string, checkOnly bool) error {
	path := filepath.Join(root, appDir, FileName)
	_, err := os.Stat(path)
	missing := errors.Is(err, fs.ErrNotExist)
	if checkOnly {
		if missing {
			return fmt.Errorf("%s is missing: run goncini generate", path)
		}
		services := check describe(root, appDir) ""
		code := check autoconfigure(root, appDir, services) ""
		old := check os.ReadFile(path) ""
		if !bytes.Equal(old, code) {
			return fmt.Errorf("%s isn't up to date: run goncini generate", path)
		}
		return nil
	}
	if missing {
		stub := generatedTitle + "package " + filepath.Base(appDir) + "\n\nimport \"" + layerPath + "\"\n\nvar Autoconfigured = layer.Set()\n"
		check os.WriteFile(path, []byte(stub), 0o644) ""
	}
	egoGenerate(root) // the app's layers can't be wired until Autoconfigured is
	code := check autoconfigure(root, appDir, nil) ""
	check os.WriteFile(path, code, 0o644) ""
	if out, err := egoGenerate(root); err != nil {
		return fmt.Errorf("ego generate: %v\n%s", err, out)
	}
	// Now that the layers are wired, describe the services they build: the
	// providers stay the same, so the layers do too.
	services := check describe(root, appDir) ""
	code = check autoconfigure(root, appDir, services) ""
	check os.WriteFile(path, code, 0o644) ""
	return nil
}

// egoGenerate runs ego generate on the module at root.
func egoGenerate(root string) ([]byte, error) {
	cmd := exec.Command("go", "tool", "ego", "generate", "./...")
	cmd.Dir = root
	return cmd.CombinedOutput()
}

// kind is a kind of service that goncini collects into a slice, and how.
type kind struct {
	name  string // the provider's name
	slice string // the slice's type, in goncini: routing.Routes for []routing.Routes
	doc   string
}

var kinds = []kind{
	{"autoRoutes", "routing.Routes", "autoRoutes are the services that have routes, in the order they are provided."},
	{"autoProblems", "httpkernel.ErrorMapper", "autoProblems are the error mappers that the app's packages declare."},
	{"autoCommands", "console.Command", "autoCommands are the services that are console commands, and the commands of the migrator."},
	{"autoChecks", "goncini.Check", "autoChecks ping the services that can be pinged, such as the database, before serving."},
}

// app is what goncini generate knows of an app.
type app struct {
	pkg      *packages.Package
	all      []*packages.Package // the module's packages
	provided []types.Type        // the results of the app's providers, in order
	config   *types.Named        // the injector's config type
	imports  map[string]string   // import path -> name, for the generated file
}

// autoconfigure returns the generated file of the app, describing
// services, if the app uses goncini.Service.
func autoconfigure(root, appDir string, services []service) ([]byte, error) {
	a := check load(root, appDir) ""
	var b strings.Builder
	var names []string
	for _, k := range kinds {
		elem := a.lookup(k.slice)
		if elem == nil || a.provides(types.NewSlice(elem)) {
			continue // goncini doesn't use it, or the app provides it itself
		}
		names = append(names, k.name)
		params, values := a.collect(k, elem)
		fmt.Fprintf(&b, "// %s\nfunc %s(%s) []%s {\n\treturn %s\n}\n\n", k.doc, k.name, strings.Join(params, ", "), a.typeString(elem), values)
	}
	if svc := a.lookup("goncini.Service"); svc != nil && !a.provides(types.NewSlice(svc)) {
		names = append(names, "autoServices")
		fmt.Fprintf(&b, "// autoServices describes the app's services, for debug:container.\nfunc autoServices() []%s {\n\treturn []%s{\n", a.typeString(svc), a.typeString(svc))
		for _, s := range services {
			needs := make([]string, len(s.needs))
			for i, n := range s.needs {
				needs[i] = strconv.Quote(n)
			}
			fmt.Fprintf(&b, "\t\t{Type: %q, Provider: %q, Needs: []string{%s}},\n", s.typ, s.provider, strings.Join(needs, ", "))
		}
		b.WriteString("\t}\n}\n\n")
	}
	if a.config != nil {
		st, _ := a.config.Underlying().(*types.Struct)
		for i := 0; st != nil && i < st.NumFields(); i++ {
			f := st.Field(i)
			if !f.Exported() || a.provides(f.Type()) {
				continue
			}
			name := "autoConfig" + f.Name()
			names = append(names, name)
			fmt.Fprintf(&b, "// %s is the %s section of the config.\nfunc %s(c %s) %s { return c.%s }\n\n", name, f.Name(), name, a.typeString(a.config), a.typeString(f.Type()), f.Name())
		}
	}
	var out bytes.Buffer
	out.WriteString(generatedTitle + "package " + a.pkg.Name + "\n\n")
	a.imports[layerPath] = "layer"
	out.WriteString(a.importBlock())
	out.WriteString("// Autoconfigured hands goncini the app's services of each kind it uses,\n// found by their types, and each part of goncini its config section.\n")
	out.WriteString("var Autoconfigured = layer.Set(" + strings.Join(names, ", ") + ")\n\n")
	out.WriteString(b.String())
	code, err := format.Source(out.Bytes())
	if err != nil {
		return nil, fmt.Errorf("internal error: %v\n%s", err, out.Bytes())
	}
	return code, nil
}

// load loads the module at root, and finds what the app in appDir provides.
func load(root, appDir string) (*app, error) {
	cfg := &packages.Config{
		Mode:       packages.NeedName | packages.NeedFiles | packages.NeedSyntax | packages.NeedTypes | packages.NeedTypesInfo | packages.NeedImports | packages.NeedDeps,
		Dir:        root,
		BuildFlags: []string{"-tags=egolayers"}, // the injectors, not the layers they compile to
	}
	pkgs := check packages.Load(cfg, "./...") ""
	var errs []error
	packages.Visit(pkgs, nil, p => {
		for _, e := range p.Errors {
			errs = append(errs, errors.New(e.Error()))
		}
	})
	check errors.Join(errs...) ""
	dir := check filepath.Abs(filepath.Join(root, appDir)) ""
	a := &app{all: pkgs, imports: map[string]string{}}
	for _, p := range pkgs {
		if len(p.GoFiles) > 0 && filepath.Dir(p.GoFiles[0]) == dir {
			a.pkg = p
		}
	}
	if a.pkg == nil {
		return nil, fmt.Errorf("no package in %s", dir)
	}
	check a.findProviders() ""
	return a, nil
}

// findProviders finds the injectors of the app's package, the providers
// they build with, but for goncini's and Autoconfigured, and the config
// type, an injector's first parameter that is a struct.
func (a *app) findProviders() error {
	seen := map[types.Object]bool{}
	for _, f := range a.pkg.Syntax {
		for _, d := range f.Decls {
			fd, ok := d.(*ast.FuncDecl)
			if !ok || fd.Body == nil || len(fd.Body.List) != 1 {
				continue
			}
			args, ok := buildArgs(a.pkg.TypesInfo, fd)
			if !ok {
				continue
			}
			sig := a.pkg.TypesInfo.Defs[fd.Name].Type().(*types.Signature)
			for i := 0; i < sig.Params().Len() && a.config == nil; i++ {
				if n, ok := sig.Params().At(i).Type().(*types.Named); ok {
					if _, ok := n.Underlying().(*types.Struct); ok {
						a.config = n
					}
				}
			}
			a.addProviders(args, seen)
		}
	}
	if a.config == nil {
		return errors.New("no injector with a config: a function in an egolayers file whose body is panic(layer.Build(…)), with a config struct parameter")
	}
	return nil
}

// buildArgs returns the arguments of layer.Build, if fd's body is
// panic(layer.Build(…)).
func buildArgs(info *types.Info, fd *ast.FuncDecl) ([]ast.Expr, bool) {
	stmt, ok := fd.Body.List[0].(*ast.ExprStmt)
	if !ok {
		return nil, false
	}
	call, ok := stmt.X.(*ast.CallExpr)
	if !ok || len(call.Args) != 1 || !isFunc(info, call.Fun, "", "panic") {
		return nil, false
	}
	build, ok := call.Args[0].(*ast.CallExpr)
	if !ok || !isFunc(info, build.Fun, layerPath, "Build") {
		return nil, false
	}
	return build.Args, true
}

// isFunc reports whether x is the function name of the package path; ""
// is the universe.
func isFunc(info *types.Info, x ast.Expr, path, name string) bool {
	obj := info.Uses[ident(x)]
	if obj == nil || obj.Name() != name {
		return false
	}
	return if path == "" { obj.Parent() == types.Universe } else { obj.Pkg() != nil && obj.Pkg().Path() == path }
}

// ident is the name in x, an identifier or a selector, or nil.
func ident(x ast.Expr) *ast.Ident {
	switch x := x.(type) {
	case *ast.Ident:
		return x
	case *ast.SelectorExpr:
		return x.Sel
	}
	return nil
}

// addProviders adds the results of the providers in args: functions, sets
// of the app's package, and layer.Close of a function.
func (a *app) addProviders(args []ast.Expr, seen map[types.Object]bool) {
	info := a.pkg.TypesInfo
	for _, x := range args {
		if call, ok := x.(*ast.CallExpr); ok {
			if isFunc(info, call.Fun, layerPath, "Close") || isFunc(info, call.Fun, layerPath, "Set") {
				a.addProviders(call.Args, seen)
			}
			continue
		}
		obj := info.Uses[ident(x)]
		if v, ok := obj.(*types.Var); ok && isNamed(v.Type(), layerPath, "ProviderSet") {
			// The app's own sets, not goncini's, nor what this file generates.
			if seen[v] || v.Pkg() != a.pkg.Types || v.Name() == "Autoconfigured" {
				continue
			}
			seen[v] = true
			if init := a.varInit(v); init != nil {
				a.addProviders([]ast.Expr{init}, seen)
			}
			continue
		}
		if sig, ok := info.TypeOf(x).(*types.Signature); ok && sig.Results().Len() > 0 {
			a.provided = append(a.provided, sig.Results().At(0).Type())
		}
	}
}

// varInit returns the expression that v, a package-level variable of the
// app, is initialized with.
func (a *app) varInit(v *types.Var) ast.Expr {
	for _, f := range a.pkg.Syntax {
		for _, d := range f.Decls {
			gd, ok := d.(*ast.GenDecl)
			if !ok {
				continue
			}
			for _, s := range gd.Specs {
				vs, ok := s.(*ast.ValueSpec)
				if !ok {
					continue
				}
				for i, n := range vs.Names {
					if a.pkg.TypesInfo.Defs[n] == v && i < len(vs.Values) {
						return vs.Values[i]
					}
				}
			}
		}
	}
	return nil
}

func isNamed(t types.Type, path, name string) bool {
	n, ok := types.Unalias(t).(*types.Named)
	return ok && n.Obj().Pkg() != nil && n.Obj().Pkg().Path() == path && n.Obj().Name() == name
}

// provides reports whether an app's provider returns t.
func (a *app) provides(t types.Type) bool {
	for _, p := range a.provided {
		if types.Identical(p, t) {
			return true
		}
	}
	return false
}

// lookup returns goncini's type named "pkg.Name", where pkg is goncini's
// package of that name, or goncini itself; nil if no package of the module
// imports it.
func (a *app) lookup(name string) types.Type {
	pkgName, typeName, _ := strings.Cut(name, ".")
	path := if pkgName == "goncini" { gonciniPath } else { gonciniPath + "/" + pkgName }
	var found types.Type
	packages.Visit(a.all, nil, p => {
		if found == nil && p.PkgPath == path {
			if obj := p.Types.Scope().Lookup(typeName); obj != nil {
				found = obj.Type()
			}
		}
	})
	return found
}

// collect returns the parameters and the slice of a kind's provider.
func (a *app) collect(k kind, elem types.Type) (params []string, values string) {
	var items []string
	add := (t types.Type, value string) => {
		p := "p" + strconv.Itoa(len(params)+1)
		params = append(params, p+" "+a.typeString(t))
		items = append(items, strings.ReplaceAll(value, "$", p))
	}
	match k.name {
		"autoProblems" => {
			for _, v := range a.mappers(elem) {
				items = append(items, a.qualify(v.Pkg())+"."+v.Name())
			}
		}
		"autoChecks" => {
			for _, t := range a.provided {
				if m := pinger(t); m != "" {
					add(t, "$."+m)
				}
			}
		}
		_ => {
			iface, _ := elem.Underlying().(*types.Interface)
			for _, t := range a.provided {
				if iface != nil && types.Implements(t, iface) && !types.IsInterface(t) {
					add(t, "$")
				}
			}
		}
	}
	list := "[]" + a.typeString(elem) + "{" + strings.Join(items, ", ") + "}"
	if k.name == "autoCommands" {
		if m := a.lookup("db.Migrator"); m != nil && a.provides(m) {
			params = append(params, "m "+a.typeString(m))
			migrations := a.qualify(m.(*types.Named).Obj().Pkg()) + ".Commands(m)"
			return params, if len(items) == 0 { migrations } else { "append(" + migrations + ", " + strings.Join(items, ", ") + ")" }
		}
	}
	return params, list
}

// mappers returns the package-level variables of type elem, an
// httpkernel.ErrorMapper, that the module's packages declare, sorted by
// package and name.
func (a *app) mappers(elem types.Type) []*types.Var {
	var vars []*types.Var
	for _, p := range a.all {
		scope := p.Types.Scope()
		for _, name := range scope.Names() {
			if v, ok := scope.Lookup(name).(*types.Var); ok && v.Exported() && types.Identical(v.Type(), elem) {
				vars = append(vars, v)
			}
		}
	}
	sort.SliceStable(vars, (i, j int) => vars[i].Pkg().Path() < vars[j].Pkg().Path())
	return vars
}

// pinger returns the method that pings t, PingContext or Ping taking a
// context and returning an error, or "".
func pinger(t types.Type) string {
	ms := types.NewMethodSet(t)
	for _, name := range []string{"PingContext", "Ping"} {
		sel := ms.Lookup(nil, name)
		if sel == nil {
			continue
		}
		sig := sel.Type().(*types.Signature)
		if sig.Params().Len() == 1 && isNamed(sig.Params().At(0).Type(), "context", "Context") &&
			sig.Results().Len() == 1 && types.Identical(sig.Results().At(0).Type(), types.Universe.Lookup("error").Type()) {
			return name
		}
	}
	return ""
}

// typeString writes t with the generated file's imports.
func (a *app) typeString(t types.Type) string {
	return types.TypeString(t, p => a.qualify(p))
}

// qualify returns the name that the generated file imports p as.
func (a *app) qualify(p *types.Package) string {
	if p == a.pkg.Types {
		return ""
	}
	if name, ok := a.imports[p.Path()]; ok {
		return name
	}
	name := p.Name()
	for n := 2; a.taken(name); n++ {
		name = p.Name() + strconv.Itoa(n)
	}
	a.imports[p.Path()] = name
	return name
}

// taken reports whether an import has the name.
func (a *app) taken(name string) bool {
	for _, n := range a.imports {
		if n == name {
			return true
		}
	}
	return false
}

// importBlock writes the imports, the standard library first.
func (a *app) importBlock() string {
	var std, others []string
	for path, name := range a.imports {
		spec := strconv.Quote(path)
		if name != filepath.Base(path) {
			spec = name + " " + spec
		}
		if strings.Contains(strings.Split(path, "/")[0], ".") {
			others = append(others, spec)
		} else {
			std = append(std, spec)
		}
	}
	sort.Strings(std)
	sort.Strings(others)
	groups := []string{}
	for _, g := range [][]string{std, others} {
		if len(g) > 0 {
			groups = append(groups, "\t"+strings.Join(g, "\n\t"))
		}
	}
	return "import (\n" + strings.Join(groups, "\n\n") + "\n)\n\n"
}

// service is a service that the app's Build injector builds.
type service struct {
	typ, provider string
	needs         []string
}

// describe returns the services that the app's injector named Build, or
// else its first, builds, in order, as ego generate wired them in the
// layers_ego.go of the app's package; none if the layers aren't wired.
func describe(root, appDir string) ([]service, error) {
	cfg := &packages.Config{
		Mode: packages.NeedName | packages.NeedFiles | packages.NeedCompiledGoFiles | packages.NeedSyntax | packages.NeedTypes | packages.NeedTypesInfo,
		Dir:  filepath.Join(root, appDir),
	}
	pkgs := check packages.Load(cfg, ".") ""
	if len(pkgs) != 1 || len(pkgs[0].Errors) > 0 {
		return nil, nil
	}
	p := pkgs[0]
	var build *ast.FuncDecl
	for i, f := range p.Syntax {
		if filepath.Base(p.CompiledGoFiles[i]) != "layers_ego.go" {
			continue
		}
		for _, d := range f.Decls {
			if fd, ok := d.(*ast.FuncDecl); ok && (build == nil || fd.Name.Name == "Build") {
				build = fd
			}
		}
	}
	if build == nil {
		return nil, nil
	}
	name := func(pkg *types.Package) string { return if pkg == p.Types { "" } else { pkg.Name() } }
	var services []service
	for _, stmt := range build.Body.List {
		assign, ok := stmt.(*ast.AssignStmt)
		if !ok || len(assign.Rhs) != 1 {
			continue
		}
		call, ok := assign.Rhs[0].(*ast.CallExpr)
		lhs, ok2 := assign.Lhs[0].(*ast.Ident)
		if !ok || !ok2 || p.TypesInfo.Defs[lhs] == nil {
			continue
		}
		s := service{typ: types.TypeString(p.TypesInfo.Defs[lhs].Type(), name), provider: types.ExprString(call.Fun)}
		for _, arg := range call.Args {
			if t := p.TypesInfo.TypeOf(arg); t != nil {
				s.needs = append(s.needs, types.TypeString(t, name))
			}
		}
		services = append(services, s)
	}
	return services, nil
}
