package main

import (
	"bufio"
	"crypto/rand"
	"errors"
	"fmt"
	"io"
	"os"
	"path/filepath"
	"strings"

	"github.com/goncini/goncini"
	"github.com/goncini/goncini/secrets"
)

// vaultDir is the directory of the vault of env, in the app at root.
func vaultDir(root, env string) string {
	return filepath.Join(root, "config", "secrets", env)
}

// openVault opens the vault of env, with the decryption key of the
// environment, or its decrypt.key file.
func openVault(root, env string) (*secrets.Vault, error) {
	v, err := secrets.Open(vaultDir(root, env), os.Getenv(goncini.DecryptionKey))
	if errors.Is(err, os.ErrNotExist) {
		return nil, fmt.Errorf("the %s environment has no vault: goncini secrets:generate-keys -env %s makes one", env, env)
	}
	return v, err
}

// generateKeys makes the vault of env, or with rotate, replaces its keys.
func generateKeys(out io.Writer, root, env string, rotate bool) error {
	dir := vaultDir(root, env)
	if rotate {
		v := check openVault(root, env) ""
		check v.Rotate() ""
	} else {
		check secrets.Generate(dir) ""
	}
	rel := filepath.Join("config", "secrets", env)
	fmt.Fprintf(out, "Wrote %s and %s, in %s.\n", secrets.EncryptKey, secrets.DecryptKey, rel)
	fmt.Fprintf(out, "Commit %s. Unless anyone who reads the repository may read the secrets, as in dev, keep %s out of it,\nand give the servers its content in %s.\n", secrets.EncryptKey, secrets.DecryptKey, goncini.DecryptionKey)
	return nil
}

// setSecret seals the secret name in the vault of env: a random value, or
// the one that in holds, up to a newline when it is a terminal.
func setSecret(out io.Writer, in *os.File, root, env, name string, random bool) error {
	v := check openVault(root, env) ""
	var value string
	if random {
		value = rand.Text()
	} else {
		value = check readValue(out, in, name) ""
	}
	check v.Set(name, value) ""
	fmt.Fprintf(out, "Sealed %s in the %s vault.\n", name, env)
	return nil
}

// readValue reads a secret's value: a line from a terminal, which it asks
// for, or all of a pipe, without its last newline.
func readValue(out io.Writer, in *os.File, name string) (string, error) {
	info := check in.Stat() ""
	if info.Mode()&os.ModeCharDevice != 0 {
		fmt.Fprintf(out, "The value of %s, then Enter: ", name)
		line := check bufio.NewReader(in).ReadString('\n') ""
		return strings.TrimRight(line, "\r\n"), nil
	}
	b := check io.ReadAll(io.LimitReader(in, 1<<20)) ""
	return strings.TrimSuffix(strings.TrimSuffix(string(b), "\n"), "\r"), nil
}

// listSecrets prints the names of the secrets of the vault of env, and
// with reveal, their values.
func listSecrets(out io.Writer, root, env string, reveal bool) error {
	v := check openVault(root, env) ""
	names := check v.Names() ""
	for _, name := range names {
		if !reveal {
			fmt.Fprintln(out, name)
			continue
		}
		value, _ := check v.Get(name) ""
		fmt.Fprintf(out, "%s=%s\n", name, value)
	}
	return nil
}

// removeSecret removes the secret name from the vault of env.
func removeSecret(out io.Writer, root, env, name string) error {
	v := check openVault(root, env) ""
	check v.Remove(name) ""
	fmt.Fprintf(out, "Removed %s from the %s vault.\n", name, env)
	return nil
}
