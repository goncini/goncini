// Package otlp exports an app's spans to an OpenTelemetry collector, over
// OTLP/HTTP: Jaeger, Tempo, Honeycomb, Datadog's agent, or any other. It
// is an adapter module, so that apps that don't export spans don't depend
// on the exporter's protobuf and gRPC libraries.
//
//	var Services = layer.Set(otlp.Layer, …)
//
//	c.OTLP = otlp.Config{Endpoint: env.OptionalSecret("OTEL_EXPORTER_OTLP_ENDPOINT")}
//
// Without an endpoint, nothing is exported, and the exporter wants no
// spans. The spans' resource follows OTEL_SERVICE_NAME and
// OTEL_RESOURCE_ATTRIBUTES.
package otlp

import (
	"context"
	"fmt"
	"net/url"

	"github.com/effect-go/effect-go/layer"
	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"
)

// Config configures the export.
type Config struct {
	// Endpoint is the collector's URL, such as http://localhost:4318, as
	// OTEL_EXPORTER_OTLP_ENDPOINT has it: the spans go to its /v1/traces,
	// unless it has a path of its own. Empty means no export.
	Endpoint string
	// Headers are sent with each export, such as an API key: secrets.
	Headers map[string]string
}

// Layer is the exporter's provider.
var Layer = layer.Set(New)

// Exporter sends the app's spans to the collector in batches. It is a
// goncini.SpanProcessor, enabled when there is an endpoint.
type Exporter struct {
	sdktrace.SpanProcessor
}

// New returns the exporter to c.Endpoint, or a disabled one without an
// endpoint. The tracer provider shuts it down when the app stops, sending
// the spans it still has.
func New(c Config) (*Exporter, error) {
	if c.Endpoint == "" {
		return &Exporter{}, nil
	}
	u, err := url.Parse(c.Endpoint)
	if err != nil {
		return nil, fmt.Errorf("otlp: %w", err)
	}
	if u.Path == "" || u.Path == "/" {
		u.Path = "/v1/traces"
	}
	opts := []otlptracehttp.Option{otlptracehttp.WithEndpointURL(u.String())}
	if len(c.Headers) > 0 {
		opts = append(opts, otlptracehttp.WithHeaders(c.Headers))
	}
	exp, err := otlptracehttp.New(context.Background(), opts...)
	if err != nil {
		return nil, fmt.Errorf("otlp: %w", err)
	}
	return &Exporter{sdktrace.NewBatchSpanProcessor(exp)}, nil
}

// Enabled reports whether there is a collector to export to.
func (e *Exporter) Enabled() bool { return e.SpanProcessor != nil }
