package goncini

import (
	"context"

	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/propagation"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"
)

// SpanProcessor receives the app's spans when it is enabled, as the
// profiler in dev, or an exporter given an endpoint. goncini generate
// collects the services that are SpanProcessors.
type SpanProcessor interface {
	sdktrace.SpanProcessor
	// Enabled reports whether it wants spans. When none does, the app
	// records none, and its spans cost next to nothing.
	Enabled() bool
}

// Tracing is the app's tracer provider, nil when no SpanProcessor is
// enabled.
type Tracing struct {
	Provider *sdktrace.TracerProvider
}

// NewTracing returns the tracer provider of the enabled processors, and
// makes it the global one, which goncini's and effect-go's spans use,
// until the app stops; its resource follows OTEL_SERVICE_NAME and
// OTEL_RESOURCE_ATTRIBUTES. It also makes W3C trace context the global
// propagator, so that incoming and outgoing requests carry their traces.
func NewTracing(processors []SpanProcessor) (*Tracing, func(ctx context.Context) error, error) {
	var opts []sdktrace.TracerProviderOption
	for _, p := range processors {
		if p.Enabled() {
			opts = append(opts, sdktrace.WithSpanProcessor(p))
		}
	}
	if len(opts) == 0 {
		return &Tracing{}, (ctx context.Context) => nil, nil
	}
	tp := sdktrace.NewTracerProvider(opts...)
	previous, propagator := otel.GetTracerProvider(), otel.GetTextMapPropagator()
	otel.SetTracerProvider(tp)
	otel.SetTextMapPropagator(propagation.TraceContext{})
	stop := func(ctx context.Context) error {
		otel.SetTracerProvider(previous)
		otel.SetTextMapPropagator(propagator)
		return tp.Shutdown(ctx)
	}
	return &Tracing{Provider: tp}, stop, nil
}
