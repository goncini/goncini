package mime_test

import (
	"bytes"
	"encoding/base64"
	"io"
	stdmime "mime"
	"mime/multipart"
	"mime/quotedprintable"
	"net/mail"
	"reflect"
	"strings"
	"testing"
	"time"

	"github.com/goncini/goncini/mime"
)

// parts reads the leaves of a multipart body: content type, then decoded
// content.
func parts(t *testing.T, contentType string, body io.Reader, out map[string]string) {
	t.Helper()
	media, params := must stdmime.ParseMediaType(contentType)
	if !strings.HasPrefix(media, "multipart/") {
		t.Fatalf("not multipart: %s", media)
	}
	r := multipart.NewReader(body, params["boundary"])
	for {
		p, err := r.NextRawPart()
		if err == io.EOF {
			return
		}
		if err != nil {
			t.Fatal(err)
		}
		ct := p.Header.Get("Content-Type")
		if strings.HasPrefix(ct, "multipart/") {
			parts(t, ct, p, out)
			continue
		}
		var data []byte
		switch p.Header.Get("Content-Transfer-Encoding") {
		case "quoted-printable":
			data = must io.ReadAll(quotedprintable.NewReader(p))
		case "base64":
			data = must io.ReadAll(base64.NewDecoder(base64.StdEncoding, p))
		}
		media, _ := must stdmime.ParseMediaType(ct)
		out[media] = string(data)
	}
}

func TestEmail(t *testing.T) {
	e := &mime.Email{
		From:    mime.Address{Name: "Conduit", Email: "hello@conduit.example"},
		To:      []mime.Address{{Name: "Zoé", Email: "zoe@example.com"}},
		Bcc:     []mime.Address{{Email: "audit@conduit.example"}},
		Subject: "Bienvenue, Zoé",
		Text:    "Welcome to Conduit.\nA line long enough to be wrapped by quoted-printable, which wraps lines over seventy-six characters.",
		HTML:    `<p>Welcome</p><img src="cid:logo">`,
		Parts: []mime.Part{
			{Name: "logo.png", Data: []byte("\x89PNG..."), ContentID: "logo"},
			{Name: "terms.pdf", Data: bytes.Repeat([]byte("%PDF"), 50)},
		},
		Header: map[string]string{"List-Unsubscribe": "<https://conduit.example/unsubscribe>"},
	}
	raw := must e.Bytes()
	msg := must mail.ReadMessage(bytes.NewReader(raw))
	dec := new(stdmime.WordDecoder)
	subject := must dec.DecodeHeader(msg.Header.Get("Subject"))
	to := must msg.Header.AddressList("To")
	if subject != "Bienvenue, Zoé" || to[0].Name != "Zoé" || msg.Header.Get("Bcc") != "" || msg.Header.Get("List-Unsubscribe") == "" || msg.Header.Get("Message-Id") == "" {
		t.Errorf("header %v", msg.Header)
	}
	got := map[string]string{}
	parts(t, msg.Header.Get("Content-Type"), msg.Body, got)
	if got["text/plain"] != strings.ReplaceAll(e.Text, "\n", "\r\n") || got["text/html"] != e.HTML || got["image/png"] != "\x89PNG..." || got["application/pdf"] != strings.Repeat("%PDF", 50) {
		t.Errorf("parts %q", got)
	}
	if rs := e.Recipients(); len(rs) != 2 {
		t.Errorf("recipients %v", rs)
	}
}

func TestInvalid(t *testing.T) {
	for _, e := range []*mime.Email{
		{To: []mime.Address{{Email: "a@example.com"}}, Text: "x"},
		{From: mime.Address{Email: "a@example.com"}, Text: "x"},
		{From: mime.Address{Email: "a@example.com"}, To: []mime.Address{{Email: "b@example.com"}}},
		{From: mime.Address{Email: "a@example.com\r\nBcc: x@evil.example"}, To: []mime.Address{{Email: "b@example.com"}}, Text: "x"},
		{From: mime.Address{Email: "a@example.com"}, To: []mime.Address{{Email: "b@example.com"}}, Text: "x", Header: map[string]string{"X": "a\r\nBcc: x@evil.example"}},
		{From: mime.Address{Email: "a@example.com"}, To: []mime.Address{{Email: "b@example.com"}}, Text: "x", Header: map[string]string{"X Bad": "a"}},
		{From: mime.Address{Email: "a@example.com"}, To: []mime.Address{{Email: "Eve <eve@example.com>"}}, Text: "x"},
		{From: mime.Address{Email: "a@example.com"}, To: []mime.Address{{Email: "b@example.com"}}, ReplyTo: []mime.Address{{Email: "nope"}}, Text: "x"},
		{From: mime.Address{Email: "a@example.com"}, To: []mime.Address{{Email: "b@example.com"}}, HTML: "x", Parts: []mime.Part{{Name: "a.png", ContentID: "x>\r\nContent-Type: text/html"}}},
	} {
		if _, err := e.Bytes(); err == nil {
			t.Errorf("%+v: no error", e)
		}
	}
}

// TestLongAndPlain checks that long headers are folded, that a type with
// parameters is kept, and that an inline image of an email without HTML
// is attached.
func TestLongAndPlain(t *testing.T) {
	var to []mime.Address
	for range 60 {
		to = append(to, mime.Address{Email: "reader@example.com"})
	}
	e := &mime.Email{
		From:    mime.Address{Email: "a@example.com"},
		To:      to,
		Subject: strings.Repeat("é", 300),
		Text:    "x",
		Parts: []mime.Part{
			{Name: "notes.csv", Data: []byte("a,b")},
			{Name: "logo.png", Data: []byte("png"), ContentID: "logo"},
		},
	}
	b := must e.Bytes()
	raw := string(b)
	for _, line := range strings.Split(raw, "\r\n") {
		if len(line) > 78 {
			t.Errorf("a line of %d: %.40s…", len(line), line)
		}
	}
	msg := must mail.ReadMessage(strings.NewReader(raw))
	subject := must new(stdmime.WordDecoder).DecodeHeader(msg.Header.Get("Subject"))
	addresses := must msg.Header.AddressList("To")
	got := map[string]string{}
	parts(t, msg.Header.Get("Content-Type"), msg.Body, got)
	if subject != e.Subject || len(addresses) != 60 || got["text/plain"] != "x" || got["text/csv"] != "a,b" || got["image/png"] != "png" {
		t.Errorf("subject %q, parts %q", subject, got)
	}
	if !strings.Contains(raw, `Content-Type: text/csv; charset=utf-8; name=notes.csv`) {
		t.Errorf("no type for notes.csv:\n%s", raw)
	}
}

// TestParse checks that Parse reads what Bytes writes, but Bcc, which the
// message doesn't hold.
func TestParse(t *testing.T) {
	e := &mime.Email{
		From:    mime.Address{Name: "Conduit Équipe", Email: "hello@conduit.example"},
		To:      []mime.Address{{Name: "Zoé", Email: "zoe@example.com"}, {Email: "ann@example.com"}},
		Cc:      []mime.Address{{Email: "bob@example.com"}},
		Bcc:     []mime.Address{{Email: "audit@conduit.example"}},
		ReplyTo: []mime.Address{{Name: "Support", Email: "support@conduit.example"}},
		Subject: "Bienvenue, Zoé: a subject long enough to be folded over two lines of the header",
		Text:    "Welcome to Conduit.\nA line long enough to be wrapped by quoted-printable, which wraps lines over seventy-six characters.",
		HTML:    `<p>Welcome</p><img src="cid:logo">`,
		Parts: []mime.Part{
			{Name: "logo.png", Data: []byte("\x89PNG..."), ContentID: "logo"},
			{Name: "terms.pdf", ContentType: "application/pdf", Data: bytes.Repeat([]byte("%PDF"), 50)},
		},
		Header: map[string]string{"List-Unsubscribe": "<https://conduit.example/unsubscribe>", "X-Campaign": "été"},
		Date:   time.Date(2026, 10, 19, 9, 30, 0, 0, time.UTC),
	}
	raw := must e.Bytes()
	got := must mime.Parse(raw)
	want := *e
	want.Bcc = nil
	want.Parts = []mime.Part{{Name: "logo.png", ContentType: "image/png", Data: e.Parts[0].Data, ContentID: "logo"}, e.Parts[1]}
	if !got.Date.Equal(want.Date) {
		t.Errorf("date %v", got.Date)
	}
	got.Date = want.Date
	if !reflect.DeepEqual(*got, want) {
		t.Errorf("parsed\n%+v\nwant\n%+v", *got, want)
	}

	// A message of one part, of no type: a text.
	plain := must mime.Parse([]byte("From: ann@example.com\r\nTo: bob@example.com\r\nSubject: hi\r\n\r\nhello\r\n"))
	if plain.Text != "hello\n" || plain.From.Email != "ann@example.com" || len(plain.Parts) != 0 || plain.Header != nil {
		t.Errorf("plain %+v", plain)
	}
}
