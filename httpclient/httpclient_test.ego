package httpclient_test

import (
	"context"
	"errors"
	"io"
	"net/http"
	"net/http/httptest"
	"net/url"
	"strings"
	"testing"
	"testing/synctest"
	"time"

	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/propagation"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"

	"github.com/goncini/goncini/httpclient"
)

type repo struct {
	Name string `json:"name"`
}

// api answers with the statuses given, in turn, then 200 with a repo, and
// records what it got.
type api struct {
	statuses []int
	retry    string // a Retry-After for the statuses
	got      []*http.Request
	bodies   []string
	times    []time.Time
}

func (a *api) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	body, _ := io.ReadAll(r.Body)
	a.got, a.bodies, a.times = append(a.got, r), append(a.bodies, string(body)), append(a.times, time.Now())
	if len(a.statuses) > 0 {
		status := a.statuses[0]
		a.statuses = a.statuses[1:]
		if a.retry != "" {
			w.Header().Set("Retry-After", a.retry)
		}
		w.WriteHeader(status)
		w.Write([]byte("down"))
		return
	}
	w.Header().Set("Content-Type", "application/json")
	w.Write([]byte(`{"name":"goncini"}`))
}

func client(a *api) *httpclient.Client {
	c := httpclient.New(httpclient.Config{BaseURL: "https://api.example.com/v3/", Header: map[string]string{"User-Agent": "goncini-test"}})
	c.Transport = httpclient.Handler(a)
	return c
}

func TestGet(t *testing.T) {
	a := &api{}
	r := must httpclient.Get[repo](context.Background(), client(a), "/repos/goncini")
	got := a.got[0]
	if r.Name != "goncini" || got.URL.String() != "https://api.example.com/v3/repos/goncini" || got.Header.Get("User-Agent") != "goncini-test" || got.Header.Get("Accept") != "application/json" {
		t.Errorf("%+v, %s %v", r, got.URL, got.Header)
	}
}

func TestRetries(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		a := &api{statuses: []int{503, 502}}
		start := time.Now()
		must httpclient.Get[repo](context.Background(), client(a), "/repos/goncini")
		if len(a.times) != 3 || a.times[1].Sub(start) != 100*time.Millisecond || a.times[2].Sub(start) != 300*time.Millisecond {
			t.Errorf("attempts at %v", a.times)
		}

		a = &api{statuses: []int{429}, retry: "2"}
		start = time.Now()
		must httpclient.Get[repo](context.Background(), client(a), "/")
		if a.times[1].Sub(start) != 2*time.Second {
			t.Errorf("Retry-After: retried after %v", a.times[1].Sub(start))
		}

		a = &api{statuses: []int{503}, retry: "3600"} // too long a pause
		if _, err := httpclient.Get[repo](context.Background(), client(a), "/"); len(a.got) != 1 || err == nil {
			t.Errorf("%d attempts, %v", len(a.got), err)
		}

		a = &api{statuses: []int{503, 503, 503, 503, 503}}
		_, err := httpclient.Get[repo](context.Background(), client(a), "/")
		if e, ok := errors.AsType[*httpclient.StatusError](err); !ok || e.Status != 503 || len(a.got) != 4 {
			t.Errorf("%d attempts, %v", len(a.got), err)
		}

		a = &api{statuses: []int{404}}
		_, err = httpclient.Get[repo](context.Background(), client(a), "/")
		if e, ok := errors.AsType[*httpclient.StatusError](err); !ok || e.Status != 404 || e.Body != "down" || len(a.got) != 1 {
			t.Errorf("%d attempts, %v", len(a.got), err)
		}
	})
}

func TestPOSTs(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		a := &api{statuses: []int{503}}
		ctx := context.Background()
		if _, err := httpclient.Send[repo](ctx, client(a), http.MethodPost, "/repos", repo{"new"}); err == nil || len(a.got) != 1 {
			t.Errorf("a POST was retried: %d attempts, %v", len(a.got), err)
		}
		a = &api{statuses: []int{503}}
		req := must http.NewRequestWithContext(ctx, http.MethodPost, "/repos", strings.NewReader(`{"name":"new"}`))
		req.Header.Set("Idempotency-Key", "1")
		res := must client(a).Do(req)
		res.Body.Close()
		if res.StatusCode != 200 || len(a.got) != 2 || a.bodies[1] != `{"name":"new"}` {
			t.Errorf("with an idempotency key: %d, %d attempts, bodies %q", res.StatusCode, len(a.got), a.bodies)
		}
	})
}

// failing is a transport whose first round trip fails, as a connection
// refused.
type failing struct {
	http.RoundTripper
	failed bool
}

func (f *failing) RoundTrip(req *http.Request) (*http.Response, error) {
	if !f.failed {
		f.failed = true
		return nil, errors.New("connection refused")
	}
	return f.RoundTripper.RoundTrip(req)
}

func TestConnectionFailures(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		a := &api{}
		c := client(a)
		c.Transport = &failing{RoundTripper: c.Transport}
		must httpclient.Get[repo](context.Background(), c, "/")
		if len(a.got) != 1 {
			t.Errorf("%d attempts reached the API", len(a.got))
		}
	})
}

func TestTracePropagates(t *testing.T) {
	otel.SetTextMapPropagator(propagation.TraceContext{})
	tp := sdktrace.NewTracerProvider()
	otel.SetTracerProvider(tp)
	t.Cleanup(() => { tp.Shutdown(context.Background()) })
	ctx, span := tp.Tracer("test").Start(context.Background(), "caller")
	defer span.End()
	a := &api{}
	must httpclient.Get[repo](ctx, client(a), "/")
	if tp := a.got[0].Header.Get("Traceparent"); !strings.Contains(tp, span.SpanContext().TraceID().String()) {
		t.Errorf("traceparent %q", tp)
	}
}

// TestRedirectsAndHosts checks that redirects are followed, and that the
// default headers go only to the base URL's host.
func TestRedirectsAndHosts(t *testing.T) {
	var auths []string
	c := httpclient.New(httpclient.Config{BaseURL: "https://api.example.com", Header: map[string]string{"Authorization": "Bearer secret"}})
	c.Transport = httpclient.Handler(http.HandlerFunc((w http.ResponseWriter, r *http.Request) => {
		auths = append(auths, r.URL.Host+" "+r.Header.Get("Authorization"))
		if r.URL.Path == "/old" {
			http.Redirect(w, r, "/new", http.StatusMovedPermanently)
			return
		}
		w.Write([]byte(`{"name":"goncini"}`))
	}))
	r := must httpclient.Get[repo](context.Background(), c, "/old")
	must httpclient.Get[repo](context.Background(), c, "https://elsewhere.example.com/x")
	u := must url.Parse("/new")
	req := &http.Request{Method: http.MethodGet, URL: u} // no Header
	res := must c.Do(req)
	res.Body.Close()
	want := "api.example.com Bearer secret, api.example.com Bearer secret, elsewhere.example.com , api.example.com Bearer secret"
	if r.Name != "goncini" || strings.Join(auths, ", ") != want {
		t.Errorf("got %v, %v", r, auths)
	}
	if req.Header != nil || req.URL.Host != "" {
		t.Errorf("Do changed the request: %v", req.URL)
	}
}

// TestHandlerTimeout checks that a handler slower than the timeout fails
// the request.
func TestHandlerTimeout(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		c := httpclient.New(httpclient.Config{Timeout: time.Second, Retries: -1})
		c.Transport = httpclient.Handler(http.HandlerFunc((w http.ResponseWriter, r *http.Request) => time.Sleep(time.Minute)))
		_, err := httpclient.Get[repo](context.Background(), c, "https://api.example.com/slow")
		if !errors.Is(err, context.DeadlineExceeded) {
			t.Errorf("got %v", err)
		}
		time.Sleep(time.Minute)
	})
}

// TestPublic checks that a client of Public doesn't connect to the
// loopback.
func TestPublic(t *testing.T) {
	srv := httptest.NewServer(http.HandlerFunc((w http.ResponseWriter, r *http.Request) => {}))
	defer srv.Close()
	c := httpclient.New(httpclient.Config{Retries: -1})
	c.Transport = httpclient.Public()
	req := must http.NewRequest(http.MethodGet, srv.URL, nil)
	if _, err := c.Do(req); err == nil || !strings.Contains(err.Error(), "127.0.0.1 isn't a public address") {
		t.Errorf("connected to the loopback: %v", err)
	}
}
