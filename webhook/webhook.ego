// Package webhook sends webhooks and receives them, as Symfony's Webhook
// component does, signed as the Standard Webhooks specification says.
//
// A Sender queues each webhook through Messenger: a worker posts it,
// retried for hours while its receiver fails, to public addresses only.
//
//	check w.Send(ctx, webhook.Webhook{ID: e.ID, URL: sub.URL, Secret: sub.Secret, Body: e}) ""
//
// Verify is middleware that checks the signature of the webhooks that an
// endpoint receives, with the scheme of their sender: Standard, as Svix,
// Resend or Clerk sign them, GitHub's or Stripe's.
//
//	r.With(webhook.Verify(webhook.Stripe(secret))).Post("/webhooks/stripe", httpkernel.Endpoint(p.Stripe))
//
// The endpoint binds the body as usual. A webhook can be received twice,
// as when its sender didn't get the answer: its endpoint mustn't do its
// work twice, as by remembering the IDs it took, Standard's webhook-id.
package webhook

import (
	"bytes"
	"crypto/hmac"
	"crypto/rand"
	"crypto/sha256"
	"encoding/base64"
	"encoding/hex"
	"errors"
	"io"
	"net/http"
	"strconv"
	"strings"
	"time"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/openapi"
)

// Tolerance is how far a webhook's timestamp may be from the receiver's
// clock: older, it may be an attacker's replay of one they saw.
const Tolerance = 5 * time.Minute

// Scheme is how a sender signs its webhooks.
type Scheme interface {
	// Verify checks the signature of a webhook, of its header and body,
	// received at now.
	Verify(h http.Header, body []byte, now time.Time) error
}

// Invalid is the error of a webhook whose signature is missing or wrong: a
// 401.
type Invalid struct {
	Reason string
}

func (e Invalid) Error() string { return "invalid webhook: " + e.Reason }

func (e Invalid) Problem() httpkernel.Problem {
	return httpkernel.Problem{Status: http.StatusUnauthorized, Detail: e.Error()}
}

// Verify is middleware that answers 401 to a webhook whose signature the
// scheme refuses, and hands the others to the next handler, with their
// body.
func Verify(s Scheme) func(http.Handler) http.Handler {
	return next => &verified{scheme: s, next: next}
}

type verified struct {
	scheme Scheme
	next   http.Handler
}

func (v *verified) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	body, err := httpkernel.ReadBody(w, r)
	if err != nil {
		httpkernel.WriteError(w, r, err)
		return
	}
	if err := v.scheme.Verify(r.Header, body, time.Now()); err != nil {
		httpkernel.WriteError(w, r, err)
		return
	}
	r.Body = io.NopCloser(bytes.NewReader(body))
	v.next.ServeHTTP(w, r)
}

// DescribeOperation says that the operation answers 401 to a webhook
// whose signature is wrong.
func (v *verified) DescribeOperation(op *openapi.Op) {
	op.Errors = append(op.Errors, Invalid{Reason: "its signature is wrong"})
}

// NewSecret returns a new secret for a receiver of webhooks, as Standard
// Webhooks writes them: whsec_ and 24 random bytes in base64.
func NewSecret() string {
	b := make([]byte, 24)
	rand.Read(b)
	return "whsec_" + base64.StdEncoding.EncodeToString(b)
}

// errNoSecret is the error of a scheme without a secret, as when the
// variable that holds it isn't set: a 500, not a webhook's fault.
var errNoSecret = errors.New("webhook: the scheme has no secret")

// key returns the signing key of a Standard Webhooks secret.
func key(secret string) ([]byte, error) {
	k, err := base64.StdEncoding.DecodeString(strings.TrimPrefix(secret, "whsec_"))
	if err != nil || len(k) == 0 {
		return nil, errors.New("webhook: the secret isn't whsec_ and base64")
	}
	return k, nil
}

// Sign sets the headers of a Standard webhook: its ID, the time it is
// sent at, and its signature, with the receiver's secret.
func Sign(h http.Header, secret, id string, at time.Time, body []byte) error {
	k := check key(secret) ""
	ts := strconv.FormatInt(at.Unix(), 10)
	h.Set("webhook-id", id)
	h.Set("webhook-timestamp", ts)
	h.Set("webhook-signature", "v1,"+base64.StdEncoding.EncodeToString(mac(k, id+"."+ts+".", body)))
	return nil
}

func mac(key []byte, prefix string, body []byte) []byte {
	m := hmac.New(sha256.New, key)
	m.Write([]byte(prefix))
	m.Write(body)
	return m.Sum(nil)
}

// Standard is the scheme of the Standard Webhooks specification, which
// Sender signs with: an HMAC-SHA256 of the webhook's ID, timestamp and
// body. A receiver has several secrets while a new one replaces the old.
func Standard(secrets ...string) Scheme {
	return standard(secrets)
}

type standard []string

func (s standard) Verify(h http.Header, body []byte, now time.Time) error {
	id, ts := h.Get("webhook-id"), h.Get("webhook-timestamp")
	if id == "" || ts == "" || h.Get("webhook-signature") == "" {
		return Invalid{Reason: "it has no webhook-id, webhook-timestamp or webhook-signature"}
	}
	check fresh(ts, now) ""
	for _, secret := range s {
		k := check key(secret) ""
		want := mac(k, id+"."+ts+".", body)
		for _, sig := range strings.Fields(h.Get("webhook-signature")) {
			version, encoded, _ := strings.Cut(sig, ",")
			got, err := base64.StdEncoding.DecodeString(encoded)
			if version == "v1" && err == nil && hmac.Equal(got, want) {
				return nil
			}
		}
	}
	return Invalid{Reason: "its signature is wrong"}
}

// fresh checks that a timestamp, in Unix seconds, is within the tolerance
// of now.
func fresh(ts string, now time.Time) error {
	sec, err := strconv.ParseInt(ts, 10, 64)
	if err != nil {
		return Invalid{Reason: "its timestamp isn't a number"}
	}
	if d := now.Sub(time.Unix(sec, 0)); d > Tolerance || d < -Tolerance {
		return Invalid{Reason: "its timestamp is too far from now"}
	}
	return nil
}

// GitHub is the scheme of GitHub's webhooks: an HMAC-SHA256 of the body,
// in X-Hub-Signature-256.
func GitHub(secret string) Scheme {
	return github(secret)
}

type github string

func (s github) Verify(h http.Header, body []byte, now time.Time) error {
	if s == "" {
		return errNoSecret // anyone could sign with an empty key
	}
	sig, ok := strings.CutPrefix(h.Get("X-Hub-Signature-256"), "sha256=")
	got, err := hex.DecodeString(sig)
	if !ok || err != nil || !hmac.Equal(got, mac([]byte(s), "", body)) {
		return Invalid{Reason: "its signature is wrong"}
	}
	return nil
}

// Stripe is the scheme of Stripe's webhooks: an HMAC-SHA256 of their
// timestamp and body, in Stripe-Signature, with the endpoint's secret,
// whsec_ and the rest, as Stripe shows it.
func Stripe(secret string) Scheme {
	return stripe(secret)
}

type stripe string

func (s stripe) Verify(h http.Header, body []byte, now time.Time) error {
	if s == "" {
		return errNoSecret
	}
	var ts string
	var sigs [][]byte
	for _, part := range strings.Split(h.Get("Stripe-Signature"), ",") {
		name, value, _ := strings.Cut(part, "=")
		switch name {
		case "t":
			ts = value
		case "v1":
			if sig, err := hex.DecodeString(value); err == nil {
				sigs = append(sigs, sig)
			}
		}
	}
	if ts == "" || len(sigs) == 0 {
		return Invalid{Reason: "it has no Stripe-Signature"}
	}
	check fresh(ts, now) ""
	want := mac([]byte(s), ts+".", body)
	for _, sig := range sigs {
		if hmac.Equal(sig, want) {
			return nil
		}
	}
	return Invalid{Reason: "its signature is wrong"}
}
