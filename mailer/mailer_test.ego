func welcome() *mime.Email {
	return &mime.Email{To: []mime.Address{{Email: "ann@example.com"}}, Bcc: []mime.Address{{Email: "audit@example.com"}}, Subject: "Welcome", Text: "Hi Ann."}
}

func TestSMTP(t *testing.T) {
	server := mailertest.NewServer(t)
	c := mailer.Config{DSN: server.DSN(), From: mime.Address{Name: "Conduit", Email: "hello@conduit.example"}}
	tr := must mailer.NewTransport(c, slog.New(slog.DiscardHandler))
	e := welcome()
	must mailer.New(c, tr).Send(context.Background(), e)
	if e.From.Email != "" {
		t.Errorf("Send changed the email's sender: %v", e.From)
	}
	got := server.Messages()
	if len(got) != 1 || got[0].From != "hello@conduit.example" || len(got[0].To) != 2 {
		t.Fatalf("received %+v", got)
	}
	msg := must mail.ReadMessage(bytes.NewReader(got[0].Data))
	if msg.Header.Get("Subject") != "Welcome" || msg.Header.Get("Bcc") != "" {
		t.Errorf("header %v", msg.Header)
	}
}

func TestDSNs(t *testing.T) {
	logger := slog.New(slog.DiscardHandler)
	for dsn, want := range map[string]string{
		"":                             "*mailer.LogTransport",
		"log://":                       "*mailer.LogTransport",
		"memory://":                    "*mailer.MemoryTransport",
		"null://":                      "mailer.NullTransport",
		"smtps://u:p@mail.example.com": "*mailer.SMTPTransport",
		"smtp://mail.example.com:2525": "*mailer.SMTPTransport",
	} {
		tr, err := mailer.NewTransport(mailer.Config{DSN: dsn}, logger)
		if err != nil || f"{tr:T}" != want {
			t.Errorf("%q: %T, %v", dsn, tr, err)
		}
	}
	tr := must mailer.NewTransport(mailer.Config{DSN: "smtps://u:p%40ss@mail.example.com"}, logger)
	smtp := tr.(*mailer.SMTPTransport)
	if smtp.Addr != "mail.example.com:465" || !smtp.TLS || smtp.Password != "p@ss" {
		t.Errorf("%+v", smtp)
	}
	for _, bad := range []string{"smtp://", "carrier-pigeon://x", "smtp://user:p@ss#w/rd@mail.example.com:587", "postmark+api://default", "mailgun+api://key@default", "mailjet+api://key@default", "pigeon+api://key@default"} {
		if _, err := mailer.NewTransport(mailer.Config{DSN: bad}, logger); err == nil {
			t.Errorf("%q: no error", bad)
		}
	}
}

// TestAPIs checks that the API transports send what the email has, and
// its Bcc, to their providers' endpoints, with their keys.
func TestAPIs(t *testing.T) {
	e := welcome()
	e.To[0].Name = "Ann"
	e.HTML = `<p>Hi Ann.</p><img src="cid:logo">`
	e.Parts = []mime.Part{{Name: "logo.png", Data: []byte("png"), ContentID: "logo"}}
	e.Header = map[string]string{"List-Unsubscribe": "<https://conduit.example/u>"}
	e.ReplyTo = []mime.Address{{Email: "support@conduit.example"}}
	for _, c := range []struct {
		dsn, url, header string
		want             []string // in the request's body, its JSON written again with sorted keys
	}{
		{"postmark+api://tok@default?message_stream=broadcast", "https://api.postmarkapp.com/email", "X-Postmark-Server-Token: tok", []string{
			`"Attachments":[{"Content":"cG5n","ContentID":"cid:logo","ContentType":"image/png","Name":"logo.png"}]`, `"Bcc":"audit@example.com"`,
			`"From":"\"Conduit\" <hello@conduit.example>"`, `"Headers":[{"Name":"List-Unsubscribe","Value":"<https://conduit.example/u>"}]`,
			`"HtmlBody":"<p>Hi Ann.</p><img src=\"cid:logo\">"`, `"MessageStream":"broadcast"`, `"Subject":"Welcome"`, `"TextBody":"Hi Ann."`, `"To":"\"Ann\" <ann@example.com>"`,
		}},
		{"sendgrid+api://SG.key@default?region=eu", "https://api.eu.sendgrid.com/v3/mail/send", "Authorization: Bearer SG.key", []string{
			`"attachments":[{"content":"cG5n","content_id":"logo","disposition":"inline","filename":"logo.png","type":"image/png"}]`,
			`"content":[{"type":"text/plain","value":"Hi Ann."},{"type":"text/html","value":"<p>Hi Ann.</p><img src=\"cid:logo\">"}]`,
			`"from":{"email":"hello@conduit.example","name":"Conduit"}`, `"headers":{"List-Unsubscribe":"<https://conduit.example/u>"}`,
			`"personalizations":[{"bcc":[{"email":"audit@example.com"}],"to":[{"email":"ann@example.com","name":"Ann"}]}]`,
		}},
		{"resend+api://re_key@default", "https://api.resend.com/emails", "Authorization: Bearer re_key", []string{
			`"attachments":[{"content":"cG5n","content_id":"logo","content_type":"image/png","filename":"logo.png"}]`, `"bcc":["audit@example.com"]`,
			`"from":"\"Conduit\" <hello@conduit.example>"`, `"text":"Hi Ann."`, `"to":["\"Ann\" <ann@example.com>"]`,
		}},
		{"mailgun+api://key:mg.conduit.example@default", "https://api.mailgun.net/v3/mg.conduit.example/messages.mime", "Authorization: Basic YXBpOmtleQ==", []string{
			`to=ann@example.com`, `to=audit@example.com`, "Subject: Welcome",
		}},
		{"brevo+api://xkeysib-1@default", "https://api.brevo.com/v3/smtp/email", "Api-Key: xkeysib-1", []string{
			`"attachment":[{"content":"cG5n","name":"logo.png"}]`, `"bcc":[{"email":"audit@example.com"}]`,
			`"headers":{"List-Unsubscribe":"<https://conduit.example/u>"}`, `"htmlContent":"<p>Hi Ann.</p><img src=\"cid:logo\">"`,
			`"replyTo":{"email":"support@conduit.example"}`, `"sender":{"email":"hello@conduit.example","name":"Conduit"}`,
			`"textContent":"Hi Ann."`, `"to":[{"email":"ann@example.com","name":"Ann"}]`,
		}},
		{"mailjet+api://key:secret@api.us.mailjet.com?sandbox=true", "https://api.us.mailjet.com/v3.1/send", "Authorization: Basic a2V5OnNlY3JldA==", []string{
			`"Bcc":[{"Email":"audit@example.com"}]`, `"From":{"Email":"hello@conduit.example","Name":"Conduit"}`,
			`"InlinedAttachments":[{"Base64Content":"cG5n","ContentID":"logo","ContentType":"image/png","Filename":"logo.png"}]`,
			`"ReplyTo":{"Email":"support@conduit.example"}`, `"TextPart":"Hi Ann."`, `"To":[{"Email":"ann@example.com","Name":"Ann"}]}]`, `"SandboxMode":true`,
		}},
		{"resend+api://re_key@proxy.example:8443", "https://proxy.example:8443/emails", "Authorization: Bearer re_key", nil},
	} {
		cfg := mailer.Config{DSN: c.dsn, From: mime.Address{Name: "Conduit", Email: "hello@conduit.example"}}
		tr := must mailer.NewTransport(cfg, slog.New(slog.DiscardHandler))
		var got *http.Request
		var body string
		h := http.HandlerFunc((w http.ResponseWriter, r *http.Request) => {
			got = r
			body = requestBody(t, r)
			w.Header().Set("Content-Type", "application/json")
			w.Write([]byte(`{"id":"1"}`))
		})
		switch api := tr.(type) {
		case *mailer.PostmarkTransport:
			api.Client.Transport = httpclient.Handler(h)
		case *mailer.SendGridTransport:
			api.Client.Transport = httpclient.Handler(h)
		case *mailer.ResendTransport:
			api.Client.Transport = httpclient.Handler(h)
		case *mailer.MailgunTransport:
			api.Client.Transport = httpclient.Handler(h)
		case *mailer.BrevoTransport:
			api.Client.Transport = httpclient.Handler(h)
		case *mailer.MailjetTransport:
			api.Client.Transport = httpclient.Handler(h)
		}
		must mailer.New(cfg, tr).Send(context.Background(), e)
		name, value, _ := strings.Cut(c.header, ": ")
		if got.Method != http.MethodPost || got.URL.String() != c.url || got.Header.Get(name) != value {
			t.Errorf("%s: %s %s, %s: %q", c.dsn, got.Method, got.URL, name, got.Header.Get(name))
		}
		for _, want := range c.want {
			if !strings.Contains(body, want) {
				t.Errorf("%s: %s lacks %s", c.dsn, body, want)
			}
		}
	}

	tr := must mailer.NewTransport(mailer.Config{DSN: "resend+api://re_key@default"}, slog.New(slog.DiscardHandler))
	tr.(*mailer.ResendTransport).Client.Transport = httpclient.Handler(http.HandlerFunc((w http.ResponseWriter, r *http.Request) => {
		w.WriteHeader(http.StatusUnprocessableEntity)
		w.Write([]byte(`{"message":"Invalid to field"}`))
	}))
	e.From = mime.Address{Email: "hello@conduit.example"}
	raw := must e.Bytes()
	err := tr.Send(context.Background(), "hello@conduit.example", []string{"ann@example.com"}, raw)
	if _, ok := errors.AsType[*httpclient.StatusError](err); !ok || !strings.Contains(err.Error(), "mailer: Resend: httpclient: 422 Unprocessable Entity: {\"message\":\"Invalid to field\"}") {
		t.Errorf("a refused email: %v", err)
	}

	tr = must mailer.NewTransport(mailer.Config{DSN: "mailjet+api://key:secret@default"}, slog.New(slog.DiscardHandler))
	e.ReplyTo = append(e.ReplyTo, mime.Address{Email: "sales@conduit.example"})
	raw = must e.Bytes()
	if err := tr.Send(context.Background(), "hello@conduit.example", []string{"ann@example.com"}, raw); err == nil || err.Error() != "mailer: Mailjet takes one Reply-To, not 2" {
		t.Errorf("two Reply-Tos: %v", err)
	}
}

// requestBody is the body of a request to an API: its JSON, written again
// with sorted keys and without escapes, or its form's fields and files.
func requestBody(t *testing.T, r *http.Request) string {
	if strings.HasPrefix(r.Header.Get("Content-Type"), "multipart/form-data") {
		must r.ParseMultipartForm(1 << 20)
		var b strings.Builder
		for _, to := range r.MultipartForm.Value["to"] {
			b.WriteString("to=" + to + "\n")
		}
		f := must r.MultipartForm.File["message"][0].Open()
		raw := must io.ReadAll(f)
		b.Write(raw)
		return b.String()
	}
	var v any
	must json.NewDecoder(r.Body).Decode(&v)
	var b bytes.Buffer
	enc := json.NewEncoder(&b)
	enc.SetEscapeHTML(false)
	must enc.Encode(v)
	return b.String()
}

// TestAsync checks that an Async mailer sends emails as messages, which a
// worker sends.
func TestAsync(t *testing.T) {
	c := mailer.Config{DSN: "memory://", From: mime.Address{Email: "hello@conduit.example"}}
	tr := must mailer.NewTransport(c, slog.New(slog.DiscardHandler))
	bus := messenger.NewBus(messenger.Config{}, messenger.NewMemoryTransports(messenger.Config{}), []messenger.Handlers{mailer.NewHandler(c, tr)}, slog.New(slog.DiscardHandler))
	ctx := context.Background()
	must mailer.NewAsync(c, bus).Send(ctx, welcome())
	memory := tr.(*mailer.MemoryTransport)
	if len(memory.Sent()) != 0 {
		t.Fatal("sent in the request")
	}
	w := &messenger.Worker{Bus: bus, Transports: []string{"async"}, Limit: 1}
	must w.Run(ctx)
	if sent := memory.Sent(); len(sent) != 1 || sent[0].To[0] != "ann@example.com" {
		t.Errorf("sent %+v", sent)
	}
}

// rawServer is an SMTP server that accepts the email, then stalls before
// answering its end if stall says so, or drops the connection on QUIT.
func rawServer(t *testing.T, stall bool) string {
	l := must net.Listen("tcp", "127.0.0.1:0")
	t.Cleanup(() => l.Close())
	go func() {
		conn, err := l.Accept()
		if err != nil {
			return
		}
		defer conn.Close()
		r := bufio.NewReader(conn)
		conn.Write([]byte("220 hi\r\n"))
		for {
			line, err := r.ReadString('\n')
			if err != nil {
				return
			}
			switch cmd := strings.ToUpper(strings.Fields(line + " x")[0]); cmd {
			case "DATA":
				conn.Write([]byte("354 go on\r\n"))
				for line != ".\r\n" {
					if line, err = r.ReadString('\n'); err != nil {
						return
					}
				}
				if stall {
					time.Sleep(3 * time.Second)
				}
				conn.Write([]byte("250 queued\r\n"))
			case "QUIT":
				return // dropped, without its 221
			default:
				conn.Write([]byte("250 ok\r\n"))
			}
		}
	}()
	return "smtp://" + l.Addr().String()
}

// TestSMTPFailures checks that an email the server accepted is sent, even
// if the server then drops the connection, and that a stalled server
// doesn't outlast the context.
func TestSMTPFailures(t *testing.T) {
	logger := slog.New(slog.DiscardHandler)
	send := func(dsn string, ctx context.Context) error {
		c := mailer.Config{DSN: dsn, From: mime.Address{Email: "hello@conduit.example"}}
		tr := must mailer.NewTransport(c, logger)
		return mailer.New(c, tr).Send(ctx, welcome())
	}
	if err := send(rawServer(t, false), context.Background()); err != nil {
		t.Errorf("an accepted email: %v", err)
	}
	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
	defer cancel()
	start := time.Now()
	err := send(rawServer(t, true), ctx)
	if !errors.Is(err, context.DeadlineExceeded) || time.Since(start) > time.Second {
		t.Errorf("a stalled server: %v after %v", err, time.Since(start))
	}
}
