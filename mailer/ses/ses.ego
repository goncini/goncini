// Package ses sends goncini's emails through Amazon SES's API, version 2,
// whose DSN is ses+api://default?region=eu-west-1:
//
//	var Services = layer.Set(ses.Async, …)
//
// in place of mailer.Async, or ses.Sync in place of mailer.Sync, so that
// mailer.Config's DSN can be SES's, and the others, such as log:// in
// development, or a mailertest server's in tests, are mailer's.
//
// The AWS SDK's default configuration gives the credentials, and the region
// if the DSN has none, from the environment, such as AWS_REGION, the
// shared files, or the role of the task or the instance; or an IAM user's
// keys are the DSN's, percent-encoded, as passwords are:
//
//	ses+api://ACCESS_KEY:SECRET_KEY@default?region=eu-west-1   and &session_token=… for a temporary key
//	ses+api://default?region=eu-west-1&configuration_set=NAME  sends with a configuration set, for its event destinations
//	ses+api://vpce-1.email.eu-west-1.vpce.amazonaws.com        another endpoint, over HTTPS, such as a VPC's
//
// SES sends the emails as mailer writes them, with their attachments and
// headers, to the envelope's recipients, which include the Bcc.
package ses

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/url"
	"strings"

	"github.com/aws/aws-sdk-go-v2/aws"
	"github.com/aws/aws-sdk-go-v2/config"
	"github.com/aws/aws-sdk-go-v2/credentials"
	"github.com/aws/aws-sdk-go-v2/service/sesv2"
	"github.com/aws/aws-sdk-go-v2/service/sesv2/types"
	"github.com/effect-go/effect-go/layer"

	"github.com/goncini/goncini/mailer"
)

// Sync is the providers of a mailer that sends emails when they're sent, as
// mailer.Sync's, which can send them through SES.
var Sync = layer.Set(NewTransport, mailer.New)

// Async is the providers of a mailer that sends emails through Messenger, as
// mailer.Async's, which can send them through SES.
var Async = layer.Set(NewTransport, mailer.NewHandler, mailer.NewAsync)

// NewTransport returns the transport of c.DSN: SES's for ses+api, and
// mailer's for the others.
func NewTransport(c mailer.Config, logger *slog.Logger) (mailer.Transport, error) {
	u, err := url.Parse(c.DSN)
	if err != nil || u.Scheme != "ses+api" {
		return mailer.NewTransport(c, logger)
	}
	if strings.Trim(u.Path, "/") != "" || u.Fragment != "" {
		return nil, errors.New("mailer: the ses+api DSN has more than a host and a query: percent-encode the @, # and / of its keys")
	}
	q := u.Query()
	var opts []func(*config.LoadOptions) error
	if region := q.Get("region"); region != "" {
		opts = append(opts, config.WithRegion(region))
	}
	if key := u.User.Username(); key != "" {
		secret, _ := u.User.Password()
		if secret == "" {
			return nil, errors.New("mailer: the ses+api DSN has an access key without its secret: ses+api://ACCESS_KEY:SECRET_KEY@default")
		}
		opts = append(opts, config.WithCredentialsProvider(credentials.NewStaticCredentialsProvider(key, secret, q.Get("session_token"))))
	}
	cfg := check config.LoadDefaultConfig(context.Background(), opts...) "mailer: the AWS configuration"
	if cfg.Region == "" {
		return nil, errors.New("mailer: the ses+api DSN has no region, nor has the AWS configuration: ?region=… or AWS_REGION")
	}
	client := sesv2.NewFromConfig(cfg, func(o *sesv2.Options) {
		if u.Host != "default" {
			o.BaseEndpoint = aws.String("https://" + u.Host)
		}
	})
	return &Transport{Client: client, ConfigurationSet: q.Get("configuration_set")}, nil
}

// Transport sends emails through SES's API, as they are written.
type Transport struct {
	// Client calls SES. Tests point it at a server of theirs.
	Client *sesv2.Client
	// ConfigurationSet is the configuration set to send with; empty means
	// the identity's default one, if it has one.
	ConfigurationSet string
}

func (t *Transport) Send(ctx context.Context, from string, to []string, raw []byte) error {
	in := &sesv2.SendEmailInput{
		FromEmailAddress: &from,
		Destination:      &types.Destination{ToAddresses: to},
		Content:          &types.EmailContent{Raw: &types.RawMessage{Data: raw}},
	}
	if t.ConfigurationSet != "" {
		in.ConfigurationSetName = &t.ConfigurationSet
	}
	if _, err := t.Client.SendEmail(ctx, in); err != nil {
		return fmt.Errorf("mailer: SES: %w", err)
	}
	return nil
}
