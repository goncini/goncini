// Package mailertest runs an SMTP server in a test, which keeps the emails
// it receives, so that a test sends them as the app would, over SMTP:
//
//	smtp := mailertest.NewServer(t)
//	t.Setenv("MAILER_DSN", smtp.DSN())
//	… // the app sends an email
//	msg := smtp.Messages()[0]
package mailertest

import (
	"bufio"
	"net"
	"net/textproto"
	"strings"
	"sync"
	"testing"
)

// Message is an email the server received.
type Message struct {
	From string
	To   []string
	Data []byte
}

// Server is an SMTP server on a local port.
type Server struct {
	ln       net.Listener
	mu       sync.Mutex
	messages []Message
	wg       sync.WaitGroup
}

// NewServer starts a server, which stops when the test ends.
func NewServer(t testing.TB) *Server {
	ln, err := net.Listen("tcp", "127.0.0.1:0")
	if err != nil {
		t.Fatal(err)
	}
	s := &Server{ln: ln}
	s.wg.Go(s.accept)
	t.Cleanup(() => {
		ln.Close()
		s.wg.Wait()
	})
	return s
}

// DSN is the mailer's DSN of the server.
func (s *Server) DSN() string {
	return "smtp://" + s.ln.Addr().String()
}

// Messages returns the emails received, in order.
func (s *Server) Messages() []Message {
	s.mu.Lock()
	defer s.mu.Unlock()
	return append([]Message(nil), s.messages...)
}

func (s *Server) accept() {
	for {
		conn, err := s.ln.Accept()
		if err != nil {
			return
		}
		s.wg.Go(() => s.serve(conn))
	}
}

// serve speaks enough SMTP to receive emails: no TLS, no authentication.
func (s *Server) serve(conn net.Conn) {
	defer conn.Close()
	r := textproto.NewReader(bufio.NewReader(conn))
	reply := (line string) => { conn.Write([]byte(line + "\r\n")) }
	reply("220 mailertest ready")
	var msg Message
	for {
		line, err := r.ReadLine()
		if err != nil {
			return
		}
		verb, arg, _ := strings.Cut(line, " ")
		switch strings.ToUpper(verb) {
		case "EHLO":
			reply("250-mailertest")
			reply("250 8BITMIME")
		case "HELO", "NOOP":
			reply("250 OK")
		case "MAIL":
			msg = Message{From: address(arg)}
			reply("250 OK")
		case "RCPT":
			msg.To = append(msg.To, address(arg))
			reply("250 OK")
		case "DATA":
			reply("354 go ahead")
			data, err := r.ReadDotBytes()
			if err != nil {
				return
			}
			msg.Data = data
			s.mu.Lock()
			s.messages = append(s.messages, msg)
			s.mu.Unlock()
			reply("250 OK")
		case "RSET":
			msg = Message{}
			reply("250 OK")
		case "QUIT":
			reply("221 bye")
			return
		default:
			reply("502 not implemented")
		}
	}
}

// address is the address in FROM:<a@example.com> or TO:<…>.
func address(arg string) string {
	_, a, _ := strings.Cut(arg, "<")
	a, _, _ = strings.Cut(a, ">")
	return a
}
