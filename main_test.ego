package goncini_test

import (
	"bytes"
	"context"
	"errors"
	"io"
	"log/slog"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"time"

	"go.opentelemetry.io/otel/trace"

	"github.com/goncini/goncini"
	"github.com/goncini/goncini/console"
	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/openapi"
	"github.com/goncini/goncini/routing"
)

// config is an app's config.
type config struct {
	HTTP goncini.HTTP
	DSN  string
}

// load is an app's config.Load: prod reads secrets.
func load(env *goncini.Env) config {
	c := config{HTTP: goncini.HTTP{ShutdownTimeout: 5 * time.Second}}
	match env.Name {
		"dev"  => c.DSN = "sqlite::memory:"
		"prod" => c.DSN = "postgres://app:" + env.Secret("DB_PASSWORD") + "@" + env.Secret("DB_HOST")
		_      => env.Unknown()
	}
	return c
}

// build is an app's Build, by hand.
func build(c goncini.HTTP, routes []routing.Routes, commands []console.Command) *goncini.App {
	logger := slog.New(slog.DiscardHandler)
	router := goncini.NewRouter(routes)
	kernel := must goncini.NewKernel(c, router, nil, nil, goncini.NewRenderer(), goncini.NewValidator(), logger)
	services := []goncini.Service{{Type: "*routing.Router", Provider: "goncini.NewRouter", Needs: []string{"[]routing.Routes"}}}
	doc := must goncini.NewOpenAPI(openapi.Config{Title: "Hello"}, router, kernel, openapi.Annotations{})
	return goncini.NewApp(kernel, goncini.NewServer(c, kernel, logger), router, commands, nil, services, logger, doc)
}

// routes registers a route.
type routes struct{}

func (routes) Routes(r *routing.Router) {
	r.Get("/hello", http.HandlerFunc((w http.ResponseWriter, r *http.Request) => {})).Name("hello")
}

func TestLoad(t *testing.T) {
	t.Setenv("DB_HOST", "db.internal")
	_, _, err := goncini.Load(t.TempDir(), "prod", load)
	if want := "missing secret DB_PASSWORD: set it in the environment, or in a .env file"; err == nil || err.Error() != want {
		t.Errorf("Load(prod) = %v", err)
	}
	t.Setenv("DB_PASSWORD", "s3cret")
	_, cfg := must goncini.Load(t.TempDir(), "prod", load)
	if cfg.DSN != "postgres://app:s3cret@db.internal" {
		t.Errorf("DSN = %q", cfg.DSN)
	}
	if _, _, err := goncini.Load(t.TempDir(), "staging", load); !errors.Is(err, goncini.UnknownEnv{Name: "staging"}) {
		t.Errorf("Load(staging) = %v", err)
	}
}

func TestRun(t *testing.T) {
	env := goncini.NewEnv("prod", map[string]string{"DB_PASSWORD": `s3"cret`, "DB_HOST": "db.internal"})
	cfg := load(env)
	greet := console.New("greet", "Greets", (ctx context.Context, out io.Writer, args []string) => {
		_, err := io.WriteString(out, "hello "+strings.Join(args, " "))
		return err
	})
	app := build(cfg.HTTP, []routing.Routes{routes{}}, []console.Command{greet})
	run := func(args ...string) (string, error) {
		var out bytes.Buffer
		err := goncini.Run(context.Background(), &out, env, cfg, app, args)
		return out.String(), err
	}

	for args, want := range map[string]string{
		"greet you all": "hello you all",
		"debug:container": "" +
			"SERVICE          PROVIDER           NEEDS\n" +
			"*routing.Router  goncini.NewRouter  []routing.Routes\n",
		"debug:router": "" +
			"NAME     METHOD  PATH           HANDLER\n" +
			"hello    GET     /hello         http.HandlerFunc\n" +
			"openapi  GET     /openapi.json  openapi.Handler\n",
		"openapi:dump": "" +
			"{\n" +
			"  \"openapi\": \"3.1.0\",\n" +
			"  \"info\": {\n" +
			"    \"title\": \"Hello\",\n" +
			"    \"version\": \"0.0.0\"\n" +
			"  },\n" +
			"  \"paths\": {}\n" +
			"}\n",
		"debug:config": "" +
			"{\n" +
			"  \"HTTP\": {\n" +
			"    \"ShutdownTimeout\": \"5s\"\n" +
			"  },\n" +
			"  \"DSN\": \"postgres://app:******@******\"\n" +
			"}\n",
	} {
		out, err := run(strings.Fields(args)...)
		if err != nil || out != want {
			t.Errorf("%s: %v\n%s\nwant:\n%s", args, err, out, want)
		}
	}

	// goncini's commands are there, next to the app's.
	list := must run("list")
	for _, name := range []string{"serve", "debug:router", "debug:config", "greet"} {
		if !strings.Contains(list, "\n"+name+" ") {
			t.Errorf("list doesn't have %s:\n%s", name, list)
		}
	}
	if _, err := run("nope"); !errors.Is(err, console.UnknownCommand{Name: "nope"}) {
		t.Errorf("nope: %v", err)
	}
	app.Commands = append(app.Commands, console.New("serve", "Serves", nil))
	if _, err := run("greet"); !errors.Is(err, console.Duplicate{Name: "serve"}) {
		t.Errorf("an app's serve: %v", err)
	}
}

func TestServe(t *testing.T) {
	app := build(goncini.HTTP{}, nil, nil)
	ctx, cancel := context.WithCancel(context.Background())
	cancel() // serve, then shut down at once
	var out bytes.Buffer
	if err := goncini.Run(ctx, &out, goncini.NewEnv("dev", nil), config{}, app, nil); err != nil {
		t.Errorf("serve: %v", err)
	}
	if app.Server.Addr != ":8080" {
		t.Errorf("Addr = %q", app.Server.Addr)
	}
	if err := goncini.Run(ctx, &out, goncini.NewEnv("dev", nil), config{}, app, []string{"serve", "-addr", "127.0.0.1:0"}); err != nil {
		t.Errorf("serve -addr: %v", err)
	}
	up := func(context.Context) error { return nil }
	down := func(context.Context) error { return errors.New("the database is down") }
	app.Checks = []goncini.Check{up, down}
	if err := goncini.Run(ctx, &out, goncini.NewEnv("dev", nil), config{}, app, nil); err == nil || err.Error() != "goncini: the app isn't ready to serve: the database is down" {
		t.Errorf("serve with a failing check: %v", err)
	}
	for _, args := range [][]string{{"serve", "-port", "1"}, {"serve", "now"}} {
		if err := goncini.Run(ctx, &out, goncini.NewEnv("dev", nil), config{}, app, args); !console.IsUsage(err) {
			t.Errorf("%q: %v", args, err)
		}
	}
}

func TestNewKernel(t *testing.T) {
	c := goncini.HTTP{TrustedProxies: []string{"10.0.0.0/8"}, TrustedHosts: []string{"api.example.com"}}
	app := build(c, []routing.Routes{routes{}}, nil)
	for host, want := range map[string]int{"api.example.com": 200, "evil.example": 400} {
		r := httptest.NewRequest(http.MethodGet, "http://"+host+"/hello", nil)
		rec := httptest.NewRecorder()
		app.Kernel.ServeHTTP(rec, r)
		if rec.Code != want {
			t.Errorf("%s: %d", host, rec.Code)
		}
	}
	// The app's middleware runs inside goncini's.
	var mw httpkernel.Middleware = (next http.Handler) => http.HandlerFunc((w http.ResponseWriter, r *http.Request) => {
		w.Header().Set("X-App", "1")
		next.ServeHTTP(w, r)
	})
	logger := slog.New(slog.DiscardHandler)
	k := must goncini.NewKernel(goncini.HTTP{TrustedHosts: []string{"api.example.com"}}, routing.New(), []httpkernel.Middleware{mw}, nil, nil, nil, logger)
	rec := httptest.NewRecorder()
	k.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "http://evil.example/", nil))
	if rec.Code != 400 || rec.Header().Get("X-App") != "" {
		t.Errorf("untrusted host: %d, X-App %q", rec.Code, rec.Header().Get("X-App"))
	}
	rec = httptest.NewRecorder()
	k.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "http://api.example.com/", nil))
	if rec.Header().Get("X-App") != "1" {
		t.Error("the app's middleware didn't run")
	}

	for _, c := range []goncini.HTTP{{TrustedProxies: []string{"lb.internal"}}, {TrustedHosts: []string{"api.example.com:443"}}} {
		if _, err := goncini.NewKernel(c, routing.New(), nil, nil, nil, nil, slog.New(slog.DiscardHandler)); err == nil {
			t.Errorf("NewKernel(%+v) accepted it", c)
		}
	}
}

func TestDebugContainerWithoutServices(t *testing.T) {
	var out bytes.Buffer
	app := build(goncini.HTTP{}, nil, nil)
	app.Services = nil
	must goncini.Run(context.Background(), &out, goncini.NewEnv("dev", nil), config{}, app, []string{"debug:container"})
	if out.String() != "no services are described: run goncini generate\n" {
		t.Errorf("debug:container: %q", out.String())
	}
}

// TestDebugConfigMasksStringsOnly masks a short secret in strings, where it
// may be part of a URL, but not in numbers.
func TestDebugConfigMasksStringsOnly(t *testing.T) {
	env := goncini.NewEnv("prod", map[string]string{"PIN": "5"})
	cfg := struct {
		Limit int
		URL   string
	}{Limit: 51, URL: "db://u:" + env.Secret("PIN") + "@h"}
	var out bytes.Buffer
	must goncini.Run(context.Background(), &out, env, cfg, build(goncini.HTTP{}, nil, nil), []string{"debug:config"})
	if want := "{\n  \"Limit\": 51,\n  \"URL\": \"db://u:******@h\"\n}\n"; out.String() != want {
		t.Errorf("debug:config:\n%s\nwant:\n%s", out.String(), want)
	}
}

// recorder is a slog.Handler that keeps the attributes of its records, as a
// logging library's handler would get them.
type recorder struct{ attrs map[string]string }

func (r *recorder) Enabled(context.Context, slog.Level) bool { return true }
func (r *recorder) WithAttrs([]slog.Attr) slog.Handler       { return r }
func (r *recorder) WithGroup(string) slog.Handler            { return r }
func (r *recorder) Handle(_ context.Context, rec slog.Record) error {
	rec.Attrs(a => {
		r.attrs[a.Key] = a.Value.String()
		return true
	})
	return nil
}

// TestLoggerOnAnotherHandler: an app's own handler gets the trace IDs.
func TestLoggerOnAnotherHandler(t *testing.T) {
	h := &recorder{attrs: map[string]string{}}
	tid := must trace.TraceIDFromHex("0102030405060708090a0b0c0d0e0f10")
	sid := must trace.SpanIDFromHex("0102030405060708")
	ctx := trace.ContextWithSpanContext(context.Background(), trace.NewSpanContext(trace.SpanContextConfig{TraceID: tid, SpanID: sid}))
	goncini.NewLogger(h).InfoContext(ctx, "hello", "k", "v")
	if h.attrs["k"] != "v" || h.attrs["trace_id"] != tid.String() || h.attrs["span_id"] != sid.String() {
		t.Errorf("attributes %v", h.attrs)
	}
}
