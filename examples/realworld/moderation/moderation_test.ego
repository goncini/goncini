package moderation_test

import (
	"testing"

	"github.com/goncini/goncini/webtest"

	"github.com/goncini/goncini/examples/realworld/app"
	"github.com/goncini/goncini/examples/realworld/config"
)

// moderatorKey is the key of .env.test.
const moderatorKey = "a test moderator's key that is long enough"

// TestModeration checks that moderators, with their key, may delete any
// article under /api/admin, and nowhere else, and that users may not.
func TestModeration(t *testing.T) {
	a := webtest.Boot(t, config.Load, app.Build)
	webtest.Run(t, a, "db:migrate")
	c := webtest.NewClient(t, a)
	var bob struct {
		User struct {
			Token string `json:"token"`
		} `json:"user"`
	}
	c.Post("/api/users", `{"user":{"username":"bob","email":"bob@example.com","password":"bob's password"}}`).Status(201).JSON(&bob)
	author := c.WithHeader("Authorization", "Token "+bob.User.Token)
	author.Post("/api/articles", `{"article":{"title":"Spam","description":"Spam","body":"Spam"}}`).Status(201)
	moderator := c.WithHeader("Authorization", "Bearer "+moderatorKey)

	author.Delete("/api/admin/articles/spam").Status(401) // a user's token isn't a moderator's key
	c.Delete("/api/admin/articles/spam").Status(401)      // no key
	moderator.Delete("/api/articles/spam").Status(401)    // the users' firewall doesn't know the key
	moderator.Delete("/api/admin/articles/spam").Status(204)
	c.Get("/api/articles/spam").Status(404)
}
