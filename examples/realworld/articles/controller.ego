package articles

import (
	"github.com/goncini/goncini/event"
	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/routing"
	"github.com/goncini/goncini/security"

	"github.com/goncini/goncini/examples/realworld/users"
)

// Articles serves the articles, their favorites, comments and tags.
type Articles struct {
	store  *Store
	access *security.Access
	events *event.Dispatcher
}

func NewArticles(store *Store, access *security.Access, events *event.Dispatcher) *Articles {
	return &Articles{store: store, access: access, events: events}
}

// Published is the event of an article published, for the features that
// care, such as notifications.
type Published struct {
	Slug     string
	AuthorID int64
}

// Routes registers the endpoints.
func (a *Articles) Routes(r *routing.Router) {
	r.Get("/articles", httpkernel.Endpoint(a.List)).Name("article_list")
	r.Get("/articles/{slug}", httpkernel.Endpoint(a.Show)).Name("article_show")
	r.Get("/articles/{slug}/comments", httpkernel.Endpoint(a.Comments)).Name("comment_list")
	r.Get("/tags", httpkernel.Endpoint(a.Tags)).Name("tag_list")
	auth := r.With(security.Required)
	auth.Get("/articles/feed", httpkernel.Endpoint(a.Feed)).Name("article_feed")
	auth.Post("/articles", httpkernel.Endpoint(a.Create)).Name("article_create")
	auth.Put("/articles/{slug}", httpkernel.Endpoint(a.Update)).Name("article_update")
	auth.Delete("/articles/{slug}", httpkernel.Endpoint(a.Delete)).Name("article_delete")
	auth.Post("/articles/{slug}/favorite", httpkernel.Endpoint(a.Favorite)).Name("article_favorite")
	auth.Delete("/articles/{slug}/favorite", httpkernel.Endpoint(a.Unfavorite)).Name("article_unfavorite")
	auth.Post("/articles/{slug}/comments", httpkernel.Endpoint(a.AddComment)).Name("comment_add")
	auth.Delete("/articles/{slug}/comments/{id<\\d+>}", httpkernel.Endpoint(a.DeleteComment)).Name("comment_delete")
}

// ArticleBody is an article, as the API sends it.
type ArticleBody struct {
	Article Article `json:"article"`
}

// ArticlesBody is a page of articles, with how many there are in all.
type ArticlesBody struct {
	Articles      []Summary `json:"articles"`
	ArticlesCount int       `json:"articlesCount"`
}

// Page is where a page of articles starts, and its size.
type Page struct {
	Limit  int `query:"limit" default:"20" validate:"min=1,max=100"` // how many articles, at most
	Offset int `query:"offset" validate:"min=0"`                     // how many articles to skip
}

type ListInput struct {
	Page
	Tag       string `query:"tag"`       // only the articles with this tag
	Author    string `query:"author"`    // only the articles of this author, a username
	Favorited string `query:"favorited"` // only the favorites of this user, a username
}

// List returns the articles that the filters select, newest first, without
// their bodies.
effect (a *Articles) List(in ListInput) (ArticlesBody, ArticleError) {
	f := Filter{Tag: in.Tag, Author: in.Author, Favorited: in.Favorited}
	list, count := check a.store.List(users.Viewer(ctx), f, in.Limit, in.Offset) as Unavailable
	return ArticlesBody{list, count}, nil
}

// Feed returns the articles of the authors that the authenticated user
// follows, newest first, without their bodies.
effect (a *Articles) Feed(in Page) (ArticlesBody, ArticleError) {
	viewer := users.Viewer(ctx)
	list, count := check a.store.List(viewer, Filter{FeedOf: viewer}, in.Limit, in.Offset) as Unavailable
	return ArticlesBody{list, count}, nil
}

type SlugInput struct {
	Slug string `path:"slug"`
}

// Show returns an article.
effect (a *Articles) Show(in SlugInput) (ArticleBody, ArticleError) {
	art := check a.find(in.Slug) ""
	return ArticleBody{art}, nil
}

// find returns the article with the slug, as the viewer sees it.
effect (a *Articles) find(slug string) (Article, ArticleError) {
	art, ok := check a.store.BySlug(users.Viewer(ctx), slug) as Unavailable
	if !ok {
		fail NoArticle{Slug: slug}
	}
	return art, nil
}

// findGranted returns the article with the slug, if the viewer may do
// attribute to it, as Authorship decides.
effect (a *Articles) findGranted(slug, attribute string) (Article, ArticleError) {
	art := check a.find(slug) ""
	if !a.access.IsGranted(ctx, attribute, art) {
		fail NotAuthor{Slug: slug}
	}
	return art, nil
}

type CreateInput struct {
	Body struct {
		Article struct {
			Title       string   `json:"title" validate:"required"`
			Description string   `json:"description" validate:"required"`
			Body        string   `json:"body" validate:"required"`
			TagList     []string `json:"tagList" validate:"dive,required"`
		} `json:"article"`
	}
}

// Create publishes an article, with a slug made of its title.
effect (a *Articles) Create(in CreateInput) (httpkernel.Created[ArticleBody], ArticleError) {
	b := in.Body.Article
	art := Article{Summary{Title: b.Title, Description: b.Description, AuthorID: users.Viewer(ctx)}, b.Body}
	slug := check a.store.Save(art, b.TagList ?? []string{}) as Unavailable
	created := check a.find(slug) ""
	check event.Dispatch(ctx, a.events, &Published{Slug: slug, AuthorID: created.AuthorID}) as Unavailable
	return httpkernel.Created[ArticleBody]{Body: ArticleBody{created}}, nil
}

type UpdateInput struct {
	SlugInput
	Body struct {
		Article struct {
			Title       httpkernel.Optional[string]   `json:"title"`
			Description httpkernel.Optional[string]   `json:"description"`
			Body        httpkernel.Optional[string]   `json:"body"`
			TagList     httpkernel.Optional[[]string] `json:"tagList"`
		} `json:"article"`
	}
}

// Validate refuses to clear what an article must have.
func (in *UpdateInput) Validate() error {
	b := in.Body.Article
	var vs []httpkernel.Violation
	for name, field := range map[string]httpkernel.Optional[string]{"title": b.Title, "description": b.Description, "body": b.Body} {
		if field.Set && (field.Null || field.Value == "") {
			vs = append(vs, httpkernel.Violation{Pointer: "#/article/" + name, Detail: "can't be blank"})
		}
	}
	if b.TagList.Null {
		vs = append(vs, httpkernel.Violation{Pointer: "#/article/tagList", Detail: "can't be null"})
	}
	if len(vs) > 0 {
		return httpkernel.Invalid(vs...)
	}
	return nil
}

// Update changes the values that the body has of an article that the
// authenticated user wrote. Its slug stays the same.
effect (a *Articles) Update(in UpdateInput) (ArticleBody, ArticleError) {
	art := check a.findGranted(in.Slug, "edit") ""
	b := in.Body.Article
	if b.Title.Set {
		art.Title = b.Title.Value
	}
	if b.Description.Set {
		art.Description = b.Description.Value
	}
	if b.Body.Set {
		art.Body = b.Body.Value
	}
	var tags []string // nil leaves the tags as they are
	if b.TagList.Set {
		tags = b.TagList.Value ?? []string{}
	}
	check a.store.Save(art, tags) as Unavailable
	updated := check a.find(art.Slug) ""
	return ArticleBody{updated}, nil
}

// Delete deletes an article: one the authenticated user wrote, or any for
// a moderator.
effect (a *Articles) Delete(in SlugInput) (httpkernel.NoContent, ArticleError) {
	art := check a.findGranted(in.Slug, "delete") ""
	check a.store.Delete(art.ID) as Unavailable
	return httpkernel.NoContent{}, nil
}

// Favorite adds an article to the authenticated user's favorites.
effect (a *Articles) Favorite(in SlugInput) (ArticleBody, ArticleError) {
	return a.favorite(in.Slug, true)
}

// Unfavorite removes an article from the authenticated user's favorites.
effect (a *Articles) Unfavorite(in SlugInput) (ArticleBody, ArticleError) {
	return a.favorite(in.Slug, false)
}

// favorite makes the viewer favorite the article with the slug, or not.
effect (a *Articles) favorite(slug string, favorite bool) (ArticleBody, ArticleError) {
	art := check a.find(slug) ""
	check a.store.Favorite(users.Viewer(ctx), art.ID, favorite) as Unavailable
	updated := check a.find(slug) ""
	return ArticleBody{updated}, nil
}

// TagsBody is every tag.
type TagsBody struct {
	Tags []string `json:"tags"`
}

// Tags returns every tag that an article has.
effect (a *Articles) Tags(in struct{}) (TagsBody, ArticleError) {
	tags := check a.store.Tags() as Unavailable
	return TagsBody{tags}, nil
}
