package articles_test

import (
	"testing"

	"github.com/goncini/goncini/webtest"

	"github.com/goncini/goncini/examples/realworld/app"
	"github.com/goncini/goncini/examples/realworld/config"
)

// TestCaching is M4's first gate: what anonymous readers see comes from the
// cache, without a query, until the articles change.
func TestCaching(t *testing.T) {
	a := webtest.Boot(t, config.Load, app.BuildTest)
	webtest.Run(t, a.App, "db:migrate")
	c := webtest.NewClient(t, a.App)
	var u struct {
		User struct {
			Token string `json:"token"`
		} `json:"user"`
	}
	c.Post("/api/users", `{"user":{"username":"bob","email":"bob@example.com","password":"a password"}}`).Status(201).JSON(&u)
	bob := c.WithHeader("Authorization", "Token "+u.User.Token)
	bob.Post("/api/articles", `{"article":{"title":"One","description":"d","body":"b","tagList":["go"]}}`).Status(201)

	c.Get("/api/tags").Status(200).Contains(`{"tags":["go"]}`)
	c.Get("/api/articles").Status(200).Contains(`"articlesCount":1`)
	// Behind the API's back: what the cache keeps doesn't change.
	must a.DB.Exec("INSERT INTO article_tags (article_id, position, tag) SELECT id, 1, 'hidden' FROM articles")
	must a.DB.Exec("UPDATE articles SET title = 'Changed'")
	c.Get("/api/tags").Status(200).Contains(`{"tags":["go"]}`)
	c.Get("/api/articles").Status(200).Contains(`"title":"One"`)
	bob.Get("/api/articles").Status(200).Contains(`"title":"Changed"`) // users aren't served from the cache

	// Through the API: the cache forgets.
	bob.Post("/api/articles", `{"article":{"title":"Two","description":"d","body":"b"}}`).Status(201)
	c.Get("/api/tags").Status(200).Contains(`"hidden"`)
	c.Get("/api/articles").Status(200).Contains(`"articlesCount":2`).Contains(`"title":"Changed"`)
	bob.Put("/api/user", `{"user":{"bio":"New bio"}}`).Status(200)
	c.Get("/api/articles").Status(200).Contains(`"bio":"New bio"`)
}
