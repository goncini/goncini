package articles

import (
	"context"
	"slices"

	"github.com/goncini/goncini/security"

	"github.com/goncini/goncini/examples/realworld/users"
)

// Authorship decides who may change articles and comments: their authors
// may edit and delete them, and moderators may delete them.
type Authorship struct{}

func NewAuthorship() Authorship { return Authorship{} }

// Vote grants "edit" and "delete" of an article or a comment to its
// author, and "delete" to a user with ROLE_MODERATOR.
func (Authorship) Vote(ctx context.Context, attribute string, subject any) security.Vote {
	var author int64
	switch s := subject.(type) {
	case Article:
		author = s.AuthorID
	case Comment:
		author = s.AuthorID
	default:
		return security.Abstain
	}
	if author == users.Viewer(ctx) {
		return security.Grant
	}
	if mod, ok := security.User[security.RoleHolder](ctx); ok && attribute == "delete" && slices.Contains(mod.Roles(), "ROLE_MODERATOR") {
		return security.Grant
	}
	return security.Deny
}
