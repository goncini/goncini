// Package conduit is what the RealWorld API's features share: its error
// format, {"errors": {"title": ["can't be blank"]}}, and the messages of
// its validation.
package conduit

import (
	"cmp"
	"errors"
	"net/http"
	"strings"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/security"
	"github.com/goncini/goncini/validator"
)

// Errors is RealWorld's error body: messages by field.
type Errors struct {
	Errors map[string][]string `json:"errors"`
}

// Problem returns the problem whose body is {"errors": {field: [message]}}.
func Problem(status int, field, message string) httpkernel.Problem {
	return httpkernel.Problem{
		Status:     status,
		Detail:     field + " " + message,
		Extensions: map[string]any{"errors": map[string][]string{field: {message}}},
	}
}

// Render writes problems as RealWorld's error bodies: the errors of a
// Problem made by Problem, or else one message per violation, by the last
// part of its pointer or by its parameter, or else the detail as the
// body's.
func Render(w http.ResponseWriter, r *http.Request, p httpkernel.Problem) {
	errs, _ := p.Extensions["errors"].(map[string][]string)
	if errs == nil {
		errs = map[string][]string{}
		for _, v := range p.Errors {
			field := v.Parameter + v.Header
			if v.Pointer != "" {
				field = v.Pointer[strings.LastIndexByte(v.Pointer, '/')+1:]
			}
			errs[field] = append(errs[field], v.Detail)
		}
	}
	if len(errs) == 0 {
		errs["body"] = []string{cmp.Or(p.Detail, http.StatusText(p.Status))}
	}
	status := if p.Status >= 400 && p.Status <= 599 { p.Status } else { http.StatusInternalServerError }
	for name, values := range p.Header {
		w.Header()[name] = values
	}
	httpkernel.WriteJSON(w, status, Errors{Errors: errs})
}

// NewRenderer provides Render, in place of goncini's problem+json.
func NewRenderer() httpkernel.Renderer {
	return Render
}

// NewValidator provides the validator with RealWorld's messages.
func NewValidator() httpkernel.Validator {
	return validator.New().Message("required", "can't be blank")
}

// AuthProblems gives security's failures RealWorld's bodies.
var AuthProblems = httpkernel.Map[security.AuthError](authProblem)

// authProblem is a 401 for err, an AuthError, with the WWW-Authenticate
// header of security's.
func authProblem(err error) httpkernel.Problem {
	p := Problem(http.StatusUnauthorized, "token", "is missing")
	if _, ok := errors.AsType[security.InvalidToken](err); ok {
		p = Problem(http.StatusUnauthorized, "token", "is invalid")
	}
	p.Header = httpkernel.ProblemFor(err).Header
	return p
}
