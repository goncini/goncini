package users

import (
	"strconv"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/routing"
	"github.com/goncini/goncini/security"
)

// Users serves the users and their profiles.
type Users struct {
	store  *Store
	hasher security.Hasher
	tokens *security.Tokens
}

func NewUsers(store *Store, hasher security.Hasher, tokens *security.Tokens) *Users {
	return &Users{store: store, hasher: hasher, tokens: tokens}
}

// Routes registers the endpoints.
func (u *Users) Routes(r *routing.Router) {
	r.Post("/users", httpkernel.Endpoint(u.Register)).Name("user_register")
	r.Post("/users/login", httpkernel.Endpoint(u.Login)).Name("user_login")
	r.Get("/profiles/{username}", httpkernel.Endpoint(u.Profile)).Name("profile_show")
	auth := r.With(security.Required)
	auth.Get("/user", httpkernel.Endpoint(u.Current)).Name("user_current")
	auth.Put("/user", httpkernel.Endpoint(u.Update)).Name("user_update")
	auth.Post("/profiles/{username}/follow", httpkernel.Endpoint(u.Follow)).Name("profile_follow")
	auth.Delete("/profiles/{username}/follow", httpkernel.Endpoint(u.Unfollow)).Name("profile_unfollow")
}

// UserBody is the user that a user sees, with a token.
type UserBody struct {
	User struct {
		Email    string  `json:"email"`
		Token    string  `json:"token"`
		Username string  `json:"username"`
		Bio      *string `json:"bio"`
		Image    *string `json:"image"`
	} `json:"user"`
}

// body returns what user sees of themselves, with a new token.
func (u *Users) body(user *User) (UserBody, error) {
	var b UserBody
	b.User.Token = check u.tokens.Issue(strconv.FormatInt(user.ID, 10)) ""
	b.User.Email, b.User.Username, b.User.Bio, b.User.Image = user.Email, user.Username, user.Bio, user.Image
	return b, nil
}

type RegisterInput struct {
	Body struct {
		User struct {
			Username string `json:"username" validate:"required"`
			Email    string `json:"email" validate:"required"`
			Password string `json:"password" validate:"required"`
		} `json:"user"`
	}
}

// Register registers a user, and returns them with a token.
effect (u *Users) Register(in RegisterInput) (httpkernel.Created[UserBody], UserError) {
	b := in.Body.User
	hash := check u.hasher.Hash(b.Password) as Unavailable
	user := &User{Username: b.Username, Email: b.Email, PasswordHash: hash}
	taken := check u.store.Save(user) as Unavailable
	if taken != "" {
		fail Taken{Field: taken}
	}
	body := check u.body(user) as Unavailable
	return httpkernel.Created[UserBody]{Body: body}, nil
}

type LoginInput struct {
	Body struct {
		User struct {
			Email    string `json:"email" validate:"required"`
			Password string `json:"password" validate:"required"`
		} `json:"user"`
	}
}

// Login returns the user with an email and a password, with a new token.
effect (u *Users) Login(in LoginInput) (UserBody, UserError) {
	user, ok := check u.store.ByEmail(in.Body.User.Email) as Unavailable
	if !ok {
		fail BadCredentials{}
	}
	valid := check u.hasher.Verify(user.PasswordHash, in.Body.User.Password) as Unavailable
	if !valid {
		fail BadCredentials{}
	}
	body := check u.body(user) as Unavailable
	return body, nil
}

// Current returns the authenticated user, with a new token.
effect (u *Users) Current(in struct{}) (UserBody, UserError) {
	body := check u.body(Current(ctx)) as Unavailable
	return body, nil
}

type UpdateInput struct {
	Body struct {
		User struct {
			Email    httpkernel.Optional[string] `json:"email"`
			Username httpkernel.Optional[string] `json:"username"`
			Password httpkernel.Optional[string] `json:"password"`
			Bio      httpkernel.Optional[string] `json:"bio"`
			Image    httpkernel.Optional[string] `json:"image"`
		} `json:"user"`
	}
}

// Validate refuses to clear what a user must have. A password has at least
// 8 characters, as NIST 800-63B says, and no other rule.
func (in *UpdateInput) Validate() error {
	b := in.Body.User
	var vs []httpkernel.Violation
	for name, field := range map[string]httpkernel.Optional[string]{"email": b.Email, "username": b.Username, "password": b.Password} {
		if field.Set && (field.Null || field.Value == "") {
			vs = append(vs, httpkernel.Violation{Pointer: "#/user/" + name, Detail: "can't be blank"})
		}
	}
	if b.Password.Present() && b.Password.Value != "" && len([]rune(b.Password.Value)) < 8 {
		vs = append(vs, httpkernel.Violation{Pointer: "#/user/password", Detail: "is too short (minimum is 8 characters)"})
	}
	if len(vs) > 0 {
		return httpkernel.Invalid(vs...)
	}
	return nil
}

// Update changes the authenticated user's values that the body has.
effect (u *Users) Update(in UpdateInput) (UserBody, UserError) {
	b := in.Body.User
	user := *Current(ctx)
	if b.Email.Set {
		user.Email = b.Email.Value
	}
	if b.Username.Set {
		user.Username = b.Username.Value
	}
	if b.Password.Set {
		user.PasswordHash = check u.hasher.Hash(b.Password.Value) as Unavailable
	}
	if b.Bio.Set {
		user.Bio = orNull(b.Bio)
	}
	if b.Image.Set {
		user.Image = orNull(b.Image)
	}
	taken := check u.store.Save(&user) as Unavailable
	if taken != "" {
		fail Taken{Field: taken}
	}
	body := check u.body(&user) as Unavailable
	return body, nil
}

// orNull returns the value of o, or nil for null and "".
func orNull(o httpkernel.Optional[string]) *string {
	return if o.Null || o.Value == "" { nil } else { &o.Value }
}

// ProfileBody is a profile, as the API sends it.
type ProfileBody struct {
	Profile Profile `json:"profile"`
}

type ProfileInput struct {
	Username string `path:"username"`
}

// Profile returns a user's profile.
effect (u *Users) Profile(in ProfileInput) (ProfileBody, UserError) {
	return u.profile(in.Username, nil)
}

// Follow makes the authenticated user follow another.
effect (u *Users) Follow(in ProfileInput) (ProfileBody, UserError) {
	follow := true
	return u.profile(in.Username, &follow)
}

// Unfollow makes the authenticated user stop following another.
effect (u *Users) Unfollow(in ProfileInput) (ProfileBody, UserError) {
	follow := false
	return u.profile(in.Username, &follow)
}

// profile returns the profile of the user with the username, as the viewer
// sees it, after following or unfollowing them if follow isn't nil.
effect (u *Users) profile(username string, follow *bool) (ProfileBody, UserError) {
	user, ok := check u.store.ByUsername(username) as Unavailable
	if !ok {
		fail NoProfile{Username: username}
	}
	viewer := Viewer(ctx)
	if follow != nil {
		check u.store.Follow(viewer, user.ID, *follow) as Unavailable
	}
	following := check u.store.Follows(viewer, user.ID) as Unavailable
	return ProfileBody{Profile{Username: user.Username, Bio: user.Bio, Image: user.Image, Following: following}}, nil
}
