package app

import (
	"database/sql"

	"github.com/goncini/goncini"
	"github.com/goncini/goncini/console"
	"github.com/goncini/goncini/db"
	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/routing"
	"github.com/goncini/goncini/security"

	"github.com/goncini/goncini/examples/realworld/articles"
	"github.com/goncini/goncini/examples/realworld/conduit"
	"github.com/goncini/goncini/examples/realworld/config"
	"github.com/goncini/goncini/examples/realworld/users"
)

// Autoconfigured hands goncini the app's services of each kind it uses, and
// each part of goncini its config section. goncini generate will write it.
var Autoconfigured = layer.Set(routes, problems, commands, checks, httpConfig, logConfig, dbConfig, securityConfig)

func routes(u *users.Users, a *articles.Articles) []routing.Routes {
	return []routing.Routes{routing.Prefix("/api", u, a)}
}

func problems() []httpkernel.ErrorMapper {
	return []httpkernel.ErrorMapper{users.Problems, articles.Problems, conduit.AuthProblems}
}

func commands(m db.Migrator) []console.Command { return db.Commands(m) }

func checks(pool *sql.DB) []goncini.Check { return []goncini.Check{pool.PingContext} }

func httpConfig(c config.Config) goncini.HTTP { return c.HTTP }

func logConfig(c config.Config) goncini.Log { return c.Log }

func dbConfig(c config.Config) db.Config { return c.DB }

func securityConfig(c config.Config) security.Config { return c.Security }
