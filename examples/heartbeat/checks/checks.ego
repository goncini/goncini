// Package checks is the checks: each expects its job to ping it every
// period, and goes down when a ping is later than its grace time, or when
// the job reports a failure. Going down, and back up, is a flip, which
// the channels alert of.
package checks

import (
	"net/http"
	"time"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/uid"
	"github.com/goncini/goncini/workflow"
)

// The statuses of a check: the places of its Lifecycle.
const (
	New    = "new" // not pinged since it was created, or resumed
	Up     = "up"
	Down   = "down"
	Paused = "paused" // its pings aren't expected
)

// Lifecycle is how a check's status changes: a ping brings it up, from any
// status, and a failure down; a late ping takes it down, by the sweep.
var Lifecycle = workflow.Definition{
	Name:    "check",
	Places:  []string{New, Up, Down, Paused},
	Initial: New,
	Transitions: []workflow.Transition{
		{Name: "ping", From: []string{New, Up, Down, Paused}, To: Up},
		{Name: "fail", From: []string{New, Up, Down, Paused}, To: Down},
		{Name: "expire", From: []string{Up}, To: Down},
		{Name: "pause", From: []string{New, Up, Down}, To: Paused},
		{Name: "resume", From: []string{Paused}, To: New},
	},
}

// NewWorkflows returns the app's workflows: the checks' lifecycle.
func NewWorkflows() (workflow.Registry, error) {
	lifecycle := check workflow.New(Lifecycle, nil, nil) ""
	return workflow.Registry{Lifecycle.Name: lifecycle}, nil
}

// Check is a check, as the API serves it.
type Check struct {
	ID        uid.UUID  `json:"id"` // and its ping URL's: /ping/{id}
	ProjectID uid.UUID  `json:"-"`
	Name      string    `json:"name"`
	Period    int       `json:"period"` // the seconds between pings
	Grace     int       `json:"grace"`  // the seconds a ping may be late by
	Status    string    `json:"status"` // new, up, down or paused
	LastPing  time.Time `json:"lastPing,omitzero"`
	StartedAt time.Time `json:"startedAt,omitzero"` // when the job's run started, if it runs
	DueAt     time.Time `json:"dueAt,omitzero"`     // when it goes down without a ping, if it is up
	CreatedAt time.Time `json:"createdAt"`
}

// due returns when c goes down without a ping, once its status is
// status: never, unless it is up.
func (c Check) due(status string) time.Time {
	if status != Up {
		return time.Time{}
	}
	return c.LastPing.Add(time.Duration(c.Period+c.Grace) * time.Second)
}

// Flipped is dispatched when a check goes down, or back up.
type Flipped struct {
	ID    uid.UUID // the flip's
	Check Check
	From  string
	At    time.Time
}

// flips reports whether a check moving from one status to another flips.
func flips(from, to string) bool {
	return to == Down && from != Down || from == Down && to == Up
}

// CheckError is everything the checks endpoints fail with.
error CheckError {
	NotFound{ ID uid.UUID } "no check {ID}"
	// Refused means that the lifecycle refused the transition: the check's
	// status doesn't allow it.
	Refused{ Cause error } "the transition is refused"
	// Unavailable means that the store failed.
	Unavailable{ Cause error } "the checks are unavailable"
}

// Problem says what each CheckError looks like over HTTP.
func Problem(err CheckError) httpkernel.Problem {
	return match err {
		nil            => httpkernel.Problem{}
		NotFound(e)    => httpkernel.Problem{Status: http.StatusNotFound, Detail: e.Error()}
		Refused(e)     => httpkernel.ProblemFor(e.Cause)
		Unavailable(_) => httpkernel.Problem{Status: http.StatusServiceUnavailable}
	}
}

// Problems is what the kernel registers to answer CheckErrors.
var Problems = httpkernel.Map[CheckError](Problem)
