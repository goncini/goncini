package channels

import (
	"context"
	"errors"
	"fmt"
	"time"

	"github.com/goncini/goncini/event"
	"github.com/goncini/goncini/mailer"
	"github.com/goncini/goncini/messenger"
	"github.com/goncini/goncini/mime"
	"github.com/goncini/goncini/scheduler"
	"github.com/goncini/goncini/uid"
	"github.com/goncini/goncini/webhook"

	"github.com/goncini/goncini/examples/heartbeat/checks"
)

// Alert is the message that alerts a project's channels of a flip, and the
// body of its webhooks.
type Alert struct {
	Flip    uid.UUID  `json:"flip"`
	Project uid.UUID  `json:"project"`
	Check   uid.UUID  `json:"check"`
	Name    string    `json:"name"`   // the check's
	Status  string    `json:"status"` // up or down
	At      time.Time `json:"at"`
}

// Subscriber queues an Alert for each flip, in the transaction that flips
// the check: the alert is sent only if the flip is saved.
type Subscriber struct {
	bus *messenger.Bus
}

func NewSubscriber(bus *messenger.Bus) *Subscriber {
	return &Subscriber{bus: bus}
}

func (s *Subscriber) Subscribe(d *event.Dispatcher) {
	event.On(d, func(ctx context.Context, e *checks.Flipped) error {
		return messenger.Dispatch(ctx, s.bus, Alert{Flip: e.ID, Project: e.Check.ProjectID, Check: e.Check.ID, Name: e.Check.Name, Status: e.Check.Status, At: e.At})
	})
}

// deliveriesKept is how long the deliveries are remembered: longer than an
// Alert is retried.
const deliveriesKept = 30 * 24 * time.Hour

// AlertHandler sends the alerts to the channels.
type AlertHandler struct {
	store    *Store
	mailer   *mailer.Mailer
	webhooks *webhook.Sender // on the bus it handles the alerts of
	now      func() time.Time
}

func NewAlertHandler(store *Store, m *mailer.Mailer, now func() time.Time) *AlertHandler {
	return &AlertHandler{store: store, mailer: m, now: now}
}

// Handlers registers the handler, and routes the alerts to the async
// queue. The handler sends the webhooks on the bus it is given: it can't
// take the bus, which takes the handlers.
func (h *AlertHandler) Handlers(b *messenger.Bus) {
	h.webhooks = webhook.NewSender(b)
	messenger.Handle(b, h.handle)
	messenger.Route[Alert](b, "async")
}

// Schedule forgets the old deliveries, every day.
func (h *AlertHandler) Schedule(s *scheduler.Scheduler) {
	s.Add("deliveries:prune", scheduler.Every(24*time.Hour), (ctx context.Context) => h.store.PruneDeliveries(ctx, h.now().Add(-deliveriesKept)))
}

// handle sends the alert to each of its project's channels. It fails if
// one fails, and is retried: the channels it was delivered to are skipped.
effect (h *AlertHandler) handle(m Alert) error {
	list := check h.store.All(m.Project)
	var errs []error
	for _, ch := range list {
		if err := h.deliver(ch, m); err != nil {
			errs = append(errs, fmt.Errorf("channel %s: %w", ch.ID, err))
		}
	}
	return errors.Join(errs...)
}

// deliver sends the alert to the channel, unless it was: an email, or a
// webhook, which its own message delivers, retried while its receiver
// fails, with the flip's ID, for the receiver to take it once.
effect (h *AlertHandler) deliver(ch Channel, m Alert) error {
	sent := check h.store.Delivered(m.Flip, ch.ID)
	if sent {
		return nil
	}
	match ch.Kind {
		Email => check h.email(ch, m)
		_     => check h.webhooks.Send(ctx, webhook.Webhook{ID: m.Flip.String(), URL: ch.Target, Secret: ch.Secret, Body: m}) ""
	}
	return h.store.AddDelivery(m.Flip, ch.ID, h.now())
}

// email sends the alert to the channel's address.
effect (h *AlertHandler) email(ch Channel, m Alert) error {
	return h.mailer.Send(ctx, &mime.Email{
		To:      []mime.Address{{Email: ch.Target}},
		Subject: f"{m.Name} is {m.Status}",
		Text:    f"The check {m.Name} is {m.Status}, since {m.At.Format(time.RFC1123)}.\n",
	})
}
