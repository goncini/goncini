// Package app wires the API: goncini's services, the app's own, and the
// config sections they take.
package app

import (
	"database/sql"
	"time"

	"github.com/pressly/goose/v3"
	_ "modernc.org/sqlite" // the "sqlite" database/sql driver

	"github.com/goncini/goncini/cache"
	"github.com/goncini/goncini/db"
	"github.com/goncini/goncini/db/goosedb"
	"github.com/goncini/goncini/hub"
	"github.com/goncini/goncini/lock"
	"github.com/goncini/goncini/mailer"
	"github.com/goncini/goncini/messenger"
	"github.com/goncini/goncini/profiler"
	"github.com/goncini/goncini/routing"
	"github.com/goncini/goncini/scheduler"
	"github.com/goncini/goncini/security"
	"github.com/goncini/goncini/webhook"

	"github.com/goncini/goncini/examples/heartbeat/channels"
	"github.com/goncini/goncini/examples/heartbeat/checks"
	"github.com/goncini/goncini/examples/heartbeat/home"
	"github.com/goncini/goncini/examples/heartbeat/migrations"
	"github.com/goncini/goncini/examples/heartbeat/projects"
)

// Services is the app's own services: add each new one here.
var Services = layer.Set(
	db.Open, db.NewSQL, migrator, clock, profiler.Layer,
	cache.Memory, mailer.Sync, messenger.SQL, lock.SQL, scheduler.New, webhook.Layer, hub.Memory,
	home.NewHome,
	projects.NewStore, projects.NewFirewall, projects.NewProjects, projects.NewCreateCommand,
	checks.NewStore, checks.NewWorkflows, checks.NewChecks, checks.NewPings, checks.NewAnnouncer,
	channels.NewStore, channels.NewChannels, channels.NewSubscriber, channels.NewAlertHandler,
	routes,
)

// routes serves the API under /api/v1, where a project's key authenticates
// it, and the jobs' pings and the home at the root.
func routes(fw *security.Firewall[*projects.Project], h *home.Home, pings *checks.Pings, p *projects.Projects, c *checks.Checks, ch *channels.Channels) []routing.Routes {
	return []routing.Routes{h, pings, routing.Prefix("/api/v1", routing.With(fw.Middleware, p, c, ch))}
}

// migrator runs the migrations with goose.
func migrator(pool *sql.DB) (db.Migrator, error) {
	return goosedb.New(pool, goose.DialectSQLite3, migrations.FS)
}

// clock is the app's clock: the system's. Tests change it with
// testing/synctest.
func clock() func() time.Time { return time.Now }
