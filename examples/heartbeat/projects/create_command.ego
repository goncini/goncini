package projects

import (
	"context"
	"flag"
	"fmt"
	"io"
	"time"

	"github.com/goncini/goncini/console"
	"github.com/goncini/goncini/uid"
)

// CreateCommand is the projects:create command, which creates a project
// and prints its key: the only time it is shown.
type CreateCommand struct {
	store *Store
	now   func() time.Time
	name  string
}

func NewCreateCommand(store *Store, now func() time.Time) *CreateCommand {
	return &CreateCommand{store: store, now: now}
}

func (*CreateCommand) Name() string    { return "projects:create" }
func (*CreateCommand) Summary() string { return "Creates a project, and prints its API key" }

func (c *CreateCommand) Flags(fs *flag.FlagSet) {
	fs.StringVar(&c.name, "name", "", "the project's name")
}

func (c *CreateCommand) Run(ctx context.Context, out io.Writer, args []string) error {
	if c.name == "" || len(args) > 0 {
		return console.Usage{Command: c.Name(), Reason: "-name names the project, and nothing follows"}
	}
	p := Project{ID: uid.NewV7(), Name: c.name, CreatedAt: c.now().UTC()}
	key := check c.store.Add(ctx, p) ""
	_, err := fmt.Fprintf(out, "Created %s, %s. Its API key, which isn't shown again:\n%s\n", p.Name, p.ID, key)
	return err
}
