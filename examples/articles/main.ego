// Command articles is a small API built with goncini, in the layout of
// goncini apps: an effect-go error set mapped to responses, typed
// endpoints, validation, named routes, config as code, and a server that
// shuts down gracefully.
//
//	go run .
//	curl -i localhost:8080/articles -H 'Content-Type: application/json' -d '{"title":"Hello","body":"First post"}'
//
// go run . list lists the commands, such as debug:router.
package main

import (
	"github.com/goncini/goncini"

	"github.com/goncini/goncini/examples/articles/app"
	"github.com/goncini/goncini/examples/articles/config"
)

func main() { goncini.Main(config.Load, app.Build) }
