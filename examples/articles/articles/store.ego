package articles

import (
	"context"
	"encoding/json/v2"
	"time"

	"github.com/goncini/goncini/db"
	"github.com/goncini/goncini/uid"
)

// Store keeps the articles in the database.
type Store struct {
	sql *db.SQL
}

func NewStore(s *db.SQL) *Store {
	return &Store{sql: s}
}

// columns are what scan reads.
const columns = "SELECT id, slug, title, body, tags, created_at, state FROM articles"

// List returns the articles with the tag if it isn't empty, sorted by
// order, an ORDER BY list, from offset and at most limit of them, and how
// many there are in all.
effect (s *Store) List(tag, order string, limit, offset int) ([]Article, int, error) {
	where, args := "", []any{}
	if tag != "" {
		where, args = " WHERE EXISTS (SELECT 1 FROM json_each(tags) WHERE value = ?)", []any{tag}
	}
	conn := s.sql.Conn(ctx)
	count := check db.Value[int](ctx, conn, "SELECT count(*) FROM articles"+where, args...)
	list := check db.All(ctx, conn, scan, columns+where+" ORDER BY "+order+", id LIMIT ? OFFSET ?", append(args, limit, offset)...)
	return list, count, nil
}

// Get returns the article with the slug, and reports whether there is one.
effect (s *Store) Get(slug string) (Article, bool, error) {
	return db.One(ctx, s.sql.Conn(ctx), scan, columns+" WHERE slug = ?", slug)
}

// ByID returns the article with the ID, and reports whether there is one.
effect (s *Store) ByID(id uid.UUID) (Article, bool, error) {
	return db.One(ctx, s.sql.Conn(ctx), scan, columns+" WHERE id = ?", id)
}

// Add adds an article, unless its slug is taken, and reports whether it
// did. Checking the slug and adding the article is one transaction, which
// Get takes part in.
effect (s *Store) Add(art Article) (bool, error) {
	added := false
	check s.sql.InTx(ctx, func(ctx context.Context) error {
		_, taken := check s.Get(art.Slug)
		if taken {
			return nil
		}
		tags := check json.Marshal(art.Tags) ""
		check s.sql.Conn(ctx).ExecContext(ctx, "INSERT INTO articles (id, slug, title, body, tags, created_at, state) VALUES (?, ?, ?, ?, ?, ?, ?)",
			art.ID, art.Slug, art.Title, art.Body, string(tags), art.CreatedAt.UnixMicro(), art.State)
		added = true
		return nil
	}) ""
	return added, nil
}

// SetState moves the article with the slug from the state from to the
// state to, and reports whether it was in from: one statement, which no
// other request can come between.
effect (s *Store) SetState(slug, from, to string) (bool, error) {
	res := check s.sql.Conn(ctx).ExecContext(ctx, "UPDATE articles SET state = ? WHERE slug = ? AND state = ?", to, slug, from)
	n := check res.RowsAffected()
	return n == 1, nil
}

// scan reads an article from a row.
func scan(row db.Scanner) (Article, error) {
	var art Article
	var tags string
	var created int64
	check row.Scan(&art.ID, &art.Slug, &art.Title, &art.Body, &tags, &created, &art.State) ""
	check json.Unmarshal([]byte(tags), &art.Tags) ""
	art.CreatedAt = time.UnixMicro(created).UTC()
	return art, nil
}
