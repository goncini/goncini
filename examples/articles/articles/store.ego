package articles

import (
	"context"
	"encoding/json/v2"
	"time"

	"github.com/goncini/goncini/db"
)

// Store keeps the articles in the database.
type Store struct {
	sql *db.SQL
}

func NewStore(s *db.SQL) *Store {
	return &Store{sql: s}
}

// List returns the newest articles first, at most limit of them, with the
// tag if it isn't empty, and how many there are in all.
effect (s *Store) List(tag string, limit int) ([]Article, int, error) {
	where, args := "", []any{}
	if tag != "" {
		where, args = " WHERE EXISTS (SELECT 1 FROM json_each(tags) WHERE value = ?)", []any{tag}
	}
	conn := s.sql.Conn(ctx)
	count := check db.Value[int](ctx, conn, "SELECT count(*) FROM articles"+where, args...)
	list := check db.All(ctx, conn, scan, "SELECT slug, title, body, tags, created_at FROM articles"+where+" ORDER BY created_at DESC LIMIT ?", append(args, limit)...)
	return list, count, nil
}

// Get returns the article with the slug, and reports whether there is one.
effect (s *Store) Get(slug string) (Article, bool, error) {
	return db.One(ctx, s.sql.Conn(ctx), scan, "SELECT slug, title, body, tags, created_at FROM articles WHERE slug = ?", slug)
}

// Add adds an article, unless its slug is taken, and reports whether it
// did. Checking the slug and adding the article is one transaction, which
// Get takes part in.
effect (s *Store) Add(art Article) (bool, error) {
	added := false
	check s.sql.InTx(ctx, func(ctx context.Context) error {
		_, taken := check s.Get(art.Slug)
		if taken {
			return nil
		}
		tags := check json.Marshal(art.Tags) ""
		check s.sql.Conn(ctx).ExecContext(ctx, "INSERT INTO articles (slug, title, body, tags, created_at) VALUES (?, ?, ?, ?, ?)",
			art.Slug, art.Title, art.Body, string(tags), art.CreatedAt.UnixMicro())
		added = true
		return nil
	}) ""
	return added, nil
}

// scan reads an article from a row.
func scan(row db.Scanner) (Article, error) {
	var art Article
	var tags string
	var created int64
	check row.Scan(&art.Slug, &art.Title, &art.Body, &tags, &created) ""
	check json.Unmarshal([]byte(tags), &art.Tags) ""
	art.CreatedAt = time.UnixMicro(created).UTC()
	return art, nil
}
