package articles_test

import (
	"context"
	"fmt"
	"strings"
	"testing"
	"time"

	"github.com/goncini/goncini"
	"github.com/goncini/goncini/listing"
	"github.com/goncini/goncini/routing"
	"github.com/goncini/goncini/uid"
	"github.com/goncini/goncini/webtest"

	"github.com/goncini/goncini/examples/articles/app"
	"github.com/goncini/goncini/examples/articles/articles"
	"github.com/goncini/goncini/examples/articles/config"
)

// boot builds the app as main does, in the test environment, with a clock
// that ticks a minute at each call, finer than the store keeps, and migrates its database: a new one
// in memory.
func boot(t *testing.T) *goncini.App {
	now := time.Date(2026, 10, 4, 9, 0, 0, 123456789, time.UTC)
	clock := func() time.Time { now = now.Add(time.Minute); return now }
	a := webtest.Boot(t, config.Load, (ctx context.Context, s *scope.Scope, cfg config.Config) => app.BuildTest(ctx, s, cfg, clock))
	webtest.Run(t, a, "db:migrate")
	return a
}

func TestArticlesAPI(t *testing.T) {
	c := webtest.NewClient(t, boot(t))

	var hello articles.Article
	c.Post("/articles", `{"title":"Hello, World!","body":"First","tags":["go"]}`).Status(201).
		HasHeader("Location", "/articles/hello-world").JSON(&hello)
	if hello.Slug != "hello-world" || hello.CreatedAt.IsZero() {
		t.Errorf("created %+v", hello)
	}
	c.Post("/articles", `{"title":"Second post","body":"Again"}`).Status(201).Contains(`"tags":[]`)
	c.Post("/articles", `{"title":"hello world","body":"Same slug"}`).Problem(409).HasDetail("an article hello-world already exists")

	var got articles.Article
	c.Get("/articles/hello-world").Status(200).JSON(&got)
	if !got.CreatedAt.Equal(hello.CreatedAt) || got.Title != "Hello, World!" {
		t.Errorf("got %+v, want %+v", got, hello)
	}
	c.Get("/articles/nope").Problem(404).HasDetail("no article nope")

	c.Get("/articles/" + hello.ID.String()).Status(200).Contains(`"slug":"hello-world"`)
	c.Get("/articles/" + uid.NewV7().String()).Problem(404)

	var list listing.Page[articles.Article]
	c.Get("/articles").Status(200).JSON(&list)
	if list.Total != 2 || list.Items[0].Slug != "second-post" {
		t.Errorf("list %+v", list)
	}
	c.Get("/articles?tag=go").Status(200).Contains(`"total":1`)
	c.Get("/articles?sort=title").Status(200).Contains(`{"items":[{"id":"` + hello.ID.String() + `"`)
	c.Get("/articles?limit=1&offset=1").Status(200).Contains(`"slug":"hello-world"`).
		HasHeader("Link", `</articles?limit=1&offset=0>; rel="first"`)
	c.Get("/articles?sort=body").Problem(400).Violation("sort", `is invalid: can't sort by "body": sort by createdAt, title`)
	c.Delete("/articles/hello-world").Problem(405).HasDetail("DELETE isn't allowed on /articles/hello-world")
}

func TestValidation(t *testing.T) {
	c := webtest.NewClient(t, boot(t))
	c.Post("/articles", `{"title":" ","body":""}`).Problem(422).
		Violation("#/title", "can't be blank").
		Violation("#/body", "can't be blank")
	c.Post("/articles", `{"title":"!?","body":"x"}`).Problem(422).Violation("#/title", "needs a letter or a digit")
	c.Post("/articles", `{"title":"Tags","body":"x","tags":["go",""]}`).Problem(422).Violation("#/tags/1", "is required")
	c.Post("/articles", `{"title":1}`).Problem(422)
	c.Get("/articles?limit=0").Problem(422).Violation("limit", "must be at least 1")
	c.Get("/articles?limit=all").Problem(400).Violation("limit", "must be an integer")
}

func TestCreatedLocation(t *testing.T) {
	c := webtest.NewClient(t, boot(t))
	for title, want := range map[string]string{
		"Go 1.27":    "/articles/go-1-27",
		"Café crème": "/articles/caf%C3%A9-cr%C3%A8me",
	} {
		loc := c.Post("/articles", map[string]string{"title": title, "body": "News"}).Status(201).HasHeader("Location", want).Header.Get("Location")
		c.Get(loc).Status(200).Contains(`"title":"` + title + `"`)
	}
}

func TestRoutes(t *testing.T) {
	var b strings.Builder
	must routing.WriteTable(&b, boot(t).Router.List())
	byID := "/articles/{id<" + routing.UUID + ">}"
	line := (name, method, path, handler string) => fmt.Sprintf("%-20s%-8s%-*s%s\n", name, method, len(byID)+2, path, handler)
	want := line("NAME", "METHOD", "PATH", "HANDLER") +
		line("article_list", "GET", "/articles", "articles.(*Articles).List") +
		line("article_show_by_id", "GET", byID, "articles.(*Articles).ShowByID") +
		line("article_show", "GET", "/articles/{slug}", "articles.(*Articles).Show") +
		line("article_create", "POST", "/articles", "articles.(*Articles).Create") +
		line("openapi", "GET", "/openapi.json", "openapi.Handler")
	if b.String() != want {
		t.Errorf("routes:\n%s\nwant:\n%s", b.String(), want)
	}
}
