package articles

import (
	"strings"
	"time"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/listing"
	"github.com/goncini/goncini/routing"
	"github.com/goncini/goncini/uid"
)

// Routes registers the endpoints, and keeps the route of an article to build
// its URL. Each effect method compiles to a func(ctx, In) (Out, error),
// which httpkernel.Endpoint serves.
func (a *Articles) Routes(r *routing.Router) {
	r.Get("/articles", httpkernel.Endpoint(a.List)).Name("article_list")
	r.Get("/articles/{id}", httpkernel.Endpoint(a.ShowByID)).Name("article_show_by_id").Require("id", routing.UUID)
	a.show = r.Get("/articles/{slug}", httpkernel.Endpoint(a.Show)).Name("article_show")
	r.Post("/articles", httpkernel.Endpoint(a.Create)).Name("article_create")
}

type ListInput struct {
	listing.Window
	Sort listing.Sort[Order] `query:"sort" default:"-createdAt"`
	Tag  string              `query:"tag"` // only the articles with this tag
}

// Order is what lists of articles can be sorted by.
type Order struct{}

func (Order) Fields() map[string]string {
	return map[string]string{"createdAt": "created_at", "title": "title"}
}

// List returns a page of the articles, the newest first unless the sort
// says otherwise, with the tag if one is given.
effect (a *Articles) List(in ListInput) (listing.Page[Article], ArticleError) {
	list, count := check a.store.List(in.Tag, in.Sort.SQL(), in.Limit, in.Offset) as Unavailable
	return listing.Page[Article]{Items: list, Total: count, Window: in.Window}, nil
}

type IDInput struct {
	ID uid.UUID `path:"id"`
}

// ShowByID returns the article with the ID.
effect (a *Articles) ShowByID(in IDInput) (Article, ArticleError) {
	art, ok := check a.store.ByID(in.ID) as Unavailable
	if !ok {
		fail NotFound{Slug: in.ID.String()}
	}
	return art, nil
}

type ShowInput struct {
	Slug string `path:"slug"`
}

effect (a *Articles) Show(in ShowInput) (Article, ArticleError) {
	art, ok := check a.store.Get(in.Slug) as Unavailable
	if !ok {
		fail NotFound{Slug: in.Slug}
	}
	return art, nil
}

type CreateInput struct {
	Body struct {
		Title string   `json:"title"`
		Body  string   `json:"body"`
		Tags  []string `json:"tags" validate:"max=5,dive,required"`
	}
}

// Validate checks what the validate tags can't express.
func (in *CreateInput) Validate() error {
	var vs []httpkernel.Violation
	if strings.TrimSpace(in.Body.Title) == "" {
		vs = append(vs, httpkernel.Violation{Pointer: "#/title", Detail: "can't be blank"})
	} else if slugify(in.Body.Title) == "" {
		vs = append(vs, httpkernel.Violation{Pointer: "#/title", Detail: "needs a letter or a digit"})
	}
	if strings.TrimSpace(in.Body.Body) == "" {
		vs = append(vs, httpkernel.Violation{Pointer: "#/body", Detail: "can't be blank"})
	}
	if len(vs) > 0 {
		return httpkernel.Invalid(vs...)
	}
	return nil
}

effect (a *Articles) Create(in CreateInput) (httpkernel.Created[Article], ArticleError) {
	// The store keeps times to the microsecond: so does the response.
	created := a.now().Truncate(time.Microsecond)
	art := Article{ID: uid.NewV7(), Slug: slugify(in.Body.Title), Title: in.Body.Title, Body: in.Body.Body, Tags: in.Body.Tags, CreatedAt: created}
	added := check a.store.Add(art) as Unavailable
	if !added {
		fail Duplicate{Slug: art.Slug}
	}
	// A URL that can't be built is a bug in this code, not in the request.
	loc := must a.show.URL(routing.Params{"slug": art.Slug})
	return httpkernel.Created[Article]{Location: loc, Body: art}, nil
}
