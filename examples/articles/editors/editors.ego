// Package editors authenticates the articles API's editors, by their API
// keys, sent as bearer tokens: they review articles, as the review
// workflow says. Other requests go through as anonymous.
package editors

import (
	"context"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/security"
)

// Config is the editors' API keys.
type Config struct {
	// Keys are the editors' names, by their keys.
	Keys map[string]string
}

// Editor is an editor, as their key names them.
type Editor struct {
	Name string
}

// Roles gives editors ROLE_EDITOR.
func (*Editor) Roles() []string { return []string{"ROLE_EDITOR"} }

// NewFirewall returns the firewall of the editors' keys.
func NewFirewall(c Config) (*security.Firewall[*Editor], error) {
	keys := check security.NewAPIKeys(c.Keys) ""
	return &security.Firewall[*Editor]{
		Tokens: keys,
		Load: func(ctx context.Context, name string) (*Editor, bool, error) {
			return &Editor{Name: name}, true, nil
		},
	}, nil
}

// NewMiddleware puts the firewall in the kernel.
func NewMiddleware(f *security.Firewall[*Editor]) []httpkernel.Middleware {
	return []httpkernel.Middleware{f.Middleware}
}
