// Package translations is the articles API's catalogs: its messages, and
// goncini's, in the languages it speaks besides English.
package translations

import "github.com/goncini/goncini/translation"

// All are the catalogs, by language.
func All() translation.Catalogs {
	return translation.Catalogs{"fr": French}
}

// French is the catalog of French.
var French = translation.Catalog{
	// Statuses, the problems' titles.
	"Bad Request":            "Requête invalide",
	"Not Found":              "Introuvable",
	"Method Not Allowed":     "Méthode non autorisée",
	"Conflict":               "Conflit",
	"Unprocessable Entity":   "Requête non traitable",
	"Service Unavailable":    "Service indisponible",
	"Internal Server Error":  "Erreur interne",
	"Unsupported Media Type": "Type de contenu non pris en charge",

	// Details.
	"no article {slug}":                "aucun article {slug}",
	"an article {slug} already exists": "un article {slug} existe déjà",
	"the request has invalid values":   "la requête a des valeurs invalides",
	"invalid request parameters":       "paramètres de requête invalides",
	"can't be blank":                   "ne peut pas être vide",
	"needs a letter or a digit":        "doit avoir une lettre ou un chiffre",
	"is required":                      "est obligatoire",
	"must be at least {n}":             "doit valoir au moins {n}",
	"must be at most {n}":              "doit valoir au plus {n}",
	"must have at most {n} {things}":   "doit avoir au plus {n} {things}",
	"must be an integer":               "doit être un entier",
	"{method} isn't allowed on {path}": "{method} n'est pas autorisé sur {path}",
}
