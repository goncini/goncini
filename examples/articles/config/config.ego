// Package config is the articles API's config: the values of every
// environment, then what each environment changes.
package config

import "github.com/goncini/goncini"

// Config is the articles API's config, one section per part of the app.
type Config struct {
	HTTP goncini.HTTP
	Log  goncini.Log
}

// Load returns the config of env. goncini's defaults suit every
// environment, so only the environments change it.
func Load(env *goncini.Env) Config {
	var c Config
	switch env.Name {
	case "dev":
		dev(&c)
	case "test":
		test(&c)
	case "prod":
		prod(&c)
	default:
		env.Unknown()
	}
	return c
}
