// Package maintenance is a bundle that takes an API down for maintenance:
// while it is down, every request but the maintenance status's is answered
// with 503 Service Unavailable, by every instance that sees the file that
// says so.
//
// It is an example of a third-party bundle, a package that plugs into a
// goncini app when its Layer joins the app's Services:
//
//	var Services = layer.Set(…, maintenance.Layer)
//
// Its services are a subscriber to the kernel's requests, routes and
// commands, which goncini generate hands to goncini by their types. It
// takes a Config, which the app's config may have as a section; when it
// has none, goncini generate gives it the default, its zero value.
package maintenance

import (
	"cmp"
	"context"
	"errors"
	"io/fs"
	"net/http"
	"os"
	"path/filepath"

	"github.com/effect-go/effect-go/layer"

	"github.com/goncini/goncini"
	"github.com/goncini/goncini/event"
	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/routing"
)

// Config configures the maintenance.
type Config struct {
	// File is the file whose existence means that the API is down; empty
	// means var/maintenance. A relative path is the app's project
	// directory's, as goncini.ProjectDir finds it.
	File string
	// Path is the maintenance status's path, which stays up; empty means
	// /_maintenance. It is the path as requests have it, under any prefix
	// that the app puts the routes under.
	Path string
}

// Layer is the bundle's providers.
var Layer = layer.Set(New, NewDown, NewUp)

// Maintenance takes the API down, and answers its requests while it is.
type Maintenance struct {
	file, path string
}

func New(c Config) *Maintenance {
	file := cmp.Or(c.File, filepath.Join("var", "maintenance"))
	if !filepath.IsAbs(file) {
		file = filepath.Join(goncini.ProjectDir(), file)
	}
	return &Maintenance{file: file, path: cmp.Or(c.Path, "/_maintenance")}
}

// IsDown reports whether the API is down for maintenance.
func (m *Maintenance) IsDown() bool {
	_, err := os.Stat(m.file)
	return err == nil
}

// SetDown takes the API down, or brings it back up.
func (m *Maintenance) SetDown(down bool) error {
	if !down {
		err := os.Remove(m.file)
		return if errors.Is(err, fs.ErrNotExist) { nil } else { err }
	}
	check os.MkdirAll(filepath.Dir(m.file), 0o755) ""
	return os.WriteFile(m.file, nil, 0o644)
}

// Subscribe answers the requests with 503 while the API is down, but the
// status's.
func (m *Maintenance) Subscribe(d *event.Dispatcher) {
	event.On(d, func(ctx context.Context, e *httpkernel.RequestEvent) error {
		if e.Request.URL.Path != m.path && m.IsDown() {
			return httpkernel.Problem{Status: http.StatusServiceUnavailable, Detail: "the API is down for maintenance"}
		}
		return nil
	})
}

// Routes registers the status.
func (m *Maintenance) Routes(r *routing.Router) {
	r.Get(m.path, httpkernel.Endpoint(m.Status)).Name("maintenance_status")
}

// Status is whether the API is down.
type Status struct {
	Down bool `json:"down"`
}

// Status says whether the API is down for maintenance.
effect (m *Maintenance) Status(in struct{}) (Status, error) {
	return Status{Down: m.IsDown()}, nil
}
