package maintenance

import (
	"context"
	"fmt"
	"io"
)

// Down is the maintenance:down command.
type Down struct{ m *Maintenance }

func NewDown(m *Maintenance) *Down { return &Down{m} }

func (*Down) Name() string    { return "maintenance:down" }
func (*Down) Summary() string { return "Takes the API down for maintenance" }

func (c *Down) Run(ctx context.Context, out io.Writer, args []string) error {
	check c.m.SetDown(true) ""
	_, err := fmt.Fprintln(out, "The API is down for maintenance.")
	return err
}

// Up is the maintenance:up command.
type Up struct{ m *Maintenance }

func NewUp(m *Maintenance) *Up { return &Up{m} }

func (*Up) Name() string    { return "maintenance:up" }
func (*Up) Summary() string { return "Brings the API back up after maintenance" }

func (c *Up) Run(ctx context.Context, out io.Writer, args []string) error {
	check c.m.SetDown(false) ""
	_, err := fmt.Fprintln(out, "The API is up.")
	return err
}
