package secrets_test

import (
	"os"
	"path/filepath"
	"strings"
	"testing"

	"github.com/goncini/goncini/secrets"
)

// TestVault checks that a vault opens what it sealed with its key only,
// and that one without its decryption key seals, but doesn't open.
func TestVault(t *testing.T) {
	dir := t.TempDir()
	must secrets.Generate(dir)
	if err := secrets.Generate(dir); err == nil {
		t.Error("a vault's keys are replaced")
	}
	v := must secrets.Open(dir, "")
	must v.Set("DATABASE_URL", "postgres://app:s3cret@db/app")
	must v.Set("API_KEY", "")
	if err := v.Set("not a name", "x"); err == nil {
		t.Error("a secret without a variable's name is sealed")
	}
	all := must v.All()
	if len(all) != 2 || all["DATABASE_URL"] != "postgres://app:s3cret@db/app" || all["API_KEY"] != "" {
		t.Errorf("secrets %q", all)
	}
	sealed := must os.ReadFile(filepath.Join(dir, "DATABASE_URL.secret"))
	if strings.Contains(string(sealed), "s3cret") {
		t.Error("the secret's file has its value")
	}

	// A secret's file renamed as another's doesn't open.
	must os.Rename(filepath.Join(dir, "DATABASE_URL.secret"), filepath.Join(dir, "API_KEY.secret"))
	if _, _, err := v.Get("API_KEY"); err == nil {
		t.Error("a renamed secret opens")
	}
	must v.Remove("API_KEY")
	names := must v.Names()
	if len(names) != 0 {
		t.Errorf("names %v", names)
	}

	// Without decrypt.key, as on a developer's machine for prod.
	key := must os.ReadFile(filepath.Join(dir, secrets.DecryptKey))
	must os.Remove(filepath.Join(dir, secrets.DecryptKey))
	locked := must secrets.Open(dir, "")
	must locked.Set("SMTP_PASSWORD", "hunter2")
	if _, _, err := locked.Get("SMTP_PASSWORD"); !locked.Locked() || err == nil {
		t.Error("a vault without its key opens a secret")
	}
	server := must secrets.Open(dir, string(key)) // GONCINI_DECRYPTION_KEY's
	value, ok := must server.Get("SMTP_PASSWORD")
	if !ok || value != "hunter2" {
		t.Errorf("SMTP_PASSWORD = %q, %v", value, ok)
	}

	// Rotating seals the secrets again, with keys that the old one isn't.
	must server.Rotate()
	if _, err := secrets.Open(dir, string(key)); err == nil {
		t.Error("the old key opens the vault")
	}
	rotated := must secrets.Open(dir, "")
	value, ok = must rotated.Get("SMTP_PASSWORD")
	if !ok || value != "hunter2" {
		t.Errorf("after the rotation, SMTP_PASSWORD = %q, %v", value, ok)
	}
}
