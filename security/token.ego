package security

import (
	"cmp"
	"crypto/sha256"
	"errors"
	"fmt"
	"time"

	"github.com/golang-jwt/jwt/v5"
)

// Config configures tokens and the firewall.
type Config struct {
	// Secret signs the tokens: at least 32 bytes, read with
	// env.Secret("APP_SECRET"). Changing it invalidates every token.
	Secret string
	// TTL is how long a token is valid; zero means 24 hours.
	TTL time.Duration
	// Issuer is written in the tokens and required of them; empty means
	// none.
	Issuer string
	// Scheme is the scheme of the Authorization header, as in
	// "Authorization: Bearer <token>"; empty means Bearer.
	Scheme string
	// RoleHierarchy gives roles the roles they include, for Access:
	// {"ROLE_ADMIN": {"ROLE_MODERATOR"}}.
	RoleHierarchy map[string][]string
}

// Verifier verifies tokens: it returns the subject that a token names, or
// fails with InvalidToken. Tokens and APIKeys are verifiers.
type Verifier interface {
	Verify(token string) (subject string, err error)
}

// Tokens issues and verifies signed tokens, JWTs signed with HMAC-SHA256,
// that name a user.
type Tokens struct {
	secret []byte
	ttl    time.Duration
	issuer string
}

// NewTokens returns the tokens that c configures.
func NewTokens(c Config) (*Tokens, error) {
	if len(c.Secret) < 32 {
		return nil, errors.New("security: Config.Secret has fewer than 32 bytes")
	}
	return &Tokens{secret: []byte(c.Secret), ttl: cmp.Or(c.TTL, 24*time.Hour), issuer: c.Issuer}, nil
}

// Issue returns a token for the user that subject identifies, such as its
// ID, valid for the TTL.
func (t *Tokens) Issue(subject string) (string, error) {
	now := time.Now()
	claims := jwt.RegisteredClaims{
		Subject:   subject,
		Issuer:    t.issuer,
		IssuedAt:  jwt.NewNumericDate(now),
		ExpiresAt: jwt.NewNumericDate(now.Add(t.ttl)),
	}
	return jwt.NewWithClaims(jwt.SigningMethodHS256, claims).SignedString(t.secret)
}

// Verify returns the subject of token, if Tokens issued it and it hasn't
// expired. Its errors are InvalidToken cases, without a scheme.
func (t *Tokens) Verify(token string) (string, error) {
	opts := []jwt.ParserOption{jwt.WithValidMethods([]string{"HS256"}), jwt.WithExpirationRequired()}
	if t.issuer != "" {
		opts = append(opts, jwt.WithIssuer(t.issuer))
	}
	var claims jwt.RegisteredClaims
	_, err := jwt.ParseWithClaims(token, &claims, func(*jwt.Token) (any, error) { return t.secret, nil }, opts...)
	switch {
	case errors.Is(err, jwt.ErrTokenExpired):
		fail InvalidToken{Reason: "it has expired"}
	case err != nil:
		fail InvalidToken{Reason: "it isn't one of the API's"}
	case claims.Subject == "":
		fail InvalidToken{Reason: "it names no user"}
	}
	return claims.Subject, nil
}

// APIKeys verifies API keys, secrets that machine clients send as tokens,
// each naming a subject. It keeps their SHA-256 hashes, and looks keys up
// by them: the time a lookup takes says nothing of the keys.
type APIKeys struct {
	subjects map[[sha256.Size]byte]string
}

// NewAPIKeys returns the verifier of keys, a map from each key to the
// subject it names. Keys must have at least 32 bytes, as random as the
// app's secret: read them with env.Secret.
func NewAPIKeys(keys map[string]string) (*APIKeys, error) {
	k := &APIKeys{subjects: map[[sha256.Size]byte]string{}}
	for key, subject := range keys {
		if len(key) < 32 {
			return nil, fmt.Errorf("security: the API key of %q has fewer than 32 bytes", subject)
		}
		k.subjects[sha256.Sum256([]byte(key))] = subject
	}
	return k, nil
}

// Verify returns the subject of key, or fails with InvalidToken.
func (k *APIKeys) Verify(key string) (string, error) {
	subject, ok := k.subjects[sha256.Sum256([]byte(key))]
	if !ok {
		fail InvalidToken{Reason: "it isn't one of the API's keys"}
	}
	return subject, nil
}
