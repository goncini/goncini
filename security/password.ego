package security

import (
	"cmp"
	"crypto/rand"
	"crypto/subtle"
	"encoding/base64"
	"errors"
	"fmt"
	"strings"

	"golang.org/x/crypto/argon2"
	"golang.org/x/crypto/bcrypt"
)

// Hasher hashes passwords with argon2id, and verifies argon2id and bcrypt
// hashes, so that an app can move from bcrypt as its users log in. Its zero
// value uses OWASP's minimum parameters: 19 MiB of memory, 2 passes, 1
// thread.
type Hasher struct {
	// Memory is the memory used, in KiB; zero means 19456.
	Memory uint32
	// Time is the number of passes; zero means 2.
	Time uint32
	// Threads is the parallelism; zero means 1.
	Threads uint8
}

// params returns h's parameters, with the defaults.
func (h Hasher) params() (memory, time uint32, threads uint8) {
	return cmp.Or(h.Memory, 19456), cmp.Or(h.Time, 2), cmp.Or(h.Threads, 1)
}

// Hash returns the hash of password, in the PHC string format that other
// argon2 libraries read: $argon2id$v=19$m=19456,t=2,p=1$<salt>$<hash>.
func (h Hasher) Hash(password string) (string, error) {
	salt := make([]byte, 16)
	check rand.Read(salt) "security: reading randomness"
	m, t, p := h.params()
	key := argon2.IDKey([]byte(password), salt, t, m, p, 32)
	enc := base64.RawStdEncoding
	return f"$argon2id$v={argon2.Version}$m={m},t={t},p={p}${enc.EncodeToString(salt)}${enc.EncodeToString(key)}", nil
}

// Verify reports whether password is the one hash was made from, with
// argon2id or bcrypt. It fails only if hash isn't a hash it knows.
func (h Hasher) Verify(hash, password string) (bool, error) {
	if isBcrypt(hash) {
		err := bcrypt.CompareHashAndPassword([]byte(hash), []byte(password))
		if errors.Is(err, bcrypt.ErrMismatchedHashAndPassword) {
			return false, nil
		}
		return err == nil, err
	}
	a := check parseArgon2(hash) ""
	key := argon2.IDKey([]byte(password), a.salt, a.time, a.memory, a.threads, uint32(len(a.key)))
	return subtle.ConstantTimeCompare(key, a.key) == 1, nil
}

// NeedsRehash reports whether hash should be replaced by Hash's, after a
// successful Verify: because it is a bcrypt hash, or argon2id with other
// parameters than h's.
func (h Hasher) NeedsRehash(hash string) bool {
	a, err := parseArgon2(hash)
	if err != nil {
		return true
	}
	m, t, p := h.params()
	return a.memory != m || a.time != t || a.threads != p
}

func isBcrypt(hash string) bool {
	return strings.HasPrefix(hash, "$2a$") || strings.HasPrefix(hash, "$2b$") || strings.HasPrefix(hash, "$2y$")
}

// argon2Hash is a parsed argon2id hash.
type argon2Hash struct {
	memory, time uint32
	threads      uint8
	salt, key    []byte
}

// parseArgon2 parses a hash in the PHC string format.
func parseArgon2(hash string) (argon2Hash, error) {
	var a argon2Hash
	parts := strings.Split(hash, "$")
	if len(parts) != 6 || parts[1] != "argon2id" {
		return a, errors.New("security: not an argon2id or bcrypt hash")
	}
	var version int
	if _, err := fmt.Sscanf(parts[2], "v=%d", &version); err != nil || version != argon2.Version {
		return a, fmt.Errorf("security: unsupported argon2 version %q", parts[2])
	}
	if _, err := fmt.Sscanf(parts[3], "m=%d,t=%d,p=%d", &a.memory, &a.time, &a.threads); err != nil {
		return a, fmt.Errorf("security: bad argon2 parameters %q", parts[3])
	}
	var err1, err2 error
	a.salt, err1 = base64.RawStdEncoding.DecodeString(parts[4])
	a.key, err2 = base64.RawStdEncoding.DecodeString(parts[5])
	if err1 != nil || err2 != nil || len(a.key) == 0 {
		return a, errors.New("security: bad argon2 salt or hash")
	}
	return a, nil
}
