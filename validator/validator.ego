// Package validator checks httpkernel.Endpoint inputs against their
// validate struct tags, with go-playground/validator: Symfony's Validator
// constraints, as tags.
//
//	type CreateInput struct {
//		Body struct {
//			Title string   `json:"title" validate:"required,max=120"`
//			Tags  []string `json:"tags" validate:"max=10,dive,required"`
//		}
//		Draft bool `query:"draft"`
//	}
//
// A Validator is an httpkernel.Validator: a kernel with one answers an
// invalid input with a 422 problem that lists every failing value, pointing
// at it in the body (#/title) or naming its parameter or header. Rules that
// involve several fields, or the app's data, belong in the input's Validate
// method, which runs once the tags hold.
package validator

import (
	"context"
	"errors"
	"reflect"
	"strings"

	playground "github.com/go-playground/validator/v10"

	"github.com/goncini/goncini/httpkernel"
)

// Validator checks inputs against their validate tags.
type Validator struct {
	rules    *playground.Validate
	messages map[string]string
}

// New returns a validator with go-playground/validator's rules, as
// documented at https://pkg.go.dev/github.com/go-playground/validator/v10.
func New() *Validator {
	rules := playground.New(playground.WithRequiredStructEnabled())
	rules.RegisterTagNameFunc(fieldName)
	return &Validator{rules: rules}
}

// Message replaces the detail of the violations of a rule, such as
// required, by detail, and returns v:
//
//	validator.New().Message("required", "can't be blank")
func (v *Validator) Message(rule, detail string) *Validator {
	if v.messages == nil {
		v.messages = map[string]string{}
	}
	v.messages[rule] = detail
	return v
}

// Rules returns the underlying go-playground validator, to register rules
// of the app's own with RegisterValidation.
func (v *Validator) Rules() *playground.Validate {
	return v.rules
}

// Validate checks in, a struct or a pointer to one, against its validate
// tags. It returns httpkernel.Invalid with a violation per failing value, or
// the error of a tag that doesn't parse.
func (v *Validator) Validate(ctx context.Context, in any) error {
	err := v.rules.StructCtx(ctx, in)
	var failures playground.ValidationErrors
	if !errors.As(err, &failures) {
		return err
	}
	violations := make([]httpkernel.Violation, len(failures))
	for i, f := range failures {
		violations[i] = violation(f, v.messages[f.Tag()] ?? detailOf(f))
	}
	return httpkernel.Invalid(violations...)
}

// A field that isn't a JSON member is named source:name behind a marker,
// which JSON names can't start with: query:limit, header:X-Version, or
// -:Field for a field that isn't in the request.
const marker = "\x00"

// fieldName is the name of a field in violations: its JSON member name, or
// else its source and its name there.
func fieldName(f reflect.StructField) string {
	for _, source := range []string{"path", "query", "header"} {
		if tag, ok := f.Tag.Lookup(source); ok {
			name, _, _ := strings.Cut(tag, ",")
			return marker + source + ":" + name
		}
	}
	name, _, _ := strings.Cut(f.Tag.Get("json"), ",")
	return match name {
		"-" => marker + "-:" + f.Name
		""  => f.Name
		_   => name
	}
}

// violation is where f failed, with the detail.
func violation(f playground.FieldError, detail string) httpkernel.Violation {
	segments := strings.Split(f.Namespace(), ".")[1:] // without the input's type
	for _, s := range segments {
		named, ok := strings.CutPrefix(s, marker)
		if !ok {
			continue
		}
		source, name, _ := strings.Cut(named, ":")
		return match source {
			"header" => httpkernel.Violation{Header: name, Detail: detail}
			"-"      => httpkernel.Violation{Detail: name + " " + detail} // where the request can't point
			_        => httpkernel.Violation{Parameter: name, Detail: detail}
		}
	}
	if len(segments) > 0 && segments[0] == "Body" {
		segments = segments[1:]
	}
	return httpkernel.Violation{Pointer: pointer(segments), Detail: detail}
}

// pointer is the JSON Pointer, as a URI fragment, of a value named by
// go-playground namespace segments such as tags[0].
func pointer(segments []string) string {
	var b strings.Builder
	b.WriteString("#")
	escape := strings.NewReplacer("~", "~0", "/", "~1")
	for _, s := range segments {
		name, index, _ := strings.Cut(s, "[")
		if name != "" {
			b.WriteString("/" + escape.Replace(name))
		}
		for index != "" {
			key, rest, _ := strings.Cut(index, "]")
			b.WriteString("/" + escape.Replace(key))
			index = strings.TrimPrefix(rest, "[")
		}
	}
	return b.String()
}

// detailOf says what is wrong with the value, for the common rules.
func detailOf(f playground.FieldError) string {
	p := f.Param()
	kind := f.Kind()
	size := match kind {
		reflect.String                            => "characters"
		reflect.Slice, reflect.Array, reflect.Map => "items"
		_                                         => ""
	}
	return match f.Tag() {
		"required", "required_if", "required_unless", "required_with", "required_without" => "is required"
		"min", "gte"                                                                      => if size != "" { f"must have at least {p} {size}" } else { f"must be at least {p}" }
		"max", "lte"                                                                      => if size != "" { f"must have at most {p} {size}" } else { f"must be at most {p}" }
		"len"                                                                             => if size != "" { f"must have exactly {p} {size}" } else { f"must be {p}" }
		"gt"                                                                              => if size != "" { f"must have more than {p} {size}" } else { f"must be greater than {p}" }
		"lt"                                                                              => if size != "" { f"must have fewer than {p} {size}" } else { f"must be less than {p}" }
		"eq"                                                                              => f"must be {p}"
		"ne"                                                                              => f"must not be {p}"
		"oneof"                                                                           => f"must be one of {strings.ReplaceAll(p, " ", ", ")}"
		"email"                                                                           => "must be an email address"
		"url", "http_url"                                                                 => "must be a URL"
		"uri"                                                                             => "must be a URI"
		"uuid", "uuid4"                                                                   => "must be a UUID"
		"alpha"                                                                           => "must have letters only"
		"alphanum"                                                                        => "must have letters and digits only"
		"numeric"                                                                         => "must be a number"
		"ascii"                                                                           => "must be ASCII"
		"lowercase"                                                                       => "must be lowercase"
		"uppercase"                                                                       => "must be uppercase"
		"datetime"                                                                        => f"must be a date and time in the layout {p}"
		"unique"                                                                          => "must have no duplicates"
		_                                                                                 => if p != "" { f"must satisfy {f.Tag()}={p}" } else { f"must satisfy {f.Tag()}" }
	}
}
