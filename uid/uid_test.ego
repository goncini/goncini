package uid_test

import (
	"context"
	"net/http"
	"net/http/httptest"
	"slices"
	"strings"
	"testing"
	"time"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/routing"
	"github.com/goncini/goncini/uid"
)

func TestUUID(t *testing.T) {
	v4, v7 := uid.NewV4(), uid.NewV7()
	if v4.Version() != 4 || v7.Version() != 7 || v4[8]>>6 != 2 || v7[8]>>6 != 2 {
		t.Errorf("versions and variants: %s, %s", v4, v7)
	}
	if d := time.Since(v7.Time()); d < 0 || d > time.Second {
		t.Errorf("v7 time %v", v7.Time())
	}
	for _, u := range []uid.UUID{v4, v7, {}} {
		back := must uid.ParseUUID(u.String())
		upper := must uid.ParseUUID(strings.ToUpper(u.String()))
		if back != u || upper != u {
			t.Errorf("%s doesn't round-trip", u)
		}
	}
	for _, bad := range []string{"", "0192a6f0-7c1e-7d3a-9f3b-2b6c1e9d0a4", "0192a6f07c1e7d3a9f3b2b6c1e9d0a4f", "0192a6f0-7c1e-7d3a-9f3b-2b6c1e9d0a4g"} {
		if _, err := uid.ParseUUID(bad); err == nil {
			t.Errorf("%q parsed", bad)
		}
	}
}

// TestV7Order checks that v7 UUIDs made in a row sort in order, as text
// and as bytes, even many in a millisecond.
func TestV7Order(t *testing.T) {
	ids := make([]string, 10000)
	for i := range ids {
		ids[i] = uid.NewV7().String()
	}
	if !slices.IsSorted(ids) {
		t.Error("v7 UUIDs made in a row aren't sorted")
	}
}

func TestULID(t *testing.T) {
	u := uid.NewULID()
	if d := time.Since(u.Time()); d < 0 || d > time.Second {
		t.Errorf("time %v", u.Time())
	}
	s := u.String()
	back := must uid.ParseULID(s)
	lower := must uid.ParseULID(strings.ToLower(s))
	if len(s) != 26 || back != u || lower != u || u.UUID().ULID() != u {
		t.Errorf("%s doesn't round-trip", s)
	}
	known := must uid.ParseULID("01ARYZ6S41TSV4RRFFQ69G5FAV") // the spec's example for 1469918176385
	if known.Time().UnixMilli() != 1469918176385 {
		t.Errorf("time %d", known.Time().UnixMilli())
	}
	confusable := must uid.ParseULID("O1ARYZ6S41TSV4RRFFQ69G5FAV") // O for 0
	if confusable != known {
		t.Error("O isn't read as 0")
	}
	ids := make([]string, 10000)
	for i := range ids {
		ids[i] = uid.NewULID().String()
	}
	if !slices.IsSorted(ids) {
		t.Error("ULIDs made in a row aren't sorted")
	}
	for _, bad := range []string{"", "8ZZZZZZZZZZZZZZZZZZZZZZZZZ", "01ARZ3NDEKTSV4RRFFQ69G5FAU"} {
		if _, err := uid.ParseULID(bad); err == nil {
			t.Errorf("%q parsed", bad)
		}
	}
}

func TestScan(t *testing.T) {
	u := uid.NewV7()
	text, _ := u.Value()
	var fromText, fromBytes, fromBinary uid.UUID
	must fromText.Scan(text)
	must fromBytes.Scan([]byte(text.(string)))
	must fromBinary.Scan(u[:])
	if fromText != u || fromBytes != u || fromBinary != u {
		t.Error("UUIDs don't scan back")
	}
	if err := fromText.Scan(42); err == nil {
		t.Error("an int scanned")
	}
	l := uid.NewULID()
	var ulid uid.ULID
	lv, _ := l.Value()
	must ulid.Scan(lv)
	if ulid != l {
		t.Error("ULIDs don't scan back")
	}
}

// TestBind checks that UUIDs bind from paths, with a 400 for a value that
// isn't one, and are written as text in JSON.
func TestBind(t *testing.T) {
	r := routing.New()
	r.Get("/notes/{id}", httpkernel.Endpoint(func(ctx context.Context, in struct {
		ID uid.UUID `path:"id"`
	}) (map[string]uid.UUID, error) {
		return map[string]uid.UUID{"id": in.ID}, nil
	}))
	k := &httpkernel.Kernel{Handler: r}
	id := uid.NewV7()
	w := httptest.NewRecorder()
	k.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/notes/"+id.String(), nil))
	if w.Code != 200 || w.Body.String() != `{"id":"`+id.String()+`"}` {
		t.Errorf("%d %s", w.Code, w.Body)
	}
	w = httptest.NewRecorder()
	k.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/notes/nope", nil))
	if w.Code != 400 || !strings.Contains(w.Body.String(), "is invalid: not a UUID") {
		t.Errorf("%d %s", w.Code, w.Body)
	}
}
