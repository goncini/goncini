package migratedb_test

import (
	"bytes"
	"context"
	"testing"
	"testing/fstest"

	"github.com/golang-migrate/migrate/v4/database/sqlite"
	"github.com/golang-migrate/migrate/v4/source/iofs"

	"github.com/goncini/goncini/db"
	"github.com/goncini/goncini/db/migratedb"
)

var migrations = fstest.MapFS{
	"1_create_articles.up.sql":   {Data: []byte("CREATE TABLE articles (slug TEXT PRIMARY KEY);")},
	"1_create_articles.down.sql": {Data: []byte("DROP TABLE articles;")},
	"2_add_title.up.sql":         {Data: []byte("ALTER TABLE articles ADD COLUMN title TEXT;")},
	"2_add_title.down.sql":       {Data: []byte("ALTER TABLE articles DROP COLUMN title;")},
}

func TestMigrator(t *testing.T) {
	ctx := context.Background()
	pool, closePool := must db.Open(db.Config{Driver: "sqlite", URL: ":memory:", MaxOpenConns: 1})
	defer closePool()
	src := must iofs.New(migrations, ".")
	drv := must sqlite.WithInstance(pool, &sqlite.Config{})
	m := must migratedb.New(src, "sqlite", drv)

	up := (ctx context.Context, out *bytes.Buffer) => m.Up(ctx, out)
	down := (ctx context.Context, out *bytes.Buffer) => m.Down(ctx, out)
	status := (ctx context.Context, out *bytes.Buffer) => m.Status(ctx, out)
	for i, tt := range []struct {
		f    func(context.Context, *bytes.Buffer) error
		want string
	}{
		{status, "MIGRATION          APPLIED\n1_create_articles  pending\n2_add_title        pending\n"},
		{up, "applied 1_create_articles\napplied 2_add_title\n"},
		{up, "nothing to apply: the database is up to date\n"},
		{status, "MIGRATION          APPLIED\n1_create_articles  yes\n2_add_title        yes\n"},
		{down, "reverted 2_add_title\n"},
		{status, "MIGRATION          APPLIED\n1_create_articles  yes\n2_add_title        pending\n"},
		{down, "reverted 1_create_articles\n"},
		{down, "nothing to revert: no migration is applied\n"},
	} {
		var out bytes.Buffer
		if err := tt.f(ctx, &out); err != nil || out.String() != tt.want {
			t.Errorf("step %d: %v\n%s\nwant:\n%s", i, err, out.String(), tt.want)
		}
	}
}
