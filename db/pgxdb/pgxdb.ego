// Package pgxdb connects goncini apps to PostgreSQL through pgx's native
// pool, which is faster than database/sql and speaks PostgreSQL's types:
// it opens the pool with goncini's db.Config, closes it with the app, and
// runs functions in transactions that repositories find in their ctx.
//
// sqlc's pgx code takes a Conn:
//
//	queries := sqlcgen.New(s.pgx.Conn(ctx))
//
// Layer provides them all: the pool, its Transactor, and a *sql.DB on the
// same pool for what needs database/sql, such as goose, messenger.SQL and
// lock.SQL; what queries that *sql.DB through db.SQL, as messenger.SQL
// does, takes part in the Transactor's transactions, so that a message
// dispatched in one is queued if it commits, and only then:
//
//	var Services = layer.Set(pgxdb.Layer, messenger.SQL, lock.SQL, …)
package pgxdb

import (
	"context"
	"database/sql"
	"errors"
	"fmt"

	"github.com/effect-go/effect-go/layer"
	"github.com/jackc/pgx/v5/stdlib"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgconn"
	"github.com/jackc/pgx/v5/pgxpool"

	"github.com/goncini/goncini/db"
)

// Open opens the pool of c.URL, and returns the function that closes it:
// as a provider, Open's pool is closed with the app's scope. c.MaxOpenConns,
// c.ConnMaxLifetime and c.ConnMaxIdleTime set the pool's MaxConns,
// MaxConnLifetime and MaxConnIdleTime when they aren't zero; c.Driver is
// unused. Open doesn't connect, so that commands that don't need the
// database work without it; the app checks it before serving with
// pool.Ping, as a goncini.Check.
func Open(ctx context.Context, c db.Config) (*pgxpool.Pool, func(), error) {
	cfg, err := pgxpool.ParseConfig(c.URL)
	if err != nil {
		return nil, nil, fmt.Errorf("pgxdb: %w", err)
	}
	if c.MaxOpenConns > 0 {
		cfg.MaxConns = int32(c.MaxOpenConns)
	}
	if c.ConnMaxLifetime > 0 {
		cfg.MaxConnLifetime = c.ConnMaxLifetime
	}
	if c.ConnMaxIdleTime > 0 {
		cfg.MaxConnIdleTime = c.ConnMaxIdleTime
	}
	pool, err := pgxpool.NewWithConfig(ctx, cfg)
	if err != nil {
		return nil, nil, fmt.Errorf("pgxdb: %w", err)
	}
	return pool, pool.Close, nil
}

// Layer is the providers of a PostgreSQL database through pgx, from the
// app's db.Config: Open, New and DB.
var Layer = layer.Set(Open, New, DB)

// DB returns a *sql.DB on pool, for the libraries that need database/sql:
// they share the pool's connections, and closing it leaves the pool open.
func DB(pool *pgxpool.Pool) (*sql.DB, func() error, error) {
	d := stdlib.OpenDBFromPool(pool)
	return d, d.Close, nil
}

// Conn is what pgx's pools and transactions have in common: the DBTX
// interface that sqlc's pgx code takes.
type Conn interface {
	Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error)
	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
	CopyFrom(ctx context.Context, table pgx.Identifier, columns []string, rows pgx.CopyFromSource) (int64, error)
	SendBatch(ctx context.Context, b *pgx.Batch) pgx.BatchResults
}

// Transactor is the db.Transactor of a pgx pool, and gives repositories the
// connection to query with.
type Transactor struct {
	// Pool is the pool.
	Pool *pgxpool.Pool
	// TxOptions sets the isolation level and access mode of the
	// transactions.
	TxOptions pgx.TxOptions
	// SQL, if not nil, is a *sql.DB on Pool, as DB returns: the
	// transactions run on one of its connections, which db.SQL's users
	// find in their ctx, with db.Join.
	SQL *sql.DB
}

var _ db.Isolator = (*Transactor)(nil)

// New returns the Transactor of pool, whose transactions sqlDB's users
// join; sqlDB may be nil.
func New(pool *pgxpool.Pool, sqlDB *sql.DB) *Transactor {
	return &Transactor{Pool: pool, SQL: sqlDB}
}

// begin begins a transaction, and returns a context with it, and the
// function that gives its connection back once it is over.
func (t *Transactor) begin(ctx context.Context) (context.Context, pgx.Tx, func(), error) {
	if t.SQL == nil {
		tx, err := t.Pool.BeginTx(ctx, t.TxOptions)
		if err != nil {
			return nil, nil, nil, fmt.Errorf("pgxdb: beginning a transaction: %w", err)
		}
		return context.WithValue(ctx, txKey{t.Pool}, tx), tx, () => {}, nil
	}
	conn, err := t.SQL.Conn(ctx)
	if err != nil {
		return nil, nil, nil, fmt.Errorf("pgxdb: beginning a transaction: %w", err)
	}
	// The pgx connection under database/sql's, which conn keeps for this
	// transaction until it is closed.
	var pc *pgx.Conn
	err = conn.Raw(func(dc any) error {
		c, ok := dc.(*stdlib.Conn)
		if !ok {
			return fmt.Errorf("SQL's driver is %T, not pgx's", dc)
		}
		pc = c.Conn()
		return nil
	})
	if err != nil {
		conn.Close()
		return nil, nil, nil, fmt.Errorf("pgxdb: beginning a transaction: %w", err)
	}
	tx, err := pc.BeginTx(ctx, t.TxOptions)
	if err != nil {
		conn.Close()
		return nil, nil, nil, fmt.Errorf("pgxdb: beginning a transaction: %w", err)
	}
	ctx = db.Join(context.WithValue(ctx, txKey{t.Pool}, tx), t.SQL, conn)
	return ctx, tx, () => { conn.Close() }, nil
}

// txKey is the context key of a pool's transaction.
type txKey struct{ pool *pgxpool.Pool }

// Conn returns what to query with: the transaction that ctx is in, or else
// the pool.
func (t *Transactor) Conn(ctx context.Context) Conn {
	if tx, ok := t.Tx(ctx); ok {
		return tx
	}
	return t.Pool
}

// Tx returns the transaction that ctx is in, if any.
func (t *Transactor) Tx(ctx context.Context) (pgx.Tx, bool) {
	tx, ok := ctx.Value(txKey{t.Pool}).(pgx.Tx)
	return tx, ok
}

// Isolate begins a transaction, and returns a context with it and the
// function that rolls it back, as db.Isolator says.
func (t *Transactor) Isolate(ctx context.Context) (context.Context, func() error, error) {
	txCtx, tx, done := check t.begin(ctx) ""
	return txCtx, func() error {
		defer done()
		return tx.Rollback(context.WithoutCancel(ctx))
	}, nil
}

// InTx runs fn in a transaction of the pool, as db.Transactor says.
func (t *Transactor) InTx(ctx context.Context, fn func(ctx context.Context) error) (err error) {
	if _, ok := t.Tx(ctx); ok {
		return fn(ctx)
	}
	txCtx, tx, done := check t.begin(ctx) ""
	defer done()
	committed := false
	defer func() {
		if !committed {
			// Roll back even when ctx is done, which would stop Rollback.
			rerr := tx.Rollback(context.WithoutCancel(ctx))
			if rerr != nil && !errors.Is(rerr, pgx.ErrTxClosed) && err != nil {
				err = errors.Join(err, fmt.Errorf("pgxdb: rolling back: %w", rerr))
			}
		}
	}()
	if err := fn(txCtx); err != nil {
		return err
	}
	committed = true
	if err := tx.Commit(ctx); err != nil {
		return fmt.Errorf("pgxdb: committing: %w", err)
	}
	return nil
}
