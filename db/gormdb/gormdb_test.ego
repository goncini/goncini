package gormdb_test

import (
	"bytes"
	"context"
	"errors"
	"strings"
	"testing"

	"github.com/glebarez/sqlite"
	"gorm.io/gorm"
	"gorm.io/gorm/logger"

	"github.com/goncini/goncini/db"
	"github.com/goncini/goncini/db/gormdb"
)

type Article struct {
	Slug string `gorm:"primaryKey"`
}

// open opens GORM on a pool that goncini's db.Open opened, as an app does.
func open(t *testing.T) *gormdb.Transactor {
	pool, closePool := must db.Open(context.Background(), db.Config{Driver: "sqlite", URL: ":memory:", MaxOpenConns: 1})
	t.Cleanup(() => { closePool() })
	gdb := must gorm.Open(sqlite.Dialector{Conn: pool}, &gorm.Config{Logger: logger.Discard})
	return gormdb.New(gdb)
}

func TestAutoMigrate(t *testing.T) {
	tr := open(t)
	ctx := context.Background()
	m := gormdb.AutoMigrate(tr.DB, &Article{})
	var out bytes.Buffer
	must m.Status(ctx, &out)
	must m.Up(ctx, &out)
	must m.Status(ctx, &out)
	want := "MODEL                 TABLE\n*gormdb_test.Article  missing\n" +
		"migrated the tables of 1 models\n" +
		"MODEL                 TABLE\n*gormdb_test.Article  exists\n"
	if out.String() != want {
		t.Errorf("output:\n%s\nwant:\n%s", out.String(), want)
	}
	if err := m.Down(ctx, &out); err == nil {
		t.Error("Down succeeded")
	}
}

func TestInTx(t *testing.T) {
	tr := open(t)
	ctx := context.Background()
	must tr.DB.AutoMigrate(&Article{})
	insert := (ctx context.Context, slug string) => tr.Conn(ctx).Create(&Article{Slug: slug}).Error
	failed := errors.New("failed")

	must tr.InTx(ctx, ctx => insert(ctx, "a"))
	if err := tr.InTx(ctx, func(ctx context.Context) error { insert(ctx, "b"); return failed }); !errors.Is(err, failed) {
		t.Errorf("failure: %v", err)
	}
	must tr.InTx(ctx, ctx => tr.InTx(ctx, ctx => insert(ctx, "c")))
	err := tr.InTx(ctx, func(ctx context.Context) error {
		insert(ctx, "d")
		return tr.InTx(ctx, _ => failed)
	})
	if !errors.Is(err, failed) {
		t.Errorf("nested failure: %v", err)
	}
	func() {
		defer func() { recover() }()
		tr.InTx(ctx, func(ctx context.Context) error { insert(ctx, "e"); panic("boom") })
	}()

	var all []Article
	if err := tr.Conn(ctx).Order("slug").Find(&all).Error; err != nil {
		t.Fatal(err)
	}
	var slugs []string
	for _, a := range all {
		slugs = append(slugs, a.Slug)
	}
	if got := strings.Join(slugs, " "); got != "a c" {
		t.Errorf("slugs: %q, want %q", got, "a c")
	}
}
