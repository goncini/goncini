package db_test

import (
	"bytes"
	"context"
	"database/sql"
	"database/sql/driver"
	"errors"
	"io"
	"strings"
	"sync"
	"testing"

	"github.com/goncini/goncini/console"
	"github.com/goncini/goncini/db"
)

// fake is a database/sql driver that logs what happens to its
// transactions, and fails to connect when the URL says "down".
type fake struct {
	mu  sync.Mutex
	log []string
}

func (f *fake) record(s string) {
	f.mu.Lock()
	defer f.mu.Unlock()
	f.log = append(f.log, s)
}

func (f *fake) logged() string {
	f.mu.Lock()
	defer f.mu.Unlock()
	return strings.Join(f.log, " ")
}

func (f *fake) Open(name string) (driver.Conn, error) {
	if name == "down" {
		return nil, errors.New("connection refused")
	}
	return &conn{f}, nil
}

type conn struct{ f *fake }

func (c *conn) Prepare(query string) (driver.Stmt, error) { return &stmt{c.f, query}, nil }
func (c *conn) Close() error                              { return nil }
func (c *conn) Begin() (driver.Tx, error) {
	c.f.record("begin")
	return &tx{c.f}, nil
}

type tx struct{ f *fake }

func (t *tx) Commit() error   { t.f.record("commit"); return nil }
func (t *tx) Rollback() error { t.f.record("rollback"); return nil }

type stmt struct {
	f     *fake
	query string
}

func (s *stmt) Close() error  { return nil }
func (s *stmt) NumInput() int { return -1 }
func (s *stmt) Exec(args []driver.Value) (driver.Result, error) {
	s.f.record(s.query)
	return driver.RowsAffected(1), nil
}
func (s *stmt) Query(args []driver.Value) (driver.Rows, error) { return nil, errors.New("no rows") }

var driverLog = &fake{}

func init() { sql.Register("fake", driverLog) }

func open(t *testing.T) *db.SQL {
	pool, closePool := must db.Open(db.Config{Driver: "fake", URL: "up", MaxOpenConns: 1})
	t.Cleanup(() => { closePool() })
	driverLog.mu.Lock()
	driverLog.log = nil
	driverLog.mu.Unlock()
	return db.NewSQL(pool)
}

func TestOpen(t *testing.T) {
	for c, want := range map[db.Config]string{
		{}:               "db: Config.Driver is empty",
		{Driver: "nope"}: `db: sql: unknown driver "nope"`,
	} {
		if _, _, err := db.Open(c); err == nil || !strings.HasPrefix(err.Error(), want) {
			t.Errorf("Open(%+v) = %v, want %s", c, err, want)
		}
	}
	// Open doesn't connect: the app checks the database before serving.
	pool, closePool := must db.Open(db.Config{Driver: "fake", URL: "down"})
	defer closePool()
	if err := pool.PingContext(context.Background()); err == nil || err.Error() != "connection refused" {
		t.Errorf("PingContext = %v", err)
	}
}

func TestInTx(t *testing.T) {
	s := open(t)
	ctx := context.Background()
	exec := func(ctx context.Context, q string) error {
		_, err := s.Conn(ctx).ExecContext(ctx, q)
		return err
	}
	failed := errors.New("failed")

	for _, tt := range []struct {
		name string
		fn   func(ctx context.Context) error
		err  error
		log  string
	}{
		{"commit", (ctx context.Context) => exec(ctx, "insert"), nil, "begin insert commit"},
		{"rollback", func(ctx context.Context) error { exec(ctx, "insert"); return failed }, failed, "begin insert rollback"},
		{"nested", (ctx context.Context) => s.InTx(ctx, ctx => exec(ctx, "inner")), nil, "begin inner commit"},
		{"nested failure", (ctx context.Context) => s.InTx(ctx, _ => failed), failed, "begin rollback"},
	} {
		driverLog.log = nil
		if err := s.InTx(ctx, tt.fn); !errors.Is(err, tt.err) || driverLog.logged() != tt.log {
			t.Errorf("%s: %v, log %q; want %v, %q", tt.name, err, driverLog.logged(), tt.err, tt.log)
		}
	}

	driverLog.log = nil
	func() {
		defer func() { recover() }()
		s.InTx(ctx, func(ctx context.Context) error { exec(ctx, "insert"); panic("boom") })
	}()
	if driverLog.logged() != "begin insert rollback" {
		t.Errorf("panic: log %q", driverLog.logged())
	}

	if _, ok := s.Tx(ctx); ok {
		t.Error("a transaction outside InTx")
	}
	if s.Conn(ctx) != s.DB {
		t.Error("Conn outside InTx isn't the pool")
	}
}

// migrator records its calls.
type migrator struct{ calls []string }

func (m *migrator) Up(ctx context.Context, out io.Writer) error {
	m.calls = append(m.calls, "up")
	return nil
}
func (m *migrator) Down(ctx context.Context, out io.Writer) error {
	m.calls = append(m.calls, "down")
	return nil
}
func (m *migrator) Status(ctx context.Context, out io.Writer) error {
	m.calls = append(m.calls, "status")
	return nil
}

func TestCommands(t *testing.T) {
	m := &migrator{}
	for _, name := range []string{"db:migrate", "db:migrate:status", "db:rollback"} {
		must console.Run(context.Background(), &bytes.Buffer{}, db.Commands(m), "", []string{name})
	}
	if got := strings.Join(m.calls, " "); got != "up status down" {
		t.Errorf("calls: %s", got)
	}
}

func TestIsolate(t *testing.T) {
	s := open(t)
	ctx, rollback := must s.Isolate(context.Background())
	must s.InTx(ctx, func(ctx context.Context) error {
		_, err := s.Conn(ctx).ExecContext(ctx, "insert")
		return err
	})
	must rollback()
	if got := driverLog.logged(); got != "begin insert rollback" {
		t.Errorf("log %q: the test's transaction should take in the app's", got)
	}
}

func TestQueries(t *testing.T) {
	pool := must sql.Open("words", "")
	defer pool.Close()
	ctx := context.Background()
	scan := func(row db.Scanner) (string, error) {
		var s string
		err := row.Scan(&s)
		return s, err
	}
	all := must db.All(ctx, pool, scan, "a b c")
	none := must db.All(ctx, pool, scan, "")
	first, ok := must db.One(ctx, pool, scan, "x y")
	_, missing := must db.One(ctx, pool, scan, "")
	value := must db.Value[string](ctx, pool, "v")
	if strings.Join(all, " ") != "a b c" || none == nil || len(none) != 0 || first != "x" || !ok || missing || value != "v" {
		t.Errorf("All %q, %q; One %q %v, %v; Value %q", all, none, first, ok, missing, value)
	}
}

// rowsDriver answers each query with a row per word of the query, in one
// column.
type rowsDriver struct{}

func (rowsDriver) Open(string) (driver.Conn, error) { return rowsConn{}, nil }

type rowsConn struct{}

func (rowsConn) Prepare(query string) (driver.Stmt, error) { return rowsStmt(query), nil }
func (rowsConn) Close() error                              { return nil }
func (rowsConn) Begin() (driver.Tx, error)                 { return nil, errors.New("no transactions") }

type rowsStmt string

func (s rowsStmt) Close() error                                    { return nil }
func (s rowsStmt) NumInput() int                                   { return -1 }
func (s rowsStmt) Exec(args []driver.Value) (driver.Result, error) { return nil, errors.New("no exec") }
func (s rowsStmt) Query(args []driver.Value) (driver.Rows, error) {
	return &words{words: strings.Fields(string(s))}, nil
}

type words struct{ words []string }

func (w *words) Columns() []string { return []string{"word"} }
func (w *words) Close() error      { return nil }
func (w *words) Next(dest []driver.Value) error {
	if len(w.words) == 0 {
		return io.EOF
	}
	dest[0], w.words = w.words[0], w.words[1:]
	return nil
}

func init() { sql.Register("words", rowsDriver{}) }
