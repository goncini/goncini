package db

import (
	"context"
	"database/sql"
	"errors"
)

// Scanner is a row to read: *sql.Rows and *sql.Row.
type Scanner interface {
	Scan(dest ...any) error
}

// All runs query on conn, and returns the value that scan reads from each
// row:
//
//	articles := check db.All(ctx, s.sql.Conn(ctx), scanArticle, "SELECT … WHERE author_id = ?", id)
//
// scan is the app's function, which knows its columns:
//
//	func scanArticle(row db.Scanner) (Article, error) {
//		var a Article
//		err := row.Scan(&a.Slug, &a.Title)
//		return a, err
//	}
//
// All returns an empty slice, not nil, when no row matches.
func All[T any](ctx context.Context, conn Conn, scan func(Scanner) (T, error), query string, args ...any) ([]T, error) {
	rows := check conn.QueryContext(ctx, query, args...) ""
	defer rows.Close()
	all := []T{}
	for rows.Next() {
		v := check scan(rows) ""
		all = append(all, v)
	}
	check rows.Err() ""
	return all, nil
}

// One runs query on conn, and returns the value that scan reads from the
// first row, and reports whether there is one.
func One[T any](ctx context.Context, conn Conn, scan func(Scanner) (T, error), query string, args ...any) (T, bool, error) {
	v, err := scan(conn.QueryRowContext(ctx, query, args...))
	if errors.Is(err, sql.ErrNoRows) {
		var zero T
		return zero, false, nil
	}
	if err != nil {
		var zero T
		return zero, false, err
	}
	return v, true, nil
}

// Value runs query on conn, and returns the first column of its first
// row, such as a count or an EXISTS:
//
//	n := check db.Value[int](ctx, conn, "SELECT count(*) FROM articles")
func Value[T any](ctx context.Context, conn Conn, query string, args ...any) (T, error) {
	var v T
	err := conn.QueryRowContext(ctx, query, args...).Scan(&v)
	return v, err
}
