package hub_test

import (
	"context"
	"log/slog"
	"testing"
	"testing/synctest"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/hub"
)

type note struct {
	Title string `json:"title"`
}

// newHub returns a hub of one instance, stopped with the test.
func newHub(t *testing.T, c hub.Config) *hub.Hub {
	h, stop, _ := hub.New(c, hub.NewLocalTransport(), slog.New(slog.DiscardHandler))
	t.Cleanup(() => { stop() })
	return h
}

// titles receives n events of ch.
func titles(t *testing.T, ch <-chan httpkernel.Event[note], n int) []string {
	t.Helper()
	var out []string
	for range n {
		e, ok := <-ch
		if !ok {
			t.Fatalf("closed after %v", out)
		}
		out = append(out, e.Data.Title)
	}
	return out
}

func TestHub(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		h := newHub(t, hub.Config{})
		ctx, cancel := context.WithCancel(context.Background())
		notes := hub.Subscribe[note](ctx, h, "", "notes")
		both := hub.Subscribe[note](ctx, h, "", "notes", "drafts", "notes")
		must h.Publish(ctx, "notes", note{"a"})
		must h.Publish(ctx, "drafts", note{"b"})
		must h.Publish(ctx, "others", note{"c"})
		if got := titles(t, notes, 1); got[0] != "a" {
			t.Errorf("notes %v", got)
		}
		if got := titles(t, both, 2); got[0] != "a" || got[1] != "b" {
			t.Errorf("notes and drafts %v", got)
		}
		cancel()
		synctest.Wait()
		if _, ok := <-notes; ok {
			t.Error("a subscription outlives its ctx")
		}
	})
}

// TestReplay checks that a client that reconnects gets what it missed
// after its last event, of what the instance keeps.
func TestReplay(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		h := newHub(t, hub.Config{History: 3})
		ctx := context.Background()
		first := hub.Subscribe[note](t.Context(), h, "", "notes")
		for _, title := range []string{"a", "b", "c", "d"} {
			must h.Publish(ctx, "notes", note{title})
		}
		must h.Publish(ctx, "drafts", note{"e"})
		var ids []string
		for range 4 {
			e := <-first
			ids = append(ids, e.ID)
		}
		again := hub.Subscribe[note](t.Context(), h, ids[1], "notes", "drafts")
		if got := titles(t, again, 3); got[0] != "c" || got[1] != "d" || got[2] != "e" {
			t.Errorf("after b: %v", got)
		}
		// b is no longer kept: the events published after it are.
		gone := hub.Subscribe[note](t.Context(), h, ids[0], "notes")
		if got := titles(t, gone, 3); got[0] != "b" || got[2] != "d" {
			t.Errorf("after a: %v", got)
		}
	})
}

// TestSlowSubscriber checks that a client that falls behind is let go,
// so that it reconnects, while the others keep up.
func TestSlowSubscriber(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		h := newHub(t, hub.Config{Buffer: 2})
		ctx := context.Background()
		slow := hub.Subscribe[note](t.Context(), h, "", "notes")
		fast := hub.Subscribe[note](t.Context(), h, "", "notes")
		for _, title := range []string{"a", "b", "c"} {
			must h.Publish(ctx, "notes", note{title})
			<-fast
		}
		if got := titles(t, slow, 2); got[1] != "b" {
			t.Errorf("the slow one's %v", got)
		}
		if _, ok := <-slow; ok {
			t.Error("the slow subscriber is still subscribed")
		}
		must h.Publish(ctx, "notes", note{"d"})
		if got := titles(t, fast, 1); got[0] != "d" {
			t.Errorf("the fast one's %v", got)
		}
	})
}
