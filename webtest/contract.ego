package webtest

import (
	"bytes"
	"cmp"
	"io"
	"net/http"
	"testing"

	"github.com/goncini/goncini/openapi"
)

// Contract returns a handler that serves requests with h, and fails the
// test when an exchange breaks doc, as openapi.Document.Check says: a
// response whose status, media type or body the document doesn't declare,
// or a successful request whose body it doesn't allow. It is middleware,
// so it also checks an app served over HTTP, as to a client in another
// language:
//
//	srv := httptest.NewServer(webtest.Contract(t, app.OpenAPI, app.Kernel))
func Contract(t testing.TB, doc *openapi.Document, h http.Handler) http.Handler {
	return http.HandlerFunc((w http.ResponseWriter, r *http.Request) => {
		var reqBody []byte
		if r.Body != nil && r.Body != http.NoBody {
			var err error
			reqBody, err = io.ReadAll(r.Body)
			// The app reads what the client sent, then the error reading it
			// failed with, if any.
			r.Body = io.NopCloser(io.MultiReader(bytes.NewReader(reqBody), failing{err}))
		}
		tw := &teeWriter{ResponseWriter: w}
		h.ServeHTTP(tw, r)
		err := doc.Check(openapi.Exchange{
			Method:      r.Method,
			Path:        r.URL.EscapedPath(),
			RequestType: r.Header.Get("Content-Type"),
			RequestBody: reqBody,
			Status:      cmp.Or(tw.status, http.StatusOK),
			Header:      w.Header(),
			Body:        tw.body.Bytes(),
		})
		if err != nil {
			t.Errorf("the API breaks its OpenAPI document: %v", err)
		}
	})
}

// failing is a reader that fails with err, or ends if it is nil.
type failing struct{ err error }

func (f failing) Read([]byte) (int, error) { return 0, f.err ?? io.EOF }

// teeWriter writes a response, and keeps its status and body.
type teeWriter struct {
	http.ResponseWriter
	status int
	body   bytes.Buffer
}

func (w *teeWriter) WriteHeader(status int) {
	if w.status == 0 && status >= 200 { // not an informational 1xx
		w.status = status
	}
	w.ResponseWriter.WriteHeader(status)
}

func (w *teeWriter) Flush() {
	if f, ok := w.ResponseWriter.(http.Flusher); ok {
		f.Flush()
	}
}

func (w *teeWriter) Write(b []byte) (int, error) {
	if w.status == 0 {
		w.status = http.StatusOK
	}
	w.body.Write(b)
	return w.ResponseWriter.Write(b)
}

func (w *teeWriter) Unwrap() http.ResponseWriter { return w.ResponseWriter }
