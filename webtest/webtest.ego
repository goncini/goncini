// Package webtest tests goncini apps.
package webtest

import (
	"bytes"
	"context"
	"strings"
	"testing"

	"github.com/goncini/goncini"
	"github.com/goncini/goncini/console"
)

// Boot builds an app for a test, as goncini.Main does in the test
// environment: with the .env files of goncini.ProjectDir for test, the
// config that load makes for it, and build. The app's scope closes, and its
// resources are released, when the test ends.
//
//	app := webtest.Boot(t, config.Load, app.Build)
//	app.Kernel.ServeHTTP(rec, req)
func Boot[C any](t testing.TB, load func(*goncini.Env) C, build func(context.Context, *scope.Scope, C) (*goncini.App, error)) *goncini.App {
	t.Helper()
	_, cfg, err := goncini.Load(goncini.ProjectDir(), "test", load)
	if err != nil {
		t.Fatal(err)
	}
	built := make(chan *goncini.App, 1)
	stop := make(chan struct{})
	done := make(chan error, 1)
	go func() {
		_, err := scope.Run(context.Background(), func(s *scope.Scope) (struct{}, error) {
			app := check build(s.Context(), s, cfg) ""
			built <- app
			<-stop
			return struct{}{}, nil
		})
		done <- err
	}()
	select {
	case app := <-built:
		t.Cleanup(() => {
			close(stop)
			if err := <-done; err != nil {
				t.Errorf("closing the app: %v", err)
			}
		})
		return app
	case err := <-done:
		t.Fatalf("building the app: %v", err)
		return nil
	}
}

// Run runs one of app's own commands with args, such as db:migrate to
// create a test database's tables, and returns its output. The test fails
// if the command does.
//
//	webtest.Run(t, app, "db:migrate")
func Run(t testing.TB, app *goncini.App, args ...string) string {
	t.Helper()
	var out bytes.Buffer
	if err := console.Run(t.Context(), &out, app.Commands, "", args); err != nil {
		t.Fatalf("%s: %v", strings.Join(args, " "), err)
	}
	return out.String()
}
