package webtest_test

import (
	"context"
	"fmt"
	"io"
	"net/http"
	"strings"
	"testing"
	"testing/synctest"
	"time"

	"github.com/goncini/goncini"
	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/openapi"
	"github.com/goncini/goncini/routing"
	"github.com/goncini/goncini/webtest"
)

// echo answers JSON describing the request.
var echo = http.HandlerFunc((w http.ResponseWriter, r *http.Request) => {
	body, _ := io.ReadAll(r.Body)
	w.Header().Set("Content-Type", "application/json")
	w.Header().Set("X-Seen", r.Header.Get("Authorization"))
	fmt.Fprintf(w, `{"method":%q,"uri":%q,"type":%q,"body":%q}`, r.Method, r.URL.RequestURI(), r.Header.Get("Content-Type"), body)
})

type echoed struct {
	Method string `json:"method"`
	URI    string `json:"uri"`
	Type   string `json:"type"`
	Body   string `json:"body"`
}

func TestClient(t *testing.T) {
	c := webtest.NewClient(t, echo)
	for _, tt := range []struct {
		res  *webtest.Response
		want echoed
	}{
		{c.Get("/a?b=1"), echoed{"GET", "/a?b=1", "", ""}},
		{c.Post("/a", `{"x":1}`), echoed{"POST", "/a", "application/json", `{"x":1}`}},
		{c.Put("/a", map[string]int{"x": 1}), echoed{"PUT", "/a", "application/json", `{"x":1}`}},
		{c.Patch("/a", []byte(`[]`)), echoed{"PATCH", "/a", "application/json", `[]`}},
		{c.Delete("/a"), echoed{"DELETE", "/a", "", ""}},
	} {
		var got echoed
		tt.res.Status(200).JSON(&got)
		if got != tt.want {
			t.Errorf("%+v, want %+v", got, tt.want)
		}
	}

	alice := c.WithHeader("Authorization", "Token alice")
	alice.Get("/").HasHeader("X-Seen", "Token alice").Contains(`"method":"GET"`)
	c.Get("/").HasHeader("X-Seen", "") // c itself is unchanged
	req := must http.NewRequest(http.MethodGet, "/", nil)
	req.Header.Set("Authorization", "Token bob")
	alice.Do(req).HasHeader("X-Seen", "Token bob") // the request's own header wins
}

func TestProblem(t *testing.T) {
	type input struct {
		Body struct {
			Title string `json:"title"`
		}
		Limit int `query:"limit"`
	}
	k := &httpkernel.Kernel{Handler: httpkernel.Endpoint(func(ctx context.Context, in input) (httpkernel.NoContent, error) {
		return httpkernel.NoContent{}, httpkernel.Invalid(
			httpkernel.Violation{Pointer: "#/title", Detail: "is required"},
			httpkernel.Violation{Parameter: "limit", Detail: "must be at least 1"},
		)
	})}
	webtest.NewClient(t, k).Post("/?limit=0", `{}`).Problem(422).
		HasDetail("the request has invalid values").
		Violation("#/title", "is required").
		Violation("limit", "must be at least 1")
}

// recorder is a testing.TB that records the failures it is told of.
type recorder struct {
	testing.TB
	failures []string
}

func (r *recorder) Helper() {}

func (r *recorder) Errorf(format string, args ...any) {
	r.failures = append(r.failures, fmt.Sprintf(format, args...))
}

func TestFailedChecks(t *testing.T) {
	rec := &recorder{TB: t}
	c := webtest.NewClient(rec, echo)
	problem := webtest.NewClient(rec, &httpkernel.Kernel{}) // answers 404 problems
	for i, check := range []func(){
		() => { c.Get("/x").Status(201) },
		() => { c.Get("/x").HasHeader("X-Seen", "Token") },
		() => { c.Get("/x").Contains("nope") },
		() => { var v []int; c.Get("/x").JSON(&v) },
		() => { c.Get("/x").Problem(200) },
		() => { problem.Get("/x").Problem(404).HasDetail("nope") },
		() => { problem.Get("/x").Problem(404).Violation("#/title", "is required") },
		() => { var v map[string]any; webtest.NewClient(rec, http.NotFoundHandler()).Get("/x").JSON(&v) },
	} {
		rec.failures = nil
		check()
		if len(rec.failures) != 1 || !strings.HasPrefix(rec.failures[0], "GET /x: ") {
			t.Errorf("check %d: failures %q", i, rec.failures)
		}
	}
	rec.failures = nil
	problem.Get("/x").Problem(404).HasDetail("no route matches GET /x")
	if rec.failures != nil {
		t.Errorf("failures %q", rec.failures)
	}
}

// isolator is a db.Isolator that puts a marker in the context.
type isolator struct{ rolledBack bool }

type marker struct{}

func (i *isolator) InTx(ctx context.Context, fn func(context.Context) error) error { return fn(ctx) }

func (i *isolator) Isolate(ctx context.Context) (context.Context, func() error, error) {
	return context.WithValue(ctx, marker{}, true), () => { i.rolledBack = true; return nil }, nil
}

func TestIsolate(t *testing.T) {
	iso := &isolator{}
	t.Run("test", (t *testing.T) => {
		ctx := webtest.Isolate(t, iso)
		seen := false
		h := http.HandlerFunc((w http.ResponseWriter, r *http.Request) => {
			seen = r.Context().Value(marker{}) == true
		})
		webtest.NewClient(t, h).WithContext(ctx).Get("/")
		if !seen {
			t.Error("the request's context isn't the isolated one")
		}
		if iso.rolledBack {
			t.Error("rolled back before the test ended")
		}
	})
	if !iso.rolledBack {
		t.Error("not rolled back when the test ended")
	}
}

// TestInABubble boots an app inside a synctest bubble, where time is fake:
// an hour-long request takes no time.
func TestInABubble(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		build := func(ctx context.Context, s *scope.Scope, cfg string) (*goncini.App, error) {
			r := routing.New()
			r.Get("/slow", http.HandlerFunc((w http.ResponseWriter, r *http.Request) => { time.Sleep(time.Hour) }))
			return &goncini.App{Kernel: &httpkernel.Kernel{Handler: r}}, nil
		}
		a := webtest.Boot(t, (env *goncini.Env) => env.Name, build)
		start := time.Now()
		webtest.NewClient(t, a.Kernel).Get("/slow").Status(200)
		if d := time.Since(start); d != time.Hour {
			t.Errorf("the request took %v of fake time", d)
		}
	})
}

type greeting struct {
	Hello string `json:"hello"`
}

// TestContract checks that a client of an app checks responses against
// its OpenAPI document, and a client of its kernel doesn't.
func TestContract(t *testing.T) {
	r := routing.New()
	r.Get("/hello", httpkernel.Endpoint(func(ctx context.Context, in struct{}) (greeting, error) { return greeting{"world"}, nil }))
	k := &httpkernel.Kernel{Handler: r}
	doc := must openapi.Generate(r.List(), k, openapi.Config{}, openapi.Annotations{})
	app := &goncini.App{Kernel: k, OpenAPI: doc}
	rec := &recorder{TB: t}
	webtest.NewClient(rec, app).Get("/hello").Status(200)
	if rec.failures != nil {
		t.Errorf("failures %q", rec.failures)
	}
	doc.Components.Schemas["greeting"].Required = []string{"bye"}
	webtest.NewClient(rec, app.Kernel).Get("/hello").Status(200)
	if rec.failures != nil {
		t.Errorf("a kernel's client: failures %q", rec.failures)
	}
	webtest.NewClient(rec, app).Get("/hello").Status(200)
	if want := `GET /hello: the 200 response: /: the required member "bye" is missing`; len(rec.failures) != 1 || !strings.Contains(rec.failures[0], want) {
		t.Errorf("failures %q, want %q", rec.failures, want)
	}
}
