package goncini

import (
	"bytes"
	"context"
	"encoding/json/jsontext"
	"encoding/json/v2"
	"flag"
	"fmt"
	"io"
	"log/slog"
	"os"
	"path/filepath"
	"strings"
	"text/tabwriter"
	"time"

	"github.com/goncini/goncini/console"
	"github.com/goncini/goncini/event"
	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/openapi"
	"github.com/goncini/goncini/routing"
)

// Main runs an app from its command line, as its main function does:
//
//	func main() { goncini.Main(config.Load, app.Build) }
//
// It loads the environment named by APP_ENV from the process and the .env
// files of ProjectDir, then the config with load, and fails with every
// missing secret at once. It then builds the app with build, in a scope
// that SIGINT and SIGTERM cancel, and runs the command that the arguments
// name, as Run does.
//
// A mistake in the command line, such as an unknown command, is printed and
// exits with status 2. Anything else that fails is logged, and exits with
// status 1.
func Main[C any](load func(*Env) C, build func(context.Context, *scope.Scope, C) (*App, error)) {
	env, cfg, err := Load(ProjectDir(), "", load)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	var usage error
	scope.Main(s => {
		app := check build(s.Context(), s, cfg) ""
		slog.SetDefault(app.Logger)
		err := Run(s.Context(), os.Stdout, env, cfg, app, os.Args[1:])
		if console.IsUsage(err) {
			usage = err
			return nil
		}
		return err
	})
	if usage != nil {
		fmt.Fprintln(os.Stderr, usage)
		os.Exit(2)
	}
}

// Load returns the environment named name, loaded from dir as LoadEnv does,
// and the config that load makes for it. It fails with the reasons of
// Env.Err: an unknown environment and every missing secret.
func Load[C any](dir, name string, load func(*Env) C) (*Env, C, error) {
	var cfg C
	env := check LoadEnv(dir, name) ""
	cfg = load(env)
	check env.Err() ""
	return env, cfg, nil
}

// ProjectDir returns the directory of the app's .env files: the nearest one
// that holds a go.mod file, from the working directory up, which is the
// app's own when it runs through go run or go test; or else the working
// directory, as for a deployed binary.
func ProjectDir() string {
	wd := os.Getwd() else "."
	for dir := wd; ; dir = filepath.Dir(dir) {
		if _, err := os.Stat(filepath.Join(dir, "go.mod")); err == nil {
			return dir
		}
		if filepath.Dir(dir) == dir {
			return wd
		}
	}
}

// Run runs the command of app that args[0] names, with the rest of args,
// writing its output to out: serve when args is empty. Besides the app's
// own commands, there are:
//   - serve, which runs the app's checks, then serves it over HTTP until
//     ctx is done, and shuts down gracefully; -addr overrides the address
//     of the config, for a developer whose port is taken;
//   - debug:router, which lists the routes;
//   - openapi:dump, which prints the app's OpenAPI document;
//   - debug:event-dispatcher, which lists the listeners of each event;
//   - debug:container, which lists the app's services, as goncini generate
//     describes them;
//   - debug:config, which prints cfg as JSON, with the values of env's
//     secrets masked, and without its zero values, which are defaults;
//   - list and help, which describe the commands.
func Run[C any](ctx context.Context, out io.Writer, env *Env, cfg C, app *App, args []string) error {
	commands := []console.Command{
		serveCommand{app.Server, app.Checks},
		console.New("debug:router", "Lists the routes", (ctx context.Context, out io.Writer, args []string) => routing.WriteTable(out, app.Router.List())),
		console.New("openapi:dump", "Prints the OpenAPI document", (ctx context.Context, out io.Writer, args []string) => writeDocument(out, app.OpenAPI)),
		console.New("debug:event-dispatcher", "Lists the listeners of each event", (ctx context.Context, out io.Writer, args []string) => event.WriteTable(out, app.Events.List())),
		console.New("debug:config", "Prints the config, with secrets masked", (ctx context.Context, out io.Writer, args []string) => writeConfig(out, env, cfg)),
		console.New("debug:container", "Lists the app's services", (ctx context.Context, out io.Writer, args []string) => writeServices(out, app.Services)),
	}
	return console.Run(ctx, out, append(commands, app.Commands...), "serve", args)
}

// writeDocument writes doc as indented JSON.
func writeDocument(out io.Writer, doc *openapi.Document) error {
	b := check json.Marshal(doc, json.Deterministic(true), jsontext.Multiline(true), jsontext.WithIndent("  ")) ""
	_, err := fmt.Fprintf(out, "%s\n", b)
	return err
}

// serveCommand serves the app until ctx is done, once its checks pass.
type serveCommand struct {
	server *httpkernel.Server
	checks []Check
}

func (serveCommand) Name() string    { return "serve" }
func (serveCommand) Summary() string { return "Serves the app over HTTP" }

func (c serveCommand) Flags(fs *flag.FlagSet) {
	fs.StringVar(&c.server.Addr, "addr", c.server.Addr, "the TCP address to listen on, instead of the config's")
}

func (c serveCommand) Run(ctx context.Context, out io.Writer, args []string) error {
	if len(args) > 0 {
		return console.Usage{Command: "serve", Reason: f"unexpected argument {args[0]:q}"}
	}
	for _, check := range c.checks {
		if err := check(ctx); err != nil {
			return fmt.Errorf("goncini: the app isn't ready to serve: %w", err)
		}
	}
	return c.server.ListenAndServe(ctx)
}

// writeServices writes the services, with their providers and what they
// need, in the order the app builds them.
func writeServices(out io.Writer, services []Service) error {
	if len(services) == 0 {
		_, err := fmt.Fprintln(out, "no services are described: run goncini generate")
		return err
	}
	tw := tabwriter.NewWriter(out, 0, 0, 2, ' ', 0)
	fmt.Fprintln(tw, "SERVICE\tPROVIDER\tNEEDS")
	for _, s := range services {
		fmt.Fprintf(tw, "%s\t%s\t%s\n", s.Type, s.Provider, strings.Join(s.Needs, ", "))
	}
	return tw.Flush()
}

// writeConfig writes cfg as indented JSON, without its zero values, which
// are defaults, and with the values of env's secrets masked in its strings.
func writeConfig(out io.Writer, env *Env, cfg any) error {
	durations := json.MarshalToFunc((enc *jsontext.Encoder, d time.Duration) => enc.WriteToken(jsontext.String(d.String())))
	b := check json.Marshal(cfg, json.OmitZeroStructFields(true), json.WithMarshalers(durations)) ""
	dec := jsontext.NewDecoder(bytes.NewReader(b))
	enc := jsontext.NewEncoder(out, jsontext.WithIndent("  "))
	for {
		tok, err := dec.ReadToken()
		if err == io.EOF {
			return nil
		}
		check err ""
		if tok.Kind() == '"' {
			s := tok.String()
			for _, secret := range env.read {
				s = strings.ReplaceAll(s, secret, "******")
			}
			tok = jsontext.String(s)
		}
		check enc.WriteToken(tok) ""
	}
}
