// Package workflow moves things through states by transitions, as
// Symfony's Workflow component does with its state machines: an article
// goes from draft to in_review to published, and a transition the state
// doesn't allow is refused, as is one its guard denies.
//
//	review := must workflow.New(workflow.Definition{
//		Name:    "review",
//		Places:  []string{"draft", "in_review", "published"},
//		Initial: "draft",
//		Transitions: []workflow.Transition{
//			{Name: "submit", From: []string{"draft"}, To: "in_review"},
//			{Name: "publish", From: []string{"in_review"}, To: "published", Guard: "ROLE_EDITOR"},
//		},
//	}, access, events)
//
//	art.State = check review.Apply(ctx, art, art.State, "publish") ""
//
// A guard is a security attribute, which the Access's voters decide with
// the subject: a role, or "publish" for an Authorship voter. Applying a
// transition dispatches Transitioning, whose listeners may refuse it, then
// Transitioned. The subject keeps its state where the app wants, such as a
// column: Apply returns the new one.
package workflow

import (
	"context"
	"errors"
	"fmt"
	"io"
	"net/http"
	"slices"
	"sort"
	"strings"

	"github.com/goncini/goncini/console"
	"github.com/goncini/goncini/event"
	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/security"
)

// Transition is a way from places to a place.
type Transition struct {
	Name string
	From []string
	To   string
	// Guard is the security attribute that the user must be granted for
	// the subject: empty means none.
	Guard string
}

// Definition is a state machine: its places, and its transitions.
type Definition struct {
	Name        string
	Places      []string
	Initial     string
	Transitions []Transition
}

// WorkflowError is everything applying a transition fails with, but its
// guard's denial, which is security's.
error WorkflowError {
	// NotAllowed means that the transition doesn't start from the state.
	NotAllowed {
		Workflow   string
		Transition string
		State      string
	} "{Workflow}: can't {Transition} from {State}"
	// UnknownTransition means that the workflow has no such transition.
	UnknownTransition {
		Workflow   string
		Transition string
	} "{Workflow}: no transition {Transition}"
}

// Problem is a 409: the subject isn't in a state for it.
func (e NotAllowed) Problem() httpkernel.Problem {
	return httpkernel.Problem{Status: http.StatusConflict, Detail: e.Error()}
}

// Problem is a 404: there is no such transition.
func (e UnknownTransition) Problem() httpkernel.Problem {
	return httpkernel.Problem{Status: http.StatusNotFound, Detail: e.Error()}
}

// Transitioning is dispatched before a transition is applied: a listener's
// error refuses it.
type Transitioning struct {
	Workflow   string
	Transition Transition
	Subject    any
	From       string
}

// Transitioned is dispatched once a transition is applied.
type Transitioned struct {
	Workflow   string
	Transition Transition
	Subject    any
	From       string
}

// Workflow is a state machine, with the access that decides its guards
// and the dispatcher of its events.
type Workflow struct {
	Definition
	access *security.Access
	events *event.Dispatcher
}

// New returns the workflow of d, or an error if d is inconsistent: an
// unknown place, a transition twice. access and events may be nil: no
// guard is then granted, and no event dispatched.
func New(d Definition, access *security.Access, events *event.Dispatcher) (*Workflow, error) {
	var errs []error
	place := (p string) => {
		if !slices.Contains(d.Places, p) {
			errs = append(errs, fmt.Errorf("workflow %s: unknown place %q", d.Name, p))
		}
	}
	place(d.Initial)
	seen := map[string]bool{}
	for _, t := range d.Transitions {
		if seen[t.Name] {
			errs = append(errs, fmt.Errorf("workflow %s: two transitions are named %q", d.Name, t.Name))
		}
		seen[t.Name] = true
		for _, f := range t.From {
			place(f)
		}
		place(t.To)
	}
	check errors.Join(errs...) ""
	return &Workflow{Definition: d, access: access, events: events}, nil
}

// transition returns the transition with the name.
func (w *Workflow) transition(name string) (Transition, bool) {
	i := slices.IndexFunc(w.Transitions, t => t.Name == name)
	if i < 0 {
		return Transition{}, false
	}
	return w.Transitions[i], true
}

// Can reports whether the transition can be applied to subject, in state:
// it starts from state, and its guard is granted.
func (w *Workflow) Can(ctx context.Context, subject any, state, transition string) bool {
	t, ok := w.transition(transition)
	return ok && slices.Contains(t.From, state) && w.granted(ctx, subject, t)
}

// granted reports whether t's guard, if any, is granted for subject.
func (w *Workflow) granted(ctx context.Context, subject any, t Transition) bool {
	return t.Guard == "" || w.access != nil && w.access.IsGranted(ctx, t.Guard, subject)
}

// Enabled returns the transitions that can be applied to subject, in state.
func (w *Workflow) Enabled(ctx context.Context, subject any, state string) []Transition {
	var out []Transition
	for _, t := range w.Transitions {
		if slices.Contains(t.From, state) && w.granted(ctx, subject, t) {
			out = append(out, t)
		}
	}
	return out
}

// Apply applies the transition to subject, in state, and returns its new
// state. It fails with UnknownTransition, NotAllowed, security's 401 or 403
// when its guard isn't granted, or a Transitioning listener's error.
func (w *Workflow) Apply(ctx context.Context, subject any, state, transition string) (string, error) {
	t, ok := w.transition(transition)
	if !ok {
		fail UnknownTransition{Workflow: w.Name, Transition: transition}
	}
	if !slices.Contains(t.From, state) {
		fail NotAllowed{Workflow: w.Name, Transition: transition, State: state}
	}
	if t.Guard != "" {
		if w.access == nil {
			return "", security.AccessDenied{Attribute: t.Guard}
		}
		check w.access.Check(ctx, t.Guard, subject) ""
	}
	check event.Dispatch(ctx, w.events, &Transitioning{Workflow: w.Name, Transition: t, Subject: subject, From: state}) ""
	event.Dispatch(ctx, w.events, &Transitioned{Workflow: w.Name, Transition: t, Subject: subject, From: state})
	return t.To, nil
}

// Mermaid returns the workflow's graph as a Mermaid state diagram.
func (w *Workflow) Mermaid() string {
	var b strings.Builder
	b.WriteString("stateDiagram-v2\n")
	b.WriteString(f"    [*] --> {w.Initial}\n")
	for _, t := range w.Transitions {
		label := t.Name
		if t.Guard != "" {
			label += f" [{t.Guard}]"
		}
		for _, from := range t.From {
			b.WriteString(f"    {from} --> {t.To}: {label}\n")
		}
	}
	return b.String()
}

// Registry is an app's workflows, by name.
type Registry map[string]*Workflow

// Get returns the workflow with the name, which must be there: a missing
// one is a bug.
func (r Registry) Get(name string) *Workflow {
	w, ok := r[name]
	if !ok {
		panic(f"workflow: no workflow {name:q}")
	}
	return w
}

// Commands returns the registry's console commands: workflow:dump, which
// draws a workflow in Mermaid, and lists the workflows without a name.
func Commands(r Registry) []console.Command {
	return []console.Command{
		console.New("workflow:dump", "Draws a workflow, given by name, as a Mermaid state diagram", func(ctx context.Context, out io.Writer, args []string) error {
			if len(args) != 1 {
				names := make([]string, 0, len(r))
				for name := range r {
					names = append(names, name)
				}
				sort.Strings(names)
				return console.Usage{Command: "workflow:dump", Reason: "name a workflow: " + strings.Join(names, ", ")}
			}
			w, ok := r[args[0]]
			if !ok {
				return fmt.Errorf("workflow: no workflow %q", args[0])
			}
			_, err := io.WriteString(out, w.Mermaid())
			return err
		}),
	}
}
