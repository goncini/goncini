package httpkernel_test

import (
	"context"
	"crypto/tls"
	"net/http"
	"net/http/httptest"
	"net/netip"
	"testing"

	"github.com/goncini/goncini/httpkernel"
)

func TestTrustProxiesRejectsGarbage(t *testing.T) {
	if _, err := httpkernel.TrustProxies("10.0.0.0/8", "lb.internal"); err == nil {
		t.Error("TrustProxies accepted a host name")
	}
}

func TestProxies(t *testing.T) {
	tests := []struct {
		name      string
		forwarded bool // trust the Forwarded header instead of X-Forwarded-*
		remote    string
		headers   []string
		ip        string
		scheme    string
		host      string
	}{
		{"direct client", false, "203.0.113.7:4242", nil, "203.0.113.7", "http", "api.example.com"},
		{"untrusted peer can't spoof", false, "203.0.113.7:4242",
			[]string{"X-Forwarded-For", "1.2.3.4", "X-Forwarded-Proto", "https", "X-Forwarded-Host", "evil.example"},
			"203.0.113.7", "http", "api.example.com"},
		{"one proxy", false, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "198.51.100.9", "X-Forwarded-Proto", "https", "X-Forwarded-Host", "shop.example"},
			"198.51.100.9", "https", "shop.example"},
		{"proxy chain", false, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "198.51.100.9, 192.0.2.1"},
			"198.51.100.9", "http", "api.example.com"},
		{"spoofed entries left of the client are ignored", false, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "6.6.6.6, 198.51.100.9"},
			"198.51.100.9", "http", "api.example.com"},
		{"several header lines", false, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "198.51.100.9", "X-Forwarded-For", "10.1.1.1"},
			"198.51.100.9", "http", "api.example.com"},
		{"every hop trusted", false, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "10.9.9.9, 10.1.1.1"},
			"10.9.9.9", "http", "api.example.com"},
		{"unknown hop stops the walk", false, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "198.51.100.9, unknown"},
			"10.0.0.5", "http", "api.example.com"},
		{"scheme and host aligned with the client's hop", false, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "198.51.100.9, 192.0.2.1", "X-Forwarded-Proto", "https, http", "X-Forwarded-Host", "shop.example, lb.internal"},
			"198.51.100.9", "https", "shop.example"},
		{"a client-sent host before the proxy's is ignored", false, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "198.51.100.9", "X-Forwarded-Host", "evil.example, shop.example"},
			"198.51.100.9", "http", "shop.example"},
		{"invalid scheme and host are ignored", false, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "198.51.100.9", "X-Forwarded-Proto", "gopher", "X-Forwarded-Host", `a"b<c>`},
			"198.51.100.9", "http", "api.example.com"},
		{"Forwarded isn't read by default", false, "10.0.0.5:80",
			[]string{"Forwarded", "for=6.6.6.6;proto=https;host=evil.example", "X-Forwarded-For", "203.0.113.9"},
			"203.0.113.9", "http", "api.example.com"},
		{"Forwarded", true, "10.0.0.5:80",
			[]string{"Forwarded", `for=198.51.100.9;proto=https;host="shop.example", for=192.0.2.1`},
			"198.51.100.9", "https", "shop.example"},
		{"Forwarded: the client's own element is ignored", true, "10.0.0.5:80",
			[]string{"Forwarded", "for=6.6.6.6;proto=https;host=evil.example, for=203.0.113.9;proto=http;host=api.example.com"},
			"203.0.113.9", "http", "api.example.com"},
		{"Forwarded IPv6 with port", true, "10.0.0.5:80",
			[]string{"Forwarded", `for="[2001:db8:cafe::17]:4711"`},
			"2001:db8:cafe::17", "http", "api.example.com"},
		{"Forwarded obfuscated port", true, "10.0.0.5:80",
			[]string{"Forwarded", `for="198.51.100.9:_hidden"`},
			"198.51.100.9", "http", "api.example.com"},
		{"X-Forwarded-For isn't read with Forwarded", true, "10.0.0.5:80",
			[]string{"X-Forwarded-For", "6.6.6.6"},
			"10.0.0.5", "http", "api.example.com"},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			proxies := must httpkernel.TrustProxies("10.0.0.0/8", "192.0.2.1")
			proxies.Forwarded = tt.forwarded
			r := httptest.NewRequest(http.MethodGet, "http://api.example.com/articles", nil)
			r.RemoteAddr = tt.remote
			for i := 0; i+1 < len(tt.headers); i += 2 {
				r.Header.Add(tt.headers[i], tt.headers[i+1])
			}
			var ip netip.Addr
			var scheme, host string
			proxies.Middleware(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				ip, scheme, host = httpkernel.ClientIP(r), httpkernel.Scheme(r), httpkernel.Host(r)
			})).ServeHTTP(httptest.NewRecorder(), r)
			if ip.String() != tt.ip || scheme != tt.scheme || host != tt.host {
				t.Errorf("got %s %s %s, want %s %s %s", ip, scheme, host, tt.ip, tt.scheme, tt.host)
			}
		})
	}
}

func TestBaseURL(t *testing.T) {
	var got string
	endpoint := httpkernel.Endpoint(func(ctx context.Context, in struct{}) (httpkernel.NoContent, error) {
		got = httpkernel.BaseURL(ctx)
		return httpkernel.NoContent{}, nil
	})
	proxies := must httpkernel.TrustProxies("10.0.0.0/8")
	k := &httpkernel.Kernel{Handler: endpoint, Middleware: []httpkernel.Middleware{proxies.Middleware}}

	proxied := httptest.NewRequest(http.MethodGet, "http://lb.internal/x", nil)
	proxied.RemoteAddr = "10.0.0.5:80"
	proxied.Header.Set("X-Forwarded-For", "198.51.100.9")
	proxied.Header.Set("X-Forwarded-Proto", "https")
	proxied.Header.Set("X-Forwarded-Host", "shop.example")
	for want, r := range map[string]*http.Request{
		"http://api.example.com":       httptest.NewRequest(http.MethodGet, "http://api.example.com/x", nil),
		"https://api.example.com:8443": httptest.NewRequest(http.MethodGet, "https://api.example.com:8443/x", nil),
		"https://shop.example":         proxied,
	} {
		got = ""
		k.ServeHTTP(httptest.NewRecorder(), r)
		if got != want {
			t.Errorf("BaseURL = %q, want %q", got, want)
		}
	}
	if base := httpkernel.BaseURL(context.Background()); base != "" {
		t.Errorf("BaseURL outside a kernel = %q", base)
	}
}

func TestProxiesIPv4MappedRange(t *testing.T) {
	proxies := must httpkernel.TrustProxies("::ffff:10.0.0.0/104")
	r := httptest.NewRequest(http.MethodGet, "/", nil)
	r.RemoteAddr = "[::ffff:10.0.0.5]:80"
	r.Header.Set("X-Forwarded-For", "198.51.100.9")
	var ip netip.Addr
	proxies.Middleware(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		ip = httpkernel.ClientIP(r)
	})).ServeHTTP(httptest.NewRecorder(), r)
	if ip.String() != "198.51.100.9" {
		t.Errorf("ClientIP = %s", ip)
	}
}

func TestPrivateProxies(t *testing.T) {
	proxies := must httpkernel.TrustProxies("private")
	r := httptest.NewRequest(http.MethodGet, "/", nil)
	r.RemoteAddr = "[::ffff:172.17.0.2]:5000" // Docker's bridge, as IPv4-mapped IPv6
	r.Header.Set("X-Forwarded-For", "198.51.100.9")
	var ip netip.Addr
	proxies.Middleware(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		ip = httpkernel.ClientIP(r)
	})).ServeHTTP(httptest.NewRecorder(), r)
	if ip.String() != "198.51.100.9" {
		t.Errorf("ClientIP = %s", ip)
	}
}

func TestClientWithoutProxies(t *testing.T) {
	r := httptest.NewRequest(http.MethodGet, "https://api.example.com/", nil)
	r.TLS = &tls.ConnectionState{}
	if ip := httpkernel.ClientIP(r); ip.String() != "192.0.2.1" {
		t.Errorf("ClientIP = %s, want httptest's 192.0.2.1", ip)
	}
	if s := httpkernel.Scheme(r); s != "https" {
		t.Errorf("Scheme = %s, want https", s)
	}
	r.RemoteAddr = "not an address"
	if ip := httpkernel.ClientIP(r); ip.IsValid() {
		t.Errorf("ClientIP = %s, want the zero Addr", ip)
	}
}
