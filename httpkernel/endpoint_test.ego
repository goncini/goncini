package httpkernel_test

import (
	"context"
	"errors"
	"io"
	"net/http"
	"net/http/httptest"
	"reflect"
	"strings"
	"testing"
	"time"

	"github.com/goncini/goncini/httpkernel"
)

// code is a parameter type of its own: it parses itself, in upper case.
type code string

func (c *code) UnmarshalText(b []byte) error {
	if strings.ContainsAny(string(b), "0123456789") {
		return errors.New("digits aren't allowed")
	}
	*c = code(strings.ToUpper(string(b)))
	return nil
}

type search struct {
	Slug     string        `path:"slug"`
	Limit    int           `query:"limit" default:"20"`
	Offset   *int          `query:"offset"`
	Tags     []string      `query:"tag"`
	Draft    bool          `query:"draft"`
	Score    float64       `query:"score"`
	Since    time.Time     `query:"since"`
	Every    time.Duration `query:"every"`
	Order    order         `query:"order" enum:"newest,oldest" default:"newest"`
	Code     code          `query:"code"`
	Small    int8          `query:"small"`
	Count    uint          `query:"count"`
	Request  string        `header:"X-Request-Id,required"`
	Untagged string
}

// echo serves an endpoint that returns its bound input.
func echo[In any](pattern string) http.Handler {
	mux := http.NewServeMux()
	mux.Handle(pattern, httpkernel.Endpoint(func(ctx context.Context, in In) (In, error) { return in, nil }))
	return mux
}

// capture serves an endpoint that stores its bound input in got.
func capture[In any](pattern string, got *In) http.Handler {
	mux := http.NewServeMux()
	mux.Handle(pattern, httpkernel.Endpoint(func(ctx context.Context, in In) (httpkernel.NoContent, error) {
		*got = in
		return httpkernel.NoContent{}, nil
	}))
	return mux
}

func TestEndpointBindsParameters(t *testing.T) {
	r := httptest.NewRequest(http.MethodGet, "/articles/go?limit=5&offset=10&tag=a&tag=b&draft=1&score=2.5"+
		"&since=2026-10-04T09:30:00Z&every=1m30s&order=oldest&code=abc&small=-7&count=3&untagged=no", nil)
	r.Header.Set("X-Request-Id", "req-1")
	rec := httptest.NewRecorder()
	var got search
	capture("GET /articles/{slug}", &got).ServeHTTP(rec, r)
	if rec.Code != http.StatusNoContent {
		t.Fatalf("status %d: %s", rec.Code, rec.Body)
	}
	offset := 10
	want := search{
		Slug: "go", Limit: 5, Offset: &offset, Tags: []string{"a", "b"}, Draft: true, Score: 2.5,
		Since: time.Date(2026, 10, 4, 9, 30, 0, 0, time.UTC), Every: 90 * time.Second, Order: oldest,
		Code: "ABC", Small: -7, Count: 3, Request: "req-1",
	}
	if !reflect.DeepEqual(got, want) {
		t.Errorf("bound %+v\nwant  %+v", got, want)
	}
}

func TestEndpointDefaults(t *testing.T) {
	r := httptest.NewRequest(http.MethodGet, "/articles/go?limit=", nil)
	r.Header.Set("X-Request-Id", "req-1")
	var got search
	capture("GET /articles/{slug}", &got).ServeHTTP(httptest.NewRecorder(), r)
	if got.Limit != 20 || got.Offset != nil || got.Order != newest || got.Tags != nil {
		t.Errorf("defaults: %+v", got)
	}
}

func TestEndpointParameterViolations(t *testing.T) {
	r := httptest.NewRequest(http.MethodGet, "/articles/go?limit=many&small=300&count=-1&order=random&code=a1&since=today&every=soon", nil)
	rec := httptest.NewRecorder()
	echo[search]("GET /articles/{slug}").ServeHTTP(rec, r)
	p := problem(t, rec)
	if rec.Code != http.StatusBadRequest || p.Detail != "invalid request parameters" {
		t.Fatalf("got %d %+v", rec.Code, p)
	}
	want := []httpkernel.Violation{
		{Parameter: "limit", Detail: "must be an integer"},
		{Parameter: "since", Detail: "must be an RFC 3339 time, such as 2026-10-04T09:30:00Z"},
		{Parameter: "every", Detail: "must be a duration, such as 1m30s"},
		{Parameter: "order", Detail: "must be one of: newest, oldest"},
		{Parameter: "code", Detail: "is invalid: digits aren't allowed"},
		{Parameter: "small", Detail: "must be an integer from -128 to 127"},
		{Parameter: "count", Detail: "must be a non-negative integer"},
		{Header: "X-Request-Id", Detail: "is required"},
	}
	if !reflect.DeepEqual(p.Errors, want) {
		t.Errorf("violations:\n%+v\nwant\n%+v", p.Errors, want)
	}
}

type createArticle struct {
	Body struct {
		Title string `json:"title"`
	}
}

type patchArticle struct {
	Slug string `path:"slug"`
	Body *struct {
		Title *string `json:"title"`
	}
}

func TestEndpointBindsBodies(t *testing.T) {
	h := echo[createArticle]("POST /articles")
	rec := do(h, http.MethodPost, "/articles", `{"title":"Hi"}`)
	if rec.Code != http.StatusOK || rec.Body.String() != `{"Body":{"title":"Hi"}}` {
		t.Errorf("got %d %s", rec.Code, rec.Body)
	}

	rec = httptest.NewRecorder()
	h.ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/articles", strings.NewReader(`{"title":"Hi"}`)))
	if p := problem(t, rec); rec.Code != http.StatusUnsupportedMediaType {
		t.Errorf("no Content-Type: %d %+v", rec.Code, p)
	}

	rec = do(h, http.MethodPost, "/articles", `{"title":7}`)
	if p := problem(t, rec); rec.Code != http.StatusUnprocessableEntity || p.Errors[0].Pointer != "#/title" {
		t.Errorf("bad value: %d %+v", rec.Code, p)
	}
}

func TestEndpointOptionalBody(t *testing.T) {
	h := echo[patchArticle]("PATCH /articles/{slug}")
	rec := do(h, http.MethodPatch, "/articles/go")
	if rec.Code != http.StatusOK || rec.Body.String() != `{"Slug":"go","Body":null}` {
		t.Errorf("without a body: %d %s", rec.Code, rec.Body)
	}
	rec = do(h, http.MethodPatch, "/articles/go", `{"title":"New"}`)
	if rec.Code != http.StatusOK || rec.Body.String() != `{"Slug":"go","Body":{"title":"New"}}` {
		t.Errorf("with a body: %d %s", rec.Code, rec.Body)
	}
}

func TestEndpointBodyLimit(t *testing.T) {
	k := &httpkernel.Kernel{Handler: echo[createArticle]("POST /articles"), BodyLimit: 8}
	k.Logger, _ = logged()
	if rec := do(k, http.MethodPost, "/articles", `{"title":"Hello"}`); rec.Code != http.StatusRequestEntityTooLarge {
		t.Errorf("status = %d, want 413", rec.Code)
	}
}

func TestEndpointResponders(t *testing.T) {
	type job struct {
		ID int `json:"id"`
	}
	tests := []struct {
		name   string
		out    httpkernel.Responder
		status int
		body   string
		header string // a header the response must have, "Name: value"
	}{
		{"created", httpkernel.Created[job]{Location: "/jobs/1", Body: job{1}}, 201, `{"id":1}`, "Location: /jobs/1"},
		{"no content", httpkernel.NoContent{}, 204, "", ""},
		{"response", httpkernel.Response[job]{Status: 202, Header: http.Header{"Retry-After": {"5"}}, Body: job{2}}, 202, `{"id":2}`, "Retry-After: 5"},
		{"response defaults to 200", httpkernel.Response[job]{Body: job{3}}, 200, `{"id":3}`, ""},
		{"cached", httpkernel.Cached[job]{Control: httpkernel.CacheControl{MaxAge: time.Minute}, Body: job{4}}, 200, `{"id":4}`, "Cache-Control: max-age=60"},
	}
	for _, tt := range tests {
		h := httpkernel.Endpoint(func(ctx context.Context, _ struct{}) (httpkernel.Responder, error) { return tt.out, nil })
		rec := do(h, http.MethodGet, "/")
		if rec.Code != tt.status || rec.Body.String() != tt.body {
			t.Errorf("%s: %d %q, want %d %q", tt.name, rec.Code, rec.Body, tt.status, tt.body)
		}
		if name, value, ok := strings.Cut(tt.header, ": "); ok && rec.Header().Get(name) != value {
			t.Errorf("%s: %s = %q", tt.name, name, rec.Header().Get(name))
		}
	}
}

func TestEndpointEncodingFailure(t *testing.T) {
	k := &httpkernel.Kernel{Handler: httpkernel.Endpoint(func(ctx context.Context, _ struct{}) (httpkernel.Response[chan int], error) {
		return httpkernel.Response[chan int]{Header: http.Header{"X-Partial": {"yes"}}, Body: make(chan int)}, nil
	})}
	k.Logger, _ = logged()
	rec := do(k, http.MethodGet, "/")
	if p := problem(t, rec); rec.Code != http.StatusInternalServerError || rec.Header().Get("X-Partial") != "" {
		t.Errorf("got %d %v %+v", rec.Code, rec.Header(), p)
	}
}

func TestEndpointWithoutKernel(t *testing.T) {
	h := httpkernel.Endpoint(func(ctx context.Context, _ struct{}) (struct{}, error) {
		return struct{}{}, httpkernel.Problem{Status: http.StatusTeapot}
	})
	if rec := do(h, http.MethodGet, "/"); rec.Code != http.StatusTeapot {
		t.Errorf("status = %d", rec.Code)
	}
}

type embedded struct {
	Page int `query:"page"`
}

func mustPanic(t *testing.T, want string, f func()) {
	t.Helper()
	defer func() {
		t.Helper()
		v := recover()
		if s, _ := v.(string); !strings.Contains(s, want) {
			t.Errorf("panic %v, want one about %q", v, want)
		}
	}()
	f()
}

func TestEndpointRejectsBadInputs(t *testing.T) {
	type handler[In any] func(context.Context, In) (struct{}, error)
	mustPanic(t, "isn't a struct", func() { httpkernel.Endpoint(handler[int](nil)) })
	mustPanic(t, "can't hold a query value", func() {
		httpkernel.Endpoint(handler[struct {
			M map[string]string `query:"m"`
		}](nil))
	})
	mustPanic(t, "is unexported", func() {
		httpkernel.Endpoint(handler[struct {
			x int `query:"x"`
		}](nil))
	})
	mustPanic(t, "has two of the path, query and header tags", func() {
		httpkernel.Endpoint(handler[struct {
			X int `query:"x" header:"X"`
		}](nil))
	})
	mustPanic(t, "is required and has a default", func() {
		httpkernel.Endpoint(handler[struct {
			X int `query:"x,required" default:"1"`
		}](nil))
	})
	mustPanic(t, "has a query tag, is hidden by another field named Page", func() {
		httpkernel.Endpoint(handler[struct {
			embedded
			Page string
		}](nil))
	})
	mustPanic(t, "has a query tag, is hidden by another field named Page", func() {
		httpkernel.Endpoint(handler[struct {
			*embedded
			Page string
		}](nil))
	})
	mustPanic(t, `has an invalid default "one"`, func() {
		httpkernel.Endpoint(handler[struct {
			X int `query:"x" default:"one"`
		}](nil))
	})
	mustPanic(t, `unknown option "optional"`, func() {
		httpkernel.Endpoint(handler[struct {
			X int `query:"x,optional"`
		}](nil))
	})
	mustPanic(t, "empty query name", func() {
		httpkernel.Endpoint(handler[struct {
			X int `query:""`
		}](nil))
	})
	mustPanic(t, "embedded pointer", func() {
		httpkernel.Endpoint(handler[struct{ *embedded }](nil))
	})
}

func TestEndpointEmbeddedStruct(t *testing.T) {
	type list struct {
		embedded
		Tag string `query:"tag"`
	}
	rec := do(echo[list]("GET /articles"), http.MethodGet, "/articles?page=3&tag=go")
	if rec.Body.String() != `{"Page":3,"Tag":"go"}` {
		t.Errorf("got %s", rec.Body)
	}
}

func TestEndpointOptionalBodyChunkedEmpty(t *testing.T) {
	r := httptest.NewRequest(http.MethodPatch, "/articles/go", io.NopCloser(strings.NewReader("")))
	r.ContentLength = -1 // as for a chunked body
	r.Header.Set("Content-Type", "application/json")
	rec := httptest.NewRecorder()
	echo[patchArticle]("PATCH /articles/{slug}").ServeHTTP(rec, r)
	if rec.Code != http.StatusOK || rec.Body.String() != `{"Slug":"go","Body":null}` {
		t.Errorf("got %d %s", rec.Code, rec.Body)
	}
}

func TestEndpointEmptyRemainder(t *testing.T) {
	type file struct {
		Path string `path:"path"`
	}
	var got file
	h := capture("GET /files/{path...}", &got)
	if rec := do(h, http.MethodGet, "/files/"); rec.Code != http.StatusNoContent || got.Path != "" {
		t.Errorf("/files/: %d %q %+v", rec.Code, rec.Body, got)
	}
	if rec := do(h, http.MethodGet, "/files/a/b"); rec.Code != http.StatusNoContent || got.Path != "a/b" {
		t.Errorf("/files/a/b: %d %+v", rec.Code, got)
	}
}

func TestResponseContentType(t *testing.T) {
	h := httpkernel.Endpoint(func(ctx context.Context, _ struct{}) (httpkernel.Response[map[string]int], error) {
		return httpkernel.Response[map[string]int]{Header: http.Header{"Content-Type": {"application/vnd.api+json"}}, Body: map[string]int{"n": 1}}, nil
	})
	rec := do(h, http.MethodGet, "/")
	if ct := rec.Header().Get("Content-Type"); ct != "application/vnd.api+json" {
		t.Errorf("Content-Type = %q", ct)
	}
}
