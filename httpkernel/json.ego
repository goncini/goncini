package httpkernel

import (
	"encoding/json/jsontext"
	"encoding/json/v2"
	"errors"
	"net/http"
	"reflect"
	"strconv"
	"time"
	"unicode/utf8"
)

// WriteJSON writes v as the response, encoded as JSON, with the given status.
// v is encoded before anything is written: if encoding fails, the response is
// untouched and the caller can still send an error.
func WriteJSON(w http.ResponseWriter, status int, v any) error {
	return write(w, status, "application/json", v)
}

// write encodes v, then writes it with the status and media type. Map keys
// are sorted, so equal values give equal bodies, and equal ETags.
func write(w http.ResponseWriter, status int, mediaType string, v any) error {
	if rec, ok := w.(ValueRecorder); ok {
		rec.RecordValue(v)
	}
	b, err := json.Marshal(v, json.Deterministic(true))
	if err != nil {
		return err
	}
	return writeBody(w, status, mediaType, b)
}

// writeBody writes an encoded body with the status and media type.
func writeBody(w http.ResponseWriter, status int, mediaType string, b []byte) error {
	h := w.Header()
	h.Set("Content-Type", mediaType)
	h.Set("Content-Length", strconv.Itoa(len(b)))
	w.WriteHeader(status)
	_, err := w.Write(b)
	return err
}

// syntaxReason says what is wrong with malformed JSON: the syntax error in
// err, or else err.
func syntaxReason(err error) string {
	if se, ok := errors.AsType[*jsontext.SyntacticError](err); ok && se.Err != nil {
		return se.Err.Error()
	}
	if err != nil {
		return err.Error()
	}
	return "invalid syntax"
}

// semanticReason says why a JSON value doesn't fit its Go field, from the
// semantic error in err: "expected an integer, got a string", or "expected
// an integer, got 1.5" when the kind is right but the value isn't. For a
// type with its own unmarshaler, which decides what it accepts, and for
// errors it can't explain, it says "invalid value": an unmarshaler's error
// text may reveal more than the client should see.
func semanticReason(err error) string {
	se, ok := errors.AsType[*json.SemanticError](err)
	switch {
	case !ok:
		return "invalid value"
	case errors.Is(se.Err, json.ErrUnknownName):
		return "unknown field"
	case se.GoType == nil || se.JSONKind == jsontext.KindInvalid:
		return "invalid value"
	}
	t := se.GoType
	for t.Kind() == reflect.Pointer {
		t = t.Elem()
	}
	if t != timeType && decodesItself(t) {
		return "invalid value"
	}
	got := describeKind(se.JSONKind)
	if sameKind(expectedKind(t), se.JSONKind) {
		// The kind was right, so the value is what's wrong: quote it back.
		pe, isTime := errors.AsType[*time.ParseError](se.Err)
		switch {
		case len(se.JSONValue) > 0:
			got = shorten(string(se.JSONValue))
		case isTime:
			got = shorten(strconv.Quote(pe.Value))
		default:
			got = "an invalid value"
		}
	}
	return f"expected {describeType(t)}, got {got}"
}

var (
	timeType             = reflect.TypeFor[time.Time]()
	jsonUnmarshaler      = reflect.TypeFor[json.Unmarshaler]()
	jsonUnmarshalerFrom  = reflect.TypeFor[json.UnmarshalerFrom]()
	encodingUnmarshalers = []reflect.Type{jsonUnmarshaler, jsonUnmarshalerFrom, textUnmarshaler}
)

// decodesItself reports whether t, or a pointer to it, has its own JSON or
// text unmarshaler.
func decodesItself(t reflect.Type) bool {
	for _, u := range encodingUnmarshalers {
		if t.Implements(u) || reflect.PointerTo(t).Implements(u) {
			return true
		}
	}
	return false
}

// undecodable reports whether no JSON value can decode into t: a
// time.Duration, which encoding/json/v2 has no default form for, or a kind
// JSON can't express. That is the API's mistake, not the client's.
func undecodable(t reflect.Type) bool {
	for t.Kind() == reflect.Pointer {
		t = t.Elem()
	}
	if decodesItself(t) {
		return false
	}
	switch t.Kind() {
	case reflect.Chan, reflect.Func, reflect.Complex64, reflect.Complex128, reflect.UnsafePointer:
		return true
	}
	return t == durationType
}

// describeType names what a JSON value must be to decode into t.
func describeType(t reflect.Type) string {
	for t.Kind() == reflect.Pointer {
		t = t.Elem()
	}
	if t == timeType {
		return "an RFC 3339 time"
	}
	return match t.Kind() {
		reflect.String => "a string"
		reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
			reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr => "an integer"
		reflect.Float32, reflect.Float64 => "a number"
		reflect.Bool                     => "a boolean"
		reflect.Slice, reflect.Array     => if t.Elem().Kind() == reflect.Uint8 { "a base64 string" } else { "an array" }
		reflect.Map, reflect.Struct      => "an object"
		_                                => "a valid value"
	}
}

// expectedKind is the kind of JSON value that decodes into t, or
// KindInvalid if it depends.
func expectedKind(t reflect.Type) jsontext.Kind {
	for t.Kind() == reflect.Pointer {
		t = t.Elem()
	}
	if t == timeType {
		return '"'
	}
	return match t.Kind() {
		reflect.String => jsontext.Kind('"')
		reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
			reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr,
			reflect.Float32, reflect.Float64 => '0'
		reflect.Bool                 => 't'
		reflect.Slice, reflect.Array => if t.Elem().Kind() == reflect.Uint8 { jsontext.Kind('"') } else { jsontext.Kind('[') }
		reflect.Map, reflect.Struct  => '{'
		_                            => jsontext.KindInvalid
	}
}

// sameKind reports whether two kinds are the same, counting true and false
// as one.
func sameKind(a, b jsontext.Kind) bool {
	if a == 'f' {
		a = 't'
	}
	if b == 'f' {
		b = 't'
	}
	return a != jsontext.KindInvalid && a == b
}

// describeKind names a kind of JSON value.
func describeKind(k jsontext.Kind) string {
	return match k {
		'n'      => "null"
		't', 'f' => "a boolean"
		'"'      => "a string"
		'0'      => "a number"
		'{'      => "an object"
		'['      => "an array"
		_        => "an invalid value"
	}
}

// shorten cuts a value quoted back to the client to at most 40 bytes, at
// the start of a character.
func shorten(s string) string {
	if len(s) <= 40 {
		return s
	}
	i := 40
	for i > 0 && !utf8.RuneStart(s[i]) {
		i--
	}
	return s[:i] + "…"
}
