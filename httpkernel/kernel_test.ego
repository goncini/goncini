// logged returns a logger that writes JSON records, debug ones included, to
// the returned buffer.
func logged() (*slog.Logger, *bytes.Buffer) {
	var buf bytes.Buffer
	return slog.New(slog.NewJSONHandler(&buf, &slog.HandlerOptions{Level: slog.LevelDebug})), &buf
}

// do serves a request with an optional body and returns the response.
func do(h http.Handler, method, target string, body ...string) *httptest.ResponseRecorder {
	var r *http.Request
	if len(body) > 0 {
		r = httptest.NewRequest(method, target, strings.NewReader(body[0]))
		r.Header.Set("Content-Type", "application/json")
	} else {
		r = httptest.NewRequest(method, target, nil)
	}
	rec := httptest.NewRecorder()
	h.ServeHTTP(rec, r)
	return rec
}

// problem decodes a problem response.
func problem(t *testing.T, rec *httptest.ResponseRecorder) httpkernel.Problem {
	t.Helper()
	if ct := rec.Header().Get("Content-Type"); ct != "application/problem+json" {
		t.Fatalf("Content-Type = %q, want a problem; body %s", ct, rec.Body)
	}
	var p httpkernel.Problem
	if err := json.Unmarshal(rec.Body.Bytes(), &p); err != nil {
		t.Fatal(err)
	}
	return p
}

func articlesKernel(a *articles) *httpkernel.Kernel {
	mux := http.NewServeMux()
	mux.Handle("GET /articles/{slug}", httpkernel.Endpoint(a.Show))
	return &httpkernel.Kernel{
		Handler:      mux,
		ErrorMappers: []httpkernel.ErrorMapper{articleProblems},
	}
}

func TestKernelServesEffectEndpoints(t *testing.T) {
	k := articlesKernel(&articles{titles: map[string]string{"go": "Go", "locked": ""}})
	k.Logger, _ = logged()

	rec := do(k, http.MethodGet, "/articles/go")
	if rec.Code != http.StatusOK || rec.Body.String() != `{"slug":"go","title":"Go"}` {
		t.Errorf("found: %d %s", rec.Code, rec.Body)
	}
	rec = do(k, http.MethodGet, "/articles/rust")
	if p := problem(t, rec); rec.Code != http.StatusNotFound || p.Detail != "no article rust" {
		t.Errorf("missing: %d %+v", rec.Code, p)
	}
	rec = do(k, http.MethodGet, "/articles/locked")
	if p := problem(t, rec); rec.Code != http.StatusConflict || p.Detail != "the article locked is locked" {
		t.Errorf("locked: %d %+v", rec.Code, p)
	}
}

func TestKernelMapsWrappedErrors(t *testing.T) {
	logger, logs := logged()
	k := &httpkernel.Kernel{
		Handler: httpkernel.Endpoint(func(ctx context.Context, _ struct{}) (struct{}, error) {
			return struct{}{}, fmt.Errorf("loading the feed: %w", ArticleStorage{Cause: errors.New("connection refused")})
		}),
		ErrorMappers: []httpkernel.ErrorMapper{articleProblems},
		Logger:       logger,
	}
	rec := do(k, http.MethodGet, "/feed")
	if p := problem(t, rec); rec.Code != http.StatusServiceUnavailable || p.Detail != "try again later" {
		t.Errorf("got %d %+v", rec.Code, p)
	}
	if !strings.Contains(logs.String(), "connection refused") || !strings.Contains(logs.String(), `"level":"ERROR"`) {
		t.Errorf("a 503 isn't logged as an error with its cause:\n%s", logs)
	}
}

func TestKernelHidesUnmappedErrors(t *testing.T) {
	for _, debug := range []bool{false, true} {
		logger, logs := logged()
		k := &httpkernel.Kernel{
			Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				httpkernel.WriteError(w, r, errors.New("pq: password authentication failed"))
			}),
			Logger: logger,
			Debug:  debug,
		}
		rec := do(k, http.MethodGet, "/")
		p := problem(t, rec)
		if rec.Code != http.StatusInternalServerError {
			t.Errorf("status = %d", rec.Code)
		}
		if leaked := p.Detail != ""; leaked != debug {
			t.Errorf("debug %v: detail %q", debug, p.Detail)
		}
		if !strings.Contains(logs.String(), "password authentication failed") {
			t.Errorf("the error isn't logged:\n%s", logs)
		}
	}
}

func TestKernelLogsRejectedRequestsAtDebugLevel(t *testing.T) {
	logger, logs := logged()
	k := articlesKernel(&articles{})
	k.Logger = logger
	do(k, http.MethodGet, "/articles/rust")
	if !strings.Contains(logs.String(), `"level":"DEBUG"`) || strings.Contains(logs.String(), `"level":"ERROR"`) {
		t.Errorf("a 404 should be logged at debug level:\n%s", logs)
	}
}

func TestKernelRecoversPanics(t *testing.T) {
	for _, debug := range []bool{false, true} {
		logger, logs := logged()
		k := &httpkernel.Kernel{
			Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { panic("boom") }),
			Logger:  logger,
			Debug:   debug,
		}
		rec := do(k, http.MethodGet, "/")
		p := problem(t, rec)
		if rec.Code != http.StatusInternalServerError {
			t.Errorf("status = %d", rec.Code)
		}
		if debug && (p.Detail != "panic: boom" || p.Extensions["stack"] == nil) {
			t.Errorf("debug problem = %+v", p)
		}
		if !debug && (p.Detail != "" || p.Extensions != nil) {
			t.Errorf("problem reveals the panic: %+v", p)
		}
		if !strings.Contains(logs.String(), `"panic":"boom"`) || !strings.Contains(logs.String(), "kernel_test.ego") {
			t.Errorf("the panic isn't logged with its stack:\n%s", logs)
		}
	}
}

func TestKernelRecoversPanicsInMiddleware(t *testing.T) {
	k := &httpkernel.Kernel{
		Handler: http.NotFoundHandler(),
		Middleware: []httpkernel.Middleware{func(http.Handler) http.Handler {
			return http.HandlerFunc(func(http.ResponseWriter, *http.Request) { panic(errors.New("middleware bug")) })
		}},
	}
	k.Logger, _ = logged()
	if rec := do(k, http.MethodGet, "/"); rec.Code != http.StatusInternalServerError {
		t.Errorf("status = %d", rec.Code)
	}
}

func TestKernelLetsAbortHandlerThrough(t *testing.T) {
	k := &httpkernel.Kernel{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		panic(http.ErrAbortHandler)
	})}
	defer func() {
		if v := recover(); v != http.ErrAbortHandler {
			t.Errorf("recovered %v, want http.ErrAbortHandler", v)
		}
	}()
	do(k, http.MethodGet, "/")
}

func TestKernelPanicAfterResponseStarted(t *testing.T) {
	logger, logs := logged()
	k := &httpkernel.Kernel{
		Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			io.WriteString(w, "partial")
			panic("too late")
		}),
		Logger: logger,
	}
	rec := do(k, http.MethodGet, "/")
	if rec.Code != http.StatusOK || rec.Body.String() != "partial" {
		t.Errorf("response changed after it started: %d %q", rec.Code, rec.Body)
	}
	if !strings.Contains(logs.String(), "too late") {
		t.Errorf("the panic isn't logged:\n%s", logs)
	}
}

func TestKernelRoutingProblems(t *testing.T) {
	mux := http.NewServeMux()
	mux.Handle("GET /articles/{slug}", http.NotFoundHandler())
	mux.Handle("/docs/", http.NotFoundHandler())
	k := &httpkernel.Kernel{Handler: mux}
	k.Logger, _ = logged()

	rec := do(k, http.MethodGet, "/nowhere")
	if p := problem(t, rec); rec.Code != http.StatusNotFound || p.Detail != "no route matches GET /nowhere" {
		t.Errorf("404: %d %+v", rec.Code, p)
	}
	rec = do(k, http.MethodPost, "/articles/go")
	if p := problem(t, rec); rec.Code != http.StatusMethodNotAllowed || p.Detail != "POST isn't allowed on /articles/go" {
		t.Errorf("405: %d %+v", rec.Code, p)
	}
	if allow := rec.Header().Get("Allow"); allow != "GET, HEAD" {
		t.Errorf("Allow = %q", allow)
	}
	rec = do(k, http.MethodGet, "/docs")
	if rec.Code/100 != 3 || rec.Header().Get("Location") != "/docs/" {
		t.Errorf("ServeMux's redirect was changed: %d %v", rec.Code, rec.Header())
	}
}

