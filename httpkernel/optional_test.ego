package httpkernel_test

import (
	"context"
	"encoding/json/v2"
	"testing"

	"github.com/goncini/goncini/httpkernel"
)

func TestOptional(t *testing.T) {
	type input struct {
		Body struct {
			Bio   httpkernel.Optional[string]   `json:"bio"`
			Email httpkernel.Optional[string]   `json:"email"`
			Tags  httpkernel.Optional[[]string] `json:"tags"`
		}
	}
	var got input
	k := &httpkernel.Kernel{Handler: httpkernel.Endpoint(func(ctx context.Context, in input) (httpkernel.NoContent, error) {
		got = in
		return httpkernel.NoContent{}, nil
	})}
	rec := do(k, "PUT", "/", `{"bio":null,"tags":["go"]}`)
	if rec.Code != 204 {
		t.Fatalf("%d %s", rec.Code, rec.Body)
	}
	b := got.Body
	if !b.Bio.Set || !b.Bio.Null || b.Bio.Present() || b.Email.Set || !b.Tags.Present() || b.Tags.Value[0] != "go" {
		t.Errorf("decoded %+v", b)
	}
	if rec := do(k, "PUT", "/", `{"email":1}`); rec.Code != 422 || problem(t, rec).Errors[0].Pointer != "#/email" {
		t.Errorf("a number for a string: %d %s", rec.Code, rec.Body)
	}
}

// TestOptionalEncoding checks that an Optional is written as it is read:
// its value, null, or absent with omitzero.
func TestOptionalEncoding(t *testing.T) {
	type body struct {
		Bio   httpkernel.Optional[string]   `json:"bio,omitzero"`
		Email httpkernel.Optional[string]   `json:"email,omitzero"`
		Tags  httpkernel.Optional[[]string] `json:"tags"`
	}
	out := must json.Marshal(body{Bio: httpkernel.Optional[string]{Set: true, Value: "hi"}, Email: httpkernel.Optional[string]{Set: true, Null: true}})
	if string(out) != `{"bio":"hi","email":null,"tags":null}` {
		t.Errorf("%s", out)
	}
	var back body
	must json.Unmarshal(out, &back)
	if !back.Bio.Present() || back.Bio.Value != "hi" || !back.Email.Null || !back.Tags.Null {
		t.Errorf("%+v", back)
	}
}
