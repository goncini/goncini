package httpkernel_test

import (
	"bufio"
	"context"
	"io"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"testing/synctest"
	"time"

	"github.com/goncini/goncini/httpkernel"
)

type tick struct {
	N int `json:"n"`
}

// streaming serves an endpoint that streams the events.
func streaming(events <-chan httpkernel.Event[tick], keepAlive time.Duration) http.Handler {
	return httpkernel.Endpoint(func(ctx context.Context, in struct{}) (httpkernel.Stream[tick], error) {
		return httpkernel.Stream[tick]{Events: events, KeepAlive: keepAlive}, nil
	})
}

// TestStream checks the events' format, flushed as they come, and that the
// stream ends with its events, or at an event it can't write.
func TestStream(t *testing.T) {
	events := make(chan httpkernel.Event[tick], 3)
	events <- httpkernel.Event[tick]{ID: "1", Name: "tick", Data: tick{1}, Retry: 3 * time.Second}
	events <- httpkernel.Event[tick]{Data: tick{2}}
	close(events)
	rec := httptest.NewRecorder()
	k := &httpkernel.Kernel{Handler: streaming(events, 0), Logger: quiet} // which flushes through its ResponseTracker
	k.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
	want := "id: 1\nevent: tick\nretry: 3000\ndata: {\"n\":1}\n\ndata: {\"n\":2}\n\n"
	if rec.Code != 200 || rec.Body.String() != want || rec.Header().Get("Content-Type") != "text/event-stream" || rec.Header().Get("Cache-Control") != "no-cache" || !rec.Flushed {
		t.Errorf("%d %v %q", rec.Code, rec.Header(), rec.Body)
	}

	events = make(chan httpkernel.Event[tick], 2)
	events <- httpkernel.Event[tick]{ID: "a\nb"}
	events <- httpkernel.Event[tick]{Data: tick{3}}
	k = &httpkernel.Kernel{Handler: streaming(events, 0)}
	logger, logs := logged()
	k.Logger = logger
	rec = httptest.NewRecorder()
	k.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/", nil))
	if rec.Body.Len() != 0 || !strings.Contains(logs.String(), "has a line break") {
		t.Errorf("an ID with a line break: %q, logged %s", rec.Body, logs)
	}
}

// TestStreamKeepAlive checks that a stream without events sends comments,
// until the client leaves.
func TestStreamKeepAlive(t *testing.T) {
	synctest.Test(t, (t *testing.T) => {
		ctx, cancel := context.WithTimeout(context.Background(), 50*time.Second)
		defer cancel()
		rec := httptest.NewRecorder()
		streaming(make(chan httpkernel.Event[tick]), 20*time.Second).ServeHTTP(rec, httptest.NewRequestWithContext(ctx, http.MethodGet, "/", nil))
		if rec.Body.String() != ":\n\n:\n\n" {
			t.Errorf("%q", rec.Body)
		}
	})
}

// TestStreamEndsWithServer checks that a stream outlasts the server's
// WriteTimeout, and that a server that shuts down ends it, rather than waiting
// for it.
func TestStreamEndsWithServer(t *testing.T) {
	ln := listen(t)
	events := make(chan httpkernel.Event[tick], 1)
	events <- httpkernel.Event[tick]{Data: tick{1}}
	srv := &httpkernel.Server{Handler: streaming(events, 0), WriteTimeout: 100 * time.Millisecond, Logger: quiet}
	ctx, cancel := context.WithCancel(context.Background())
	served := make(chan error, 1)
	go func() { served <- srv.Serve(ctx, ln) }()
	res := must http.Get("http://" + ln.Addr().String())
	defer res.Body.Close()
	body := bufio.NewReader(res.Body)
	line := must body.ReadString('\n')
	if line != "data: {\"n\":1}\n" {
		t.Fatalf("the first line %q", line)
	}
	time.Sleep(300 * time.Millisecond) // past the WriteTimeout
	events <- httpkernel.Event[tick]{Data: tick{2}}
	line = must body.ReadString('\n')
	line = must body.ReadString('\n')
	if line != "data: {\"n\":2}\n" {
		t.Fatalf("after the WriteTimeout: %q", line)
	}
	start := time.Now()
	cancel()
	if err := <-served; err != nil || time.Since(start) > 5*time.Second {
		t.Errorf("Serve = %v after %v", err, time.Since(start))
	}
	rest := must io.ReadAll(body)
	if string(rest) != "\n" {
		t.Errorf("after the shutdown: %q", rest)
	}
}
