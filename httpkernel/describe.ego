package httpkernel

import (
	"net/http"
	"reflect"
	"runtime"
	"strings"
)

// Description is what an Endpoint's handler takes and returns, for
// generating API documentation, such as goncini's openapi package does.
type Description struct {
	// Func is the full name of the typed handler, with its import path:
	// github.com/acme/api/articles.(*Controller).Show.
	Func string
	// Input is the handler's In type.
	Input reflect.Type
	// Params are the values bound from the path, query and headers, in the
	// order of In's fields.
	Params []ParamDescription
	// Body is the type of In's Body field, nil when it has none; a pointer
	// type means that the body is optional.
	Body reflect.Type
	// Validated reports whether In has a Validate method, which runs after
	// the kernel's Validator.
	Validated bool
	// Output is the handler's Out type.
	Output reflect.Type
	// Status is the status of a successful response: 200, or the one that
	// a ResponseDescriber result gives.
	Status int
	// Result is the type of the successful response's JSON body: Out, or
	// the one that a ResponseDescriber result gives; nil for none.
	Result reflect.Type
}

// ParamDescription is a value of an Endpoint's input bound from the path,
// query or headers.
type ParamDescription struct {
	// In is where the value comes from: "path", "query" or "header".
	In string
	// Name is the wildcard's, parameter's or header's name.
	Name     string
	Required bool
	// Default holds the values used when it is absent, or nil.
	Default []string
	// Enum holds the values allowed, or nil for any.
	Enum []string
	// Multiple reports whether the field takes every value of a repeated
	// parameter: it is a slice.
	Multiple bool
	// Field is the input's field, whose type is the value's, or a pointer
	// to it, or a slice of it, and whose tags may say more, such as
	// validate's.
	Field reflect.StructField
}

// ResponseDescriber is a Responder that says what it writes, for
// documentation: the status, and the type of the JSON body, nil for none.
// It is called on the zero value. Created, NoContent, Response and Cached
// implement it.
type ResponseDescriber interface {
	Responder
	DescribeResponse() (status int, body reflect.Type)
}

// Describe returns the description of h, a handler that Endpoint returned,
// and reports whether it is one.
func Describe(h http.Handler) (Description, bool) {
	d, ok := h.(describer)
	if !ok {
		return Description{}, false
	}
	return d.describe(), true
}

// describer is the handler Endpoint returns, whatever its type arguments.
type describer interface {
	describe() Description
}

func (e *endpoint[In, Out]) describe() Description {
	in := reflect.TypeFor[In]()
	d := Description{
		Func:      fullFuncName(e.h),
		Input:     in,
		Validated: reflect.PointerTo(in).Implements(reflect.TypeFor[interface{ Validate() error }]()),
		Output:    reflect.TypeFor[Out](),
		Status:    http.StatusOK,
		Result:    reflect.TypeFor[Out](),
	}
	if e.b.body >= 0 {
		d.Body = in.Field(e.b.body).Type
	}
	for _, p := range e.b.params {
		d.Params = append(d.Params, ParamDescription{
			In:       p.in.tag(),
			Name:     p.key,
			Required: p.required,
			Default:  p.def,
			Enum:     p.enum,
			Multiple: p.slice,
			Field:    in.FieldByIndex(p.field),
		})
	}
	var out Out
	if r, ok := any(out).(ResponseDescriber); ok {
		d.Status, d.Result = r.DescribeResponse()
	}
	return d
}

// fullFuncName is the name of a function with its package's import path,
// and without the -fm suffix of a method value.
func fullFuncName(fn any) string {
	f := runtime.FuncForPC(reflect.ValueOf(fn).Pointer())
	if f == nil {
		return "unknown"
	}
	return strings.TrimSuffix(f.Name(), "-fm")
}

// DescribeResponse says that c is a 201 with a T.
func (Created[T]) DescribeResponse() (int, reflect.Type) {
	return http.StatusCreated, reflect.TypeFor[T]()
}

// DescribeResponse says that NoContent is a 204 without a body.
func (NoContent) DescribeResponse() (int, reflect.Type) {
	return http.StatusNoContent, nil
}

// DescribeResponse says that res is a T, with status 200: the status a
// handler chooses at run time is unknown.
func (Response[T]) DescribeResponse() (int, reflect.Type) {
	return http.StatusOK, reflect.TypeFor[T]()
}

// DescribeResponse says that c is a 200 with a T.
func (Cached[T]) DescribeResponse() (int, reflect.Type) {
	return http.StatusOK, reflect.TypeFor[T]()
}

// Problem returns the problem that k answers err with: through its
// ErrorMappers, then ProblemFor. k may be nil.
func (k *Kernel) Problem(err error) Problem {
	return k.problemFor(err)
}

// ValueRecorder is a ResponseWriter that is told the values that WriteJSON
// and WriteProblem write, before they are encoded. The openapi package
// renders problems into one to learn the Go type of an API's error bodies.
type ValueRecorder interface {
	http.ResponseWriter
	RecordValue(v any)
}
