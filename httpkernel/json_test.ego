package httpkernel_test

import (
	"encoding/json/v2"
	"errors"
	"net/http"
	"net/http/httptest"
	"net/netip"
	"reflect"
	"slices"
	"strings"
	"testing"
	"testing/iotest"
	"time"
	"unicode/utf8"

	"github.com/goncini/goncini/httpkernel"
)

func TestWriteJSON(t *testing.T) {
	rec := httptest.NewRecorder()
	err := httpkernel.WriteJSON(rec, http.StatusCreated, map[string]any{"b": 1, "a": []string(nil)})
	if err != nil {
		t.Fatal(err)
	}
	if rec.Code != http.StatusCreated {
		t.Errorf("status = %d, want 201", rec.Code)
	}
	if ct := rec.Header().Get("Content-Type"); ct != "application/json" {
		t.Errorf("Content-Type = %q", ct)
	}
	// Keys are sorted, and a nil slice is an empty array.
	if got, want := rec.Body.String(), `{"a":[],"b":1}`; got != want {
		t.Errorf("body = %s, want %s", got, want)
	}
	if cl := rec.Header().Get("Content-Length"); cl != "14" {
		t.Errorf("Content-Length = %q, want 14", cl)
	}
}

func TestWriteJSONLeavesResponseUntouchedOnError(t *testing.T) {
	rec := httptest.NewRecorder()
	if err := httpkernel.WriteJSON(rec, http.StatusOK, make(chan int)); err == nil {
		t.Fatal("WriteJSON(chan) succeeded")
	}
	if rec.Header().Get("Content-Type") != "" || rec.Body.Len() != 0 {
		t.Errorf("response written: %v %q", rec.Header(), rec.Body)
	}
}

type article struct {
	Title string    `json:"title"`
	Tags  []string  `json:"tags"`
	Count int       `json:"count"`
	At    time.Time `json:"at"`
}

type envelope struct {
	Article article `json:"article"`
}

func post(contentType, body string) *http.Request {
	r := httptest.NewRequest(http.MethodPost, "/articles", strings.NewReader(body))
	if contentType != "" {
		r.Header.Set("Content-Type", contentType)
	}
	return r
}

func TestDecodeJSON(t *testing.T) {
	var in envelope
	r := post("application/json", `{"article":{"title":"Hi","tags":["go"]}}`)
	if err := httpkernel.DecodeJSON(httptest.NewRecorder(), r, &in); err != nil {
		t.Fatal(err)
	}
	if in.Article.Title != "Hi" || !slices.Equal(in.Article.Tags, []string{"go"}) {
		t.Errorf("decoded %+v", in)
	}
}

func TestDecodeJSONIgnoresUnknownMembersAndOtherCases(t *testing.T) {
	var in envelope
	r := post("application/json", `{"article":{"Title":"Hi","draft":true}}`)
	if err := httpkernel.DecodeJSON(httptest.NewRecorder(), r, &in); err != nil {
		t.Fatal(err)
	}
	if in.Article.Title != "" {
		t.Errorf("Title = %q: names should match case-sensitively", in.Article.Title)
	}
}

func TestDecodeJSONMediaTypes(t *testing.T) {
	for _, ct := range []string{"application/json", "application/json; charset=utf-8", "application/merge-patch+json", "Application/JSON"} {
		var in envelope
		if err := httpkernel.DecodeJSON(httptest.NewRecorder(), post(ct, `{}`), &in); err != nil {
			t.Errorf("Content-Type %q: %v", ct, err)
		}
	}
	for _, ct := range []string{"", "text/plain", "application/x-www-form-urlencoded", "application/jsonx"} {
		var in envelope
		err := httpkernel.DecodeJSON(httptest.NewRecorder(), post(ct, `{}`), &in)
		if e, ok := errors.AsType[httpkernel.BodyMediaType](err); !ok || e.ContentType != ct {
			t.Errorf("Content-Type %q: err = %v, want BodyMediaType", ct, err)
		}
		if p := httpkernel.ProblemFor(err); p.Status != http.StatusUnsupportedMediaType {
			t.Errorf("Content-Type %q: status %d, want 415", ct, p.Status)
		}
	}
}

func TestDecodeJSONProblems(t *testing.T) {
	invalid := "the request body has an invalid value"
	tests := []struct {
		name       string
		decoder    httpkernel.BodyDecoder
		body       string
		status     int
		detail     string // a prefix, for messages from encoding/json/jsontext
		violations []httpkernel.Violation
	}{
		{"empty", httpkernel.BodyDecoder{}, ``, 400, "the request body is empty", nil},
		{"too large", httpkernel.BodyDecoder{Limit: 10}, `{"article":{"title":"Hello"}}`, 413, "the request body is larger than 10 bytes", nil},
		{"truncated", httpkernel.BodyDecoder{}, `{"article":`, 400, "malformed JSON at byte 11: unexpected EOF", nil},
		{"trailing data", httpkernel.BodyDecoder{}, `{} {}`, 400, "malformed JSON at byte 3: unexpected data after the JSON value", nil},
		{"duplicate member", httpkernel.BodyDecoder{}, `{"article":{"title":"a","title":"b"}}`, 400, "malformed JSON at byte", nil},
		{"wrong kind", httpkernel.BodyDecoder{}, `{"article":{"title":1}}`, 422, invalid,
			[]httpkernel.Violation{{Pointer: "#/article/title", Detail: "expected a string, got a number"}}},
		{"wrong value", httpkernel.BodyDecoder{}, `{"article":{"count":1.5}}`, 422, invalid,
			[]httpkernel.Violation{{Pointer: "#/article/count", Detail: "expected an integer, got 1.5"}}},
		{"bad time", httpkernel.BodyDecoder{}, `{"article":{"at":"tomorrow"}}`, 422, invalid,
			[]httpkernel.Violation{{Pointer: "#/article/at", Detail: `expected an RFC 3339 time, got "tomorrow"`}}},
		{"wrong root", httpkernel.BodyDecoder{}, `[]`, 422, invalid,
			[]httpkernel.Violation{{Pointer: "#", Detail: "expected an object, got an array"}}},
		{"unknown member", httpkernel.BodyDecoder{RejectUnknown: true}, `{"article":{"title":"a","draft":true}}`, 422, invalid,
			[]httpkernel.Violation{{Pointer: "#/article/draft", Detail: "unknown field"}}},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			var in envelope
			err := tt.decoder.Decode(httptest.NewRecorder(), post("application/json", tt.body), &in)
			if _, ok := errors.AsType[httpkernel.BodyError](err); !ok {
				t.Fatalf("err = %v (%T), want a BodyError", err, err)
			}
			p := httpkernel.ProblemFor(err)
			if p.Status != tt.status || !strings.HasPrefix(p.Detail, tt.detail) {
				t.Errorf("problem = %d %q, want %d %q…", p.Status, p.Detail, tt.status, tt.detail)
			}
			if !reflect.DeepEqual(p.Errors, tt.violations) {
				t.Errorf("violations = %+v\nwant         %+v", p.Errors, tt.violations)
			}
		})
	}
}

func TestDecodeJSONKeepsTheCause(t *testing.T) {
	var in envelope
	err := httpkernel.DecodeJSON(httptest.NewRecorder(), post("application/json", `{"article":{"title":1}}`), &in)
	e, ok := errors.AsType[httpkernel.BodyInvalid](err)
	if !ok || e.Pointer != "/article/title" {
		t.Fatalf("err = %v, want BodyInvalid at /article/title", err)
	}
	if _, ok := errors.AsType[*json.SemanticError](err); !ok {
		t.Errorf("the json.SemanticError isn't reachable from %v", err)
	}
}

func TestDecodeJSONUnreadableBody(t *testing.T) {
	r := httptest.NewRequest(http.MethodPost, "/articles", iotest.ErrReader(errors.New("connection reset")))
	r.Header.Set("Content-Type", "application/json")
	var in envelope
	err := httpkernel.DecodeJSON(httptest.NewRecorder(), r, &in)
	if _, ok := errors.AsType[httpkernel.BodyUnreadable](err); !ok {
		t.Fatalf("err = %v (%T), want BodyUnreadable", err, err)
	}
	if p := httpkernel.ProblemFor(err); p.Status != http.StatusBadRequest {
		t.Errorf("status = %d, want 400", p.Status)
	}
}

func TestDecodeJSONDescribesWrongValues(t *testing.T) {
	type kinds struct {
		B   bool           `json:"b"`
		F   float64        `json:"f"`
		A   [2]int         `json:"a"`
		M   map[string]int `json:"m"`
		Raw []byte         `json:"raw"`
		P   *int           `json:"p"`
		U   uint8          `json:"u"`
	}
	tests := []struct{ body, pointer, detail string }{
		{`{"b":"yes"}`, "#/b", "expected a boolean, got a string"},
		{`{"f":"x"}`, "#/f", "expected a number, got a string"},
		{`{"a":{}}`, "#/a", "expected an array, got an object"},
		{`{"m":[]}`, "#/m", "expected an object, got an array"},
		{`{"m":{"k":"v"}}`, "#/m/k", "expected an integer, got a string"},
		{`{"raw":5}`, "#/raw", "expected a base64 string, got a number"},
		{`{"p":"x"}`, "#/p", "expected an integer, got a string"},
		{`{"u":300}`, "#/u", "expected an integer, got 300"},
		{`{"b":"` + strings.Repeat("y", 50) + `"}`, "#/b", "expected a boolean, got a string"},
	}
	for _, tt := range tests {
		var in kinds
		err := httpkernel.DecodeJSON(httptest.NewRecorder(), post("application/json", tt.body), &in)
		p := httpkernel.ProblemFor(err)
		want := []httpkernel.Violation{{Pointer: tt.pointer, Detail: tt.detail}}
		if !reflect.DeepEqual(p.Errors, want) {
			t.Errorf("%s: violations %+v, want %+v", tt.body, p.Errors, want)
		}
	}
}

type status int

func (s *status) UnmarshalJSON(b []byte) error {
	switch string(b) {
	case `"open"`:
		*s = 1
	case `"closed"`:
		*s = 2
	default:
		return errors.New("internal: lookup table v2 has no entry")
	}
	return nil
}

func TestDecodeJSONWithOwnUnmarshalers(t *testing.T) {
	type input struct {
		Addr   netip.Addr `json:"addr"`
		Status status     `json:"status"`
		Key    [4]byte    `json:"key"`
	}
	tests := []struct{ body, pointer, detail string }{
		{`{"addr":"not-an-ip"}`, "#/addr", "invalid value"},
		{`{"status":"pending"}`, "#/status", "invalid value"},
		{`{"key":[1,2,3,4]}`, "#/key", "expected a base64 string, got an array"},
	}
	for _, tt := range tests {
		var in input
		p := httpkernel.ProblemFor(httpkernel.DecodeJSON(httptest.NewRecorder(), post("application/json", tt.body), &in))
		want := []httpkernel.Violation{{Pointer: tt.pointer, Detail: tt.detail}}
		if !reflect.DeepEqual(p.Errors, want) {
			t.Errorf("%s: violations %+v, want %+v", tt.body, p.Errors, want)
		}
	}
}

func TestDecodeJSONIntoATypeWithoutJSONForm(t *testing.T) {
	var in struct {
		Every time.Duration `json:"every"`
	}
	err := httpkernel.DecodeJSON(httptest.NewRecorder(), post("application/json", `{"every":"1m"}`), &in)
	if _, ok := errors.AsType[httpkernel.BodyUnsupportedType](err); !ok {
		t.Fatalf("err = %v (%T), want BodyUnsupportedType", err, err)
	}
	if p := httpkernel.ProblemFor(err); p.Status != http.StatusInternalServerError {
		t.Errorf("status %d: the API's type is the API's fault", p.Status)
	}
}

func TestDecodeJSONChecksInOrder(t *testing.T) {
	tests := []struct {
		name    string
		decoder httpkernel.BodyDecoder
		body    string
		status  int
	}{
		{"truncated, with a wrong value first", httpkernel.BodyDecoder{}, `{"article":{"title":1}, "pad": "x"`, 400},
		{"trailing data after a wrong value", httpkernel.BodyDecoder{}, `{"article":{"title":1}} trailing`, 400},
		{"too large, with a wrong value first", httpkernel.BodyDecoder{Limit: 30}, `{"article":{"title":1}, "padding": "xxxxxxxxxxxxxxxx"}`, 413},
		{"whitespace only", httpkernel.BodyDecoder{}, " \n\t ", 400},
	}
	for _, tt := range tests {
		var in envelope
		err := tt.decoder.Decode(httptest.NewRecorder(), post("application/json", tt.body), &in)
		if p := httpkernel.ProblemFor(err); p.Status != tt.status {
			t.Errorf("%s: %d %q, want %d", tt.name, p.Status, p.Detail, tt.status)
		}
	}
	var in envelope
	err := httpkernel.DecodeJSON(httptest.NewRecorder(), post("application/json", " \n "), &in)
	if _, ok := errors.AsType[httpkernel.BodyEmpty](err); !ok {
		t.Errorf("whitespace: %v, want BodyEmpty", err)
	}
}

func TestDecodeJSONShortensOnCharacters(t *testing.T) {
	var in envelope
	body := `{"article":{"at":"` + strings.Repeat("é", 30) + `"}}`
	rec := httptest.NewRecorder()
	httpkernel.WriteProblem(rec, httpkernel.ProblemFor(httpkernel.DecodeJSON(httptest.NewRecorder(), post("application/json", body), &in)))
	if rec.Code != http.StatusUnprocessableEntity || !utf8.Valid(rec.Body.Bytes()) {
		t.Errorf("got %d %q", rec.Code, rec.Body)
	}
}
