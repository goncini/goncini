package httpkernel

import "net/http"

// ResponseTracker is an http.ResponseWriter that records what is written
// through it: the status, the body size, and whether the headers are out.
type ResponseTracker struct {
	w      http.ResponseWriter
	status int
	size   int64
}

// TrackResponse wraps w in a ResponseTracker, for middleware that logs or
// measures responses. If w already is one, TrackResponse returns it.
//
// The tracker's Unwrap method returns w, so http.ResponseController still
// reaches w's Flush, Hijack and deadline methods.
func TrackResponse(w http.ResponseWriter) *ResponseTracker {
	return w.(*ResponseTracker) ?? &ResponseTracker{w: w}
}

// Header returns the header map of the response.
func (t *ResponseTracker) Header() http.Header { return t.w.Header() }

// WriteHeader sends the status. Informational statuses (1xx, except 101) can
// precede the final one, so they don't count as the status.
func (t *ResponseTracker) WriteHeader(code int) {
	if t.status == 0 && (code >= 200 || code == http.StatusSwitchingProtocols) {
		t.status = code
	}
	t.w.WriteHeader(code)
}

// Write writes body bytes, after a 200 status if none was sent.
func (t *ResponseTracker) Write(b []byte) (int, error) {
	if t.status == 0 {
		t.status = http.StatusOK
	}
	n, err := t.w.Write(b)
	t.size += int64(n)
	return n, err
}

// Flush sends what is buffered to the client, if the underlying writer can.
func (t *ResponseTracker) Flush() {
	if t.status == 0 {
		t.status = http.StatusOK
	}
	_ = http.NewResponseController(t.w).Flush()
}

// Unwrap returns the writer the tracker wraps.
func (t *ResponseTracker) Unwrap() http.ResponseWriter { return t.w }

// Status is the status sent, or 0 if none yet.
func (t *ResponseTracker) Status() int { return t.status }

// Size is the number of body bytes written.
func (t *ResponseTracker) Size() int64 { return t.size }

// Started reports whether the status and headers are out, so the response
// can no longer change them.
func (t *ResponseTracker) Started() bool { return t.status != 0 }

// started reports whether a response is known to have started: whether w,
// or a writer it wraps, is a ResponseTracker that has.
func started(w http.ResponseWriter) bool {
	for w != nil {
		if t, ok := w.(*ResponseTracker); ok {
			return t.Started()
		}
		u, ok := w.(interface{ Unwrap() http.ResponseWriter })
		if !ok {
			return false
		}
		w = u.Unwrap()
	}
	return false
}
