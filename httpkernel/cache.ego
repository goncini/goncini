package httpkernel

import (
	"crypto/sha256"
	"encoding/base64"
	"encoding/json/v2"
	"net/http"
	"strings"
	"time"
)

// CacheControl is the value of a Cache-Control response header. The zero
// value writes no header.
type CacheControl struct {
	// MaxAge is how long the response stays fresh (max-age).
	MaxAge time.Duration
	// SharedMaxAge replaces MaxAge for shared caches such as CDNs (s-maxage).
	SharedMaxAge time.Duration
	// StaleWhileRevalidate lets caches serve the response stale for this
	// long while they revalidate it.
	StaleWhileRevalidate time.Duration
	// Public lets shared caches store responses to authenticated requests.
	Public bool
	// Private keeps the response out of shared caches.
	Private bool
	// NoCache makes caches revalidate the response before each use.
	NoCache bool
	// NoStore keeps the response out of every cache.
	NoStore bool
	// MustRevalidate forbids serving the response once it is stale.
	MustRevalidate bool
	// Immutable says the response won't change while it is fresh.
	Immutable bool
}

// String formats c as a header value, such as "public, max-age=60".
func (c CacheControl) String() string {
	var parts []string
	flag := (on bool, name string) => {
		if on {
			parts = append(parts, name)
		}
	}
	seconds := (d time.Duration, name string) => {
		if d > 0 {
			parts = append(parts, f"{name}={int64(d/time.Second)}")
		}
	}
	flag(c.Public, "public")
	flag(c.Private, "private")
	flag(c.NoCache, "no-cache")
	flag(c.NoStore, "no-store")
	seconds(c.MaxAge, "max-age")
	seconds(c.SharedMaxAge, "s-maxage")
	seconds(c.StaleWhileRevalidate, "stale-while-revalidate")
	flag(c.MustRevalidate, "must-revalidate")
	flag(c.Immutable, "immutable")
	return strings.Join(parts, ", ")
}

// ETag returns a strong entity tag for a response body: a quoted hash of it.
func ETag(body []byte) string {
	sum := sha256.Sum256(body)
	return `"` + base64.RawURLEncoding.EncodeToString(sum[:16]) + `"`
}

// NotModified handles a conditional GET or HEAD. It sets the ETag header
// when etag isn't empty and Last-Modified when modified isn't zero. Then, if
// the client's copy is current according to r's If-None-Match header (or,
// without one, If-Modified-Since), it writes a 304 and returns true: the
// handler has nothing more to write. Other methods always get false.
func NotModified(w http.ResponseWriter, r *http.Request, etag string, modified time.Time) bool {
	h := w.Header()
	if etag != "" {
		h.Set("ETag", etag)
	}
	if !modified.IsZero() {
		h.Set("Last-Modified", modified.UTC().Format(http.TimeFormat))
	}
	if r.Method != http.MethodGet && r.Method != http.MethodHead {
		return false
	}
	if inm := r.Header.Values("If-None-Match"); len(inm) > 0 {
		if !matchETag(strings.Join(inm, ","), etag, false) {
			return false
		}
	} else if ims := r.Header.Get("If-Modified-Since"); ims == "" || modified.IsZero() || !notAfter(modified, ims) {
		return false
	}
	h.Del("Content-Type")
	h.Del("Content-Length")
	w.WriteHeader(http.StatusNotModified)
	return true
}

// Precondition checks r's conditional headers against the resource's current
// etag and modification time, as a PUT, PATCH, DELETE or POST should before
// changing it (RFC 9110, section 13.2.2):
//   - If-Match, or without one If-Unmodified-Since: the client's copy must be
//     the current one;
//   - If-None-Match: the resource must not match, as with If-None-Match: *
//     to create a resource only if it doesn't exist.
//
// An etag of "" means the resource doesn't exist. Precondition returns a 412
// Problem when a condition fails, and nil otherwise. Dates that don't parse
// are ignored.
func Precondition(r *http.Request, etag string, modified time.Time) error {
	failed := Problem{
		Status: http.StatusPreconditionFailed,
		Detail: "the resource has changed since you got it: get it again before changing it",
	}
	if im := r.Header.Values("If-Match"); len(im) > 0 {
		if !matchETag(strings.Join(im, ","), etag, true) {
			return failed
		}
	} else if ius := r.Header.Get("If-Unmodified-Since"); ius != "" && !modified.IsZero() {
		if t, err := http.ParseTime(ius); err == nil && modified.Truncate(time.Second).After(t) {
			return failed
		}
	}
	if inm := r.Header.Values("If-None-Match"); len(inm) > 0 && matchETag(strings.Join(inm, ","), etag, false) {
		return Problem{Status: http.StatusPreconditionFailed, Detail: "the resource already exists in that state"}
	}
	return nil
}

// matchETag reports whether a list of entity tags from If-Match or
// If-None-Match matches etag, the current one. "*" matches any current
// etag; an empty etag, for a resource that doesn't exist, matches nothing.
// Strong comparison, for If-Match, never matches weak tags; weak
// comparison, for If-None-Match, ignores the W/ prefix.
func matchETag(list, etag string, strong bool) bool {
	if etag == "" {
		return false
	}
	for tag := range strings.SplitSeq(list, ",") {
		tag = strings.TrimSpace(tag)
		switch {
		case tag == "*":
			return true
		case strong:
			if tag == etag && !strings.HasPrefix(etag, "W/") {
				return true
			}
		case strings.TrimPrefix(tag, "W/") == strings.TrimPrefix(etag, "W/"):
			return true
		}
	}
	return false
}

// notAfter reports whether modified, truncated to the second as HTTP dates
// are, is not after the HTTP date in header. An unparsable date is false.
func notAfter(modified time.Time, header string) bool {
	t, err := http.ParseTime(header)
	return err == nil && !modified.Truncate(time.Second).After(t)
}

// WriteCachedJSON writes v as a 200 JSON response, like WriteJSON, that
// clients and caches may keep: with the Cache-Control header cc and an ETag
// computed from the body. A conditional GET whose copy is current gets a 304
// without the body.
func WriteCachedJSON(w http.ResponseWriter, r *http.Request, cc CacheControl, v any) error {
	b, err := json.Marshal(v, json.Deterministic(true))
	if err != nil {
		return err
	}
	if s := cc.String(); s != "" {
		w.Header().Set("Cache-Control", s)
	}
	if NotModified(w, r, ETag(b), time.Time{}) {
		return nil
	}
	return writeBody(w, http.StatusOK, "application/json", b)
}

// Cached is an Endpoint result written by WriteCachedJSON: Body as JSON,
// with the Cache-Control header Control and an ETag.
type Cached[T any] struct {
	Control CacheControl
	Body    T
}

// Respond writes c with WriteCachedJSON.
func (c Cached[T]) Respond(w http.ResponseWriter, r *http.Request) error {
	return WriteCachedJSON(w, r, c.Control, c.Body)
}
