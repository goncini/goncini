package httpkernel

import (
	"math"
	"net/http"
	"net/url"
	"slices"
	"strconv"
	"strings"
	"time"
)

// Params reads typed values from the query, path or headers of a request.
// A value is absent when it is missing or empty. Each getter returns its
// default when the value is absent, and records a violation when the value
// is there but invalid; Err returns the violations as one 400 Problem.
//
//	q := httpkernel.Query(r)
//	limit := q.Int("limit", 20)
//	tag := q.String("tag", "")
//	if err := q.Err(); err != nil {
//		return err
//	}
type Params struct {
	in         paramSource
	values     func(name string) []string
	violations []Violation
}

// paramSource is where a value comes from.
enum paramSource {
	inQuery
	inPath
	inHeader
}

// Query reads the query string of r. A malformed query string is a
// violation of its own.
func Query(r *http.Request) *Params {
	q, err := url.ParseQuery(r.URL.RawQuery)
	p := &Params{in: inQuery, values: name => q[name]}
	if err != nil {
		p.violations = append(p.violations, Violation{Detail: "malformed query string"})
	}
	return p
}

// Path reads the wildcards of the route pattern that matched r, such as
// {slug} in "GET /articles/{slug}".
func Path(r *http.Request) *Params {
	return &Params{in: inPath, values: name => {
		if v := r.PathValue(name); v != "" {
			return []string{v}
		}
		return nil
	}}
}

// Header reads the headers of r.
func Header(r *http.Request) *Params {
	return &Params{in: inHeader, values: r.Header.Values}
}

// Has reports whether the value is present.
func (p *Params) Has(name string) bool {
	_, ok := p.first(name)
	return ok
}

// String returns the value, or def if it is absent.
func (p *Params) String(name, def string) string {
	if v, ok := p.first(name); ok {
		return v
	}
	return def
}

// Strings returns every value of a repeated parameter, such as
// ?tag=go&tag=api, or nil if there are none.
func (p *Params) Strings(name string) []string {
	return nonEmpty(p.values(name))
}

// Int returns the value as an int, or def if it is absent.
func (p *Params) Int(name string, def int) int {
	return get(p, name, def, "must be an integer", strconv.Atoi)
}

// Int64 returns the value as an int64, or def if it is absent.
func (p *Params) Int64(name string, def int64) int64 {
	return get(p, name, def, "must be an integer", s => strconv.ParseInt(s, 10, 64))
}

// Float returns the value as a float64, or def if it is absent. NaN and
// infinities are invalid.
func (p *Params) Float(name string, def float64) float64 {
	return get(p, name, def, "must be a number", s => parseFinite(s, 64))
}

// Bool returns the value as a bool, or def if it is absent. It accepts what
// strconv.ParseBool does: true, false, 1, 0, t, f.
func (p *Params) Bool(name string, def bool) bool {
	return get(p, name, def, "must be true or false", strconv.ParseBool)
}

// Time returns the value as a time in RFC 3339 format, such as
// 2026-10-04T09:30:00Z, or def if it is absent.
func (p *Params) Time(name string, def time.Time) time.Time {
	return get(p, name, def, timeDetail, s => time.Parse(time.RFC3339, s))
}

// timeDetail is what a client is told about a time that doesn't parse.
const timeDetail = "must be an RFC 3339 time, such as 2026-10-04T09:30:00Z"

// get returns the named value parsed by parse, or def if it is absent. A
// value that doesn't parse is a violation with detail, and gives def too.
func get[T any](p *Params, name string, def T, detail string, parse func(string) (T, error)) T {
	v, ok := p.first(name)
	if !ok {
		return def
	}
	t, err := parse(v)
	if err != nil {
		p.invalid(name, detail)
		return def
	}
	return t
}

// parseFinite parses a float of the given bit size, rejecting NaN and
// infinities.
func parseFinite(s string, bits int) (float64, error) {
	f := check strconv.ParseFloat(s, bits) ""
	if math.IsNaN(f) || math.IsInf(f, 0) {
		fail "not a finite number"
	}
	return f, nil
}

// Enum returns the value if it is one of allowed, or def if it is absent:
//
//	order := httpkernel.Query(r).Enum("order", Newest, Newest, Oldest)
func (p *Params) Enum[T ~string](name string, def T, allowed ...T) T {
	v, ok := p.first(name)
	if !ok {
		return def
	}
	if slices.Contains(allowed, T(v)) {
		return T(v)
	}
	names := make([]string, len(allowed))
	for i, a := range allowed {
		names[i] = string(a)
	}
	p.invalid(name, f"must be one of: {strings.Join(names, ", ")}")
	return def
}

// Err returns nil, or a 400 Problem with a violation for each invalid value.
func (p *Params) Err() error {
	if len(p.violations) == 0 {
		return nil
	}
	detail := match p.in {
		inQuery  => "invalid query parameters"
		inPath   => "invalid path parameters"
		inHeader => "invalid headers"
	}
	return Problem{Status: http.StatusBadRequest, Detail: detail, Errors: slices.Clone(p.violations)}
}

// first returns the first value, unless it is absent.
func (p *Params) first(name string) (string, bool) {
	vs := p.values(name)
	if len(vs) == 0 || vs[0] == "" {
		return "", false
	}
	return vs[0], true
}

// invalid records a violation for the named value.
func (p *Params) invalid(name, detail string) {
	p.violations = append(p.violations, violationOf(p.in, name, detail))
}

// violationOf is a violation of the named value from a source.
func violationOf(in paramSource, name, detail string) Violation {
	return match in {
		inQuery, inPath => Violation{Parameter: name, Detail: detail}
		inHeader        => Violation{Header: name, Detail: detail}
	}
}
