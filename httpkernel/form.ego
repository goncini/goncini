package httpkernel

import (
	"cmp"
	"errors"
	"math"
	"mime"
	"mime/multipart"
	"net/http"
	"net/url"
	"reflect"
	"strconv"
	"strings"
)

// File is a file of a form body, which a form field of type File, *File or
// []File gets:
//
//	type AvatarInput struct {
//		Body struct {
//			Avatar httpkernel.File `form:"avatar,required"`
//			Alt    string          `form:"alt"`
//		} `limit:"8MiB"`
//	}
//
// Its Name and ContentType are what the client said: an app checks the
// content before it trusts them. The content is there until the endpoint
// returns, then removed: an endpoint that leaves work on it for later, such
// as a message, copies it first.
type File struct {
	// Name is the file's name, without its directories.
	Name string
	// ContentType is its part's, or application/octet-stream.
	ContentType string
	// Size is its length, in bytes.
	Size int64

	header *multipart.FileHeader
}

// Open opens the file's content.
func (f File) Open() (multipart.File, error) {
	if f.header == nil {
		return nil, errors.New("httpkernel: the File wasn't uploaded")
	}
	return f.header.Open()
}

var fileType = reflect.TypeFor[File]()

// formMemory is how much of a multipart body's files is kept in memory:
// the rest is in temporary files, until the endpoint returns.
const formMemory = 1 << 20

// formTypes are the media types of a form body.
const formTypes = "multipart/form-data or application/x-www-form-urlencoded"

// formParams plans the form body of type t, the Body field of the input
// type in, or returns nil if t isn't one: a struct whose fields have form
// tags, all of them.
func formParams(in, t reflect.Type) []param {
	if t.Kind() != reflect.Struct {
		return nil
	}
	mustNotHide(t, t, nil)
	var form []param
	var untagged string
	for _, f := range reflect.VisibleFields(t) {
		src, key, opts, ok := source(t, f)
		switch {
		case ok && src != inForm:
			panic(f"httpkernel.Endpoint: field {in}.Body.{f.Name} has a {src.tag()} tag: only the input's own fields can")
		case ok:
			form = append(form, newParam(t, f, src, key, opts))
		case f.IsExported() && !f.Anonymous:
			untagged = f.Name
		}
	}
	if form != nil && untagged != "" {
		panic(f"httpkernel.Endpoint: field {in}.Body.{untagged} has no form tag, which the body's other fields have")
	}
	return form
}

// readForm reads the form body of r, of at most limit bytes: its values,
// and its files, which cleanup removes.
func readForm(w http.ResponseWriter, r *http.Request, limit int64) (url.Values, map[string][]*multipart.FileHeader, func(), BodyError) {
	ct := r.Header.Get("Content-Type")
	mediaType, params, _ := mime.ParseMediaType(ct)
	switch mediaType {
	case "application/x-www-form-urlencoded":
		raw := check readBody(w, r, limit)
		values, err := url.ParseQuery(string(raw))
		if err != nil {
			fail BodyMalformedForm{Cause: err}
		}
		return values, nil, nil, nil
	case "multipart/form-data":
		if params["boundary"] == "" {
			fail BodyMalformedForm{Cause: errors.New("its Content-Type has no boundary")}
		}
		body := http.MaxBytesReader(w, r.Body ?? http.NoBody, limit)
		form, err := multipart.NewReader(body, params["boundary"]).ReadForm(formMemory)
		if tooLarge(w, err) || errors.Is(err, multipart.ErrMessageTooLarge) {
			fail BodyTooLarge{Limit: limit}
		}
		if err != nil {
			fail BodyMalformedForm{Cause: err}
		}
		return form.Value, form.File, () => { form.RemoveAll() }, nil
	}
	fail BodyMediaType{ContentType: ct, Want: formTypes}
}

// bindForm fills body, a form body, from r. Invalid values are a 422 that
// lists them all.
func (b *binder) bindForm(w http.ResponseWriter, r *http.Request, body reflect.Value, limit int64) (func(), error) {
	values, files, cleanup, err := readForm(w, r, limit)
	if err != nil {
		return nil, err
	}
	var violations []Violation
	for i := range b.form {
		p := &b.form[i]
		f := body.FieldByIndex(p.field)
		var detail string
		if !p.file {
			detail = p.fill(r, f, nonEmpty(values[p.key]))
		} else if headers := files[p.key]; len(headers) > 0 {
			p.setFiles(f, headers)
		} else if len(nonEmpty(values[p.key])) > 0 {
			detail = "must be a file"
		} else if p.required {
			detail = "is required"
		}
		if detail != "" {
			violations = append(violations, p.violation(detail))
		}
	}
	if len(violations) > 0 {
		if cleanup != nil {
			cleanup()
		}
		return nil, Invalid(violations...)
	}
	return cleanup, nil
}

// setFiles sets f, a file field, to the uploaded files: the first, unless
// it is a slice.
func (p *param) setFiles(f reflect.Value, headers []*multipart.FileHeader) {
	files := make([]File, len(headers))
	for i, h := range headers {
		files[i] = File{Name: h.Filename, ContentType: cmp.Or(h.Header.Get("Content-Type"), "application/octet-stream"), Size: h.Size, header: h}
	}
	switch {
	case p.slice:
		f.Set(reflect.ValueOf(files))
	case p.pointer:
		f.Set(reflect.ValueOf(&files[0]))
	default:
		f.Set(reflect.ValueOf(files[0]))
	}
}

// parseLimit parses a Body's limit tag: a number of bytes, or of KB, MB,
// GB, KiB, MiB or GiB.
func parseLimit(s string) (int64, bool) {
	units := []struct {
		suffix string
		size   int64
	}{{"KiB", 1 << 10}, {"MiB", 1 << 20}, {"GiB", 1 << 30}, {"KB", 1e3}, {"MB", 1e6}, {"GB", 1e9}, {"", 1}}
	for _, u := range units {
		if num, ok := strings.CutSuffix(s, u.suffix); ok {
			n, err := strconv.ParseInt(strings.TrimSpace(num), 10, 64)
			return n * u.size, err == nil && n > 0 && n <= math.MaxInt64/u.size
		}
	}
	return 0, false
}
