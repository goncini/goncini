package goncini

import (
	"cmp"
	"errors"
	"io/fs"
	"os"
	"path/filepath"
	"slices"
	"strings"
)

// Env is the environment an app runs in: its name, which APP_ENV sets, and
// the secrets that environment variables give it. An app's config reads it,
// and nothing else reads the environment.
type Env struct {
	// Name is the environment's name, such as dev, test or prod.
	Name string

	vars    map[string]string
	read    []string // the values of the secrets read, to mask them
	missing []string
	unknown bool
}

// EnvError is everything loading the environment and the config fails with.
error EnvError {
	// UnknownEnv means that APP_ENV names none of the app's environments.
	UnknownEnv{ Name string } "APP_ENV is {Name:q}, which names none of the app's environments"
	// MissingSecret means that the config reads a secret that no
	// environment variable or .env file sets.
	MissingSecret{ Name string } "missing secret {Name}: set it in the environment, or in a .env file"
	// DotenvSyntax means that a line of a .env file doesn't parse.
	DotenvSyntax {
		File   string
		Line   int
		Reason string
	} "{File}:{Line}: {Reason}"
}

// LoadEnv returns the environment named name, with the environment
// variables of the process over those of the .env files in dir. An empty
// name means APP_ENV's value, from the process or the .env files, or else
// dev; an empty APP_ENV counts as unset.
//
// The files are read as Symfony reads them, each one overriding the ones
// before: .env, .env.local, .env.<name> and .env.<name>.local. The test
// environment skips .env.local, so that tests run the same on every
// machine. Missing files are skipped.
//
// A .env file has a NAME=value per line, and # starts a comment. A value can
// be quoted: in single quotes it is taken as is, and in double quotes \n,
// \t, \" and \\ are escapes. Other variables aren't expanded.
func LoadEnv(dir, name string) (*Env, error) {
	vars := map[string]string{}
	check loadDotenv(filepath.Join(dir, ".env"), vars) ""
	if name == "" {
		local := map[string]string{}
		check loadDotenv(filepath.Join(dir, ".env.local"), local) ""
		name = cmp.Or(os.Getenv("APP_ENV"), local["APP_ENV"], vars["APP_ENV"], "dev")
	}
	files := []string{".env.local", ".env." + name, ".env." + name + ".local"}
	if name == "test" {
		files = files[1:]
	}
	for _, f := range files {
		check loadDotenv(filepath.Join(dir, f), vars) ""
	}
	for _, kv := range os.Environ() {
		if k, v, ok := strings.Cut(kv, "="); ok {
			vars[k] = v
		}
	}
	return NewEnv(name, vars), nil
}

// NewEnv returns the environment named name, with vars as its environment
// variables: for tests, which don't read the process's.
func NewEnv(name string, vars map[string]string) *Env {
	return &Env{Name: name, vars: vars}
}

// Secret returns the value of the environment variable name. A variable that
// is missing or empty makes Err fail; Secret returns "" meanwhile, so that a
// config reads all its secrets before the missing ones are reported
// together.
func (e *Env) Secret(name string) string {
	v := e.vars[name]
	if v == "" {
		if !slices.Contains(e.missing, name) {
			e.missing = append(e.missing, name)
		}
		return ""
	}
	e.read = append(e.read, v)
	return v
}

// Unknown records that Name names none of the app's environments, for Err
// to report. A config's Load calls it for the names it doesn't know.
func (e *Env) Unknown() {
	e.unknown = true
}

// Err returns what went wrong while the config was read: an unknown
// environment, then each missing secret.
func (e *Env) Err() error {
	var errs []error
	if e.unknown {
		errs = append(errs, UnknownEnv{Name: e.Name})
	}
	for _, name := range e.missing {
		errs = append(errs, MissingSecret{Name: name})
	}
	return errors.Join(errs...)
}

// loadDotenv adds the variables of the .env file at path to vars, if it
// exists.
func loadDotenv(path string, vars map[string]string) error {
	data, err := os.ReadFile(path)
	if errors.Is(err, fs.ErrNotExist) {
		return nil
	}
	check err ""
	for i, line := range strings.Split(string(data), "\n") {
		line = strings.TrimSpace(line)
		if line == "" || line[0] == '#' {
			continue
		}
		name, value, ok := strings.Cut(strings.TrimPrefix(line, "export "), "=")
		name = strings.TrimSpace(name)
		if !ok || !validName(name) {
			fail DotenvSyntax{File: path, Line: i + 1, Reason: "expected NAME=value"}
		}
		v, reason := dotenvValue(strings.TrimSpace(value))
		if reason != "" {
			fail DotenvSyntax{File: path, Line: i + 1, Reason: reason}
		}
		vars[name] = v
	}
	return nil
}

// validName reports whether name can name an environment variable: letters,
// digits and '_', not starting with a digit.
func validName(name string) bool {
	if name == "" || name[0] >= '0' && name[0] <= '9' {
		return false
	}
	return !strings.ContainsFunc(name, r => !(r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '_'))
}

// dotenvValue returns the value that s, what follows = on a line, stands
// for, or the reason it doesn't parse.
func dotenvValue(s string) (value, reason string) {
	if s == "" || s[0] != '\'' && s[0] != '"' {
		if i := strings.Index(s, " #"); i >= 0 {
			s = s[:i]
		}
		return strings.TrimSpace(s), ""
	}
	quote := s[0]
	var b strings.Builder
	for i := 1; i < len(s); i++ {
		c := s[i]
		switch {
		case c == quote:
			if rest := strings.TrimSpace(s[i+1:]); rest != "" && rest[0] != '#' {
				return "", "unexpected text after the closing quote"
			}
			return b.String(), ""
		case c == '\\' && quote == '"' && i+1 < len(s):
			i++
			esc := match s[i] {
				'n'  => "\n"
				't'  => "\t"
				'"'  => "\""
				'\\' => "\\"
				_    => ""
			}
			if esc == "" {
				return "", f"unknown escape \\{s[i]:c}"
			}
			b.WriteString(esc)
		default:
			b.WriteByte(c)
		}
	}
	return "", "missing closing quote"
}
