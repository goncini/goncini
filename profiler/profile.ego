package profiler

import (
	"cmp"
	"slices"
	"strconv"
	"time"

	"go.opentelemetry.io/otel/codes"
	sdktrace "go.opentelemetry.io/otel/sdk/trace"
)

// Profile is what a request did, or any other unit of work whose span has
// no parent in the process, such as a message's handling: its spans, with
// their log records as events.
type Profile struct {
	// ID is the trace's.
	ID   string    `json:"id"`
	Time time.Time `json:"time"`
	// Micros is how long it took, in microseconds.
	Micros int64 `json:"micros"`
	// Name is the root span's, such as GET.
	Name string `json:"name"`
	// Method, Path, Route and Status are the request's, if it is one.
	Method string `json:"method,omitempty"`
	Path   string `json:"path,omitempty"`
	Route  string `json:"route,omitempty"`
	Status int    `json:"status,omitempty"`
	Spans  []Span `json:"spans"`
}

// Span is a span of a profile.
type Span struct {
	ID     string `json:"id"`
	Parent string `json:"parent,omitempty"` // empty for the root
	Name   string `json:"name"`
	Kind   string `json:"kind"`
	// Start is when it started, in microseconds after the profile's, and
	// Micros how long it took.
	Start  int64 `json:"start"`
	Micros int64 `json:"micros"`
	// Error is its error status's description, if it failed.
	Error      string            `json:"error,omitempty"`
	Attributes map[string]string `json:"attributes,omitempty"`
	Events     []Event           `json:"events,omitempty"`
}

// Event is an event of a span, such as a log record: "log", with
// log.severity and log.message.
type Event struct {
	Name       string            `json:"name"`
	At         int64             `json:"at"` // microseconds after the profile's start
	Attributes map[string]string `json:"attributes,omitempty"`
}

// build returns the profile of root, whose trace's spans are spans, root
// included, in the order they started.
func build(root sdktrace.ReadOnlySpan, spans []sdktrace.ReadOnlySpan) Profile {
	start := root.StartTime()
	attrs := attributes(root)
	p := Profile{
		ID:     root.SpanContext().TraceID().String(),
		Time:   start,
		Micros: root.EndTime().Sub(start).Microseconds(),
		Name:   root.Name(),
		Method: attrs["http.request.method"],
		Path:   attrs["url.path"],
		Route:  attrs["http.route"],
	}
	p.Status, _ = strconv.Atoi(attrs["http.response.status_code"])
	slices.SortStableFunc(spans, (a, b sdktrace.ReadOnlySpan) => a.StartTime().Compare(b.StartTime()))
	for _, s := range spans {
		sp := Span{
			ID:         s.SpanContext().SpanID().String(),
			Name:       s.Name(),
			Kind:       s.SpanKind().String(),
			Start:      s.StartTime().Sub(start).Microseconds(),
			Micros:     s.EndTime().Sub(s.StartTime()).Microseconds(),
			Attributes: attributes(s),
		}
		if s.SpanContext().SpanID() != root.SpanContext().SpanID() {
			sp.Parent = s.Parent().SpanID().String()
		}
		if s.Status().Code == codes.Error {
			sp.Error = cmp.Or(s.Status().Description, "error")
		}
		for _, e := range s.Events() {
			ev := Event{Name: e.Name, At: e.Time.Sub(start).Microseconds(), Attributes: map[string]string{}}
			for _, kv := range e.Attributes {
				ev.Attributes[string(kv.Key)] = kv.Value.Emit()
			}
			sp.Events = append(sp.Events, ev)
		}
		p.Spans = append(p.Spans, sp)
	}
	return p
}

// attributes returns a span's attributes, as strings.
func attributes(s sdktrace.ReadOnlySpan) map[string]string {
	if len(s.Attributes()) == 0 {
		return nil
	}
	out := map[string]string{}
	for _, kv := range s.Attributes() {
		out[string(kv.Key)] = kv.Value.Emit()
	}
	return out
}
