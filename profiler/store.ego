package profiler

import (
	"encoding/json/v2"
	"errors"
	"fmt"
	"io/fs"
	"os"
	"path/filepath"
	"slices"
	"strings"
	"sync"
)

// FileStore keeps profiles as JSON files in a directory, the newest Keep
// of them, so that debug:requests, another process, reads what the server
// profiled.
type FileStore struct {
	Dir  string
	Keep int

	mu sync.Mutex
}

// Save keeps p, and forgets the oldest profiles beyond Keep.
func (s *FileStore) Save(p Profile) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	check os.MkdirAll(s.Dir, 0o755) ""
	b := check json.Marshal(p) ""
	// Names sort as the profiles' times: the newest last.
	name := fmt.Sprintf("%020d-%s.json", p.Time.UnixNano(), p.ID)
	check os.WriteFile(filepath.Join(s.Dir, name), b, 0o644) ""
	names := check s.names() ""
	for _, old := range names[:max(len(names)-s.Keep, 0)] {
		os.Remove(filepath.Join(s.Dir, old))
	}
	return nil
}

// List returns the newest n profiles, the newest first.
func (s *FileStore) List(n int) ([]Profile, error) {
	names := check s.names() ""
	slices.Reverse(names)
	out := []Profile{}
	for _, name := range names[:min(n, len(names))] {
		p, err := s.read(name)
		if errors.Is(err, fs.ErrNotExist) {
			continue // forgotten meanwhile
		}
		check err ""
		out = append(out, p)
	}
	return out, nil
}

// Get returns the profile with the ID, and whether there is one.
func (s *FileStore) Get(id string) (Profile, bool, error) {
	names := check s.names() ""
	for _, name := range names {
		if strings.HasSuffix(name, "-"+id+".json") {
			p, err := s.read(name)
			if errors.Is(err, fs.ErrNotExist) {
				return Profile{}, false, nil
			}
			return p, err == nil, err
		}
	}
	return Profile{}, false, nil
}

// names returns the names of the profiles' files, the oldest first.
func (s *FileStore) names() ([]string, error) {
	entries, err := os.ReadDir(s.Dir)
	if errors.Is(err, fs.ErrNotExist) {
		return nil, nil
	}
	check err ""
	var names []string
	for _, e := range entries {
		if strings.HasSuffix(e.Name(), ".json") {
			names = append(names, e.Name())
		}
	}
	return names, nil // ReadDir sorts them
}

func (s *FileStore) read(name string) (Profile, error) {
	var p Profile
	b := check os.ReadFile(filepath.Join(s.Dir, name)) ""
	check json.Unmarshal(b, &p) ""
	return p, nil
}
