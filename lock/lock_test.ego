package lock_test

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"testing"
	"time"

	_ "modernc.org/sqlite"

	"github.com/goncini/goncini/lock"
	"github.com/goncini/goncini/lock/locktest"
)

func TestMemoryStore(t *testing.T) {
	locktest.Run(t, (t *testing.T) => &lock.MemoryStore{})
}

func TestSQLStore(t *testing.T) {
	locktest.Run(t, func(t *testing.T) lock.Store {
		pool := must sql.Open("sqlite", "file::memory:")
		pool.SetMaxOpenConns(1) // one database: each connection to :memory: has its own
		t.Cleanup(() => { pool.Close() })
		s := must lock.NewSQLStore(pool)
		return s
	})
}

// lossy is a store that loses every lock after its first acquisition, as
// if it had expired and another owner took it.
type lossy struct{ acquired bool }

func (l *lossy) Acquire(ctx context.Context, key, owner string, ttl time.Duration) (bool, error) {
	first := !l.acquired
	l.acquired = true
	return first, nil
}

func (l *lossy) Release(ctx context.Context, key, owner string) error { return nil }

// TestRunLosesTheLock checks that Run cancels its function when a refresh
// finds the lock lost.
func TestRunLosesTheLock(t *testing.T) {
	f := &lock.Factory{Store: &lossy{}, TTL: 30 * time.Millisecond}
	ok, err := f.New("job").Run(context.Background(), func(ctx context.Context) error {
		<-ctx.Done()
		return context.Cause(ctx)
	})
	if !ok || !errors.Is(err, lock.ErrLost) {
		t.Errorf("ok %v, err %v", ok, err)
	}
}

// TestPrune checks that the SQL store deletes the expired locks now and
// then: those of keys taken once, such as a scheduler's ticks, would stay.
func TestPrune(t *testing.T) {
	pool := must sql.Open("sqlite", "file::memory:")
	pool.SetMaxOpenConns(1)
	t.Cleanup(() => { pool.Close() })
	s := must lock.NewSQLStore(pool)
	ctx := context.Background()
	for i := range 255 {
		must s.Acquire(ctx, fmt.Sprint("tick:", i), "a", time.Millisecond)
	}
	time.Sleep(2 * time.Millisecond)
	must s.Acquire(ctx, "tick:last", "a", time.Hour) // the 256th prunes
	var n int
	must pool.QueryRow("SELECT count(*) FROM goncini_locks").Scan(&n)
	if n != 1 {
		t.Errorf("%d locks, want the one that hasn't expired", n)
	}
}
