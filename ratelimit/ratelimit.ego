// Package ratelimit limits how often something happens, by key, as
// Symfony's RateLimiter does: requests by client, logins by user, emails by
// recipient. A Limiter applies a Policy to the state of each key, which a
// Store keeps:
//
//	logins := &ratelimit.Limiter{Policy: ratelimit.SlidingWindow{Limit: 5, Interval: time.Minute}}
//	res := check logins.Take(ctx, email, 1) ""
//	check res.Err() "" // Exceeded, a 429, when there were 5 in the last minute
//
// Middleware limits requests, by the key a function gives, such as ByIP.
package ratelimit

import (
	"context"
	"errors"
	"fmt"
	"math"
	"net/http"
	"strconv"
	"sync"
	"time"

	"github.com/goncini/goncini/httpkernel"
	"github.com/goncini/goncini/openapi"
)

// LimitError is everything a limiter refuses with.
error LimitError {
	// Exceeded means that the key used up its limit: it may try again
	// after RetryAfter.
	Exceeded {
		Limit      int
		RetryAfter time.Duration
	} "rate limit exceeded: retry in {RetryAfter}"
}

// Problem is a 429 with a Retry-After header, in whole seconds.
func (e Exceeded) Problem() httpkernel.Problem {
	return httpkernel.Problem{
		Status: http.StatusTooManyRequests,
		Detail: "too many requests: retry later",
		Header: http.Header{"Retry-After": {strconv.Itoa(seconds(e.RetryAfter))}},
	}
}

// seconds rounds d up to whole seconds.
func seconds(d time.Duration) int {
	return int(math.Ceil(d.Seconds()))
}

// Result is what taking tokens did.
type Result struct {
	// Allowed reports whether the tokens were taken.
	Allowed bool
	// Limit is how many tokens the policy allows.
	Limit int
	// Remaining is how many tokens are left now.
	Remaining int
	// RetryAfter is how long until the tokens can be taken, when they
	// weren't.
	RetryAfter time.Duration
	// Reset is how long until the key has its whole limit again.
	Reset time.Duration
}

// Err returns Exceeded if the tokens weren't taken, or nil.
func (r Result) Err() error {
	if r.Allowed {
		return nil
	}
	return Exceeded{Limit: r.Limit, RetryAfter: r.RetryAfter}
}

// State is what a store keeps of a key, for its policy.
type State struct {
	// Start is when the current window started, or when the bucket was
	// last filled; zero for a key not seen.
	Start time.Time
	// Count is the tokens taken in the current window, or left in the
	// bucket.
	Count float64
	// Previous is the tokens taken in the previous window, for a sliding
	// window.
	Previous float64
}

// Policy is a way to limit: FixedWindow, SlidingWindow or TokenBucket.
type Policy interface {
	// Take takes n tokens from st at now, if it can, and says what's left.
	Take(st *State, n int, now time.Time) Result
	// TTL is how long a key's state matters after it was last changed.
	TTL() time.Duration
}

// Store keeps the state of each key. Limiters in several processes share
// one to share their limits.
type Store interface {
	// Update calls f with the state of key, which it changes, with no other
	// update of key in between, and keeps the result for ttl from now, the
	// limiter's time.
	Update(ctx context.Context, key string, now time.Time, ttl time.Duration, f func(*State)) error
}

// Limiter limits how often each key takes tokens.
type Limiter struct {
	Policy Policy
	// Store keeps the keys' states; nil means a MemoryStore of the
	// limiter's own.
	Store Store
	// Now is the clock; nil means time.Now.
	Now func() time.Time

	once sync.Once
	mem  *MemoryStore
}

// Take takes n tokens for key, if the policy allows it. A Result that
// isn't allowed isn't an error: Err makes one.
func (l *Limiter) Take(ctx context.Context, key string, n int) (Result, error) {
	if n <= 0 {
		return Result{}, fmt.Errorf("ratelimit: can't take %d tokens", n)
	}
	if v, ok := l.Policy.(interface{ valid() error }); ok {
		check v.valid() ""
	}
	now := (l.Now ?? time.Now)()
	var res Result
	err := l.store().Update(ctx, key, now, l.Policy.TTL(), st => { res = l.Policy.Take(st, n, now) })
	return res, err
}

// Reset forgets key's state: it has its whole limit again, as after a
// successful login.
func (l *Limiter) Reset(ctx context.Context, key string) error {
	return l.store().Update(ctx, key, (l.Now ?? time.Now)(), l.Policy.TTL(), st => { *st = State{} })
}

// store is the limiter's store.
func (l *Limiter) store() Store {
	if l.Store != nil {
		return l.Store
	}
	l.once.Do(() => { l.mem = &MemoryStore{} })
	return l.mem
}

// FixedWindow allows Limit tokens per Interval, counted from the key's
// first in each window. A burst of twice the limit is possible across the
// end of a window.
type FixedWindow struct {
	Limit    int
	Interval time.Duration
}

func (p FixedWindow) Take(st *State, n int, now time.Time) Result {
	if st.Start.IsZero() || !now.Before(st.Start.Add(p.Interval)) {
		*st = State{Start: now}
	}
	reset := st.Start.Add(p.Interval).Sub(now)
	res := Result{Limit: p.Limit, Reset: reset}
	if st.Count+float64(n) <= float64(p.Limit) {
		st.Count += float64(n)
		res.Allowed = true
	} else {
		res.RetryAfter = if n > p.Limit { p.Interval } else { reset }
	}
	res.Remaining = p.Limit - int(st.Count)
	return res
}

func (p FixedWindow) TTL() time.Duration { return p.Interval }

func (p FixedWindow) valid() error { return positive("FixedWindow", p.Limit, p.Interval) }

// SlidingWindow allows Limit tokens per Interval, counting the previous
// window's tokens in proportion to how much of the interval it still
// covers: smoother than a fixed window, with as little state.
type SlidingWindow struct {
	Limit    int
	Interval time.Duration
}

func (p SlidingWindow) Take(st *State, n int, now time.Time) Result {
	if st.Start.IsZero() {
		st.Start = now
	}
	if elapsed := now.Sub(st.Start); elapsed >= p.Interval {
		windows := elapsed / p.Interval
		st.Previous = if windows == 1 { st.Count } else { 0 }
		st.Count = 0
		st.Start = st.Start.Add(windows * p.Interval)
	}
	elapsed := now.Sub(st.Start)
	weight := 1 - float64(elapsed)/float64(p.Interval)
	used := st.Previous*weight + st.Count
	limit := float64(p.Limit)
	res := Result{Limit: p.Limit}
	if used+float64(n) <= limit {
		st.Count += float64(n)
		used += float64(n)
		res.Allowed = true
	} else {
		res.RetryAfter = p.retryAfter(st, float64(n), elapsed)
	}
	res.Remaining = max(0, int(limit-used))
	switch {
	case st.Count > 0:
		res.Reset = st.Start.Add(2 * p.Interval).Sub(now) // when this window's tokens slide out
	case st.Previous > 0:
		res.Reset = st.Start.Add(p.Interval).Sub(now)
	}
	return res
}

// retryAfter is how long until n tokens fit, elapsed into the window.
func (p SlidingWindow) retryAfter(st *State, n float64, elapsed time.Duration) time.Duration {
	limit := float64(p.Limit)
	if n > limit {
		return 2 * p.Interval
	}
	interval := float64(p.Interval)
	if room := limit - st.Count - n; room >= 0 && st.Previous > 0 {
		// This window's tokens and n fit once enough of the previous
		// window's slide out.
		return time.Duration(interval*(1-room/st.Previous)) - elapsed
	}
	// In the next window, this one's tokens slide out.
	wait := p.Interval - elapsed
	if st.Count > limit-n {
		wait += time.Duration(interval * (1 - (limit-n)/st.Count))
	}
	return wait
}

func (p SlidingWindow) TTL() time.Duration { return 2 * p.Interval }

func (p SlidingWindow) valid() error { return positive("SlidingWindow", p.Limit, p.Interval) }

// TokenBucket allows bursts of up to Burst tokens, refilled at Rate tokens
// per Interval.
type TokenBucket struct {
	Burst    int
	Rate     int
	Interval time.Duration
}

func (p TokenBucket) Take(st *State, n int, now time.Time) Result {
	perToken := p.Interval / time.Duration(p.Rate)
	if st.Start.IsZero() {
		*st = State{Start: now, Count: float64(p.Burst)}
	}
	refill := float64(now.Sub(st.Start)) / float64(perToken)
	st.Count = min(float64(p.Burst), st.Count+refill)
	st.Start = now
	res := Result{Limit: p.Burst}
	if st.Count >= float64(n) {
		st.Count -= float64(n)
		res.Allowed = true
	} else if n > p.Burst {
		res.RetryAfter = p.Interval * time.Duration(p.Burst) / time.Duration(p.Rate)
	} else {
		res.RetryAfter = time.Duration((float64(n) - st.Count) * float64(perToken))
	}
	res.Remaining = int(st.Count)
	res.Reset = time.Duration((float64(p.Burst) - st.Count) * float64(perToken))
	return res
}

func (p TokenBucket) TTL() time.Duration {
	return p.Interval * time.Duration(p.Burst) / time.Duration(p.Rate)
}

func (p TokenBucket) valid() error {
	if p.Rate <= 0 {
		return errors.New("ratelimit: TokenBucket.Rate must be positive")
	}
	return positive("TokenBucket", p.Burst, p.Interval)
}

// positive checks a policy's limit and interval.
func positive(policy string, limit int, interval time.Duration) error {
	if limit <= 0 || interval <= 0 {
		return fmt.Errorf("ratelimit: %s needs a positive limit and interval", policy)
	}
	return nil
}

// MemoryStore keeps states in memory: the limits of one process. Its zero
// value is ready.
type MemoryStore struct {
	mu      sync.Mutex
	states  map[string]*entry
	updates int
}

// entry is a key's state, and when it expires.
type entry struct {
	st      State
	expires time.Time
}

// Update calls f with key's state, under the store's lock.
func (m *MemoryStore) Update(ctx context.Context, key string, now time.Time, ttl time.Duration, f func(*State)) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	if m.states == nil {
		m.states = map[string]*entry{}
	}
	e := m.states[key]
	if e == nil || now.After(e.expires) {
		e = &entry{}
		m.states[key] = e
	}
	f(&e.st)
	e.expires = now.Add(ttl)
	if m.updates++; m.updates%1024 == 0 {
		for k, e := range m.states {
			if now.After(e.expires) {
				delete(m.states, k)
			}
		}
	}
	return nil
}

// Middleware returns middleware that takes a token for each request, by
// the key that key returns for it, and answers Exceeded's 429 when there
// is none. Every response has the RateLimit-Limit, RateLimit-Remaining and
// RateLimit-Reset headers, in seconds.
func (l *Limiter) Middleware(key func(*http.Request) string) func(http.Handler) http.Handler {
	return next => &limited{l, key, next}
}

// ByIP is the key of a request's client: its address, as
// httpkernel.ClientIP gives it behind trusted proxies.
func ByIP(r *http.Request) string {
	return httpkernel.ClientIP(r).String()
}

// limited is a handler behind a limiter.
type limited struct {
	l    *Limiter
	key  func(*http.Request) string
	next http.Handler
}

func (h *limited) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	res, err := h.l.Take(r.Context(), h.key(r), 1)
	if err != nil {
		httpkernel.WriteError(w, r, err)
		return
	}
	hd := w.Header()
	hd.Set("RateLimit-Limit", strconv.Itoa(res.Limit))
	hd.Set("RateLimit-Remaining", strconv.Itoa(res.Remaining))
	hd.Set("RateLimit-Reset", strconv.Itoa(seconds(res.Reset)))
	if err := res.Err(); err != nil {
		httpkernel.WriteError(w, r, err)
		return
	}
	h.next.ServeHTTP(w, r)
}

// DescribeOperation says that the operation may answer 429.
func (h *limited) DescribeOperation(op *openapi.Op) {
	op.Errors = append(op.Errors, Exceeded{Limit: 60, RetryAfter: time.Minute})
}
